@page "/admin/advertise/{AdvertiseId}"
@attribute [Authorize(Policy = Permissions.Advertise.RequestView)]
@using Hisubmit.Client.SharedModels.Extensions
@inherits BaseAdminPages
<h3>AdvertiseDetail</h3>

<MudGrid>
    <MudItem xs="12">
        <MudCard Elevation="25">
            <MudContainer MaxWidth="MaxWidth.Medium">
                <MudBadge Color="Color.Info">@_advertise.AdvertiseType.ToDisplay()</MudBadge>
                <MudText Typo="Typo.body1">
                    @_advertise.Description
                </MudText>
                <MudItem xs="12">
                    <CustomDivider/>
                </MudItem>
                <MudText Typo="Typo.h4">User Information</MudText>

                <MudText Typo="Typo.h5">Email:@_advertise.Email</MudText>
                <MudText Typo="Typo.h5">Username:@_advertise.UserName</MudText>

                @foreach (var item in _advertise.Images)
                {
                    <MudImage Src="@item.Url"/>
                }
                @foreach (var item in _advertise.Files)
                {
                    <MudLink Src="@item.Url">@item.Title</MudLink>
                }
            </MudContainer>
        </MudCard>
    </MudItem>
</MudGrid>
