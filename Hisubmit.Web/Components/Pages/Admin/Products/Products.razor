@page "/admin/festival/products/{FestivalId:int}"
@page "/admin/festival/products"
@inject IStringLocalizer<Products> Localize
@using global::Hisubmit.Client.SharedModels.Features.Products.Queries.GetAllPaged;
@inherits BaseAdminPages
<style>
    .mud-table-container {
        overflow: auto;
    }
</style>

<MudContainer MaxWidth="MaxWidth.Medium">
    <HeroTitle Title="@Localize["Products"]" Description="@Localize["Manage All Products."]" />
  @*   @if (!_loaded)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    { *@
        <MudTable Elevation="25"
                  Loading="!_loaded"
                  ServerData="@(new Func<TableState, CancellationToken, Task<TableData<GetAllPagedProductsResponse>>>(ServerReload))"
                  Hover="true" @ref="_table">
            <ToolBarContent>
                <div class="justify-center mud-text-align-center min-w-xs-50">
                    <MudHidden Breakpoint="Breakpoint.LgAndUp">
                        @* <FestivalIdAuthorizeView Policy="@Permissions.FestivalIdProducts.Edit"> *@
                        @*     <MudIconButton DisableElevation Variant="Variant.Filled" Color="Color.Primary" *@
                        @*                    @onclick="@(() => InvokeModal(0))" Icon="@Icons.Material.Filled.Add"/> *@
                        @* </FestivalIdAuthorizeView> *@


                        <MudIconButton DisableElevation Variant="Variant.Filled"
                                       OnClick="@(() => OnSearch(""))" Icon="@Icons.Material.Filled.Refresh"
                                       Color="Color.Secondary" />
                        @* @if (_canExportProducts) *@
                        @* { *@
                        @*     <MudIconButton DisableElevation Variant="Variant.Filled" *@
                        @*                    OnClick="ExportToExcel" Icon="@Icons.Custom.FileFormats.FileExcel" *@
                        @*                    Color="Color.Surface" Style="margin-left: 5px;"/> *@
                        @* } *@

                    </MudHidden>
                    <MudHidden Breakpoint="Breakpoint.MdAndDown">
                        @* <FestivalIdAuthorizeView Policy="@Permissions.FestivalIdProducts.Edit"> *@
                        @*     <MudButton DisableElevation Variant="Variant.Filled" Color="Color.Primary" *@
                        @*                @onclick="@(() => InvokeModal(0))" StartIcon="@Icons.Material.Filled.Add" *@
                        @*                IconColor="Color.Surface"> *@
                        @*         @Localize["Create"] *@
                        @*     </MudButton> *@
                        @* </FestivalIdAuthorizeView> *@
                        <MudButton DisableElevation Variant="Variant.Filled"
                                   OnClick="@(() => OnSearch(""))" StartIcon="@Icons.Material.Filled.Refresh"
                                   IconColor="Color.Surface" Color="Color.Secondary">
                            @Localize["Reload"]
                        </MudButton>

                        @* <MudButton DisableElevation Variant="Variant.Filled" *@
                        @*            OnClick="ExportToExcel" StartIcon="@Icons.Custom.FileFormats.FileExcel" *@
                        @*            IconColor="Color.Secondary" Color="Color.Surface" *@
                        @*            Class="ml-2"> *@
                        @*     @Localize["Export"] *@
                        @* </MudButton> *@


                    </MudHidden>
                </div>
                <MudSpacer />

                <MudTextField T="string" ValueChanged="@(OnSearch)"
                              Placeholder="@Localize["Search"]"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium" Class="mt-0" />

            </ToolBarContent>
            <HeaderContent>
                <MudTh>
                    @Localize["Image"]
                </MudTh>
                <MudTh>
                    <MudTableSortLabel T="GetAllPagedProductsResponse" SortLabel="Name">
                        @Localize["Name"]
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    @Localize["Festival"]
                </MudTh>
                <MudTh>
                    <MudTableSortLabel T="GetAllPagedProductsResponse" SortLabel="Price">
                        @Localize["Price"]
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    @Localize["Type"]
                </MudTh>
                <MudTh>
                    @Localize["Enable"]
                </MudTh>
                <MudTh Style="text-align:right">@Localize["Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudImage Height="80" Src="@context.ImageDataURL"></MudImage>
                </MudTd>
                <MudTd DataLabel="Name">
                    <MudHighlighter Text="@context.Name" HighlightedText="@_searchString" />
                </MudTd>
                <MudTd>
                    @context.FestivalName
                </MudTd>
                <MudTd DataLabel="Price">
                    <MudHighlighter Text="@context.Price.ToString("C2")" HighlightedText="@_searchString" />
                </MudTd>
                <MudTd>
                    <ProductTypeChip ProductType="@context.ProductType" />
                </MudTd>
                <MudTd DataLabel="Enable">
                    <MudSwitch T="bool" Value="@context.IsEnable" T="bool"
                               ThumbIcon="@(context.IsEnable == true ? Icons.Material.Filled.Done : Icons.Material.Filled.Close)"
                               ThumbIconColor="@(context.IsEnable ? Color.Tertiary : Color.Error)"
                               ValueChanged="(t) => ChangeEnable(context.Id, t)" Color="Color.Success" />
                </MudTd>

                <MudTd DataLabel="Actions" Style="text-align: right">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   Href="@($"/festival/products/add/{context.Id}")"/>

                </MudTd>
            </RowTemplate>
            <PagerContent>
                <TablePager />
            </PagerContent>
        </MudTable>
    @* } *@
</MudContainer>