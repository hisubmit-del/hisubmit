@page "/Admin/violationReport"
@page "/Admin/violationReport/{FestivalIdParam:int?}"
@using Hisubmit.Client.SharedModels.Extensions
@using global::Hisubmit.Client.SharedModels.Features.Reviews.Queries
@inject IStringLocalizer<ViolationReport> Localize;
@attribute [Authorize(Policy = Permissions.ViolationReport.View)]

<MudContainer MaxWidth="MaxWidth.Large">

    <HeroTitle Title="@Localize["Violation Report"]" />

    <MudTable Loading="!_loaded" LoadingProgressColor="Color.Secondary" 
              class="default-light-table" Elevation="25" Items="_pagedDate" TotalItems="_totalItems"
              ServerData="@(new Func<TableState,CancellationToken, Task<TableData<GetAllReviewResponse>>>(ServerReload))" 
              Hover="true" Dense="true" Bordered="false" Striped="true" @ref="_table">
        <ToolBarContent>
            <MudHidden Breakpoint="Breakpoint.LgAndUp">
                <div class="justify-center mud-text-align-center">
                    <MudIconButton DisableElevation Variant="Variant.Filled" OnClick="@(() => OnSearch(""))" 
                                   Icon="@Icons.Material.Filled.Refresh" IconColor="Color.Surface" Color="Color.Secondary"/>
                </div>
            </MudHidden>
            <MudHidden Breakpoint="Breakpoint.MdAndDown">
                <div class="justify-center mud-text-align-center">
                    <MudButton DisableElevation Variant="Variant.Filled" OnClick="@(() => OnSearch(""))"
                               StartIcon="@Icons.Material.Filled.Refresh" IconColor="Color.Surface" 
                               Color="Color.Secondary">@Localize["Reload"]</MudButton>
                </div>
            </MudHidden>
            <MudSpacer />
            <MudTextField T="string" ValueChanged="@(OnSearch)" Placeholder="@Localize["Search"]" 
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>@Localize["User"]</MudTh>
            <MudTh>@Localize["festival"]</MudTh>
            <MudTh>@Localize["Text"]</MudTh>
            <MudTh>@Localize["Date"]</MudTh>
            <MudTh Style="text-align:center">@Localize["Actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="User">
                <MudHighlighter Text="@context.UserFullName" HighlightedText="@_searchString" />
            </MudTd>
            <MudTd DataLabel="festival">
                <MudHighlighter Text="@context.FestivalName" HighlightedText="@_searchString" />
            </MudTd>
            <MudTd DataLabel="Text">
                <MudText Typo="Typo.caption">@context.Text</MudText>
            </MudTd>
            <MudTd DataLabel="Date">
                <MudText>@context.CreatedOn.ToLongDateTime()</MudText>
            </MudTd>
            <MudTd DataLabel="Actions">
                <MudButton OnClick="() => SendMessage(context.UserId)">Send Message</MudButton>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <TablePager />
        </PagerContent>
    </MudTable>
</MudContainer>
