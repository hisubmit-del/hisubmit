@inject IStringLocalizer<AddPhotoModal> Localize

<EditForm Model="@_model" OnValidSubmit="SaveAsync">
    <FluentValidationValidator @ref="_fluentValidationValidator"/>
    <MudDialog>
        <TitleContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-3 mb-n1"/>
                @Localize["Add Photo"]
            </MudText>
        </TitleContent>
        <DialogContent>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Variant="Variant.Filled" For="@(() => _model.Title)" @bind-Value="_model.Title" Label="@Localize["Title"]"/>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Variant="Variant.Filled" For="@(() => _model.Location)" @bind-Value="_model.Location" Label="@Localize["Location"]"/>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Variant="Variant.Filled" For="@(() => _model.State)" @bind-Value="_model.State" Lines="3" Label="@Localize["State"]"/>
                </MudItem>
                <MudItem xs="12" md="6">
                    <ImageUploader  @bind-UploadRequest="_model.UploadRequest"/>
                </MudItem>
            </MudGrid>
        </DialogContent>
        <DialogActions>
            <MudButton DisableElevation Variant="Variant.Filled" OnClick="Cancel">@Localize["Cancel"]</MudButton>
            <LoadingButton Processing="_processing" DisableElevation Variant="Variant.Filled" ButtonType="ButtonType.Submit" Color="Color.Success">@Localize["Save"]</LoadingButton>
        </DialogActions>
    </MudDialog>
</EditForm>