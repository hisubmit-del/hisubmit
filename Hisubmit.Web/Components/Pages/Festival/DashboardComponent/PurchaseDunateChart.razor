<MudPaper Class="pa-3" Style="height: 100%">
    @if (_loaded)
    {
        <MudChart SelectedIndexChanged="ShowTotalType"
                  ChartType="ChartType.Donut"
                  Width="100%"
                  Height="240px"
                  ChartOptions="new ChartOptions() { ChartPalette = [ChartColors.Red, ChartColors.Blue, ChartColors.Green] }"
                  InputData="@_data"
                  InputLabels="@_labels">
            <CustomGraphics>
                <text class="donut-inner-text" x="47%" y="35%"
                      dominant-baseline="middle" text-anchor="middle"
                      fill="black" font-family="Helvetica" font-size="2">
                    @_showTitle
                </text>

                <text class="donut-inner-text" x="47%" y="50%"
                      dominant-baseline="middle" text-anchor="middle"
                      fill="black" font-family="Helvetica" font-size="5">
                    @_showTotal
                </text>
                @if (_showTitle != "Total")
                {
                    <MudIconButton OnClick="ShowAllTotal"
                                   Icon="@Icons.Material.Filled.Delete" Size="Size.Small"/>
                }
            </CustomGraphics>
        </MudChart>
    }
</MudPaper>