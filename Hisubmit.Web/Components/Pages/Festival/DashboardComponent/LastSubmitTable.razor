@using global::Hisubmit.Client.SharedModels.Features.Submits.Queries.GetAllSubmitsQueries
@using HiSubmit.Web.Components.Pages.Festival.JudgingProjects
@using HiSubmit.Web.Components.Pages.Festival.Submits
@using Hisubmit.Client.SharedModels.Extensions

@inject IStringLocalizer<LastSubmitTable> _Localizer

<MudCard Class="px-3 pt-1 pb-0" style="height:100%;overflow:scroll">
    <MudCardHeader>
    <HeroTitle Align="Align.Center" Title="Last Submits" ></HeroTitle>
    </MudCardHeader>
    <MudCardContent Class="mx-0" >
        <MudSimpleTable Class="default-simple-table" Elevation="0" Bordered="false" Dense="false">
            <thead>
            <tr>
                <th>Title</th>
                <th>Date</th>
                <th>Judging Enable</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var submit in Submits.OrderByDescending(p => p.SubmitDate).Take(6))
            {
                <tr>
                    <td>@submit.ProjectTitle</td>
                    <td>

                        <MudText Typo="Typo.caption">
                            @submit.SubmitDate.ToLongDate()
                        </MudText>
                    </td>
                    <td>
                        <JudgingStatusChip SelectedJudgingStatus="@submit.JudgingStatus"/>
                    </td>
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                       Title="Add To Judge" OnClick="() => AddToRefree(submit.Id)" 
                                       Color="Color.Default" Variant="Variant.Text"></MudIconButton>
                        <MudIconButton Icon="@Icons.Material.Filled.List" 
                                       Size="Size.Small" Title="Judging Results" OnClick="() => JudgingResult(submit.Id)"
                                       Color="Color.Default" Variant="Variant.Text"></MudIconButton>
                        <MudIconButton Icon="@Icons.Material.Filled.Verified"
                                       Size="Size.Small" Title="Final Result" OnClick="() => SubmitFinalResult(submit.Id)" 
                                       Color="Color.Default" Variant="Variant.Text"></MudIconButton>
                    </MudTd>
                </tr>
            }
            </tbody>
        </MudSimpleTable>
    </MudCardContent>
</MudCard>

@code{

    [Parameter]
    public List<GetAllSubmitsResponse> Submits { get; set; } = new();

    [Parameter]
    public int FestivalId { get; set; }


    private async Task AddToRefree(int submitId)
    {
        var parameters = new DialogParameters();
        parameters.Add(nameof(AddReferesToProject.FestivalId), FestivalId);
        parameters.Add(nameof(AddReferesToProject.SubmitId), submitId);
        var options = new DialogOptions
        { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true,CloseOnEscapeKey = false};
        var dialog =
            _dialogService.Show<AddReferesToProject>(_Localizer["Add Judge To Projects"], parameters, options);
        var result = await dialog.Result;
    }

    private async Task JudgingResult(int submitId)
    {
        _navigationManager.NavigateTo($"/festival/judgingResult/{submitId}");
    }

    private async Task SubmitFinalResult(int submitId)
    {
        var parameters = new DialogParameters { { nameof(FinalResultModal.SubmitId), submitId } };

        var options = new DialogOptions
        { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = _dialogService.Show<FinalResultModal>(_Localizer["Submit final result"], parameters, options);
        var result = await dialog.Result;
    }

}