@page "/festival/submits"
@inject IStringLocalizer<SubmitsList> Localize
@using global::Hisubmit.Client.SharedModels.Features.Submits.Queries.GetAllSubmitsQueries
@using Hisubmit.Client.SharedModels.Extensions
@using HiSubmit.Web.Components.Shared.SelectedItems
@inherits BaseFestival
<style>
    .mud-table-container {
        overflow: auto;
    }
</style>
<MudContainer MaxWidth="MaxWidth.ExtraLarge">

    <HeroTitle Title="@Localize["Submissions"]"
               Description="@Localize["Submitted projects to your festival"]" />
    @if (!_loaded)
    {
        <MudProgressCircular Color="Color.Primary"
                             Indeterminate="true" />
    }
    else
    {
        @* <MudButton Class="mb-3" OnClick="ToggleSearchFor" EndIcon="@Icons.Material.Filled.Search" Color="Color.Surface" Variant="Variant.Filled"> *@
        @*     Advanced Search *@
        @* </MudButton> *@
        if (_festivalperiods.FestivalPeriods.Count > 1)
        {
            <MudItem xs="12" md="6" Class="mb-2">
                <MudSelect T="int"
                           @bind-Value="_selectedFestivalId"
                           For="() => _selectedFestivalId"
                           Label="Select Period">
                    <MudSelectItem Value="@SelectedFestivalId">
                        Current
                    </MudSelectItem>
                    @foreach (var item in _festivalperiods.FestivalPeriods
                   .Where(p => p.FestivalId != SelectedFestivalId))
                    {
                        <MudSelectItem Value="item.FestivalId">
                            @item.Period
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        }


        <MudButton Class="mb-3" OnClick="ToggleSearchFor" EndIcon="@Icons.Material.Filled.Search"
                   Color="Color.Surface" Variant="Variant.Filled">
            Advanced Search
        </MudButton>

        <MudCard Class="mb-2" Elevation="5">
            <MudCardContent Class="@_displaySearchFrom">
                <SubmitFilterForm Model="_advancedSearch" OnSearchClicked="AdvancedSearch" />
            </MudCardContent>
        </MudCard>
        <MudTable class="default-table"
                  Loading="!_loadedData"
                  Elevation="25"
                  Items="PagedDate"
                  TotalItems="_totalItems"
                  MultiSelection="true"
                  T="GetAllSubmitsResponse"
                  @bind-SelectedItems="_selectedItems"
                  Hover="true"
                  Bordered="false"
                  Striped="true"
                  @ref="_table"
                  ServerData="@(new Func<TableState,CancellationToken, Task<TableData<GetAllSubmitsResponse>>>(ServerReload))">
            <ToolBarContent>
                <div class="justify-center mud-text-align-center">
                    <MudHidden Breakpoint="Breakpoint.MdAndDown">
                        <MudButton DisableElevation
                                   Variant="Variant.Filled"
                                   OnClick="@(() => OnSearch(""))"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   IconColor="Color.Surface"
                                   Color="Color.Secondary">
                            @Localize["Reload"]
                        </MudButton>
                    </MudHidden>
                    <MudHidden Breakpoint="Breakpoint.LgAndUp">
                        <MudIconButton DisableElevation
                                       Variant="Variant.Filled"
                                       OnClick="@(() => OnSearch(""))"
                                       Icon="@Icons.Material.Filled.Refresh"
                                       Color="Color.Secondary" />
                    </MudHidden>
                </div>
                <MudSpacer />
                <MudTextField T="string"
                              ValueChanged="@(OnSearch)"
                              Placeholder="@Localize["Search"]"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium"
                              Class="mt-0" />
            </ToolBarContent>
            <HeaderContent>
                <MudTh>
                    @Localize["Banner"]
                </MudTh>
                <MudTh>
                    @Localize["Title"]
                </MudTh>
                <MudTh>
                    @Localize["Type"]
                </MudTh>
                <MudTh>
                    <MudTableSortLabel T="GetAllSubmitsResponse"
                                       SortLabel="TrackingCode">
                        @Localize["Tracking Code"]
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    @Localize["Project Page"]
                </MudTh>
                <MudTh>
                    <MudTableSortLabel T="GetAllSubmitsResponse"
                                       SortLabel="SubmitDate">
                        @Localize["Submit Date"]
                    </MudTableSortLabel>
                </MudTh>

                <MudTh>
                    <MudTableSortLabel T="GetAllSubmitsResponse"
                                       SortLabel="SubmitEnable">
                        @Localize["Submission State"]
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel T="GetAllSubmitsResponse"
                                       SortLabel="JudgingEnable">
                        @Localize["Judging  Enable"]
                    </MudTableSortLabel>
                </MudTh>
                <MudTh Style="text-align:center">
                    @Localize["Actions"]
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudImage Src="@context.ProjectFileURl"
                              Width="80"
                              Height="80"
                              Alt="@context.ProjectTitle" />
                </MudTd>
                <MudTd DataLabel="Project">
                    <MudHighlighter Text="@context.ProjectTitle"
                                    HighlightedText="@_searchString"/>
                </MudTd>
                <MudTd DataLabel="Project ItemType">
                    <ProjectTypeChipSet SelectedProjectType="@context.ProjectProjectType"/>
                </MudTd>
                <MudTd>
                    @context.TrackingCode
                </MudTd>
                <MudTd DataLabel="Project Url">
                    <MudLink Href=@($"/project/{context.ProjectUrl}")>
                        @context.ProjectUrl
                    </MudLink>
                </MudTd>
                <MudTd SortBy="new Func<GetAllSubmitsResponse, object>(x => x.SubmitDate)" DataLabel="Submit Date">
                    <MudText Typo="Typo.caption">
                        @context.SubmitDate.ToLongDateTime()
                    </MudText>
                </MudTd>
                <MudTd DataLabel="submission state">
                    <SubmitStatusChip SelectedSubmitStatus="@context.SubmitStatus"/>
                </MudTd>
                <MudTd DataLabel="Judging Enable">
                    <JudgingStatusChip SelectedJudgingStatus="@context.JudgingStatus"/>
                </MudTd>
                <MudTd DataLabel="Actions">
                    <MudHidden Breakpoint="Breakpoint.MdAndDown">
                        <FestivalAuthorizeView Policy="@Permissions.Submits.AddToReferee">
                            <MudIconButton Icon="@Icons.Material.Filled.Add"
                                           Size="Size.Small"
                                           Title="Add To Judge"
                                           OnClick="() => AddToReferee(context.Id)"
                                           Color="Color.Default"
                                           Variant="Variant.Filled"/>
                        </FestivalAuthorizeView>
                        <FestivalAuthorizeView Policy="@Permissions.Submits.FinalResult">
                            <MudIconButton Icon="@Icons.Material.Filled.Verified"
                                           Size="Size.Small"
                                           Title="Notify"
                                           OnClick="() => SubmitFinalResult(context.Id)"
                                           Color="Color.Default"
                                           Variant="Variant.Filled"/>
                        </FestivalAuthorizeView>
                        <MudIconButton Icon="@Icons.Material.Filled.List"
                                       Size="Size.Small"
                                       Title="Judging Results"
                                       OnClick="() => JudgingResult(context.Id, context.ProjectTitle)"
                                       Color="Color.Default"
                                       Variant="Variant.Filled"/>
                    </MudHidden>
                    <MudHidden Breakpoint="Breakpoint.LgAndUp">
                        <MudMenu Label="@Localize["Actions"]"
                                 Variant="Variant.Filled"
                                 DisableElevation="true"
                                 EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                 IconColor="Color.Secondary"
                                 Direction="Direction.Left"
                                 OffsetX="true">
                            <FestivalAuthorizeView Policy="@Permissions.Submits.AddToReferee">
                                <MudMenuItem OnTouch="() => AddToReferee(context.Id)"
                                             OnClick="() => AddToReferee(context.Id)">
                                    @Localize["Add To Judge"]
                                </MudMenuItem>
                            </FestivalAuthorizeView>
                            <FestivalAuthorizeView Policy="@Permissions.Submits.FinalResult">
                                <MudMenuItem OnTouch="() => SubmitFinalResult(context.Id)"
                                             OnClick="() => SubmitFinalResult(context.Id)">
                                    @Localize["Notify"]
                                </MudMenuItem>
                            </FestivalAuthorizeView>
                            <MudMenuItem OnTouch="() => JudgingResult(context.Id, context.ProjectTitle)"
                                         OnClick="() => JudgingResult(context.Id, context.ProjectTitle)">
                                @Localize["Judging Results"]
                            </MudMenuItem>
                        </MudMenu>
                    </MudHidden>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <TablePager />
                <div class="mt-2 d-lg-inline">

                    <MudButton Color="Color.Default" Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Add"
                               Disabled="@(!_selectedItems.Any())"
                               OnClick="AddMultiProjectToReferee">
                        Add selected items to the Judges
                    </MudButton>
                    <MudButton Color="Color.Default" Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.Verified"
                               Disabled="@(!_selectedItems.Any())"
                               OnClick="NotifySelectedItems">
                        Notify Selected Items
                    </MudButton>

                </div>
            </PagerContent>

        </MudTable>
    }
</MudContainer>