@inject IStringLocalizer<AddJudgingFiled> Localize

<EditForm Model="@JudgingFiledModal" OnValidSubmit="SaveAsync">
    <FluentValidationValidator @ref="_fluentValidationValidator" />
    <MudDialog>
        <TitleContent>
            @{
                if (JudgingFiledModal.Id == 0)
                {
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-3 mb-n1" />
                        @Localize["Add Filed"]
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Update" Class="mr-3 mb-n1" />
                        @Localize["Update Filed"]
                    </MudText>
                }
            }
        </TitleContent>
        <DialogContent>
            <MudGrid>
               
                <MudItem xs="12" md="6">
                    <MudTextField T="string" For="@(() => JudgingFiledModal.Name)"
                                  @bind-Value="JudgingFiledModal.Name" Label="@Localize["Name"]" />
                </MudItem>              
            </MudGrid>
        </DialogContent>
        <DialogActions>
            <MudButton DisableElevation Variant="Variant.Filled" OnClick="Cancel">@Localize["Cancel"]</MudButton>
            @if (JudgingFiledModal.Id != 0)
            {
                <LoadingButton DisableElevation Variant="Variant.Filled" 
                               ButtonType="ButtonType.Submit" Processing="_processing"  
                               Color="Color.Secondary">@Localize["Update"]</LoadingButton>
            }
            else
            {
                <LoadingButton DisableElevation Variant="Variant.Filled"
                               ButtonType="ButtonType.Submit" Processing="_processing"  
                               Color="Color.Success">@Localize["Save"]</LoadingButton>
            }
        </DialogActions>
    </MudDialog>
</EditForm>