@page "/festival/news"

@inject IStringLocalizer<News> Localize;
@using global::Hisubmit.Client.SharedModels.Features.News.Queries
@inherits HiSubmit.Web.Components.Shared.Components.Base.BaseFestival

<MudContainer MaxWidth="MaxWidth.Medium">
    <HeroTitle Title="@Localize["News"]" Description="@Localize["Your festival news "]" />

    <MudTable Loading="!_loaded" LoadingProgressColor="Color.Secondary" class="default-light-table" Elevation="25" Items="_pagedDate" TotalItems="_totalItems" ServerData="@(new Func<TableState,CancellationToken, Task<TableData<GetAllNewResponse>>>(ServerReload))" Hover="true" Dense="true" Bordered="false" Striped="true" @ref="_table">
        <ToolBarContent>
            <div class="justify-center mud-text-align-center">
                <MudHidden Breakpoint="Breakpoint.LgAndUp">
                    <MudIconButton DisableElevation Variant="Variant.Filled" OnClick="@(() => OnSearch(""))" Icon="@Icons.Material.Filled.Refresh" IconColor="Color.Surface" Color="Color.Secondary" />
                    <FestivalAuthorizeView Policy="@Permissions.FestivalNews.Edit">
                        <MudIconButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Add" Icon="@Icons.Material.Filled.Add" />
                    </FestivalAuthorizeView>
                </MudHidden>
                <MudHidden Breakpoint="Breakpoint.MdAndDown">
                    <MudButton DisableElevation Variant="Variant.Filled" OnClick="@(() => OnSearch(""))" StartIcon="@Icons.Material.Filled.Refresh" IconColor="Color.Surface" Color="Color.Secondary">@Localize["Reload"]</MudButton>
                    <FestivalAuthorizeView Policy="@Permissions.FestivalNews.Edit">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Add" StartIcon="@Icons.Material.Filled.Add">Add New</MudButton>
                    </FestivalAuthorizeView>
                </MudHidden>
            </div>
            <MudSpacer />
            <MudTextField T="string" ValueChanged="@(OnSearch)" Placeholder="@Localize["Search"]" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>@Localize["Banner"]</MudTh>
            <MudTh>@Localize["Title"]</MudTh>
            <MudTh>@Localize["Enable"]</MudTh>
            <FestivalAuthorizeView Policy="@Permissions.FestivalNews.Edit">
                <MudTh Style="text-align:center">@Localize["Actions"]</MudTh>
            </FestivalAuthorizeView>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Banner">
                <MudImage Src="@context.BannerUrl" Width="100" Height="60" 
                Alt="@context.Title" Elevation="25" Class="rounded-lg" />
            </MudTd>
            <MudTd DataLabel="Title">
                <MudHighlighter Text="@context.Title" HighlightedText="@_searchString" />
            </MudTd>

            <MudTd DataLabel="Show in site">
                @if (context.IsEnable)
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error" />
                }
            </MudTd>
            <FestivalAuthorizeView Policy="@Permissions.FestivalNews.Edit">
                <MudHidden Breakpoint="Breakpoint.LgAndUp">
                    <MudTd DataLabel="Actions">
                        <MudMenu Label="@Localize["Actions"]" Variant="Variant.Filled" DisableElevation="true"
                        EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Secondary" 
                        >
                            <MudMenuItem OnTouch="() => Edit(context.Id)"
                                OnClick="@(() => Edit(context.Id))">@Localize["Edit"]</MudMenuItem>
                            <MudMenuItem OnTouch="() => Delete(context.Id, context.Title)" 
                                OnClick="@(() => Delete(context.Id, context.Title))">@Localize["Delete"]</MudMenuItem>
                        </MudMenu>
                    </MudTd>
                </MudHidden>
                <MudHidden Breakpoint="Breakpoint.MdAndDown">
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                        Size="Size.Small" Title="Edit" OnClick="() => Edit(context.Id)"
                        Color="Color.Default"></MudIconButton>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                        Size="Size.Small" Title="Delete" OnClick="() => Delete(context.Id, context.Title)" 
                        Color="Color.Default"></MudIconButton>
                    </MudTd>
                </MudHidden>
            </FestivalAuthorizeView>
        </RowTemplate>
        <PagerContent>
            <TablePager />
        </PagerContent>
    </MudTable>
</MudContainer>