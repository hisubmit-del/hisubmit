@page "/festival/subuser/roles"
@inject IStringLocalizer<FestivalRoles> Localize
@inherits BaseFestival
@using global::Hisubmit.Client.SharedModels.Responses.Identity
@using Hisubmit.Client.SharedModels.Constants.Role

<style>
    .mud-table-container {
        overflow: auto;
    }
</style>
<MudContainer MaxWidth="MaxWidth.Medium">

    <HeroTitle Title="@Localize["Roles"]" Description="@Localize["Manage Roles."]" />
    @if (!_loaded)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <MudTable Hover="true" Elevation="25" Items="_roleList" Striped="@_striped" Filter="new Func<RoleResponse, bool>(Search)" @bind-role="_role">
            <ToolBarContent>
                <div class="justify-center mud-text-align-center">
                    <MudHidden Breakpoint="Breakpoint.MdAndDown">
                        <FestivalAuthorizeView Policy="@Permissions.SubUserRole.Edit">
                            <MudButton DisableElevation Variant="Variant.Filled" Color="Color.Primary" OnClick="(() => InvokeModal())" StartIcon="@Icons.Material.Filled.Add" IconColor="Color.Surface">@Localize["Create"]</MudButton>
                        </FestivalAuthorizeView>
                        <MudButton DisableElevation Variant="Variant.Filled" OnClick="GetRolesAsync" StartIcon="@Icons.Material.Filled.Refresh" IconColor="Color.Surface" Color="Color.Secondary">@Localize["Reload"]</MudButton>

                    </MudHidden>
                    <MudHidden Breakpoint="Breakpoint.LgAndUp">
                        <FestivalAuthorizeView Policy="@Permissions.SubUserRole.Edit">
                            <MudIconButton DisableElevation Variant="Variant.Filled" Color="Color.Primary" OnClick="(() => InvokeModal())" Icon="@Icons.Material.Filled.Add" />
                        </FestivalAuthorizeView>
                        <MudIconButton DisableElevation Variant="Variant.Filled" OnClick="GetRolesAsync" Icon="@Icons.Material.Filled.Refresh" Color="Color.Secondary" />
                    </MudHidden>
                </div>
                <MudSpacer />
                <MudTextField @bind-Value="_searchString" Immediate="true" Placeholder="@Localize["Search for Roles..."]" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0 mb-3"></MudTextField>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<RoleResponse, object>(x => x.Id)">@Localize["Id"]</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<RoleResponse, object>(x => x.Name)">@Localize["Role"]</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<RoleResponse, object>(x => x.Description)">@Localize["Description"]</MudTableSortLabel>
                </MudTh>
                <FestivalAuthorizeView Policy="@Permissions.SubUserRole.Edit">
                    <MudTh Style="text-align:right">@Localize["Actions"]</MudTh>
                </FestivalAuthorizeView>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Id">@context.Id</MudTd>
                <MudTd DataLabel="@Localize["Role"]">
                    <MudHighlighter Text="@context.Name" HighlightedText="@_searchString" />
                </MudTd>
                <MudTd DataLabel="@Localize["Description"]">
                    <MudHighlighter Text="@context.Description" HighlightedText="@_searchString" />
                </MudTd>
                <MudTd DataLabel="@Localize["Actions"]" Style="text-align: right">
                   @if (context.Name != RoleConstants.Referee)
                   {
                       <FestivalAuthorizeView Policy="@Permissions.SubUserRole.Edit">
                           <MudMenu Label="@Localize["Actions"]" Variant="Variant.Filled" DisableElevation="true" 
                                    EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                    IconColor="Color.Secondary" Direction="Direction.Left" OffsetX="true">
                               <MudMenuItem OnTouch="@(() => ManagePermissions(context.Id))" 
                                            OnClick="@(() => ManagePermissions(@context.Id))">@Localize["Manage Permission"]</MudMenuItem>
                               <MudMenuItem OnTouch="@(() => InvokeModal(@context.Id))" 
                                            OnClick="@(() => InvokeModal(@context.Id))">@Localize["Edit"]</MudMenuItem>
                               <MudMenuItem OnTouch="@(() => Delete(@context.Id))" 
                                            OnClick="@(() => Delete(@context.Id))">@Localize["Delete"]</MudMenuItem>
                           </MudMenu>
                       </FestivalAuthorizeView>
                   }
                </MudTd>
            </RowTemplate>
            <FooterContent>
            </FooterContent>
            <PagerContent>
                <TablePager />
            </PagerContent>
        </MudTable>
    }
</MudContainer>