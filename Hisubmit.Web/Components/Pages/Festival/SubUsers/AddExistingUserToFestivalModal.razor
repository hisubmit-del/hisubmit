@inject IStringLocalizer<AddExistingUserToFestivalModal> _localizer


<EditForm Model="@_festival" OnValidSubmit="SubmitFestival">
    <FluentValidationValidator @ref="_fluentValidationValidator"/>
    <MudDialog>
        <TitleContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-3 mb-n1"/>
                @_localizer["Add user To  festival"]
            </MudText>
        </TitleContent>
        <DialogContent>
            <MudTextField For="@(() => _festival.Email)" @bind-value="_festival.Email" Label="@_localizer["Email address"]"/>
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Filled" OnClick="Cancel">@_localizer["Cancel"]</MudButton>
            <LoadingButton Variant="Variant.Filled" Processing="_processing" ButtonType="ButtonType.Submit" Disabled="@(!_validate)" Color="Color.Success">@_localizer["Add to FestivalId"]</LoadingButton>
        </DialogActions>
    </MudDialog>
</EditForm>