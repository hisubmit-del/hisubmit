@using Hisubmit.Client.SharedModels.Extensions
@using Hisubmit.Client.SharedModels.Enums.Advertises
@inject IStringLocalizer<Advertise> Localize

@page "/advertise"
@inherits BasePublicPages 
@attribute [AllowAnonymous]

<MudContainer MaxWidth="MaxWidth.Medium">
    <div class="festival-single">
        <MudCard>
        <div class="title-text mb-3 pa-6">
            <h2>Advertise</h2>
            <p>
                The Toronto Short Film festival is open to short films from any country which are under 50
                minutes in length.The Toronto Short Film festival is open to short films from any country
                which
                are under 50 minutes in length.The Toronto Short Film festival is open to short films from
                any
                country which are under 50 minutes in length.The Toronto Short Film festival is open to
                short
                films from any country which are under 50 minutes in length.The Toronto Short Film festival
                is
                open to short films from any country which are under 50 minutes in length.
            </p>
        </div>

        <MudPaper Class="pa-8">
                <MudItem xs="12">
                    <EditForm Model="_advertise" OnSubmit="SaveAsync">
                        <FluentValidationValidator @ref="_fluentValidationValidator"/>
                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudSelect Variant="Variant.Filled" T="AdvertiseType"
                                               @bind-Value="@_advertise.AdvertiseType" 
                                               For="() => _advertise.AdvertiseType" Label="@Localize["ItemType"]">
                                        @foreach (AdvertiseType type in Enum.GetValues<AdvertiseType>())
                                        {
                                            <MudSelectItem Value="@type">@type.ToDisplay()</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_advertise.Email" For="() => _advertise.Email" 
                                                  Label="@Localize["Email"]" Variant="Variant.Filled"></MudTextField>
                                </MudItem>

                                <MudItem xs="12" md="12">
                                    <MudTextField @bind-Value="_advertise.Description" For="() => _advertise.Description"
                                                  Lines="3" Label="@Localize["Description"]" Variant="Variant.Filled"></MudTextField>
                                </MudItem>
                            </MudGrid>

                            @if (_advertise.AdvertiseType == AdvertiseType.Banner)
                            {
                                <MudGrid Class="mt-3 d-flex align-baseline">
                                    @foreach (var image in _advertise.Images)
                                    {
                                        <MudItem xs="12" md="4">
                                            <ImageUploader @bind-UploadRequest="image.UploadRequest"
                                                           @bind-Url="image.Url" DeleteImage="() => DeleteImage(image)"></ImageUploader>
                                            <MudTextField @bind-Value="@image.Title" 
                                                          For="() => image.Title" Label="@Localize["Title"]"></MudTextField>
                                        </MudItem>
                                    }
                                    <MudButton StartIcon="@Icons.Material.Filled.Add" Title="Add Image" Class="mb-3"  Style="height: 40px"
                                               OnClick="AddImage">@Localize["Add Image"]</MudButton>
                                </MudGrid>
                            }
                            else
                            {
                                <MudGrid Class="mt-3 d-felx align-baseline">
                                    @foreach (var file in _advertise.Files)
                                    {
                                        <MudItem sm="12" md="4" lg="4" Class="mb-3">
                                            <FileUploader @bind-UploadRequest="file.UploadRequest" 
                                                          DeleteImage="() => DeleteFiles(file)"></FileUploader>
                                        </MudItem>
                                    }
                                    

                                    <MudButton Style="height: 40px"  Class="mb-3" StartIcon="@Icons.Material.Filled.Add" Title="Add File" 
                                               OnClick="AddFile">@Localize["Add File"]</MudButton>
                                </MudGrid>
                            }
                        <MudItem xs="12" Class="ma-3 mt-5 justify-center">
                            <LoadingButton  Class="my-1 w-25" Processing="_processing"
                                           Variant="Variant.Filled" Color="Color.Primary" 
                                           ButtonType="ButtonType.Submit">@Localize["Send Advertise Filter"]</LoadingButton>
                        </MudItem>
                    </EditForm>
                </MudItem>
        </MudPaper>
        </MudCard>
    </div>
</MudContainer>
