@if (!_loaded)
{
}
else
{
    <MudCard Class="mt-2 pb-3 pt-2 border-radius-20 ">
        <div Class="mt-2 text-center">
            <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-2">Venues</MudText>
        </div>
        <div class="side-box contact w-100">
            <ul class="contact-list mt-4">
                @foreach (var item in Venues)
                {
                    <li>
                        <a href="#" target="_blank">
                            <MudIcon Icon="@Icons.Material.Outlined.LocationOn"></MudIcon>
                            @item.Address.ToString()
                        </a>
                    </li>
                }
            </ul>
        </div>

    </MudCard>
}

