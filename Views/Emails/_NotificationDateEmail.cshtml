@model HiSubmit.Application.Models.Emails.SendNotificationDateEmailViewModel  
@{
    Layout = "_EmailLayout.cshtml";
}



<div class="content">
    <!-- عنوان اصلی -->
    <div class="title">
        @Model.Title
    </div>

    <!-- متن اصلی -->
    <div class="text">
        <p style="margin: 0;">
            Dear <b>@Model.FestivalName</b>
        </p>
        <p>
            Just a friendly reminder that your festival’s 'NotificationDate' is today.
        </p>
        <p style="margin-top: 4px">
            Please make sure to update the 'Judging Enable' of all
            'Undecided' submissions by your Notification Date:
            <span
                style="color:#3f3f3f">
                @Model.NotificationDate.ToString("MMMM dd ,yyyy")
            </span>.
        </p>
        <p style="margin-top: 4px">
            If you need more time to make decisions, you can easily edit
            your Notification Date
            <a shape="rect"
               href="https://HiSubmit.com/festival/edit/@Model.FestivalId"
               style="color:#327ccb" rel="noreferrer noopener"
               target="_blank">
                here
            </a>
        </p>
        <p style="margin-top: 4px">
            You can find a pre-filtered list of all your Undecided entries
            <a shape="rect"
               href="https://HiSubmit.com/festival/submits/@Model.FestivalId"
               style="color:#327ccb" rel="noreferrer noopener"
               target="_blank">
                here
            </a>.
        </p>
    </div>
</div>




