@page "/JudgingDetail/{Id:int}"

<MudContainer MaxWidth="MaxWidth.Large">
    @* <MudCard> *@
    @if (!_loaded)
    {
        <Spinner></Spinner>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12">
                <MudPaper Class="my-3 w-100">
                    <MudStack Row="true" Justify="Justify.SpaceBetween"
                              Class="pa-4 w-100">

                        <MudText Typo="Typo.h5">
                            <MudIcon Icon="@Icons.Material.Filled.AppRegistration" Color="Color.Primary" />
                            @_projectJudging.Submit.ProjectTitle
                        </MudText>

                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Color="Color.Primary" />
                            @_projectJudging.UserName
                            <MudLink typo="Typo.caption" Href="@("/Judges/dashboard/"+_projectJudging.UserId)"> (View Page)</MudLink>
                        </MudText>
                        <MudText>
                            <MudChip T="string" Color="MudBlazor.Color.Info"
                                     Variant="Variant.Text">
                                    @(_projectJudging.JudgingFiledAnswereds.Sum(p=>p.Rate).ToString())
                            </MudChip>

                            <MudChip T="string" Size="Size.Small">
                                @_projectJudging.JudgingButton?.Name
                            </MudChip>
                        </MudText>

                    </MudStack>
                </MudPaper>
            </MudItem>
            <MudItem xs="12">
                <MudPaper Class="px-3 py-3 mb-4">
                     <MudGrid Class="ma-0 pa-0"> 
                        @foreach (var filed in _judgingForm.JudgingFileds)
                        {
                            var selectedValue = 0;
                            if (_projectJudging.JudgingFiledAnswereds != null)
                            {
                                selectedValue = _projectJudging.JudgingFiledAnswereds
                                .Where(p => p.JudgingFiledId == filed.Id)
                                .Select(p => p.Rate)
                                .FirstOrDefault();
                            }

                            <MudItem xs="12" md="6" Class="pa-3">
                                <MudStack Justify="Justify.SpaceBetween" Row="true">
                                    <MudText Typo="Typo.subtitle2">@filed.Name</MudText>
                                    <MudRating ReadOnly="true" MaxValue="5" SelectedValue="selectedValue"></MudRating>
                                </MudStack>
                            </MudItem>
                        }

                    </MudGrid>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                @if (!string.IsNullOrWhiteSpace(_projectJudging.Comment))
                {
                    <MudPaper Class="min-h-300 h-100 pa-2">
                        <MudContainer>
                            @if (string.IsNullOrWhiteSpace(@_projectJudging.Comment))
                            {
                                <span class="text-secondary">
                                    The judge has not left a comment
                                </span>
                            }
                            else
                            {
                                @_projectJudging.Comment
                            }
                        </MudContainer>
                    </MudPaper>
                }
            </MudItem>
            <MudItem xs="12" md="8">
                @if (_judgingForm.Questions.Any())
                {
                    <MudPaper Class="h-100">
                        <FormCreatorWithAnswer Questions="_judgingForm.Questions"
                                               AnswerQuestions="_projectJudging.SubmitAnswerQuestions"></FormCreatorWithAnswer>
                    </MudPaper>
                }
            </MudItem>
        </MudGrid>
        <MudGrid Class="justify-end mt-2">
            <MudButton Color="Color.Secondary" Variant="Variant.Filled"
                       Href="@($"/festival/judgingResult/{_projectJudging.SubmitId}/{_projectJudging.Submit.ProjectTitle}")">Back To List</MudButton>
        </MudGrid>
    }
</MudContainer>