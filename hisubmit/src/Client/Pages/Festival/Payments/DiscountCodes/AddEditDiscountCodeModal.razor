@using HiSubmit.Client.Infrastructure.Managers.Payments
@using HiSubmit.Client.SharedModels.Extensions
@using Hisubmit.Hisubmit.Client.SharedModels.Features.Payments
@inject IStringLocalizer<AddEditDiscountCodeModal> Localize

<EditForm Model="@Model" OnValidSubmit="SaveAsync">
    <FluentValidationValidator @ref="_fluentValidationValidator" />
    <MudDialog>
        <TitleContent>
            @{
                if (Model.Id == 0)
                {
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-3 mb-n1" />
                        @Localize["Add Discount code"]
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Update" Class="mr-3 mb-n1" />
                        @Localize["Update Discount code"]
                    </MudText>
                }
            }
        </TitleContent>
        <DialogContent>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField For="@(() => Model.Description)" Variant="Variant.Filled"
                                  Margin="Margin.Dense"
                                  @bind-Value="Model.Description" Label="@Localize["Short Description"]" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField For="@(() => Model.Code)" Variant="Variant.Filled"
                                  Margin="Margin.Dense"
                                  @bind-Value="Model.Code" Label="@Localize["Code"]" />
                </MudItem>


                <MudItem xs="12" md="6">
                    <MudSelect @bind-Value="Model.DiscountValueType" For="@(() => Model.DiscountValueType)" Margin="Margin.Dense"
                               T="DiscountValueType" Label="@Localize["Discount Type"]" Variant="Variant.Filled" AnchorOrigin="Origin.BottomCenter">
                        @foreach (DiscountValueType type in Enum.GetValues<DiscountValueType>())
                        {
                            <MudSelectItem Value="type">@type.ToDisplay()</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField For="@(() => Model.DiscountValue)"
                                     Margin="Margin.Dense"
                                     Variant="Variant.Filled" HelperText="Amount Or Percentage"
                                     @bind-Value="Model.DiscountValue" Label="@Localize["Amount"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudDatePicker @bind-Date="@Model.ExpiredTime" Variant="Variant.Filled"
                                   Margin="Margin.Dense"
                                   Label="Expiration Date"></MudDatePicker>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudNumericField For="@(() => Model.Count)" Variant="Variant.Filled" HelperText="Leave empty if unlimited"
                                     @bind-Value="Model.Count" Label="@Localize["Code Usage Limit"]" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.subtitle2">Apply To: </MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudCheckBox @bind-Value="Model.ForSubmissions"  Size="Size.Small" Color="Color.Primary">
                        Event Submissions
                    </MudCheckBox>
                    
                    <MudCheckBox @bind-Value="Model.ForProducts"  Size="Size.Small" Color="Color.Primary">
                        Products
                    </MudCheckBox>
                    
                    <MudCheckBox @bind-Value="Model.ForTickets" Size="Size.Small" Color="Color.Primary">
                        Tickets
                    </MudCheckBox>
                    <ValidationMessage For="@(() => Model.CartItemTypes)" class="text-danger" />
                </MudItem>
                
                <MudItem>
                    <MudSwitch @bind-Value="Model.Enable" Label="Is Enable" Color="Color.Primary" />
                </MudItem>
            </MudGrid>
        </DialogContent>
        <DialogActions>
            <MudButton DisableElevation Variant="Variant.Filled" OnClick="Cancel">@Localize["Cancel"]</MudButton>
            <FestivalAuthorizeView Policy="@Permissions.DiscountCode.Edit">
                @if (Model.Id != 0)
                {
                    <LoadingButton Processing="_processing" DisableElevation Variant="Variant.Filled"
                                   ButtonType="ButtonType.Submit"  Color="Color.Secondary">
                        @Localize["Update"]
                    </LoadingButton>
                }
                else
                {
                    <LoadingButton Processing="_processing" DisableElevation Variant="Variant.Filled"
                                   ButtonType="ButtonType.Submit"  Color="Color.Success">
                        @Localize["Save"]
                    </LoadingButton>
                }
            </FestivalAuthorizeView>
        </DialogActions>
    </MudDialog>
</EditForm>

@code
{
    #region Inject

    [Inject] private IDiscountCodeManager DiscountCodeManager { get; set; }

    #endregion

    #region Parameter

    [Parameter] public int FestivalId { get; set; }
    [Parameter] public AddEditDiscountCodeRequest Model { get; set; } = new();

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; }

    #endregion

    #region Private Field
    private FluentValidationValidator _fluentValidationValidator;
  //  private bool Validated => _fluentValidationValidator.Validate(options => { options.IncludeAllRuleSets(); });
    private bool _processing;
    #endregion

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    protected override Task OnParametersSetAsync()
    {
        SetCartItems();
        return base.OnParametersSetAsync();
    }

    private async Task SaveAsync()
    {
        _processing = true;
        Model.CartItemTypes = GetCartItems();
        var response = await DiscountCodeManager.AddEdit(Model);
        if (response.Succeeded)
        {
            _snackBar.Add(response.Messages[0], Severity.Success);
            MudDialog.Close();
        }
        else
            foreach (var message in response.Messages)
                _snackBar.Add(message, Severity.Error);

        _processing = false;
    }

    private string GetCartItems()
    {
        List<byte> t = [];
        if(Model.ForSubmissions)
            t.Add((byte)CartItemType.Submit);
        if (Model.ForProducts)
            t.Add((byte)CartItemType.Product);
        if (Model.ForTickets)
        {
            t.Add((byte)CartItemType.Ticket);
            t.Add((byte)CartItemType.Badge);
        }

        return string.Join(',',t);
    }

    private void SetCartItems()
    {
        if(string.IsNullOrWhiteSpace(Model.CartItemTypes))
            return;
        Model.ForSubmissions = Model.CartItemTypes.Contains(((byte)CartItemType.Submit).ToString());
        Model.ForProducts = Model.CartItemTypes.Contains(((byte)CartItemType.Product).ToString());
        Model.ForTickets = Model.CartItemTypes.Contains(((byte)CartItemType.Ticket).ToString()) || 
                           Model.CartItemTypes.Contains(((byte)CartItemType.Badge).ToString());
    }
}
