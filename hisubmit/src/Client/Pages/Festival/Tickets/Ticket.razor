@page "/festival/ticket/{TicketId:int}"
@page "/festival/ticket"

@inherits BaseFestival
@inject IStringLocalizer<Ticket> Localize
<MudContainer MaxWidth="MaxWidth.Medium">
    <HeroTitle Title="@Localize["Ticket"]"/>
    @* <MudItem xs="12"> *@
    <MudCard Class="pa-4" Elevation="25">
        @* <MudContainer MaxWidth="MaxWidth.Medium"> *@
      @if (_loaded)
        {
              <EditForm Model="_ticket" OnSubmit="SaveAsync">
            <MudGrid >
                <FluentValidationValidator @ref="_fluentValidationValidator"/>
                @* <MudGrid> *@
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_ticket.Title"
                                  For="() => _ticket.Title"
                                  Label="@Localize["Title"]"
                                  Variant="Variant.Filled"/>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudNumericField 
                        Label="Capacity"
                        Adornment=Adornment.None
                                  For="() => _ticket.Capacity"
                                  @bind-value="_ticket.Capacity"
                                  Variant="Variant.Filled"/>
                </MudItem>
                @* </MudGrid> *@
                @* <MudGrid> *@
                <MudItem xs="12" md="10">
                    <MudTextField @bind-Value="_ticket.Description"
                                  For="() => _ticket.Description"
                                  Lines="3"
                                  AutoGrow="true"
                                  MaxLines="7"
                                  Label="@Localize["Description"]"
                                  Variant="Variant.Filled"/>
                </MudItem>
                @* </MudGrid> *@
                @* <MudGrid> *@


                <MudItem xs="12" md="12">
                    <DividerAndTitle Title="Price"/>
                </MudItem>
                @* </MudGrid> *@
                @* <MudGrid Class="my-2"> *@

                @* <MudItem xs="12" md="3"> *@
                @*     <MudText Typo="Typo.body1"> *@
                @*         @Localize["Cost"] *@
                @*     </MudText> *@
                @* </MudItem> *@
                <MudItem xs="12" md="4">
                    <MudNumericField 
                                  For="() => _ticket.Cost"
                                  Label="Price"
                                  @bind-value="_ticket.Cost"
                                  Variant="Variant.Filled"/>
                </MudItem>
                <MudItem xs="12" md="8">
                    <MudCheckBox T="bool" @bind-Value="_ticket.AddManagerPercentage"
                                 Dense="true"
                                 Color="Color.Info"
                                 For="() => _ticket.AddManagerPercentage">
                        <MudText Typo="Typo.body1">
                            @Localize["Add site commission on ticket price"]
                        </MudText>
                    </MudCheckBox>
                </MudItem>

                <MudItem xs="12" md="12">
                <DividerAndTitle Title="Ticket sales period"></DividerAndTitle>
                </MudItem>
                @* </MudGrid> *@
                @* <MudGrid Class="my-2"> *@
                @* <MudItem xs="12" md="3"> *@
                @*     <MudText Typo="Typo.body1"> *@
                @*         @Localize["Ticket sales period"] *@
                @*     </MudText> *@
                @* </MudItem> *@
                <MudItem xs="12" md="4">
                    <MudTextField T="DateTime?"
                                  For="() => _ticket.OpenDate"
                                  @bind-Value="_ticket.OpenDate"
                                  Format="s"
                                  Variant="Variant.Filled"
                                  Label="@Localize["Start Time"]"
                                  InputType="InputType.DateTimeLocal"/>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="DateTime?"
                                  For="() => _ticket.CloseDate"
                                  @bind-Value="_ticket.CloseDate"
                                  Format="s"
                                  Variant="Variant.Filled"
                                  Label="@Localize["End Time"]"
                                  InputType="InputType.DateTimeLocal"/>
                </MudItem>
                @* </MudGrid> *@
                @* <MudGrid Class="my-2"> *@

                <MudItem xs="12">
                <DividerAndTitle Title="Venues"> </DividerAndTitle>
                </MudItem>
                @* <MudItem xs="12" md="3"> *@
                @*     <MudText Typo="Typo.body1">@Localize["Venues"]</MudText> *@
                @* </MudItem> *@
                @* <MudItem xs="12" md="9"> *@
                @* <MudGrid> *@
                <MudItem xs="12" md="5">
                    <MudSelect T="int"
                               For="() => _ticket.VenueId"
                               Value="_ticket.VenueId"
                               Variant="Variant.Filled"
                               ValueChanged="ChangeVenueSelected"
                               Label="@Localize["Select Venue"]"
                               AnchorOrigin="Origin.BottomCenter">
                        @foreach (var venue in _venues)
                        {
                            <MudSelectItem Value="@venue.Id">
                                @venue.Name
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                @* </MudGrid> *@
                <MudItem xs="12" Class="mt-5"></MudItem>
                <MudItem xs="12" md="3"></MudItem>
                @if (_selectedVenue.VenueType == VenueType.ShowLocation)
                {
                    @* <MudGrid> *@
                    <MudItem xs="12" md="9">
                        <MudTreeView T="int"
                                     Hover="true"
                                     Color="Color.Info"
                                     ReadOnly="false"
                                     SelectionMode="SelectionMode.MultiSelection"
                                     AutoSelectParent="true"
                                     @bind-SelectedValues="_ticket.ShowTimesId">
                            @foreach (var showHall in _selectedVenue.ShowHalls)
                            {
                                var expanded = showHall.ShowTimes
                                    .Any(p => _ticket.ShowTimesId.ToList().Any(k => k == p.Id));

                                var selected = showHall.ShowTimes
                                    .All(p => _ticket.ShowTimesId.ToList().Any(k => k == p.Id));

                                <MudTreeViewItem Icon="@Icons.Material.Filled.CameraRoll"
                                                 Expanded="expanded"
                                                 Selected="selected"
                                                 T="int"
                                                 Text="@showHall.Title"
                                                 Value="@(0)">
                                    @foreach (var showTime in showHall.ShowTimes)
                                    {
                                        var isSelected = _ticket.ShowTimesId.ToList().Any(id => id == showTime.Id);
                                        if (isSelected) expanded = true;
                                        <MudTreeViewItem Icon="@Icons.Material.Filled.AccessTime"
                                                         Selected="isSelected"
                                                         T="int"
                                                         Value="@showTime.Id"
                                                         Text="@($"{showTime.Name} : {showTime.OpenDate?.ToShortDateString()} : {showTime.OpenDate?.ToLongTimeString()} --> {showTime.CloseDate?.ToLongTimeString()}")">
                                        </MudTreeViewItem>
                                    }
                                </MudTreeViewItem>
                            }
                        </MudTreeView>
                        @* </MudGrid> *@
                    </MudItem>
                }
                else
                {
                    @* <MudGrid> *@
                    <MudItem xs="12" md="4">
                        <MudTextField T="DateTime?"
                                      For="() => _ticket.EventDate"
                                      @bind-Value="_ticket.EventDate"
                                      Format="s"
                                      Variant="Variant.Filled"
                                      Label="@Localize["Event Date"]"
                                      InputType="InputType.DateTimeLocal"/>
                    </MudItem>
                    // </MudGrid>
                }


                @* </MudGrid> *@
                <LoadingButton FullWidth="true"
                               Class="my-2"
                               Processing="_processing"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               ButtonType="ButtonType.Submit">
                    @Localize["Save"]
                </LoadingButton>
            </MudGrid>
        </EditForm>
        }else{
          <CustomeProgress Height="500"/>        
        }
        @* </MudContainer> *@
    </MudCard>
    @* </MudItem> *@
</MudContainer>