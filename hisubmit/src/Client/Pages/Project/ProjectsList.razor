@page "/user/projects"
@inject IStringLocalizer<ProjectsList> Localize
@using global::Hisubmit.Client.SharedModels.Features.Projects.Queries.GetAll
@inherits HiSubmit.Client.Pages.User.BaseUserPages
<style>
    .mud-table-container {
        overflow: auto;
    }
</style>

<MudContainer MaxWidth="MaxWidth.Large">
    
<HeroTitle Title="@Localize["Project"]"
           Description="@Localize["List of your projects."]"/>
@if (!_loaded)
{
    <MudProgressCircular Color="Color.Primary"
                         Indeterminate="true"/>
}
else
{
    <MudButton Class="mb-3" OnClick="ToggleSearchFor" EndIcon="@Icons.Material.Filled.Search"
               Color="Color.Surface" Variant="Variant.Filled">
        Advanced Search
    </MudButton> 
    <MudCard Class="mb-2" Elevation="5">
        <MudCardContent Class="@_displaySearchFrom">
            <ProjectFilterForm @bind-Model="_advancedSearch" OnSubmitClicked="AdvancedSearch" />
        </MudCardContent>
    </MudCard>
    <MudTable Class="default-table"
              Elevation="25"
              Items="_pagedData"
              TotalItems="_totalItems"
              ServerData="@(new Func<TableState,CancellationToken, Task<TableData<GetAllProjectResponse>>>(ServerReload))"
              Hover="true" Dense="@_dense" Bordered="@_bordered" Striped="@_striped" @ref="_table">
        <ToolBarContent>
            <div class="justify-center mud-text-align-center">
                <MudHidden Breakpoint="Breakpoint.MdAndDown">
                    <MudButtonGroup OverrideStyles="false">
                        <MudButton Variant="Variant.Filled"
                                   OnClick="@(() => OnSearch(""))"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   Color="Color.Secondary">
                            @Localize["Reload"]
                        </MudButton>
                        <MudButton OnClick="AddProject"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   Color="Color.Info"
                                   Variant="Variant.Filled">
                            @Localize["Add Project"]
                        </MudButton>
                    </MudButtonGroup>
                </MudHidden>
                <MudHidden Breakpoint="Breakpoint.LgAndUp">
                    <MudButtonGroup OverrideStyles="false">
                        <MudIconButton DisableElevation
                                       Variant="Variant.Filled"
                                       OnClick="@(() => OnSearch(""))"
                                       Icon="@Icons.Material.Filled.Refresh"
                                       Color="Color.Secondary">
                            @Localize["Reload"]
                        </MudIconButton>
                        <MudIconButton OnClick="AddProject"
                                       Icon="@Icons.Material.Filled.Add"
                                       Color="Color.Info"
                                       Variant="Variant.Filled"/>
                    </MudButtonGroup>
                </MudHidden>
            </div>
            <MudSpacer/>
            <MudTextField T="string" ValueChanged="@(OnSearch)"
                          Placeholder="@Localize["Search"]"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          Class="mt-0"/>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>
                <MudTableSortLabel T="GetAllProjectResponse"
                                   SortLabel="Title">
                    @Localize["Title"]
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel T="GetAllProjectResponse"
                                   SortLabel="CreatedOn">
                    @Localize["Create Date"]
                </MudTableSortLabel>
            </MudTh>
            <MudTh>@Localize["Link"]</MudTh>
            <MudTh>@Localize["Student Project"]</MudTh>
            <MudTh>@Localize["ItemType"]</MudTh>
            <MudTh Style="text-align:center">@Localize["Actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Title">
                <MudHighlighter Text="@context.Title"
                                HighlightedText="@_searchString"/>
            </MudTd>
            <MudTd DataLabel="Create Date">
                @context.CreatedOn.ToString("yyyy MMMM dd")
            </MudTd>

            <MudTd DataLabel="Link">
                <MudLink Href="@($"/project/{context.URL}")">
                    @context.URL
                </MudLink>
            </MudTd>
            <MudTd DataLabel="Student project">
                @if (context.StudentProject)
                {
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                             Size="Size.Small"/>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.RemoveCircle"
                             Size="Size.Small"/>
                }
            </MudTd>
            <MudTd DataLabel="ItemType">
                <MudChip T="string" Color="Color.Info"
                         Text="@context.ProjectType.ToString()"/>
            </MudTd>

            <MudTd DataLabel="Actions" Style="text-align: center">
                <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                               Size="Size.Small"
                               Color="Color.Warning"
                               OnClick="() => EditProject(context.Id)"/>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <TablePager/>
        </PagerContent>
    </MudTable>
}
</MudContainer>