@using Hisubmit.Client.SharedModels.Features.Projects.Commands.UploadProjectFile

@inject IStringLocalizer<LocalFile> Localize 

<MudGrid>
    <MudItem sm="12" Class="mb-3">
        <EditForm EditContext="_editContext" >
            <MudGrid>
                <FluentValidationValidator @ref="_localFileValidator"></FluentValidationValidator>
                <MudItem sm="12" md="6" Class="mb-3">
                    <MudTextField @bind-Value="Model.Name"
                                  For="@(() => Model.Name)" Label="@Localize["Name"]"
                                  Variant="Variant.Filled" Margin="Margin.Dense"/>
                </MudItem>
                <MudItem sm="12" md="6" Class="mb-3">
                    
                    <MudSelect T="ProjectFilePosition"
                               @bind-Value="Model.Position" Label="Position"
                               Variant="Variant.Filled" AnchorOrigin="Origin.BottomCenter">
                        @foreach (var value in Enum.GetValues<ProjectFilePosition>())
                        {
                            <MudSelectItem Value="value"/>
                        }
                    </MudSelect>
                   @*  <MudSwitch T="bool" Color="Color.Secondary"
                               @bind-Value="Model.IsMainFile"
                               For="@(() => Model.IsMainFile)"
                               Label="@Localize["Is Main File"]"/> *@
                </MudItem>
                <MudItem sm="12" md="6" Class="mb-2">
                    <MudSelect T="FileFormat"
                               Value="Model.FileFormat" Label="Format"
                               ValueChanged="(val)=>ChangeAcceptFile(val)"
                               Variant="Variant.Filled" AnchorOrigin="Origin.BottomCenter">
                        @foreach (FileFormat value in Enum.GetValues(typeof(FileFormat)))
                        {
                            <MudSelectItem Value="value"/>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6" Class="mb-3">
                    <MudTextField @bind-Value="Model.FileDescription"
                                  For="@(() => Model.FileDescription)" 
                                  Label="@Localize["Description"]"
                                  Lines="3" Variant="Variant.Filled"
                                  Margin="Margin.Dense"/>
                </MudItem>
            </MudGrid>
        </EditForm>
    </MudItem>
    <MudItem sm="12" Class="mb-3">
        <InputFile id="fileInput" accept="@_acceptFile"
                    OnChange="AddToBrowserFile" hidden multiple/>
        <MudButton HtmlTag="label"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.CloudUpload"
                   for="fileInput"
                   Disabled="@(string.IsNullOrWhiteSpace(Model.Name))">
            @Localize["Choose File"]
        </MudButton>
        <MudText Inline="true" Typo="Typo.caption">@_selectedFileName</MudText>
    </MudItem>
    @if (_uploading)
    {
        <MudProgressLinear Color="Color.Primary" Value="@_percent" Class="my-7"/>
    }
    @* <div>@_echo</div> *@
    <MudItem sm="12" Class="mb-3">
        <MudButton OnClick="Cancel" Variant="Variant.Filled" Class="ma-2">Cancel</MudButton>
        <LoadingButton Processing="_processing"
                       ProcessingTitle="@_processingTitle" Variant="Variant.Filled"
                       ButtonType="ButtonType.Button" OnClick="SaveAsync"
                       StartIcon="@Icons.Material.Filled.Save" Color="Color.Primary">
            @Localize["Upload"]
        </LoadingButton>
    </MudItem>
</MudGrid>

