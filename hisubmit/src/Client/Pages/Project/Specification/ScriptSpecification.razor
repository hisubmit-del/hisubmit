@inject IStringLocalizer<ScriptSpecification> Localize

<MudCardContent>
    <MudContainer MaxWidth="MaxWidth.Medium" Class="px-0">
        <MudGrid>
            @if (!_loaded)
            {
                <Spinner></Spinner>
            }
            else
            {
                <MudItem xs="12" sm="12" md="12">
                    <EditForm OnValidSubmit="SaveAsync" EditContext="@_editContext">
                        <FluentValidationValidator @ref="_fluentValidationValidator"/>
                        <MudGrid>
                            <MudItem xs="12">
                                <MudGrid>
                                    @foreach (var type in _subProjectTypesItem)
                                    {
                                        <MudItem xs="6" md="4" lg="3">
                                            <MudCheckBox T="bool" Size="Size.Small" @bind-Value="@type.IsSelected"
                                                         Color="Color.Default">
                                                @type.Name
                                            </MudCheckBox>
                                        </MudItem>
                                    }
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12" md="12">
                                <MudGrid >
                                    <MudItem xs="12" md="2">
                                        <MudText Typo="Typo.subtitle1">
                                            @Localize["Genre"]:
                                        </MudText>
                                    </MudItem>
                                    <MudItem xs="12" md="10">
                                        <ChipsetTextField @bind-Value="@Model.Genre" Label="Genres"
                                                          HelperText="Separate genres with the - character"/>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField @bind-Value="Model.NumberOfPage"
                                              InputType="InputType.Number" For="@(() => Model.NumberOfPage)"
                                              Label="@Localize["Number of page"]"
                                              Variant="Variant.Filled" Margin="Margin.Dense"/>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudAutocomplete T="int" Label="@Localize["Origin Country"]"
                                                 For="@(() => Model.OriginCountryId)"
                                                 @bind-Value="Model.OriginCountryId" ResetValueOnEmptyText="true"
                                                 SearchFunc="@SearchCountries" Variant="Variant.Filled"
                                                 Margin="Margin.Dense"
                                                 ToStringFunc="@(i => Countries.FirstOrDefault(b => b.Id == i)?.Name ?? string.Empty)"
                                                 OffsetY="true"/>
                            </MudItem>
                            <MudItem xs="12" md="12">
                                <MudGrid >
                                    <MudItem xs="12" md="2">
                                        <MudText Typo="Typo.subtitle1">
                                            @Localize["Languages"]:
                                        </MudText>
                                    </MudItem>
                                    <MudItem xs="12" md="10">
                                        <ChipsetTextField @bind-Value="@Model.Language"
                                                          Label="Languages" HelperText="Separate Language with the - character"/>
                                    </MudItem>
                                </MudGrid>

                            </MudItem>
                            @* <MudItem xs="12" md="6"> *@
                            @*     <MudCheckBox T="bool" Size="Size.Small" For="@(()=>_model.StudentProject)" @bind-Value="@_model.StudentProject" Color="Color.Default">@localizer["Student project"]</MudCheckBox> *@
                            @* </MudItem> *@
                            <MudItem xs="12" md="6">
                                <MudCheckBox T="bool" Size="Size.Small"
                                             For="@(() => Model.FirstTimeScreenWrite)"
                                             @bind-Value="@Model.FirstTimeScreenWrite"
                                             Color="Color.Default">
                                    @Localize["First Time Screen Write"]
                                </MudCheckBox>
                            </MudItem>
                        </MudGrid>
                    </EditForm>
                </MudItem>
            }
        </MudGrid>
    </MudContainer>
</MudCardContent>
<MudPaper Class="d-flex justify-end flex-grow-1 " Elevation="0">
    <MudPaper Class="mr-2 mb-2" Elevation="0">
        <MudButtonGroup Variant="Variant.Filled" Color="Color.Info" OverrideStyles="false"> 
            <LoadingButton Processing="_processing" Variant="Variant.Filled"
                           ButtonType="ButtonType.Submit" OnClick="SaveAsync"
                           StartIcon="@Icons.Material.Filled.Save" Color="Color.Info">
                @Localize["Save"]
            </LoadingButton>
            <MudButton Variant="Variant.Filled" OnClick="GoNext" Color="Color.Secondary"
                       EndIcon="@Icons.Material.Filled.ArrowRight">
            @Localize["Next"]
            </MudButton>
        </MudButtonGroup>
    </MudPaper>
</MudPaper>