@page "/Admin/Chat"
@page "/Admin/Chat/{RoomId:int}"
@using HiSubmit.Client.Shared.Components.Chats
@attribute [Authorize(Policy = Permissions.AdminChat.View)]
@inject IStringLocalizer<NewChat> Localize
@inherits BaseAdminPages

<MudContainer MaxWidth="MaxWidth.Large">
    <div class="d-flex flex-grow-1 flex-row">
        <ChatBox @bind-OpenContact="_openContact" @ref="_chatBox" ChatMessage="_chatMessageCommand" RoomId="@RoomId" ImageUrl="@SelectedRoomImageUrl"
               SendMessagePolicy="@Permissions.AdminChat.SendMessage"  Messages="Messages" CFullName="@SelectedRoomTitle" OnSendMessage="AddMessage"/>
    
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <MudPaper Elevation="25" Class="pa-3 ml-6" MinWidth="350px">
                <MudTextField Immediate="true"  @bind-Value="SearchString" Label="Search" Variant="Variant.Text" 
                Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"/>
                <MudToolBar Dense="true">
                    <MudText Typo="Typo.h6" Inline="true" Class="mr-2">#</MudText>
                    <MudText Typo="Typo.h6">@Localize["Chat"]</MudText>
                </MudToolBar>
                <div class="d-flex flex-column px-4" style="max-height:70vh;min-height:70vh; overflow:scroll;">
                    <MudList T="string"  Clickable="true">
                        @foreach (var user in _roomContact)
                        {
                            <ChatContactBox Contact="user" OnClickContact="LoadUserChat"/>
                        }
                        <CustomDivider/>Contacts
                        @foreach (var user in _contactContact)
                        {
                            <ChatContactBox Contact="user" OnClickContact="LoadUserChat"/>
                        }
                    </MudList>
                </div>
            </MudPaper>
        </MudHidden>
    </div>
    <MudDrawer Elevation="1" Anchor="Anchor.Right" @bind-Open="_openContact" Variant="@DrawerVariant.Temporary">
        <div class="pa-3">
            <MudTextField @bind-Value="SearchString" Immediate="true" Label="Search" Variant="Variant.Text"
            Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"/>
            <MudList T="string" Clickable="true">
                @foreach (var user in _roomContact)
                {
                    <ChatContactBox Contact="user" OnClickContact="LoadUserChat"/>
                }
                <CustomDivider/>Contacts
                @foreach (var user in _contactContact)
                {
                    <ChatContactBox Contact="user" OnClickContact="LoadUserChat"/>
                }
            </MudList>
        </div>
    </MudDrawer>
</MudContainer>