@using HiSubmit.Client.Infrastructure.Managers.Festivals
@using global::Hisubmit.Client.SharedModels.Features.Festivals.Queries.GetFestivalNames
@using HiSubmit.Client.SharedModels.Constants.Role
@inject IStringLocalizer<OtherFestivalNavMenu> _localizer

@if (HasRoleInOtherFestival)
{
   @* <MudListSubheader Class="mt-2 mb-n2">@_localizer["Other FestivalIds"]</MudListSubheader> *@
    @foreach (var item in Items.Where(p=>p.Id==SelectedFestivalId))
    {
       
            <OtherFestvalNavItem FestivalId="@item.Id"  Claims="@item.Claims"></OtherFestvalNavItem>
      
    }
}

@code {

    [Parameter]
    public int SelectedFestivalId { get; set; }
    [Inject]
    private IFestivalManager FestivalManager { get; set; }

    private bool HasRoleInOtherFestival { get; set; }

    private List<OtherFestivalItem> Items { get; set; } = new();

    
    private Dictionary<int, string> FestivalNames { get; set; }
    protected override async Task OnInitializedAsync()
    {
        var currentUser = await AuthenticationManager.CurrentUser();

        var festivalRoles = currentUser.Claims.Where(p => p.Type == ApplicationClaimTypes.FestivalRole).ToList();
        var festivalPermissions = currentUser.Claims.Where(p => p.Type == ApplicationClaimTypes.FestivalPermission).ToList();

        HasRoleInOtherFestival = festivalRoles.Any();
        if (!HasRoleInOtherFestival) return;
        
        var festivalIds = festivalRoles.Select(p => int.Parse(p.Value.Split('-').First())).ToList();

        await GetFestivalNames(festivalIds);
        
        var festivalPermissionsClass = (from permission in festivalPermissions
                                        let festivalId = int.Parse(permission.Value.Split("-")[0])
                                        let permissionName = permission.Value.Split("-")[1]
                                        select new FestivalPermission()
                                            {
                                                Name = permissionName,
                                                FestivalId = festivalId
                                            }).ToList();


        foreach (var festivalRole in festivalRoles)
        {
            if (festivalRole.Value == RoleConstants.Referee) continue;
            var festivalId = int.Parse(festivalRole.Value.Split("-")[0]);
            var festivalName = FestivalNames[festivalId];
            var roleName = festivalRole.Value.Split("-")[1];

            var claims = festivalPermissionsClass
                .Where(p => p.FestivalId == festivalId)
                .Select(p => p.Name)
                .ToList();

            var item = new OtherFestivalItem()
            {
                Id = festivalId,
                Title = $"{festivalName}({roleName})",
                Claims = claims
            };
            Items.Add(item);
        }
        await base.OnInitializedAsync();
    }

    private async Task GetFestivalNames(List<int> festivalIds)
    {
        var response = await FestivalManager.GetFestivalNames(new GetFestivalNamesQuery()
            {
                FestivalIdString =string.Join(',',festivalIds)
            });

        if (response.Succeeded)
        {
            FestivalNames = response.Data.ToDictionary(p=>p.Id,p=>p.Name);
        }
        else
        {
            foreach (var message in response.Messages)
            {
                _snackBar.Add(message, Severity.Error);
            }
        }
    }

    private class OtherFestivalItem
    {
        public int Id { get; set; }
        public string Title { get; set; }
        public List<string> Claims { get; set; }

        public OtherFestivalItem()
        {
            Claims = new List<string>();
        }
    }
    private class FestivalPermission
    {
        public int FestivalId { get; set; }
        public string Name { get; set; }
    }
}
