@inject IStringLocalizer<ProjectDistribuationInformation> Localize

@using HiSubmit.Client.SharedModels.Extensions
@if (!_Loaded)
{
    <Spinner></Spinner>
}
else
{
    @if (_command.Information.Any())
    {
        <MudPaper Elevation="4" Class="pa-lg-4 pa-2">
            <EditForm EditContext="_editContext">
                <FluentValidationValidator @ref="_fluentValidationValidator"/>
                @foreach (var info in _command.Information)
                {
                    <MudPaper Class="mb-3 pa-lg-3" Outlined="true">
                         <MudGrid>
                                                <MudItem xs="12" md="6" Class="mb-3">
                                                    <MudTextField @bind-Value="@info.Title"
                                                                  Label="@Localize["Title"]" For="@(() => info.Title)"
                                                                  Variant="Variant.Filled" Margin="Margin.Dense"/>
                                                </MudItem>
                        
                                                <MudItem xs="12" md="6" Class="mb-3">
                                                    <MudSelect @bind-Value="info.DistributionType"
                                                               For="@(() => info.DistributionType)"
                                                               Margin="Margin.Dense" T="DistributionType?"
                                                               Label="@Localize["DistributionType"]"
                                                               Variant="Variant.Filled" AnchorOrigin="Origin.BottomCenter">
                        
                                                        @foreach (DistributionType type in Enum.GetValues(typeof(DistributionType)))
                                                        {
                                                            <MudSelectItem Value="type as DistributionType?">@type.ToDisplay()</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                </MudItem>
                                            </MudGrid>
                                            @foreach (var item in info.Items)
                                            {
                                                <MudItem Class="ma-lg-4">
                                                    <ProjectDistribuationInformationItem
                                                        OnDelete="() => DeleteItem(info, item)"
                                                        Item="@item">
                                                    </ProjectDistribuationInformationItem>
                                                </MudItem>
                                            }
                                            <MudButton EndIcon="@Icons.Material.Filled.Add" Color="Color.Info"
                                                       OnClick="() => AddItem(info)">
                                                @Localize["Add Country"]
                                            </MudButton>
                                        
                        
                                            <CustomDivider/>
                                            <MudButton OnClick="() => DeleteAward(info)"
                                                       EndIcon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error">
                                                @Localize["Delete Distribution"]
                                            </MudButton>
                    </MudPaper>
                }
            </EditForm>
        </MudPaper>
    }
    <MudButton EndIcon="@Icons.Material.Filled.Add" Class="mb-3 mt-5"
               OnClick="AddAward" Variant="Variant.Filled"
               Color="Color.Default">
       @Localize["Add Distribution"]
    </MudButton>
}