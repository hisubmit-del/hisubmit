@using global::Hisubmit.Client.SharedModels.Features.Projects.Queries.GetAllProjectCredits
@using HiSubmit.Client.Infrastructure.Managers.Projects
<div class="row">
    @foreach (var credit in Credits)
    {
        <div class="col col-md-6">
            <DividerAndTitle BackGround="#f7fafa" Title="@credit.Title"></DividerAndTitle>
            @foreach (var person in credit.ProjectItemPeople)
                {
                    <MudStack Row="true" Justify="Justify.SpaceBetween" >
                        <MudText Inline="true" Typo="Typo.body1">@person.Name</MudText>
                        <MudText Inline="true" Typo="Typo.body1">@person.Email</MudText>
                    </MudStack>
                }
            </div>
    }
</div>

@code{

    [Parameter]
    public List<GetAllProjectCreditResponse> Credits { get; set; } = new();

}