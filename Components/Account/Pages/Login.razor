@page "/Account/Login"
@attribute [AllowAnonymous]
@inject IStringLocalizer<Login> Localize
@using System.ComponentModel.DataAnnotations
@using HiSubmit.Application.Interfaces.Services.Storage
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Session


@inject SignInManager<BlazorHeroUser> SignInManager
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

@using MudBlazor.StaticInput


<PageTitle>Log in</PageTitle>


<MudGrid Class="mt-lg-8" Justify="Justify.Center">

    <MudItem xs="12" md="6" lg="5" Class="pl-0">

        <MudPaper Class="pa-5">
            @if (errorMessage is { Length: > 0 })
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">
                    <MudText>@errorMessage</MudText>
                </MudAlert>
            }
            <EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login">
                @* <FluentValidationValidator @ref="_fluentValidationValidator"/> *@
                <ValidationSummary class="text-danger" role="alert" />
                <MudGrid Class=" pa-lg-8 pa-2">
                    <DataAnnotationsValidator />
                    <MudItem xs="12">
                        <div class="d-flex justify-center">
                            <MudText Color="Color.Primary" Typo="Typo.h4">Sign In</MudText>
                        </div>
                    </MudItem>
                    <MudItem xs="12" Class="text-center">
                        <MudImage Style="width: 60%" Src="@ClientAppConstants.LogoUrl"></MudImage>
                    </MudItem>
                   
                    <MudItem xs="12">
                        <div class="d-flex justify-center">
                            <MudText>
                                @Localize["Don't have an account?"] <MudLink Href="/register">@Localize["Register here"]</MudLink>
                            </MudText>
                        </div>
                    </MudItem>
                    <MudItem xs="12">
                        @*   <MudTextField T="string" Label="@Localize["E-mail"]"
                                      Required="true" Variant="Variant.Outlined"
                                      @bind-Value="Input.Email" For="@(() => Input.Email)" />
                         *@
                        <MudStaticTextField For="@(() => Input.Email)" @bind-Value="Input.Email" 
                                            Label="Email" Placeholder="name@example.com" 
                                            Variant="Variant.Outlined"
                                            Margin="Margin.Dense"
                                            UserAttributes="@(new() { { "autocomplete", "username" }, { "aria-required", "true" } } )" />
                    </MudItem>

                    <MudItem xs="12">
                      @*   <MudTextField Label="@Localize["Password"]"
                                      @bind-Value="Input.Password" Variant="Variant.Outlined"
                                      For="@(() => Input.Password)"
                                      Required="true" /> *@
                                      
                      <MudStaticTextField For="@(() => Input.Password)" @bind-Value="Input.Password" 
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Label="Password" InputType="InputType.Password" Placeholder="password" 
                                            UserAttributes="@(new() { { "autocomplete", "current-password" }, { "aria-required", "true" } } )" />
                    </MudItem>
                    <MudItem xs="12" Class="d-flex justify-space-between align-center">
                        @* <MudCheckBox T="bool" Label="@Localize["Remember me?"]" Color="Color.Primary" Class="ml-n1"></MudCheckBox> *@
                        <MudStaticCheckBox For="@(() => Input.RememberMe)" 
                                           Class="ml-n1"
                                           @bind-Value="Input.RememberMe">Remember me</MudStaticCheckBox>
                    </MudItem>
                    <MudItem xs="12" Class="d-flex justify-center">
                        <MudStaticButton Variant="Variant.Filled" 
                                         Color="Color.Primary" FullWidth="true" 
                                         Style="width: 100%;"
                                         FormAction="FormAction.Submit">Login</MudStaticButton>

                        @* <LoadingButton ButtonType="ButtonType.Submit"
                                       Variant="Variant.Filled"
                                       Color="Color.Dark" Size="Size.Large"
                                       Style="width: 100%;">@Localize["Sign In"]</LoadingButton> *@
                    </MudItem>
                    <MudItem xs="12" Class="text-center">
                        <MudLink Typo="Typo.body1" Href="/account/forgot-password">@Localize["Forgot password?"]</MudLink>
                    </MudItem>

                </MudGrid>
            </EditForm>
        </MudPaper>
    </MudItem>
</MudGrid>

