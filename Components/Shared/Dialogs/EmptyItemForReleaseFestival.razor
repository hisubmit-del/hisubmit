@using HiSubmit.Client.SharedModels.Constants.Application
@using Microsoft.AspNetCore.SignalR.Client
@namespace Web.Components.Shared.Dialogs
@inject IStringLocalizer<Logout> localizer
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Class="mr-3 mb-n1"/>
          @Title
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudPaper Class="ma-2" >
             <MudList Clickable="false" T="string" Dense="true" DisableGutters="false">
                        @foreach (string message in Messages)
                        {
                            <MudListItem T="string" Text="@message" IconColor="Color.Error" Icon="@Icons.Material.Filled.Bookmark"/>
                        }
                    </MudList>
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@localizer["Ok"]</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public string Title { get; set; } = "festival Cant be release ";
    [Parameter]
    public List<string> Messages { get; set; }

    private void Cancel()
    {
        MudDialog.Close();
    }
}