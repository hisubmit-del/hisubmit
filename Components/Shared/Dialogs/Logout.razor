@using HiSubmit.Client.SharedModels.Constants.Application
@using Hisubmit.Client.SharedModels.Constants.Storage
@using Microsoft.AspNetCore.SignalR.Client
@using MudBlazor.StaticInput
@namespace Web.Components.Shared.Dialogs
@inject IStringLocalizer<Logout> Localizer
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Logout" Class="mr-3 mb-n1" />
            @Localizer["Logout Confirmation"]
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText>@ContentText</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["Cancel"]</MudButton>
        <form action="Account/Logout" method="post">
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
          
            <MudStaticButton Variant="Variant.Filled" 
                             Color="Color.Primary" 
                             Style="width: 100%;"
                             FormAction="FormAction.Submit">@ButtonText</MudStaticButton>
        </form>
     
    </DialogActions>
</MudDialog>
@code {
    [Inject]
    public SelectedAccountService SelectedAccountService { get; set; }
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    [Parameter] public HubConnection HubConnection { get; set; }

    [Parameter] public string ContentText { get; set; }

    [Parameter] public string ButtonText { get; set; }

    [Parameter] public Color Color { get; set; }

    [Parameter] public string CurrentUserId { get; set; }

    async Task Submit()
    {
       // await HubConnection.SendAsync(ApplicationConstants.SignalR.OnDisconnect, CurrentUserId);
        await AuthenticationManager.Logout();
        await  _localStorage.SetItemAsync(StorageConstants.Local.FestivalId, 0);
        await _localStorage.RemoveItemAsync(StorageConstants.Local.SelectedFestivalId);
        _MainLayoutService.ChangeDrawerStatus(false);
        SelectedAccountService.SelectedAccountChanged(null);
        _navigationManager.NavigateTo("/");
        MudDialog.Close(DialogResult.Ok(true));
    }
    void Cancel() => MudDialog.Cancel();

    private string? currentUrl;

    protected override async Task OnInitializedAsync()
    {
        currentUrl = _navigationManager.ToBaseRelativePath(_navigationManager.Uri);
        await base.OnInitializedAsync();
    }

}
