@inherits MudDateRangePicker

<MudDateRangePicker Label="@Label" 
                    DateRange="_dateRange"
                    PlaceholderStart="@PlaceholderStart" 
                    PlaceholderEnd="@PlaceholderEnd" 
                    DateRangeChanged="(dr) => ChangeStartAndEndDate(dr)"
                    Clearable="@Clearable"/>