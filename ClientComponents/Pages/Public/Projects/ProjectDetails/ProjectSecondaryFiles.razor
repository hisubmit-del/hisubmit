
@using global::Hisubmit.Client.SharedModels.Features.Projects.Queries.GetAllProjectFiles
@using Hisubmit.Client.SharedModels.Features.Projects.Commands.UploadProjectFile
@if (DetailLoaded && Files.Where(p=>p.Position==ProjectFilePosition.SideBarFile).ToList() is { Count:>0})
{
        <hr>
        <div class="side-box mt-3">
            <h6>Files & Attachments</h6>
            @foreach (var file in Files
                .Where(p => p.Position==ProjectFilePosition.SideBarFile
                             ))
            {
                <p class="mb-0">@file.Name</p>
                <a href="@file.LocalFileURL" class="link mt-0" target="_blank">
                    Download
                </a>
            }
        </div>
}

@code{

    [Parameter]
    public List<GetAllProjectFileResponse> Files { get; set; } = new();

    [Parameter]
    public bool DetailLoaded { get; set; }

}