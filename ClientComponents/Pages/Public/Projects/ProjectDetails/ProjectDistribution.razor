@if(_information is { Count: > 0 })
{
    <MudCard Elevation="1" class="mt-2 pl-1 pb-3 pt-2 border-radius-20">
        <div Class="mt-2 text-center">
            <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-2">Distributions</MudText>
        </div>
        @foreach (var info in _information)
        {
            <div class="col-md-12">
                <h6>@($"{info.Title}({info.DistributionType})")</h6>
                <MudTreeView T="string">
                    @foreach (var item in info.Items)
                    {
                        <MudTreeViewItem Value="@item.CountryName">
                            @foreach (var mediaRightId in item.MediaRightIds)
                            {
                                <MudTreeViewItem Value="@GetMediaRightName(mediaRightId)" />
                            }
                        </MudTreeViewItem>
                    }
                </MudTreeView>
            </div>
        }
    </MudCard>
}
