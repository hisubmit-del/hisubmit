@page "/tickets/{FestivalId:int}"
@layout PublicMainLayout
@attribute [AllowAnonymous]

<MudCard>
    <MudGrid>
        <MudItem xs="12" lg="3"></MudItem>
        <MudItem xs="12" lg="9">
            @* <MudGrid> *@
            @foreach (var ticket in tickets)
            {
                <MudItem xs="12">
                    <MudPaper Class="ticket">
                        <MudGrid Style="height: 100%">
                            <MudItem Style="height:100%" xs="12" md="4">
                                <MudPaper Elevation="0" Style="background: none;">
                                    <MudStack Justify="Justify.SpaceAround">
                                        <MudText Align="Align.Center" Typo="Typo.subtitle1">@ticket.Title</MudText>
                                        <MudText Align="Align.Center" Typo="Typo.subtitle2">
                                            Price:
                                            @ticket.Cost
                                        </MudText>
                                        <MudText Align="Align.Center" Typo="Typo.subtitle2">
                                            Venue:
                                            @ticket.VenueName
                                        </MudText>
                                    </MudStack>
                                </MudPaper>
                            </MudItem>
                            <MudDivider Style="width: 3px;color: #2a3940" Vertical="true" FlexItem="true"></MudDivider>
                            <MudText xs="12" md="8">
                                <MudPaper Elevation="0" Class="pa-3" Style="background: none">
                                    <MudText Align="Align.Center" Typo="Typo.body1">@ticket.Description</MudText>
                                </MudPaper>
                            </MudText>
                        </MudGrid>
                    </MudPaper>
                </MudItem>
            }
            @* </MudGrid> *@
        </MudItem>
    </MudGrid>
</MudCard>
