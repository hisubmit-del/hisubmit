@page "/admin/festival/detail/{FestivalId:int}"


@using ClientComponents.Pages.Festival.FestivalEditComponent
@inject IStringLocalizer<FestivalDetails> Localize
@inherits BaseAdminPages
@if (!_loaded)
{
    <Spinner></Spinner>
}
else
{
    <MudTabs @ref="MainTab" ActivePanelIndex="_activePanelIndex" ActivePanelIndexChanged="ChangeTabChecked"
        Elevation="25" Color="Color.Surface" Rounded="true" Centered="true" PanelClass="mt-6">
        <MudPaper Class="Relative">

            <MudTabPanel Style="text-transform:none" Text="@Localize["Event Details"]">
                <FestivalDetail @ref="_festivalDetails" IsAdmin="true" FestivalId="FestivalId" NextPanel="() => ChangeTab(1)"></FestivalDetail>
            </MudTabPanel>
            <MudTabPanel Style="text-transform:none" Text="@Localize["Contact And Venue"]">
                <ContactAndVenue @ref="_contactAndVenue" IsAdmin="true" FestivalId="FestivalId" NextPanel="() => ChangeTab(2)"></ContactAndVenue>
            </MudTabPanel>
            <MudTabPanel Style="text-transform:none" Text="@Localize["DeadLines"]">
                <FestivalDeadline IsAdmin="true"  @ref="_festivalDeadline" NextPanel="() => ChangeTab(3)" FestivalId="FestivalId"></FestivalDeadline>
            </MudTabPanel>
            <MudTabPanel Style="text-transform:none" Text="@Localize["Categories"]">
                <FestivalEventCategory IsAdmin="true" @ref="_festivalEventCategory" NextPanel="() => ChangeTab(4)" FestivalId="FestivalId"></FestivalEventCategory>
            </MudTabPanel>
            <MudTabPanel Style="text-transform:none" Text="@Localize["Files"]">
                <FestivalFile IsAdmin="true" @ref="_festivalFile" NextPanel="() => ChangeTab(5)" FestivalId="FestivalId"></FestivalFile>
            </MudTabPanel>
            <MudTabPanel Style="text-transform:none" Text="@Localize["Gallery & Cover"]">
                <FestivalImages IsAdmin="true" @ref="_festivalImages" NextPanel="() => ChangeTab(6)" FestivalId="FestivalId"></FestivalImages>
            </MudTabPanel>
            <MudTabPanel Style="text-transform:none" Text="@Localize["Additional Setting"]">
                <FestivalAdditionalSetting IsAdmin="true" @ref="_festivalAdditionalSetting" FestivalId="FestivalId"></FestivalAdditionalSetting>
            </MudTabPanel>
        </MudPaper>
    </MudTabs>
}
