@page "/admin/advertises"
@using HiSubmit.Client.SharedModels.Extensions
@using global::Hisubmit.Client.SharedModels.Features.Advertises.Queries
@inject IStringLocalizer<Advertises> Localize;
@inherits BaseAdminPages


<MudContainer MaxWidth="MaxWidth.Medium">
    <HeroTitle Title="@Localize["Advertises Filter"]" />
    
    <MudTable LoadingProgressColor="Color.Secondary" class="default-light-table"
              Elevation="25" Items="_pagedDate" TotalItems="_totalItems"
              ServerData="@(new Func<TableState, CancellationToken ,Task<TableData<GetAllAdvertiseResponse>>>(ServerReload))" 
              Hover="true" Dense="true" Bordered="false" Striped="true" @ref="_table">
        <ToolBarContent>
            <div class="justify-center mud-text-align-center">
                <MudHidden Breakpoint="Breakpoint.LgAndUp">
                    <div class="justify-center mud-text-align-center">
                        <MudIconButton DisableElevation Variant="Variant.Filled" OnClick="@(() => OnSearch(""))"
                                       Icon="@Icons.Material.Filled.Refresh" IconColor="Color.Surface" Color="Color.Secondary" />
                    </div>
                </MudHidden>
                <MudHidden Breakpoint="Breakpoint.MdAndDown">
                    <div class="justify-center mud-text-align-center">
                        <MudButton DisableElevation Variant="Variant.Filled" OnClick="@(() => OnSearch(""))"
                                   StartIcon="@Icons.Material.Filled.Refresh" IconColor="Color.Surface" Color="Color.Secondary">@Localize["Reload"]</MudButton>
                    </div>
                </MudHidden>
            </div>
            <MudSpacer />
            <MudTextField T="string" ValueChanged="@(OnSearch)" Placeholder="@Localize["Search"]" Adornment="Adornment.Start" 
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>@Localize["Email"]</MudTh>
            <MudTh>@Localize["User"]</MudTh>
            <MudTh>@Localize["ItemType"]</MudTh>
            <MudTh>@Localize["Date"]</MudTh>
            <MudTh Style="text-align:center">@Localize["Actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Email">
                <MudHighlighter Text="@context.Email" HighlightedText="@_searchString" />
            </MudTd>
            <MudTd DataLabel="User">
                <MudHighlighter Text="@context.UserName" HighlightedText="@_searchString" />
            </MudTd>
            <MudTd DataLabel="ItemType">
                <MudText Typo="Typo.caption">@context.AdvertiseType.ToString()</MudText>
            </MudTd>
            <MudTd DataLabel="Date">
                <MudText>@context.CreatedOn.ToLongDate()</MudText>
            </MudTd>
            <MudTd DataLabel="Actions">
                <MudButton StartIcon="@Icons.Material.Filled.Details" OnClick="() => Detail(context.Id)">Detail</MudButton>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <TablePager />
        </PagerContent>
    </MudTable>
</MudContainer>
