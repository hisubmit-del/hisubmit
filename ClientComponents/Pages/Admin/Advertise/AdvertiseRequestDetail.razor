@inject IStringLocalizer<AdvertiseRequestDetail> Localize;
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Assessment" Class="mr-3 mb-n1"/>
            @Localize["Advertise Filter Detail"]
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (!_loaded)
        {
            <MudGrid Class="pa-2">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="300px" />
            </MudGrid>
        }
        else
        {
        <MudGrid>
            <MudItem xs="12" lg="6">
                <DividerAndTitle Title="User Information" Class="ma-3"/>
                
                <MudStack Row="true" Class="mb-4" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.h5">@Localize["User Name"]:</MudText>
                    <MudText Typo="Typo.body1">@_detail.UserName</MudText>
                </MudStack>
                <MudStack Row="true" Class="mb-4" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.h5">@Localize["Email"]:</MudText>
                    <MudText Typo="Typo.body1">@_detail.Email</MudText>
                </MudStack>

            </MudItem>
            <MudItem xs="12" lg="6">
                 <DividerAndTitle Title="ItemType" Class="ma-5"/>
                
                                <MudStack Row="true" Class="mb-4" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.h5">@Localize["ItemType"]:</MudText>
                                    <MudText Typo="Typo.body1">@_detail.AdvertiseType</MudText>
                                </MudStack>
            </MudItem>
            <MudItem xs="12" lg="12">
                <DividerAndTitle Title="Message" Class="ma-3"/>
                <MudStack Row="true" Class="mb-4" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.body1" Class="pa-2">@_detail.Description</MudText>
                </MudStack>
                
                @if (_detail.Images.Any())
                {
                    <DividerAndTitle Title="Images or Files" Class="ma-3"/>
                    <MudStack Row="true" Class="mb-4" Justify="Justify.SpaceBetween">
                      @foreach (var item in _detail.Images)
                      {
                          <MudItem xs="12" lg="6">
                                 <MudImage Src="@item.Url"  Alt="@item.Title" Height="70" Width="70"></MudImage>
                          </MudItem>
                      }
                    </MudStack>
                }
            </MudItem>
        </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton DisableElevation Variant="Variant.Filled" OnClick="Close">@Localize["Ok"]</MudButton>
    </DialogActions>
</MudDialog>