@page "/festival/discount-codes"

@inject IStringLocalizer<DiscountCodesList> Localize;
@using Hisubmit.Hisubmit.Client.SharedModels.Features.Payments
@inherits ClientComponents.Shared.Components.Base.BaseFestival

<MudContainer MaxWidth="MaxWidth.Medium">
    <HeroTitle Title="@Localize["Discount Codes "]" Description="@Localize["Your Festival Discount Codes "]" />

    <MudTable Loading="!_loaded" LoadingProgressColor="Color.Secondary" class="default-light-table"
              Elevation="25" Items="_pagedDate" TotalItems="_totalItems"
              ServerData="@(new Func<TableState, CancellationToken, Task<TableData<GetAllDiscountCodeResponse>>>(ServerReload))"
              Hover="true" Dense="true" Bordered="false" Striped="true" @ref="_table">
        <ToolBarContent>
            <div class="justify-center mud-text-align-center">
                <MudHidden Breakpoint="Breakpoint.LgAndUp">
                    <MudIconButton Variant="Variant.Filled"
                                   OnClick="@(() => OnSearch(""))"
                                   Icon="@Icons.Material.Filled.Refresh"
                                   Color="Color.Secondary" />
                    <FestivalAuthorizeView Policy="@Permissions.DiscountCode.Edit">
                        <MudIconButton Variant="Variant.Filled" Color="Color.Primary"
                                       OnClick="()=>AddEdit()" Icon="@Icons.Material.Filled.Add" />
                    </FestivalAuthorizeView>
                </MudHidden>
                <MudHidden Breakpoint="Breakpoint.MdAndDown">
                    <MudButton Variant="Variant.Filled"
                               OnClick="@(() => OnSearch(""))"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               IconColor="Color.Surface" Color="Color.Secondary">@Localize["Reload"]</MudButton>

                    <FestivalAuthorizeView Policy="@Permissions.DiscountCode.Edit">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="()=>AddEdit()" StartIcon="@Icons.Material.Filled.Add">Add Code</MudButton>
                    </FestivalAuthorizeView>
                </MudHidden>
            </div>
            <MudSpacer />
            <MudTextField T="string" ValueChanged="@(OnSearch)"
                          Placeholder="@Localize["Search"]" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>@Localize["Code"]</MudTh>
            <MudTh>@Localize["Description"]</MudTh>
            <MudTh>@Localize["Enable"]</MudTh>
            <MudTh>@Localize["Amount"]</MudTh>
            <FestivalAuthorizeView Policy="@Permissions.FestivalNews.Edit">
                <MudTh Style="text-align:center">@Localize["Actions"]</MudTh>
            </FestivalAuthorizeView>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Banner">
                @context.Code
            </MudTd>
            <MudTd DataLabel="Description">
                <MudHighlighter Text="@context.Description" HighlightedText="@_searchString" />
            </MudTd>

            <MudTd DataLabel="Enable">
                <MudSwitch Value="@context.Enable" Color="Color.Primary"
                           T="bool"
                           ValueChanged="(status) => ChangeStatus(context, status)"
                           Size="Size.Small"></MudSwitch>
            </MudTd>
            <MudTd DataLabel="Amount">
                @if (context.DiscountValueType==DiscountValueType.Percentage)
                {
                    <span>@context.DiscountValue.ToString("0") %</span>
                }
                else
                {
                    @context.DiscountValue.ToString("0.00")
                }
                
            </MudTd>
            <FestivalAuthorizeView Policy="@Permissions.FestivalNews.Edit">
                <MudHidden Breakpoint="Breakpoint.LgAndUp">
                    <MudTd DataLabel="Actions">
                        <MudMenu Label="@Localize["Actions"]" Variant="Variant.Filled"
                                 EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Secondary">
                            <MudMenuItem OnClick="@(() => AddEdit(context))">@Localize["AddEdit"]</MudMenuItem>
                            <MudMenuItem OnClick="@(() => Delete(context.Id, context.Code))">@Localize["Delete"]</MudMenuItem>
                        </MudMenu>
                    </MudTd>
                </MudHidden>
                <MudHidden Breakpoint="Breakpoint.MdAndDown">
                    <MudTd DataLabel="Actions">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small" Title="AddEdit" OnClick="() => AddEdit(context)"
                                       Color="Color.Default"></MudIconButton>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small" Title="Delete" OnClick="() => Delete(context.Id, context.Code)"
                                       Color="Color.Default"></MudIconButton>
                    </MudTd>
                </MudHidden>
            </FestivalAuthorizeView>
        </RowTemplate>
        <PagerContent>
            <TablePager />
        </PagerContent>
    </MudTable>
</MudContainer>

