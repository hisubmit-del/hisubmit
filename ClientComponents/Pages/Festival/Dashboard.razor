@page "/festival/dashboard"
@inject IStringLocalizer<Dashboard> Localize
@using ClientComponents.Pages.Festival.DashboardComponent
@using ClientComponents.Pages.Festival.Payments.Components
@inherits BaseFestival
@if (!_loaded)
{
    <MudGrid>
        @for (int i = 0; i < 6; i++)
        {
            <MudItem xs="6" sm="4" md="4" lg="2">
                <MudPaper>
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="60px"/>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
    <MudGrid Class="mt-3">
        <MudItem xs="12" md="3">
            <MudPaper Class="pa-2">
                <MudSkeleton Height="360px" SkeletonType="SkeletonType.Rectangle"/>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-2">
                <MudSkeleton Height="360px" SkeletonType="SkeletonType.Rectangle"/>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudPaper Class="pa-2">
                <MudSkeleton Height="360px" SkeletonType="SkeletonType.Rectangle"/>
            </MudPaper>
        </MudItem>
    </MudGrid>
    <MudGrid Class="mt-3">
        @for (var i = 0; i < 6; i++)
        {
            <MudItem xs="12" md="4" lg="4">
                <MudPaper Class="pa-2">
                    <MudSkeleton Height="360px" SkeletonType="SkeletonType.Rectangle"/>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}
else
{
    <MudStack>
        <MudGrid Class="my-1 pa-2">
            <MudItem xs="6" sm="4" md="4" lg="2">
                <MudPaper Elevation="25"
                          Class="d-flex flex-row pt-3 pb-2  mud-theme-white text-tertiary">
                    <MudIcon Icon="@Icons.Material.Filled.AppRegistration"
                             Color="Color.Tertiary"
                             Class="mx-4"
                             Size="Size.Large"/>
                    <div>
                        <MudText Typo="Typo.subtitle1"
                                 Color="Color.Dark"
                                 Class=" mb-n1">
                            @Localize["Submits"]
                        </MudText>
                        <MudText Typo="Typo.h6">
                            @_submitCount
                        </MudText>
                    </div>
                </MudPaper>
                @* <MudPaper Elevation="25" *@
                @*           Class="d-flex flex-row pt-3 pb-2 mud-theme-primary text-white"> *@
                @*     <MudIcon Icon="@Icons.Material.Filled.AppRegistration" *@
                @*              Color="Color.Surface" *@
                @*              Class="mx-4" *@
                @*              Size="Size.Large"/> *@
                @*     <div> *@
                @*         <MudText Typo="Typo.subtitle1" *@
                @*                  Class=" mb-n1"> *@
                @*             @Localize["Submits"] *@
                @*         </MudText> *@
                @*         <MudText Typo="Typo.h6"> *@
                @*             @_submitCount *@
                @*         </MudText> *@
                @*     </div> *@
                @* </MudPaper> *@
            </MudItem>
            <MudItem xs="6" sm="4" md="4" lg="2">
                <MudPaper Elevation="25"
                          Class="d-flex flex-row pt-3 pb-2  mud-theme-white text-tertiary">
                    @* Class="d-flex flex-row pt-3 pb-2 mud-theme-secondary text-white"> *@
                    <MudIcon Icon="@Icons.Material.Filled.Category"
                             Color="Color.Tertiary"
                             Class="mx-4"
                             Size="Size.Large"/>
                    <div>
                        <MudText Typo="Typo.subtitle1"
                                 Color="Color.Dark"
                                 Class=" mb-n1">
                            @Localize["Categories"]
                        </MudText>
                        <MudText Typo="Typo.h6">
                            @_categoryCount
                        </MudText>
                    </div>
                </MudPaper>
            </MudItem>

            <MudItem xs="6" sm="4" md="4" lg="2">
                <MudPaper Elevation="25"
                          Class="d-flex flex-row pt-3 pb-2  mud-theme-white text-tertiary">
                    @* Class="d-flex flex-row pt-3 pb-2 mud-theme-white text-dark"> *@
                    <MudIcon Icon="@Icons.Material.Filled.AirplaneTicket"
                             Color="Color.Tertiary"
                             Class="mx-4"
                             Size="Size.Large"/>
                    <div>
                        <MudText Typo="Typo.subtitle1"
                                 Color="Color.Dark"
                                 Class=" mb-n1">
                            @Localize["Tickets"]
                        </MudText>
                        <MudText Typo="Typo.h6">
                            @_ticketsSoldCount
                        </MudText>
                    </div>
                </MudPaper>
            </MudItem>

            <MudItem xs="6" sm="4" md="4" lg="2">
                <MudPaper Elevation="25"
                          Class="d-flex flex-row pt-3 pb-2  mud-theme-white text-tertiary">
                    @* Class="d-flex flex-row pt-3 pb-2 mud-theme-dark text-white"> *@
                    <MudIcon Icon="@Icons.Material.Filled.Newspaper"
                             Color="Color.Tertiary"
                             Class="mx-4"
                             Size="Size.Large"/>
                    <div>
                        <MudText Typo="Typo.subtitle1"
                                 Color="Color.Dark"
                                 Class=" mb-n1">
                            @Localize["News"]
                        </MudText>
                        <MudText Typo="Typo.h6">
                            @_newsCount
                        </MudText>
                    </div>
                </MudPaper>
            </MudItem>

            <MudItem xs="6" sm="4" md="4" lg="2">
                <MudPaper Elevation="25"
                          Class="d-flex flex-row pt-3 pb-2  mud-theme-white text-tertiary">
                    @* Class="d-flex flex-row pt-3 pb-2 mud-theme-success text-dark"> *@
                    <MudIcon Icon="@Icons.Material.Filled.Reviews"
                             Color="Color.Tertiary"
                             Class="mx-4"
                             Size="Size.Large"/>
                    <div>
                        <MudText Typo="Typo.subtitle1"
                                 Color="Color.Dark"
                                 Class=" mb-n1">
                            @Localize["Reviews"]
                        </MudText>
                        <MudText Typo="Typo.h6">
                            @_reviewCount
                        </MudText>
                    </div>
                </MudPaper>
            </MudItem>

            <MudItem xs="6" sm="4" md="4" lg="2">
                <MudPaper Elevation="25"
                          Class="d-flex flex-row pt-3 pb-2  mud-theme-white text-tertiary">
                    @* Class="d-flex flex-row pt-3 pb-2 mud-theme-info text-white"> *@
                    <MudIcon Icon="@Icons.Material.Filled.VerifiedUser"
                             Color="Color.Tertiary"
                             Class="mx-4"
                             Size="Size.Large"/>
                    <div>
                        <MudText Typo="Typo.subtitle1"
                                 Color="Color.Dark"
                                 Class=" mb-n1">
                            @Localize["Users"]
                        </MudText>
                        <MudText Typo="Typo.h6">
                            @_userCount
                        </MudText>
                    </div>
                </MudPaper>
            </MudItem>

        </MudGrid>
        @* <MudGrid Style="height:390px"> *@
        <MudGrid Class="mt-3">
            <MudItem xs="12" md="3" Style="height:100%">
                <FestivalDetailBox Festival="_festival"
                                   Loaded="_festivalLoaded"/>
            </MudItem>
            <MudItem xs="12" md="6" lg="6" Style="height: 382px">
                <LastSubmitTable FestivalId="SelectedFestivalId"
                                 Submits="_submits"/>
            </MudItem>
            <MudItem xs="12" md="3" Style="height: 382px">
                <FestivalTimeLine Festival="_festival"
                                  FestivalId="SelectedFestivalId"/>
            </MudItem>
        </MudGrid>
        <MudGrid Class="mt-3">
            @if (_submits.Any())
            {
                if (_submits.GroupBy(p => p.SubmitDate).Count() > 4)
                {
                    <MudItem xs="12" md="4" lg="4">
                        <DailySubmitChart Loaded="_submitLoaded"
                                          Submits="_submits"/>
                    </MudItem>
                }

                <MudItem xs="12" md="6" lg="4">
                    <CategorySubmitChart FestivalId="SelectedFestivalId"/>
                </MudItem>
                @* <MudItem xs="12" md="6" lg="4"> *@
                @*     <CategoryDeadLineSubmitChart Loaded="_submitLoaded"  *@
                @*                                  Submits="_submits"/> *@
                @* </MudItem> *@
                <MudItem xs="12" md="6" lg="4">
                    <SubmitJudgingStatusChart Loaded="_submitLoaded"
                                              Submits="_submits"/>
                </MudItem>

            }
            <MudItem xs="12">
                <FestivalPaymentState FestivalId="SelectedFestivalId"/>
            </MudItem>
            
            <MudItem xs="12" md="6" lg="9">
                <PurchaseChart FestivalId="SelectedFestivalId"/>
            </MudItem>
        </MudGrid>
    </MudStack>
}