@inject IStringLocalizer<AddEditShowHall> _localizer
<MudContainer MaxWidth="MaxWidth.Medium">

    <EditForm Model="@ShowHall" OnValidSubmit="SaveAsync">
        <FluentValidationValidator @ref="_fluentValidationValidator" />
        <MudDialog>
            <TitleContent>
                @{
                    if (ShowHall.Id == 0)
                    {
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-3 mb-n1" />
                            @_localizer["Add Show Hall"]
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.Update" Class="mr-3 mb-n1" />
                            @_localizer["Update Show Hall"]
                        </MudText>
                    }
                }
            </TitleContent>
            <DialogContent>
                <MudContainer Style="max-height: 400px; overflow-y: scroll">
                    <MudGrid>
                        <MudItem xs="12" md="6" Class="mb-2">
                            <MudTextField Variant="Variant.Filled" For="@(() => ShowHall.Title)" @bind-Value="ShowHall.Title" Label="@_localizer["Title"]" />
                        </MudItem>
                        <MudItem xs="12" md="6" Class="mb-2">
                            <MudNumericField Variant="Variant.Filled" InputItemType="InputItemType.Number" For="@(() => ShowHall.Capacity)" @bind-Value="ShowHall.Capacity" Label="@_localizer["Capacity"]" />
                        </MudItem>
                    </MudGrid>

                    @foreach (var day in ShowingTimes)
                    {
                        <MudPaper Class="pa-4 ma-2" Outlined="true" Elevation="20" Square="true">
                            <MudGrid Class="pa-2">
                                <MudItem xs="12" md="6">
                                    <MudDatePicker PickerVariant="PickerVariant.Dialog" Label="Showing Day" @bind-Date="@day.DateTime" DisableToolbar="true" />
                                </MudItem>
                                <MudItem xs="12">
                                    @foreach (var time in day.ShowingTimes)
                                    {
                                        <MudPaper Class="pa-5 relative border-l-2 border-solid mud-border-primary mb-2">
                                            <MudIconButton Color="Color.Error" Size="Size.Small" Style="position: absolute;bottom: 0;right: 0" Icon="@Icons.Material.Filled.Delete" OnClick="() => DeleteTime(day, time)"></MudIconButton>
                                            <MudGrid Class="mb-2 pb-2">
                                                <MudItem xs="12" md="6" Class="pa-2">
                                                    <MudTextField For="@(() => time.Name)" @bind-Value="@time.Name" Label="@_localizer["Name(project or film or ...)"]" />
                                                </MudItem>
                                                <MudItem xs="12" md="3" Class="pa-2">
                                                    <MudTimePicker Margin="Margin.Dense" PickerVariant="PickerVariant.Dialog" Label="@_localizer["Open Date"]" @bind-Time="time.OpenDate" />
                                                </MudItem>
                                                <MudItem xs="12" md="3" Class="pa-2">
                                                    <MudTimePicker Margin="Margin.Dense" PickerVariant="PickerVariant.Dialog" Label="@_localizer["Close Date"]" @bind-Time="time.CloseDate" />
                                                </MudItem>
                                            </MudGrid>
                                        </MudPaper>
                                    }
                                </MudItem>

                                <MudButton OnClick="() => AddShowing(day)" StartIcon="@Icons.Material.Filled.Add">Add Day</MudButton>
                                <MudButton StartIcon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => DeleteDay(day)">Delete Date</MudButton>
                            </MudGrid>
                        </MudPaper>
                    }

                    <MudButton OnClick="AddShowingDay" StartIcon="@Icons.Material.Filled.Add">Add Showing day</MudButton>
                </MudContainer>
            </DialogContent>
            <DialogActions>
                <MudButton Variant="Variant.Filled" OnClick="Cancel">@_localizer["Cancel"]</MudButton>
                @{
                    if (ShowHall.Id == 0)
                    {
                        <LoadingButton Processing="_processing" Variant="Variant.Filled" ButtonType="ButtonType.Submit" Disabled="@(!Validated)" Color="Color.Success">@_localizer["Save"]</LoadingButton>
                    }
                    else
                    {
                        <LoadingButton Processing="_processing" Variant="Variant.Filled" ButtonType="ButtonType.Submit" Disabled="@(!Validated)" Color="Color.Secondary">@_localizer["Update"]</LoadingButton>
                    }
                }
            </DialogActions>
        </MudDialog>
    </EditForm>
</MudContainer>