@{
    Layout = "_EmailLayout.cshtml";
}
<table border="0" cellpadding="0" cellspacing="0" class="paragraph_block block-5"
       role="presentation"
       style="mso-table-lspace: 0pt; mso-table-rspace: 0pt; word-break: break-word;"
       width="100%">
    <tr>
        <td class="pad" style="padding:20px;">
            <div
                style="color:#393d47;direction:ltr;font-family:Helvetica Neue, Helvetica, Arial, sans-serif;font-size:14px;font-weight:400;letter-spacing:0px;line-height:120%;text-align:justify;mso-line-height-alt:19.2px;">
                <h2
                    style="margin: 0; color: #2a3940; direction: ltr; font-family: Helvetica Neue, Helvetica, Arial, sans-serif; font-size: 24px; font-weight: 700; letter-spacing: normal; line-height: 120%; text-align: center; margin-top: 0; margin-bottom: 0;">
                    <strong>
                        <span class="tinyMce-placeholder">
                             Your ticket has been issued
                        </span>
                    </strong>
                </h2>
            </div>
        </td>
    </tr>
</table>

<table border="0" cellpadding="0" cellspacing="0" class="paragraph_block block-5"
       role="presentation"
       style="mso-table-lspace: 0pt; mso-table-rspace: 0pt; word-break: break-word;"
       width="100%">
    <tr>
        <td class="pad" style="padding:20px;">
            <div
                style="color:#393d47;direction:ltr;font-family:Helvetica Neue, Helvetica, Arial, sans-serif;font-size:14px;font-weight:400;letter-spacing:0px;line-height:120%;text-align:justify;mso-line-height-alt:19.2px;">
                <p style="margin: 0;">
                    You can get your ticket from the email attachments
                </p>
            </div>
        </td>
    </tr>
</table>
