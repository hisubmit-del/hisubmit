@using global::Hisubmit.Client.SharedModels.Features.Submits.Queries.GetAllSubmitsQueries

<MudCard Class="pa-3" >
    @if (!Loaded)
    {
        <CustomeProgress/>
    }
    else
    {
        <MudChart Style="overflow: scroll" 
                  ChartOptions="@(new ChartOptions() 
                                { LineStrokeWidth = 20, YAxisLines = true, MaxNumYAxisTicks = _maxTick, YAxisTicks = _tick })"
                  ChartType="ChartType.Bar"
                  ChartSeries="@_series" 
                  XAxisLabels="@_xLabels"
                  Width="100%" 
                  Height="240px"/>
    }
</MudCard>

@code{

    [Parameter]
    public List<GetAllSubmitsResponse> Submits { get; set; } = new();
    [Parameter]
    public  bool Loaded { get; set; }

    private List<DeadLineCategoryDto> DeadLineCategoriesDto { get; set; } = new();

    protected override Task OnInitializedAsync()
    {
        GenerateSeries();
        return base.OnInitializedAsync();
    }

    private int _tick = 1;
    private int _maxTick = 10;
    private string[] _xLabels = { };
    private List<ChartSeries> _series = new List<ChartSeries>();

    private void GenerateSeries()
    {
        foreach (var submit in Submits)
        {
            DeadLineCategoriesDto.AddRange(submit.DeadlineEventCategories);
        }
        var allCategoriesGrouped = DeadLineCategoriesDto.GroupBy(p => p.EventCategoryId).ToList();
        _xLabels = new string[allCategoriesGrouped.Count + 1];
        for (var i = 1; i <= allCategoriesGrouped.Count; i++)
        {
            var catName = DeadLineCategoriesDto
                .Where(p => p.EventCategoryId == allCategoriesGrouped[i - 1].Key)
                .Select(p => p.EventCategoryName).FirstOrDefault();

            _xLabels[i] = catName;
        }
        _xLabels[0] = string.Empty;
        
        var deadLineGroupedSubmits = DeadLineCategoriesDto.GroupBy(p => p.DeadLineId).ToList();
        
        foreach (var deadLineCategory in deadLineGroupedSubmits)
        {
            var categoryGroupedSubmits = deadLineCategory.GroupBy(p => p.EventCategoryId).ToList();

            var series = new ChartSeries()
            {
                Name = deadLineCategory.First().DeadLineName,
                Data = new double[allCategoriesGrouped.Count + 1]
            };

            series.Data[0] = 0;

            for (var i = 1; i <= categoryGroupedSubmits.Count; i++)
            {
                var catName = DeadLineCategoriesDto
                    .Where(p => p.EventCategoryId == allCategoriesGrouped[i - 1].Key
                                && p.DeadLineId == deadLineCategory.Key)
                    .Select(p => p.EventCategoryName).FirstOrDefault();

                series.Data[i] = categoryGroupedSubmits[i - 1].Count();
            }

            SetMaxTick((int)series.Data.Max());
            SetTick();
            _series.Add(series);
        }
    }

    private void SetMaxTick(int maxValue)
    {
        do
        {
            maxValue++;
        } while (maxValue % 5 == 0);
        if (maxValue > _maxTick)
            _maxTick = maxValue;
    }

    private void SetTick()
    {
        _tick = _maxTick / 10;
        if (_tick < 1)
            _tick = 1;
    }
}