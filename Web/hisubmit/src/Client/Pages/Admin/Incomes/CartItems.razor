@using HiSubmit.Client.SharedModels.Extensions
@using global::Hisubmit.Client.SharedModels.Features.Payments.Queries
@inject IStringLocalizer<CartItems> Localize;

<style>
    .mud-select-base{
        margin-top: 4px;
        border: 1px solid #c4c4c4;
        padding: 7px;
        border-radius: 3px;
    }
</style>

@if (_openSearchForm)
{
    <MudCard Elevation="1" Class="my-3 animate__animated animate__fadeInDown">
        <MudCardContent>
            <EditForm Model="Filter" OnValidSubmit="Search">
                <MudGrid>
                    <MudItem xs="12" md="6" lg="3" Class="mb-2">
                        <MudSelect Placeholder="Select the festival"
                                   Margin="Margin.Dense"
                                   Label="@Localize["festival"]" Dense="true" Variant="Variant.Outlined" T="int?"
                                   Value="Filter.MasterFestivalId" ValueChanged="(item)=>ChangedFestivalList(item)">
                            @* Value="_selectedFestivalIdId" ValueChanged="SelectedFestivalIdChanged" *@
                            <MudSelectItem Value="@(null as int?)">All festival</MudSelectItem>
                            @foreach (var festival in Festivals)
                            {
                                <MudSelectItem Value="@(festival.Id as int?)">@festival.Name</MudSelectItem>
                            }
                        </MudSelect>

                    </MudItem>
                    @if (MasterFestival != null)
                    {
                        <MudItem>
                            <InputSelect class="mud-select-base"  @bind-Value="Filter.FestivalId">
                                @{
                                    var currentId = FestivalNames
                                        .First(p => p.YearsRunning == MasterFestival.ActivePeriod).Id;
                                    
                                <option value="" selected="selected">All Years</option>
                                <option value="@(currentId)">Current</option>
                                }
                                @foreach (var f in
                                         FestivalNames.Where(p=>p.FestivalMasterId==Filter.MasterFestivalId))
                                {
                                    <option value="@(f.Id)">@f.YearsRunning</option>
                                }
                            </InputSelect>
                        </MudItem>
                    }
                    <MudItem xs="12" md="6" lg="3">
                        <MudSelect Class="w-25" T="CartItemType?" Variant="Variant.Outlined"
                                   Label="Item Type"
                                   Margin="Margin.Dense" Dense="true" @bind-Value="Filter.ItemType">
                            <MudSelectItem T="CartItemType?" value="@(null as CartItemType?)">All type</MudSelectItem>
                            @foreach (var item in Enum.GetValues<CartItemType>())
                            {
                                <MudSelectItem T="CartItemType?" value="@(item as CartItemType?)">
                                    @item.ToDisplay()
                                </MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="6" lg="4">
                        <NumericFilter T="decimal" Title="Income" Model="Filter.IncomeFilter"/>
                    </MudItem>
                    <MudItem xs="12" md="6" lg="6">
                        <DateFilterComponent Title="Paid Date" Model="Filter.CardDateFilter"/>
                    </MudItem>
                    <MudItem xs="12">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.Search"
                                   Color="Color.Info">
                            Search
                        </MudButton>
                        <MudButton ButtonType="ButtonType.Button"
                                   Variant="Variant.Filled"
                                   OnClick="ToggleSearch"
                                   Color="Color.Default">
                            Cancel
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </EditForm>
        </MudCardContent>
    </MudCard>
}

<MudTable Loading="!_loaded" LoadingProgressColor="Color.Secondary" class="default-light-table"
          Elevation="25" Items="_pagedDate" TotalItems="_totalItems"
          ServerData="@(new Func<TableState, CancellationToken, Task<TableData<GetCartItemResponse>>>(ServerReload))"
          Hover="true" Bordered="false" Dense="true" Striped="true" @ref="_table">
    <ToolBarContent>
        <ResponsiveButton Variant="Variant.Filled"
                          StartIcon="@Icons.Material.Filled.Search"
                   OnClick="ToggleSearch">
            Advanced Search
        </ResponsiveButton>
        <MudSpacer/>
        <MudTextField T="string" ValueChanged="@(OnSearch)" Placeholder="@Localize["Search"]"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium" Class="mt-0">
        </MudTextField>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>#</MudTh>
        <MudTh>@Localize["festival Name"]</MudTh>
        <MudTh>@Localize["Title"]</MudTh>
        <MudTh>@Localize["ItemType"]</MudTh>
        <MudTh>@Localize["Cost"]</MudTh>
        <MudTh>@Localize["Date of Payment"]</MudTh>
        @* <FestivalIdAuthorizeView Policy="@Permissions.FestivalIdNews.Edit"> *@
        @*     <MudTh Style="text-align:center">@Localize["Actions"]</MudTh> *@
        @* </FestivalIdAuthorizeView> *@
    </HeaderContent>
    <RowTemplate>
        <MudTd>
            @(_table.CurrentPage * _table.RowsPerPage + _pagedDate.IndexOf(context) + 1)
        </MudTd>
        <MudTd DataLabel="@nameof(context.FestivalName)">
            <MudHighlighter HighlightedText="@_searchString" Text="@context.FestivalName"/>
        </MudTd>
        <MudTd DataLabel="Title">
            <MudHighlighter HighlightedText="@_searchString" Text="@context.GetTitle()"/>
        </MudTd>
        <MudTd DataLabel="ItemType">
            <CartemTypeBadge CartItemType="context.CartItemType"/>
        </MudTd>
        <MudTd DataLabel="Price">
            <MudText Color="Color.Info">@context.Price.ToString("C2")</MudText>
        </MudTd>
        <MudTd DataLabel="Date of Payment">
            <MudText Typo="Typo.caption">@context.PaidDate.ToLongDateTime()</MudText>
        </MudTd>
        @* <FestivalIdAuthorizeView Policy="@Permissions.FestivalIdNews.Edit"> *@
        @*     <MudHidden Breakpoint="Breakpoint.LgAndUp"> *@
        @*         <MudTd DataLabel="Actions"> *@
        @*         <MudMenu Label="@Localize["Actions"]" Variant="Variant.Filled" DisableElevation="true" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Secondary" Direction="Direction.Left" OffsetX="true"> *@
        @*             <MudMenuItem OnTouch="() => Edit(context.Id)" OnClick="@(() => Edit(context.Id))">@Localize["Edit"]</MudMenuItem> *@
        @*             <MudMenuItem OnTouch="() => Delete(context.Id, context.Title)" OnClick="@(() => Delete(context.Id, context.Title))">@Localize["Delete"]</MudMenuItem> *@
        @*         </MudMenu> *@
        @*         </MudTd> *@
        @*     </MudHidden> *@
        @*     <MudHidden Breakpoint="Breakpoint.MdAndDown"> *@
        @*         <MudTd DataLabel="Actions"> *@
        @*             <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Title="Edit" OnClick="() => Edit(context.Id)" Color="Color.Default"></MudIconButton> *@
        @*             <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Title="Delete" OnClick="() => Delete(context.Id, context.Title)" Color="Color.Default"></MudIconButton> *@
        @*         </MudTd> *@
        @*     </MudHidden> *@
        @* </FestivalIdAuthorizeView> *@
    </RowTemplate>
    <PagerContent>
        <TablePager/>
    </PagerContent>
</MudTable>