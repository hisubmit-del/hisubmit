@using global::Hisubmit.Client.SharedModels.Features.Tickets.Queries.GetAllTicket

@using HiSubmit.Client.SharedModels.Extensions
@using global::Hisubmit.Client.SharedModels.Features.SoldTickets.Commands

@* <MudGrid> *@
    @foreach (var ticket in Tickets)
    {
        <MudItem xs="12"  Class="my-2">
            <MudCard Elevation="1" Class="ticket relative  rounded pa-2">
                <MudCardContent>
                    <MudGrid>
                        <MudItem xs="12" md="4">
                            <MudStack Justify="Justify.SpaceAround" Style="height: 100%">
                                <MudText Align="Align.Center" Color="Color.Primary" Typo="Typo.h5">@ticket.Title</MudText>
                                <MudText Align="Align.Center" Typo="Typo.subtitle2">
                                    Price:
                                    <MudText Inline="true" Typo="Typo.subtitle2" Color="Color.Info">
                                        @ticket.Cost
                                    </MudText>
                                </MudText>
                                <MudText Align="Align.Center" Typo="Typo.subtitle2">
                                    Venue:
                                    @ticket.VenueName
                                </MudText>
                                <MudText Align="Align.Center" Typo="Typo.subtitle2">
                                    Available:
                                    @ticket.AvailableCapacity
                                </MudText>
                            </MudStack>
                            @* </MudPaper> *@
                        </MudItem>

                        @* <MudDivider Vertical=true  DividerType="DividerType.Middle"/> *@

                        <MudItem xs="12" md="8" Class="border-l-2 border-dashed mud-border-primary">
                            @* <MudPaper Elevation="0" Class="pa-3" Style="background: none"> *@
                            <MudStack Justify="Justify.SpaceBetween" Style="height: 100%">
                                <MudText Align="Align.Left" Typo="Typo.body2">@ticket.Description</MudText>
                                <MudText xs="12" md="8">
                                    <div >
                                        <MudIcon ViewBox="0 -2 24 24" Icon="@Icons.Material.Filled.LocationOn"></MudIcon>
                                        <MudText Inline="true" Align="Align.Left" Typo="Typo.caption">@ticket.VenueAddress</MudText>
                                    </div>
                                </MudText>
                                @if (ticket.TicketType == TicketType.Badge)
                                {
                                    <MudText Typo="Typo.caption">
                                        @ticket.EventDate.ToLongDateTime()
                                    </MudText>
                                }
                            </MudStack>

                        </MudItem>
                    <MudButton 
                                   OnClick="()=>AddToCart(ticket.Id,ticket.AvailableCapacity,ticket.TicketType,ticket.VenueId)"                                   
                                   Style="position: absolute; bottom: 4px;right: 4px"                                   
                                   Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">Take a Ticket</MudButton>
                    </MudGrid>
                </MudCardContent>

            </MudCard>
        </MudItem>
    }
@* </MudGrid> *@


@code {

    [Parameter]
    public List<GetAllTicketResponse> Tickets { get; set; } = new();


    private async Task AddToCart(int ticketId, int availableCount, TicketType ticketType, int? venueId = null)
    {
        var user = await AuthenticationManager.CurrentUser();
        if (!user.Identity.IsAuthenticated)
        {
            var option = new DialogOptions
                {
                    CloseButton = true,
                    MaxWidth = MaxWidth.Small,
                    FullWidth = true,

                };
            var parameters = new DialogParameters();
            _dialogService.Show<NeedToLogin>("Need To Login", parameters, option);
            return;
        }
       
        if (ticketType == TicketType.Badge)
        {
            var dialogOption = new DialogOptions()
                {
                    CloseButton = true,
                    MaxWidth = MaxWidth.Small,
                    FullWidth = true
                };
            var parameters = new DialogParameters
            { { nameof(AddBadgeToCartModal.SoldBadge), new AddSoldBadgeCommand()
            {
                TicketId = ticketId
            } } };
            parameters.Add(nameof(AddBadgeToCartModal.MaxCount), availableCount);

            var result = _dialogService.Show<AddBadgeToCartModal>("Add To Cart", parameters, dialogOption);
        }
        else
        {
            var dialogOption = new DialogOptions()
                {
                    CloseButton = true,
                    MaxWidth = MaxWidth.Small,
                    FullWidth = true
                };
            var parameters = new DialogParameters
            { { nameof(AddTicketToCartModal.SoldTicket), new AddSoldTicketCommand()
            {
                TicketId = ticketId,
                VenueId = venueId.Value
            } },
                { nameof(AddBadgeToCartModal.MaxCount), availableCount }
            };

            var result = _dialogService.Show<AddTicketToCartModal>("Add To Cart", parameters, dialogOption);
        }
    }
}