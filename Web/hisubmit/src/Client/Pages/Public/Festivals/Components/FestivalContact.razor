@using global::Hisubmit.Client.SharedModels.Features.Festivals.Queries.GetDetailById

@using HiSubmit.Client.SharedModels.Extensions
@inject IStringLocalizer<FestivalContact> Localize


<MudCard Class="mt-2 pb-3 pt-2 border-radius-20 ">
    <div Class="mt-2 text-center">
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-2">Contacts</MudText>
    </div>
    <div class="side-box contact w-100">

        <ul class="contact-list mt-4">
            @if (!string.IsNullOrWhiteSpace(Festival.WhatsAppNumber))
            {
                <li>
                    <a href="https://wa.me/@Festival.WhatsAppNumber" target="_blank">
                        <MudIcon Icon="@Icons.Custom.Brands.WhatsApp"></MudIcon>
                        @Festival.WhatsAppNumber
                    </a>
                </li>
            }

            @if (!string.IsNullOrWhiteSpace(Festival.Telegram))
            {
            <li>
                <a href="https://telegram.me/@Festival.Telegram" target="_blank">
                    <MudIcon Icon="@Icons.Custom.Brands.Telegram"></MudIcon>
                    @Festival.Telegram
                </a>
            </li>
            }
            @if (!string.IsNullOrWhiteSpace(Festival.Twitter))
            {
                <li>
                    <a href="https://twitter.com/@Festival.Twitter" target="_blank">
                        <MudIcon Icon="@Icons.Custom.Brands.Twitter"></MudIcon>
                        @Festival.Twitter
                    </a>
                </li>
            }
            @if (!string.IsNullOrWhiteSpace(Festival.Youtube))
            {
                <li>
                    <a href="https://youtube.com/@Festival.Youtube" target="_blank">
                        <MudIcon Icon="@Icons.Custom.Brands.YouTube"></MudIcon>
                        @Festival.Youtube
                    </a>
                </li>
            }

            @if (!string.IsNullOrWhiteSpace(Festival.Instagram))
            {
                <li>
                    <a href="https://www.instagram.com/@Festival.Instagram" target="_blank">
                        <MudIcon Icon="@Icons.Custom.Brands.Instagram"></MudIcon>
                        @Festival.Instagram
                    </a>
                </li>
            }


            @if (!string.IsNullOrWhiteSpace(Festival.Facebook))
            {
                <li>
                    <a href="https://facebook.com/@Festival.Facebook" target="_blank">
                        <MudIcon Icon="@Icons.Custom.Brands.Facebook"></MudIcon>
                        @Festival.Facebook
                    </a>
                </li>
            }

            @if (!string.IsNullOrWhiteSpace(Festival.WebSite))
            {
                <li>
                    <a href="@Festival.WebSite.ToAbsolutUrl()" target="_blank">
                        <MudIcon Icon="@Icons.Material.Filled.WebAsset"></MudIcon>
                        @Festival.WebSite
                    </a>
                </li>
            }
            <AuthorizeView>
                @if (!string.IsNullOrWhiteSpace(Festival.Email))
                {
                    <li>
                        <a href="#" target="_blank">
                            <MudIcon Icon="@Icons.Material.Outlined.Email"></MudIcon>
                            @Festival.Email
                        </a>
                    </li>
                }

            </AuthorizeView>
        </ul>
    </div>
</MudCard>

@code{

    [Parameter] public GetFestivalDetailResponse Festival { get; set; }

    [Parameter] public bool UserLogined { get; set; }

    private async Task ViolationReport()
    {
        var parameters = new DialogParameters
        {
            { nameof(ReviewDialog.Type), CommentType.ViolationReport },
            { nameof(ReviewDialog.FestivalId), Festival.Id }
        };
        var options = new DialogOptions
        {
            FullWidth = true,
            CloseButton = true,
            MaxWidth = MaxWidth.Small,
            
        };
        var dialog = _dialogService
            .Show<ReviewDialog>(Localize["Review"], parameters, options);
        var result = await dialog.Result;
    }

}