@using Hisubmit.Client.SharedModels.Features.Projects.Queries.GetDetail
@using Hisubmit.Client.SharedModels.Features.ProjectJudgings.Queries.GetAll
@using Hisubmit.Client.SharedModels.Features.AdminFestival.Queries.GetAllFestival

<MudCard class="festival-card" Elevation="0">
    <MudCardContent>
        <div style="height: 220px" class="d-flex  flex-grow-1 gap-4 justify-center d-relative ">
            <img src="@ProjectReferee.ProjectFileUrl" alt="@ProjectReferee.ProjectName"
                 class="align-self-center" style="max-width: 100%;max-height: 100%"/>
            @* @if (item.SelectedQualifiersId != null && item.SelectedQualifiersId.Any()) *@
            @* { *@
            @*     var qualify = Qualifiers.FirstOrDefault(p => p.Id == item.SelectedQualifiersId.First()); *@
            @*     if (qualify != null) *@
            @*     { *@
            @*         <img src="@qualify.LogoName" alt="@qualify.Name" class="img-qualify"/> *@
            @*     } *@
            @* } *@
        </div>
        <div class="d-flex justify-space-between flex-grow-1 gap-1 mt-2 ">
            <MudText Inline="true" Class="h-2em" Typo="Typo.subtitle1"> @ProjectReferee.ProjectName</MudText>
            @if (!string.IsNullOrWhiteSpace(ProjectReferee.JudgingButtonName))
            {
                <MudChip T="string" Color="Color.Info"
                         Size="Size.Small"
                         Label="true">@ProjectReferee.JudgingButtonName</MudChip>
            }
            else
            {
                <MudChip T="string" Color="Color.Default"  Size="Size.Small" Label="true">Not Set</MudChip>
            }
        </div>
        <div class="d-flex justify-space-between flex-grow-1 gap-1 mt-2">

            <MudText Typo="Typo.subtitle2" Class="mt-3">
                @* <MudIcon Icon="@Icons.Material.Filled.DateRange" Class="mr-1 .mb-m-6"/> *@
                @ProjectReferee.FestivalName
            </MudText>
            <MudText Typo="Typo.subtitle2" Class="mt-3">
                <MudChip T="string" Color="Color.Secondary"
                         Size="Size.Small"
                         Icon="@Icons.Material.Filled.StarRate" Variant="Variant.Text">
                     @ProjectReferee.JudgingFiledAverage 
                </MudChip>
            </MudText>
        </div>
       
    </MudCardContent>
  
</MudCard>

@code {
    [Parameter] public GetAllProjectJudgingResponse ProjectReferee { get; set; }
}