@using System.Globalization
@inject IStringLocalizer<ProjectJudgingForm> Localize

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.VerifiedUser"
                     Class="mr-3 mb-n1"/>
            @Localize["Rating  Project"]
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_loaded)
        {
            <MudGrid Style="max-height:500px;overflow-y:scroll">
                <MudItem xs="12">
                    <MudGrid>
                        @foreach (var filed in _judgingForm.JudgingFileds)
                        {
                            <MudItem md="6">
                                <MudGrid>
                                    <MudItem xs="6">
                                        <MudText Typo="Typo.subtitle2">
                                            @filed.Name
                                        </MudText>
                                    </MudItem>
                                    <MudItem xs="6">
                                        <MudRating SelectedValueChanged="(rate) => ChangeRateField(filed.Id, rate)" SelectedValue="_filedRates[filed.Id]"/>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                        }
                    </MudGrid>
                </MudItem>
                <MudItem xs="12">
                    <CustomDivider></CustomDivider>
                </MudItem>
                <MudItem xs="12">
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudGrid Class="mb-4 pa-4">
                                <MudText Inline="true" Class="my-auto" Typo="Typo.subtitle2">Overall Score:</MudText>
                                @{
                                    var color = Color.Success;
                                    <MudChip T="string" Color="color"
                                             Variant="Variant.Text"
                                             Text="@Math.Round(_OveralScore, 2).ToString(CultureInfo.InvariantCulture)"/>
                                }
                            </MudGrid>
                            <MudGrid Class="pa-4">
                                <MudText Inline="true"
                                         Typo="Typo.subtitle2">
                                    Judging Enable:
                                </MudText>
                                <MudButtonGroup Color="Color.Default"
                                                Variant="Variant.Filled">
                                    <MudButton FullWidth="true">
                                        @_buttonText
                                    </MudButton>
                                    <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown">

                                        @foreach (var button in _judgingForm.JudgingButtons)
                                        {
                                            <MudMenuItem OnClick="() => SetButtonId(button.Id, button.Name)">
                                                @button.Name
                                            </MudMenuItem>
                                        }
                                    </MudMenu>
                                </MudButtonGroup>
                            </MudGrid>

                        </MudItem>
                        @* @if (_judgingForm.AddComment) *@
                        @* { *@
                        <MudItem xs="12" md="6">
                            <MudTextField Lines="3" Variant="Variant.Filled" Label="Comment"
                                          @bind-Value="JudgingResult.Comment"/>
                        </MudItem>
                        @* } *@
                    </MudGrid>
                </MudItem>
                <MudItem xs="12">
                    <CustomDivider></CustomDivider>
                </MudItem>
                <MudItem xs="12">
                    <MudGrid>
                        @if (_questions.Any())
                        {
                            <MudItem xs="12" md="2">
                                <MudText Typo="Typo.subtitle2">Answer the question</MudText>
                            </MudItem>
                        }
                        <MudItem xs="12" md="10">
                            <FormCreator SubmitButtonText="Submit"
                                         Questions="_questions"
                                         AnsweredTheQuestions="SubmitReferee"/>
                        </MudItem>
                    </MudGrid>
                </MudItem>
            </MudGrid>
        }
        else
        {
            <MudSkeleton Height="300"
                         SkeletonType="SkeletonType.Rectangle"
                         Animation="Animation.Wave"
                         Class="ma-2"/>
        }

    </DialogContent>
</MudDialog>