@using Web.Components.Pages.Festival.DashboardComponent
@inject IStringLocalizer<FestivalPaymentState> Localize
@* 
<div Class="pa-2 my-3" Elevation="0"> *@
    <MudGrid>
        <MudItem xs="12" md="4" lg="4">
            <MudPaper >
                <MudStack Class="pa-7">
                    <DividerNameValue Class="pa-3" 
                                      Icon="@Icons.Material.Filled.AppRegistration"
                                      Name="@Localize["Submit"]"
                                      Value="@_state.Submit.ToString("C2")"/>
                    <DividerNameValue Class="pa-3"
                                      Icon="@Icons.Material.Filled.ProductionQuantityLimits"
                                      Name="@Localize["Product"]"
                                      Value="@_state.Product.ToString("C2")"/>
                    <DividerNameValue Class="pa-3"
                                      Icon="@Icons.Material.Filled.AirplaneTicket"
                                      Name="@Localize["Ticket"]" 
                                      Value="@_state.Ticket.ToString("C2")"/>
                    <DividerNameValue Class="pa-3"
                                      Icon="@Icons.Material.Filled.Summarize"
                                      Name="@Localize["Total"]"
                                      Value="@_state.Income.ToString("C2")"/>
                    <DividerNameValue Class="pa-3"
                                      Icon="@Icons.Material.Filled.CalendarMonth"
                                      Name="@Localize["Last 30 days"]"
                                      Value="@_state.LastMonthIncome.ToString("C2")"/>
                    <DividerNameValue Class="pa-3"  
                                      Icon="@Icons.Material.Filled.Paid"
                                      Name="@Localize["Paid to festival"]"
                                      Value="@_state.AdminPayment.ToString("C2")"/>
                    <DividerNameValue Class="pa-3"
                                      Icon="@Icons.Material.Filled.RemoveCircleOutline"
                                      Name="@Localize["Site charges"]"
                                      Value="@_state.SiteCharges.ToString("C2")"/>
                    <DividerNameValue Class="pa-3" 
                                      Icon="@Icons.Material.Filled.AccountBalance"
                                      Name="@Localize["Net settlement due"]"
                                      Value="@_state.NetSettlementDue.ToString("C2")"/>
                </MudStack>
            </MudPaper>
        </MudItem>
       @if (_loaded)
       {
           <MudItem xs="12" md="4" lg="4" >
               <FestivalPaymentStateChart State="_state"/>
           </MudItem>

           <MudItem xs="12" md="4" lg="4">
               <PurchaseDunateChart State="_state"/>
           </MudItem>
       }
    </MudGrid>
@* </div> *@
