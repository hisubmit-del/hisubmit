<MudPaper Style="height: 100%" Class="pa-3 d-flex">
    <MudChart SelectedIndexChanged="ChangeTitle"
              ChartOptions="@(new ChartOptions() { ChartPalette = ChartColors.ChartPlate1 })"
              ChartType="ChartType.Donut" InputData="@_data"
              InputLabels="@_labels"
              Class="ma-auto"
              Width="100%" Height="240px">
        <CustomGraphics>
            <text class="donut-inner-text" x="47%" y="35%"
                  dominant-baseline="middle"
                  text-anchor="middle" fill="black"
                  font-family="Helvetica"
                  font-size="20">
                @_showTitle
            </text>

            <text class="donut-inner-text text-info"
                  x="47%" y="50%" dominant-baseline="middle"
                  text-anchor="middle" fill="black"
                  font-family="Helvetica" font-size="15">
                @_showTotal
            </text>

        </CustomGraphics>
    </MudChart>
</MudPaper>
