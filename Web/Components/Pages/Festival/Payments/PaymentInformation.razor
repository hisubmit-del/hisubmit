@page "/festival/payment-information"
@using HiSubmit.Client.SharedModels.Extensions
@using Web.Components.Shared.Components.Payments
@using Web.Components.Pages.Festival.Payments.Components
@using Hisubmit.Client.SharedModels.Enums.Festivals
@inherits Web.Components.Shared.Components.Base.BaseFestival

@inject IStringLocalizer<PaymentInformation> Localizer

<MudGrid class="mt-lg-2 pa-2">
    <MudItem xs="12">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   Href="/festival/settlements"
                   StartIcon="@Icons.Material.Filled.AccountBalance">
            Settlement statements
        </MudButton>
    </MudItem>
    <MudItem xs="12" lg="5">
      
        @if (_information != null)
        {
            <MudPaper Class="pa-4 h-100 payment-information-card d-flex flex-column" Elevation="25">
                        <MudText Typo="Typo.h5" Color="Color.Primary" Class="my-2">
                            Festival payout information
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                            This information prepares settlement payments for this festival.
                            HiSubmit never asks for your PayPal password.
                        </MudText>
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-4 settlement-guide">
                            <MudText Typo="Typo.subtitle2">How settlement works</MudText>
                            <MudText Typo="Typo.body2">
                                HiSubmit creates a statement for a completed period. You can review the income,
                                platform charges and adjustments, then confirm the statement. A payout is prepared
                                only after the statement is approved according to the festival settlement rules;
                                saving this page never transfers money automatically.
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mt-2">
                                PayPal recipients may use a supported personal or business PayPal account in their
                                own country. The recipient account must be able to receive the payout, and the
                                email below must belong to that account. HiSubmit's UAE Business account is the
                                sender account, not a requirement for the festival recipient.
                            </MudText>
                        </MudAlert>
                <EditForm Model="@_information" 
                    OnSubmit="SaveAsync">
                    <FluentValidationValidator @ref="_fluentValidationValidator"/>
                    <MudGrid Justify="Justify.Center">
                        <MudItem xs="12" Class="mb-3">
                            <MudSelect Disabled="_readOnly"
                                T="FestivalPaymentType" 
                                Variant="Variant.Filled"
                                @bind-Value="_information.Type" 
                                Required="true"
                                Label="Preferred settlement method *">
                                @foreach (FestivalPaymentType type in Enum.GetValues(typeof(FestivalPaymentType)))
                                {
                                    <MudSelectItem Value="@(type)">
                                        @type.ToDisplay()
                                        </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                    <MudItem xs="12">
                         <CustomDivider/>
                    </MudItem>
                    <MudGrid Justify="Justify.Center">
                        @{
                            if (_information.Type == FestivalPaymentType.Paypal)
                            {
                                <MudItem xs="12">
                                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                                        Enter the exact email of the PayPal account that should receive the festival
                                        payout. It may be a personal or business account from a supported country;
                                        it does not need to be a UAE PayPal account.
                                    </MudAlert>
                                    <MudTextField Disabled="_readOnly"
                                                  Variant="Variant.Filled"
                                                  @bind-Value="_information.PaypalEmail"
                                                  For="() => _information.PaypalEmail"
                                                  Required="true"
                                                  Label="PayPal payout recipient email *"
                                                  Placeholder="payments@yourfestival.com"
                                                  HelperText="Adding this email does not trigger a transfer."
                                                  InputMode="InputMode.email"
                                                  Adornment="Adornment.Start"
                                                  AdornmentIcon="@Icons.Material.Filled.AccountBalanceWallet">
                                    </MudTextField>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                                        Transfers are created only from an approved settlement statement.
                                    </MudText>
                                </MudItem>
                            }
                            if (_information.Type == FestivalPaymentType.DebitCard)
                            {
                                <MudItem xs="12">
                                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                                        This is a legacy settlement option. Never enter a PayPal password or security code here.
                                    </MudAlert>
                                    <MudGrid>
                                        <MudItem xs="12">
                                            <MudTextField Disabled="_readOnly" 
                                                          Variant="Variant.Filled" 
                                                          Mask="@(new PatternMask("0000 0000 0000 0000"))" 
                                                          Label="Credit Card Number"
                                                          @bind-Value="_information.CardNumber" Clearable/>
                                        </MudItem>
                                        <MudItem xs="5">
                                            <MudTextField Disabled="_readOnly" 
                                                          Variant="Variant.Filled" 
                                                          Mask="@(new DateMask("MM/YY", 'Y', 'M'))"
                                                          Label="Expires"
                                                          @bind-Value="_information.Expires"/>
                                        </MudItem>
                                        <MudItem xs="2"/>
                                        <MudItem xs="5">
                                            <MudTextField Disabled="_readOnly" 
                                                          Variant="Variant.Filled" 
                                                          Mask="@(new PatternMask("000"))" 
                                                          Label="CVC"
                                                          @bind-Value="_information.CVC"/>
                                        </MudItem>
                                    </MudGrid>
                                </MudItem>
                            }
                        }
                        <MudSpacer/>
                        <MudGrid Justify="Justify.Center" Class="mb-0 mt-auto">
                            <MudItem xs="12" md="8">
                                
                                @if (_readOnly)
                                {
                                    <MudButton Class="my-3" Variant="Variant.Filled"
                                            OnClick="@(()=>_readOnly=false)" 
                                            FullWidth="true"  
                                            StartIcon="@Icons.Material.Filled.Edit">
                                            Edit
                                            </MudButton>
                                }
                                else
                                {
                                    <LoadingButton Processing="_processing" 
                                                   Variant="Variant.Filled" 
                                                   Class="my-3 d-inline" 
                                                   ButtonType="ButtonType.Submit"
                                                   StartIcon="@Icons.Material.Filled.Save"
                                                   Color="Color.Primary">
                                        Save
                                    </LoadingButton>
                                    <MudButton  Class="my-3 d-inline" 
                                                Variant="Variant.Filled"
                                                OnClick="@(()=>_readOnly=true)"  
                                                StartIcon="@Icons.Material.Filled.Cancel">
                                                Cancel
                                                </MudButton>
                                }
                                
                            </MudItem>
                        </MudGrid>
                    </MudGrid>
                </EditForm>
            </MudPaper>
        }
    </MudItem>
    <MudItem xs="12" lg="8">
        @if (SelectedFestivalId != 0)
        {
            <FestivalPaymentItemsList FestivalId="SelectedFestivalId" IsAdmin="false"/>
        }
    </MudItem>
</MudGrid>

@if (SelectedFestivalId != 0)
{
    <FestivalPaymentState FestivalId="SelectedFestivalId"/>
    <MudGrid>
        <MudItem xs="12" Class="mb-4">
            <IncomeItems FestivalId="SelectedFestivalId" />
        </MudItem>
    </MudGrid>
}

