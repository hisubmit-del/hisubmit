@inject IStringLocalizer<AddEditQuestion> _localizer

@using HiSubmit.Client.SharedModels.Extensions
<EditForm Model="@SubQuestionModal" OnValidSubmit="SaveAsync">
    <FluentValidationValidator @ref="_fluentValidationValidator" />
    <MudDialog>
        <TitleContent>
            @{
                if (SubQuestionModal.Id == 0)
                {
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-3 mb-n1" />
                        @_localizer["Add Question"]
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Update" Class="mr-3 mb-n1" />
                        @_localizer["Update Question"]
                    </MudText>
                }
            }
        </TitleContent>
        <DialogContent>
            <MudGrid>

                <MudItem xs="12" md="6">
                    <MudTextField T="string" For="@(() => SubQuestionModal.Title)"
                                  Variant="Variant.Outlined"
                                  @bind-Value="SubQuestionModal.Title" Label="@_localizer["Name"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="Questiontype" For="@(()=>SubQuestionModal.Questiontype)"
                               Variant="Variant.Outlined"
                               @bind-Value="SubQuestionModal.Questiontype" Label="Question type">
                        @foreach (Questiontype qType in Enum.GetValues(typeof(Questiontype)))
                        {
                            <MudSelectItem Value="qType">@qType.ToDisplay()</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudGrid>
                        @if (SubQuestionModal.Questiontype == Questiontype.DropDownMenu || 
                             SubQuestionModal.Questiontype == Questiontype.CheckBox)
                        {

                            @foreach (var option in SubQuestionModal.Options)
                            {
                                <MudItem xs="6">
                                    <MudTextField T="string" For="()=>option.Title"
                                                  @bind-Value="option.Title" Margin="Margin.Dense" 
                                                  Variant="Variant.Outlined" Adornment="Adornment.End" 
                                                  AdornmentIcon="@Icons.Material.Filled.DeleteOutline" OnAdornmentClick="()=>deleteOption(option.Id)" AdornmentAriaLabel="Delete option" />
                                </MudItem>
                            }

                            <MudButton  Variant="Variant.Text" Class="text-transform:none" 
                                        OnClick="AddOption" Size="Size.Small" EndIcon="@Icons.Material.Filled.Add"
                                        Color="Color.Primary">@_localizer["Add Option"]</MudButton>
                        }
                    </MudGrid>
                </MudItem>

                <MudItem xs="12">
                    <MudSwitch T="bool" @bind-Value="@SubQuestionModal.ApplyforAllCategory" Label="@_localizer["Apply to all category"]" Color="Color.Primary" />
                </MudItem>
                @if (!SubQuestionModal.ApplyforAllCategory)
                {
                    <MudItem xs="12">
                        <MudGrid>
                            @foreach (var cat in CategorirsCheckBox)
                            {
                                <MudItem xs="12" md="6" lg="4">
                                    <MudCheckBox T="bool" Size="Size.Small" Dense="true" @bind-Value="@cat.IsSelected" Color="Color.Secondary">@cat.Name</MudCheckBox>
                                </MudItem>
                            }
                        </MudGrid>
                    </MudItem>
                }
            </MudGrid>
        </DialogContent>
        <DialogActions>
            <MudButton DisableElevation Variant="Variant.Filled" OnClick="Cancel">@_localizer["Cancel"]</MudButton>
            @if (SubQuestionModal.Id != 0)
            {
                <LoadingButton Processing="_processing" DisableElevation Variant="Variant.Filled" ButtonType="ButtonType.Submit" Disabled="@(!Validated)" Color="Color.Secondary">@_localizer["Update"]</LoadingButton>
            }
            else
            {
                <LoadingButton  Processing="_processing"  DisableElevation Variant="Variant.Filled" ButtonType="ButtonType.Submit" Disabled="@(!Validated)" Color="Color.Success">@_localizer["Save"]</LoadingButton>
            }
        </DialogActions>
    </MudDialog>
</EditForm>
