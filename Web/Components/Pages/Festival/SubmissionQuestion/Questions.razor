@page "/festival/question"

@inject IStringLocalizer<Questions> Localize

@inherits BaseFestival
@using global::Hisubmit.Client.SharedModels.Features.Submission.SubmissionQuestions.Query.GetAll
@using HiSubmit.Client.SharedModels.Extensions

<style>
    .mud-table-container {
        overflow: auto;
    }
</style>
<MudContainer MaxWidth="MaxWidth.Medium">

<HeroTitle Title="@Localize["Submission Question"]" Description="@Localize["Registration form question settings"]"/>
@if (!_loaded)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true"/>
}
else
{
    <MudTable Class="default-table" Hover="true" Elevation="25" Items="_questionList" Dense="true" Striped="true" @bind-brand="_question">
        <ToolBarContent>
            <div class="justify-center mud-text-align-center">
                <MudHidden Breakpoint="Breakpoint.MdAndDown">
                    <MudButton DisableElevation Variant="Variant.Filled" Color="Color.Primary" OnClick="() => InvokeModal()" StartIcon="@Icons.Material.Filled.Add" IconColor="Color.Surface">@Localize["Create"]</MudButton>
                    <MudButton DisableElevation Variant="Variant.Filled" OnClick="GetQuestionAsync" StartIcon="@Icons.Material.Filled.Refresh" IconColor="Color.Surface" Color="Color.Secondary">@Localize["Reload"]</MudButton>
                </MudHidden>
                <MudHidden Breakpoint="Breakpoint.LgAndUp">
                    <MudIconButton DisableElevation Variant="Variant.Filled" Color="Color.Primary" OnClick="() => InvokeModal()" Icon="@Icons.Material.Filled.Add" />
                    <MudIconButton DisableElevation Variant="Variant.Filled" OnClick="GetQuestionAsync" Icon="@Icons.Material.Filled.Refresh" Color="Color.Secondary"/>
                </MudHidden>

            </div>

        </ToolBarContent>
        <HeaderContent>
            <MudTh>
                <MudText Align="Align.Center" Typo="Typo.subtitle1"> @Localize["Name"]</MudText>
            </MudTh>
            <MudTh>
                <MudText Align="Align.Center" Typo="Typo.subtitle1">Question type</MudText>
            </MudTh>
            <MudTh>
                <MudText Align="Align.Center" Typo="Typo.subtitle1"> @Localize["Apply to all category"]</MudText>
            </MudTh>
            <MudTh Style="text-align:right">@Localize["Actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>

            <MudTd DataLabel="Name" Style="text-align:center">
                <MudHighlighter Text="@context.Title"/>
            </MudTd>
            <MudTd DataLabel="Question type" Style="text-align:center">
                <MudChip T="string" Variant="Variant.Text" Label="true" Color="Color.Secondary">@context.Questiontype.ToDisplay()</MudChip>
            </MudTd>
            <MudTd DataLabel="Apply To all Category" Style="text-align:center">
                <MudCheckBox T="bool" Disabled="true" @bind-Value="@context.ApplyforAllCategory" Color="Color.Secondary"></MudCheckBox>
            </MudTd>

            <MudTd DataLabel="Actions" Style="text-align: center">
                <MudMenu Label="@Localize["Actions"]" Variant="Variant.Filled" DisableElevation="true" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Secondary" Direction="Direction.Left" OffsetX="true">
                    <MudMenuItem OnTouch="@(() => InvokeModal(context.Id))" OnClick="@(() => InvokeModal(context.Id))">@Localize["Edit"]</MudMenuItem>
                    <MudMenuItem OnTouch="@(() => Delete(context.Id))"  OnClick="@(() => Delete(context.Id))">@Localize["Delete"]</MudMenuItem>
                </MudMenu>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

</MudContainer>
