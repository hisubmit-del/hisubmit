@page "/festival/judging"
@inject IStringLocalizer<Judging> Localize
@inherits BaseFestival

@using HiSubmit.Client.SharedModels.Extensions

<MudContainer MaxWidth="MaxWidth.Large">

    <HeroTitle Title="@Localize["judging"]" Description="@Localize["You can customize your Judging Forms below."]" />
    <MudGrid>
        <MudItem xs="12">
            <MudCard Elevation="25">
                <MudContainer MaxWidth="MaxWidth.Medium">
                    <MudCardHeader Class="border-b-2 border-solid mud-border-secondary">
                        <MudItem xs="12" md="6" lg="4" xl="3">
                            <MudSelect T="ProjectType" For="@(() => _judging.ProjectType)"
                                       SelectedValuesChanged="async (types) => { await ChangeProjectType(types.ToList()); }"
                                       @bind-Value="_judging.ProjectType" Label="Project type">
                                @foreach (ProjectType qType in Enum.GetValues(typeof(ProjectType)))
                                {
                                    <MudSelectItem Value="qType">@qType.ToDisplay()</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        @* <MudItem xs="12"> *@
                        @*     <CustomDivider/> *@
                        @* </MudItem> *@
                    </MudCardHeader>
                    <MudCardContent>
                        <MudGrid Class="pl-2 pr-2 pt-2 pb-2">
                            <MudItem xs="12" md="5">
                                <MudText Typo="Typo.subtitle2">@Localize["Fields"]</MudText>
                                <div class="d-flex flex-column align-center">
                                    <MudRating SelectedValue="1" MaxValue="3" Disabled="true" />
                                    <MudRating SelectedValue="2" Disabled="true" />
                                    <MudRating SelectedValue="3" MaxValue="10" Disabled="true" />
                                    <MudButton Style="text-transform:none" OnClick="AddFiled" Variant="Variant.Filled" Size="Size.Small" ButtonType="ButtonType.Button"
                                               Color="Color.Surface" Class="mt-3">
                                        @Localize["Add Costume Filed"]
                                    </MudButton>
                                </div>
                            </MudItem>
                            <MudItem xs="12" md="7">
                                <MudGrid>
                                    @foreach (var filed in _judging.JudgingFileds)
                                    {
                                        <MudItem xs="12" lg="9">
                                            <MudTextField Variant="Variant.Text" Margin="Margin.Dense" For="() => filed.Name" @bind-Value="filed.Name"
                                                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Outlined.DeleteOutline" OnAdornmentClick="() => { DeleteFiled(filed.Id); }">
                                            </MudTextField>
                                        </MudItem>
                                    }
                                </MudGrid>
                            </MudItem>
                        </MudGrid>
                        <CustomDivider></CustomDivider>
                        <MudGrid Class="pl-2 pr-2 pt-2 pb-2">
                            <MudItem xs="12" md="5">
                                <MudText Typo="Typo.subtitle2">@Localize["Buttons"]</MudText>
                            </MudItem>
                            <MudItem xs="12" md="9">
                                <MudGrid>
                                    @foreach (var button in _judging.JudgingButtons)
                                    {
                                        <MudChip T="string" Color="Color.Default" OnClose="() => DeleteButton(button.Id)">@button.Name</MudChip>
                                    }
                                    <MudItem lg="9">
                                        <MudButton Variant="Variant.Filled" Style="text-transform:none" Size="Size.Small" OnClick="AddButton" ButtonType="ButtonType.Button" Color="Color.Inherit">@Localize["Add Custome Button"]</MudButton>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                        </MudGrid>
                        <CustomDivider></CustomDivider>
                        <MudGrid>
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.subtitle2">
                                    @Localize["Costume Questions"]
                                </MudText>
                            </MudItem>
                            <MudItem xs="12" md="9">
                                <MudHidden Breakpoint="Breakpoint.MdAndUp">
                                    <MudButton Class="mb-2" Variant="Variant.Filled" Color="Color.Default" OnClick="() => AddQuestion()"
                                               StartIcon="@Icons.Material.Filled.Add" IconColor="Color.Surface">
                                        @Localize["Create Question"]
                                    </MudButton>
                                </MudHidden>
                                <MudTable Class="default-table" Hover="true" Elevation="25" Items="_judging.Questions" Dense="true" Bordered="false" Striped="true" @bind-brand="_question">
                                    <HeaderContent>
                                        <MudTh>
                                            <MudText Align="Align.Center" Typo="Typo.subtitle1"> @Localize["Name"]</MudText>
                                        </MudTh>
                                        <MudTh>
                                            <MudText Align="Align.Center" Typo="Typo.subtitle1">Question type</MudText>
                                        </MudTh>
                                        <MudTh>
                                            <MudText Align="Align.Center" Typo="Typo.subtitle1"> @Localize["Apply to all category"]</MudText>
                                        </MudTh>
                                        <MudTh Style="text-align:center">
                                            <MudButton DisableElevation Variant="Variant.Filled" Style="text-transform:none" Color="Color.Default" OnClick="(() => AddQuestion())"
                                                       StartIcon="@Icons.Material.Filled.Add" IconColor="Color.Surface">
                                                @Localize["Create"]
                                            </MudButton>
                                        </MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Name" Style="text-align:center">
                                            <MudHighlighter Text="@context.Title" />
                                        </MudTd>
                                        <MudTd DataLabel="Question type" Style="text-align:center">
                                            <MudChip T="string" Size="Size.Small" Label="true" Variant="Variant.Text" Color="Color.Default">@context.Questiontype.ToDisplay()</MudChip>
                                        </MudTd>
                                        <MudTd DataLabel="Apply To all Category" Style="text-align:center">
                                            <MudCheckBox T="bool" Disabled="true" Size="Size.Small"
                                                         Dense="true" @bind-Value="@context.ApplyforAllCategory" Color="Color.Secondary"></MudCheckBox>
                                        </MudTd>
                                        <MudTd DataLabel="Actions" Style="text-align: center">
                                            <MudHidden Breakpoint="Breakpoint.LgAndUp">
                                                <MudMenu Label="@Localize["Actions"]" Variant="Variant.Filled" DisableElevation="true" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Secondary" Direction="Direction.Left" OffsetX="true">
                                                    <MudMenuItem OnTouch="() => AddQuestion(context.Id)" OnClick="@(() => AddQuestion(context.Id))">@Localize["Edit"]</MudMenuItem>
                                                    <MudMenuItem OnTouch="() => DeleteQuestion(context.Id)" OnClick="@(() => DeleteQuestion(context.Id))">@Localize["Delete"]</MudMenuItem>
                                                </MudMenu>
                                            </MudHidden>
                                            <MudHidden Breakpoint="Breakpoint.MdAndDown">
                                                <MudIconButton @onclick="@(() => AddQuestion(context.Id))" Icon="@Icons.Material.Filled.Edit" Size="Size.Small"></MudIconButton>
                                                <MudIconButton @onclick="@(() => DeleteQuestion(context.Id))" Icon="@Icons.Material.Filled.Delete" Size="Size.Small"></MudIconButton>
                                            </MudHidden>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudItem>
                        </MudGrid>
                    </MudCardContent>
                </MudContainer>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>
