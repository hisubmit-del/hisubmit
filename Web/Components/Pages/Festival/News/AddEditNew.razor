@page "/festival/new"
@page "/festival/new/{NewId:int}"

@inject IStringLocalizer<AddEditNew> Localize
@inherits BaseFestival

<MudContainer MaxWidth="MaxWidth.Large">
    <MudGrid>
        <HeroTitle Title="@Localize["Add news"]" />
        <MudItem xs="12">
            <MudCard Elevation="25">
                <MudContainer MaxWidth="MaxWidth.Medium">
                    <EditForm Model="_new" FormName="festival-news-editor" OnSubmit="SaveAsync">
                        <FluentValidationValidator @ref="_fluentValidationValidator" />
                        <ValidationSummary />
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudTextField @bind-Value="_new.Title" For="() => _new.Title"
                                              Label="@Localize["Title"]" Variant="Variant.Filled"></MudTextField>
                                <br />
                                @* <MudSwitch T="bool" Size="Size.Small" @bind-Value="@_new.IsEnable" For="() => _new.IsEnable" Label="@Localize["Show In Site"]" Color="Color.Secondary"/> *@
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <ImageUploader @bind-Url="_new.BannerUrl"
                                               Title="Banner"
                                               SuggestedSize="900*300"
                                               @bind-UploadRequest="_new.UploadRequest" />
                            </MudItem>
                        </MudGrid>
                        <MudGrid>
                            <MudItem xs="12">
                                <MudTextField Lines="3" Label="@Localize["Short Description"]"
                                              For="() => _new.ShortDescription" @bind-Value="_new.ShortDescription"
                                              Variant="Variant.Filled"></MudTextField>
                            </MudItem>
                        </MudGrid>
                        <MudGrid>
                            <MudItem xs="12" Class="h-100">
                                <CustomeRichTextEditor MinHeight="360px" @bind-Body="@_new.Description" />
                                @* <RichText @bind-Body="_new.Description"></RichText> *@
                            </MudItem>
                        </MudGrid>
                        <MudGrid>
                            <AddEditSeoTagForm Model="@_new.SeoTag" />
                        </MudGrid>

                        <MudItem xs="12" Class="d-flex">
                            <MudSpacer/>
                            <MudButtonGroup OverrideStyles="false" Class="mb-2">
                                <MudButton Variant="Variant.Outlined"
                                            Color="Color.Secondary"
                                            OnClick="TogglePreview"
                                            Disabled="@(!CanPreview)">
                                    @Localize["Preview"]
                                </MudButton>
                                <MudButton  Variant="Variant.Filled"
                                            Href="/festival/news">@Localize["Back to list"]</MudButton>

                                <LoadingButton Processing="_processing" Variant="Variant.Filled"
                                               StartIcon="@Icons.Material.Filled.Save"
                                               ButtonType="ButtonType.Submit" Color="Color.Info">@Localize["Save"]</LoadingButton>
                            </MudButtonGroup>
                        </MudItem>
                        @if (_showPreview)
                        {
                            <MudItem xs="12">
                                <MudPaper Class="pa-4 mt-3" Outlined="true">
                                    <MudText Typo="Typo.h5">@_new.Title</MudText>
                                    <MudText Typo="Typo.subtitle1" Class="mt-2">@_new.ShortDescription</MudText>
                                    <MudDivider Class="my-3"/>
                                    <ReadMore Text="@_new.Description" MarkUpString="true" />
                                </MudPaper>
                            </MudItem>
                        }
                    </EditForm>
                </MudContainer>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>
