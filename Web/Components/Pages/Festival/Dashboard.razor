@page "/festival/dashboard"
@inject IStringLocalizer<Dashboard> Localize
@using Web.Components.Pages.Festival.DashboardComponent
@using Web.Components.Pages.Festival.Payments.Components
@inherits BaseFestival
@if (!_loaded)
{
    <MudGrid>
        @for (int i = 0; i < 6; i++)
        {
            <MudItem xs="6" sm="4" md="4" lg="2">
                <MudPaper>
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="60px" />
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
    <MudGrid>
        <MudItem xs="12" md="3">
            <MudPaper Class="pa-2">
                <MudSkeleton Height="360px" SkeletonType="SkeletonType.Rectangle" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-2">
                <MudSkeleton Height="360px" SkeletonType="SkeletonType.Rectangle" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudPaper Class="pa-2">
                <MudSkeleton Height="360px" SkeletonType="SkeletonType.Rectangle" />
            </MudPaper>
        </MudItem>
    </MudGrid>
    <MudGrid>
        @for (var i = 0; i < 6; i++)
        {
            <MudItem xs="12" md="4" lg="4">
                <MudPaper Class="pa-2">
                    <MudSkeleton Height="360px" SkeletonType="SkeletonType.Rectangle" />
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}
else
{
    <div class="dashboard-page-shell">
    <div class="dashboard-page-intro">
        <div>
            <MudText Typo="Typo.overline">Festival workspace</MudText>
            <MudText Typo="Typo.h3">A clearer view of your festival</MudText>
            <MudText Typo="Typo.body2">Track entries, sales, judging and audience activity from one place.</MudText>
        </div>
        <MudIcon Icon="@Icons.Material.Outlined.Insights" Size="Size.Large" />
    </div>
    <MudGrid Class="mt-4">
        <MudItem xs="6" sm="4" md="4" lg="2">
            <MudPaper Elevation="25"
                      Class="d-flex flex-row pt-3 pb-2  mud-theme-white text-tertiary">
                <MudIcon Icon="@Icons.Material.Filled.AppRegistration"
                         Color="Color.Tertiary"
                         Class="mx-4"
                         Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.subtitle1"
                             Color="Color.Dark"
                             Class=" mb-n1">
                        @Localize["Submits"]
                    </MudText>
                    <MudText Typo="Typo.h6">
                        @_submitCount
                    </MudText>
                </div>
            </MudPaper>
            @* <MudPaper Elevation="25" *@
            @*           Class="d-flex flex-row pt-3 pb-2 mud-theme-primary text-white"> *@
            @*     <MudIcon Icon="@Icons.Material.Filled.AppRegistration" *@
            @*              Color="Color.Surface" *@
            @*              Class="mx-4" *@
            @*              Size="Size.Large"/> *@
            @*     <div> *@
            @*         <MudText Typo="Typo.subtitle1" *@
            @*                  Class=" mb-n1"> *@
            @*             @Localize["Submits"] *@
            @*         </MudText> *@
            @*         <MudText Typo="Typo.h6"> *@
            @*             @_submitCount *@
            @*         </MudText> *@
            @*     </div> *@
            @* </MudPaper> *@
        </MudItem>
        <MudItem xs="6" sm="4" md="4" lg="2">
            <MudPaper Elevation="25"
                      Class="d-flex flex-row pt-3 pb-2  mud-theme-white text-tertiary">
                @* Class="d-flex flex-row pt-3 pb-2 mud-theme-secondary text-white"> *@
                <MudIcon Icon="@Icons.Material.Filled.Category"
                         Color="Color.Tertiary"
                         Class="mx-4"
                         Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.subtitle1"
                             Color="Color.Dark"
                             Class=" mb-n1">
                        @Localize["Categories"]
                    </MudText>
                    <MudText Typo="Typo.h6">
                        @_categoryCount
                    </MudText>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="6" sm="4" md="4" lg="2">
            <MudPaper Elevation="25"
                      Class="d-flex flex-row pt-3 pb-2  mud-theme-white text-tertiary">
                @* Class="d-flex flex-row pt-3 pb-2 mud-theme-white text-dark"> *@
                <MudIcon Icon="@Icons.Material.Filled.AirplaneTicket"
                         Color="Color.Tertiary"
                         Class="mx-4"
                         Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.subtitle1"
                             Color="Color.Dark"
                             Class=" mb-n1">
                        @Localize["Tickets"]
                    </MudText>
                    <MudText Typo="Typo.h6">
                        @_ticketsSoldCount
                    </MudText>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="6" sm="4" md="4" lg="2">
            <MudPaper Elevation="25"
                      Class="d-flex flex-row pt-3 pb-2  mud-theme-white text-tertiary">
                @* Class="d-flex flex-row pt-3 pb-2 mud-theme-dark text-white"> *@
                <MudIcon Icon="@Icons.Material.Filled.Newspaper"
                         Color="Color.Tertiary"
                         Class="mx-4"
                         Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.subtitle1"
                             Color="Color.Dark"
                             Class=" mb-n1">
                        @Localize["News"]
                    </MudText>
                    <MudText Typo="Typo.h6">
                        @_newsCount
                    </MudText>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="6" sm="4" md="4" lg="2">
            <MudPaper Elevation="25"
                      Class="d-flex flex-row pt-3 pb-2  mud-theme-white text-tertiary">
                @* Class="d-flex flex-row pt-3 pb-2 mud-theme-success text-dark"> *@
                <MudIcon Icon="@Icons.Material.Filled.Reviews"
                         Color="Color.Tertiary"
                         Class="mx-4"
                         Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.subtitle1"
                             Color="Color.Dark"
                             Class=" mb-n1">
                        @Localize["Reviews"]
                    </MudText>
                    <MudText Typo="Typo.h6">
                        @_reviewCount
                    </MudText>
                </div>
            </MudPaper>
        </MudItem>

        <MudItem xs="6" sm="4" md="4" lg="2">
            <MudPaper Elevation="25"
                      Class="d-flex flex-row pt-3 pb-2  mud-theme-white text-tertiary">
                @* Class="d-flex flex-row pt-3 pb-2 mud-theme-info text-white"> *@
                <MudIcon Icon="@Icons.Material.Filled.VerifiedUser"
                         Color="Color.Tertiary"
                         Class="mx-4"
                         Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.subtitle1"
                             Color="Color.Dark"
                             Class=" mb-n1">
                        @Localize["Users"]
                    </MudText>
                    <MudText Typo="Typo.h6">
                        @_userCount
                    </MudText>
                </div>
            </MudPaper>
        </MudItem>

    </MudGrid>
    @* <MudGrid Style="height:390px"> *@
    <MudGrid Class="mt-4">
        <MudItem xs="12" md="3" >
            <FestivalDetailBox Festival="_festival"
                               Loaded="_festivalLoaded" />
        </MudItem>
        <MudItem xs="12" md="6" lg="6" Style="height: 382px">
            <LastSubmitTable FestivalId="SelectedFestivalId"
                             Submits="_submits" />
        </MudItem>
        <MudItem xs="12" md="3" Style="height: 382px">
            <FestivalTimeLine Festival="_festival"
                              FestivalId="SelectedFestivalId" />
        </MudItem>
    </MudGrid>
    <MudPaper Class="pa-4 mt-4 dashboard-task-queue" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween" Class="mb-3">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@Localize["Next steps"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @Localize["Actionable items for the selected festival."]
                </MudText>
            </MudStack>
            <MudIcon Icon="@Icons.Material.Outlined.TaskAlt" Color="Color.Primary" />
        </MudStack>

        @if (!HasOpenTasks)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined">
                @Localize["No immediate actions. Your festival workspace is up to date."]
            </MudAlert>
        }
        else
        {
            <MudList T="string" Dense="true" Class="pa-0">
                @if (!_festival.IsActive)
                {
                    <MudListItem Icon="@Icons.Material.Outlined.EventAvailable"
                                 Href="/festival/edit">
                        <MudText Typo="Typo.body1">@Localize["Complete and release the festival"]</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @Localize["Review the setup wizard and release it when all required sections are ready."]
                        </MudText>
                    </MudListItem>
                }
                @if (_categoryCount == 0)
                {
                    <MudListItem Icon="@Icons.Material.Outlined.Category"
                                 Href="/festival/edit">
                        <MudText Typo="Typo.body1">@Localize["Add the first category"]</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @Localize["Categories and deadlines tell artists how to submit."]
                        </MudText>
                    </MudListItem>
                }
                @if (_submitCount > 0 && _reviewCount == 0)
                {
                    <MudListItem Icon="@Icons.Material.Outlined.Score"
                                 Href="/festival/judging">
                        <MudText Typo="Typo.body1">@Localize["Prepare judging"]</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @Localize["Review judging fields and assignments for submitted works."]
                        </MudText>
                    </MudListItem>
                }
                @if (_newsCount == 0)
                {
                    <MudListItem Icon="@Icons.Material.Outlined.Newspaper"
                                 Href="/festival/news">
                        <MudText Typo="Typo.body1">@Localize["Publish a festival update"]</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @Localize["Keep applicants and your audience informed with the first news item."]
                        </MudText>
                    </MudListItem>
                }
            </MudList>
        }
    </MudPaper>
    <MudGrid Class="mt-4">
        @if (_submits.Any())
        {
            if (_submits.GroupBy(p => p.SubmitDate).Count() > 4)
            {
                <MudItem xs="12" md="4" lg="4">
                    <DailySubmitChart Loaded="_submitLoaded"
                                      Submits="_submits" />
                </MudItem>
            }

            <MudItem xs="12" md="6" lg="4">
                <CategorySubmitChart FestivalId="SelectedFestivalId" />
            </MudItem>
            @* <MudItem xs="12" md="6" lg="4"> *@
            @*     <CategoryDeadLineSubmitChart Loaded="_submitLoaded"  *@
            @*                                  Submits="_submits"/> *@
            @* </MudItem> *@
            <MudItem xs="12" md="6" lg="4">
                <SubmitJudgingStatusChart Loaded="_submitLoaded"
                                          Submits="_submits" />
            </MudItem>

        }

    </MudGrid>

    <FestivalPaymentState FestivalId="SelectedFestivalId" />

    <MudGrid Class="mt-4">
        <MudItem xs="12" md="6" lg="9">
            <PurchaseChart FestivalId="SelectedFestivalId" />
        </MudItem>
    </MudGrid>

    </div>
}
