@inject IStringLocalizer<ContactAndVenue> Localize

<MudCard Elevation="25">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h3">@Localize["Contact & Venue Information "]</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    @if (!_loaded)
    {
        <MudContainer MaxWidth="MaxWidth.Medium" Style="height:300px">
            <Spinner></Spinner>
        </MudContainer>
    }
    else
    {
        <MudCardContent>
            @* <MudContainer MaxWidth="MaxWidth.Medium"> *@
            <EditForm FormName="festival-contact-venue" EditContext="_EditForm" OnValidSubmit="SaveAsync">
                <FluentValidationValidator @ref="_fluentValidationValidator"/>
                <ValidationSummary />
                <MudGrid Class="px-0 px-md-20 px-lg-20">
                    <MudItem xs="12" md="2">
                        <MudText Typo="Typo.subtitle2">@Localize["Contact Information"]</MudText>
                    </MudItem>
                    @if (!IsAdmin)
                    {
                        if (_festival.FestivalStatus == FestivalStatus.UnderInvestigation)
                        {
                            <MudItem xs="12" Class="mb-2">
                                <MudAlert Severity="Severity.Warning"> Your festival information is under review.
                                </MudAlert>
                            </MudItem>
                        }
                    }
                    <MudItem xs="12" md="10">
                        <MudGrid>
                            <MudItem xs="12" md="6" Style="margin-bottom:2px">
                                <MudTextField @bind-Value="_festival.WebSite" For="@(() => _festival.WebSite)"
                                              HelperTextOnFocus="true" HelperText="Like: www.HiSubmit.com "
                                              Required="true" Label="@Localize["WebSite"]" Variant="Variant.Filled"
                                              Margin="Margin.Dense"/>
                            </MudItem>
                            <MudItem xs="12" md="6" Style="margin-bottom:2px">
                                <MudTextField @bind-Value="_festival.Phone" For="@(() => _festival.Phone)"
                                              HelperTextOnFocus="true" HelperText="Like: +4354323223 "
                                              Label="@Localize["Phone"]" Variant="Variant.Filled"
                                              Margin="Margin.Dense"/>
                            </MudItem>
                            <MudItem xs="12" md="6" Style="margin-bottom:2px">
                                <MudTextField @bind-Value="_festival.Email" For="@(() => _festival.Email)"
                                              HelperTextOnFocus="true" HelperText="Like: hisubmit@hisubmit.com "
                                              Required="true" Label="@Localize["Email"]" Variant="Variant.Filled"
                                              Margin="Margin.Dense"/>
                            </MudItem>
                            <MudItem>
                                <AddressComponent Address="_festival.Address"/>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                </MudGrid>
                <CustomDivider></CustomDivider>
                <MudItem>
                    <MudGrid Class="px-0 px-md-20 px-lg-20">
                        <MudItem xs="12" md="2">
                            <MudText Typo="Typo.subtitle2">@Localize["Social Media "]</MudText>
                        </MudItem>
                        <MudItem xs="12" md="10">
                            <MudGrid>
                                <MudItem xs="12" md="6" Style="margin-bottom:2px">
                                    <MudTextField @bind-Value="_festival.Facebook" For="@(() => _festival.Facebook)"
                                                  HelperTextOnFocus="true" HelperText="@("Like: hisub ;without '@'")"
                                                  Label="@Localize["FaceBook"]" Variant="Variant.Filled"
                                                  Margin="Margin.Dense"/>
                                </MudItem>
                                <MudItem xs="12" md="6" Style="margin-bottom:2px">
                                    <MudTextField @bind-Value="_festival.Twitter" For="@(() => _festival.Twitter)"
                                                  HelperTextOnFocus="true" HelperText="@("Like: hisub ;without '@'")"
                                                  Label="@Localize["Twitter"]" Variant="Variant.Filled"
                                                  Margin="Margin.Dense"/>
                                </MudItem>
                                <MudItem xs="12" md="6" Style="margin-bottom:2px">
                                    <MudTextField @bind-Value="_festival.Instagram" For="@(() => _festival.Instagram)"
                                                  HelperTextOnFocus="true" HelperText="@("Like: hisub;without '@'")"
                                                  Label="@Localize["Instagram"]" Variant="Variant.Filled"
                                                  Margin="Margin.Dense"/>
                                </MudItem>
                                <MudItem xs="12" md="6" Style="margin-bottom:2px">
                                    <MudTextField @bind-Value="_festival.Telegram" For="@(() => _festival.Telegram)"
                                                  HelperTextOnFocus="true" HelperText="@("Like: hisub;without '@'")"
                                                  Label="@Localize["Telegram UserName"]" Variant="Variant.Filled"
                                                  Margin="Margin.Dense"/>
                                </MudItem>
                                <MudItem xs="12" md="6" Style="margin-bottom:2px">
                                    <MudTextField @bind-Value="_festival.WhatsAppNumber"
                                                  For="@(() => _festival.WhatsAppNumber)"
                                                  HelperTextOnFocus="true" HelperText="@("Like: +4354656675")"
                                                  Label="@Localize["WhatsAppNumber"]" Variant="Variant.Filled"
                                                  Margin="Margin.Dense"/>
                                </MudItem>
                                <MudItem xs="12" md="6" Style="margin-bottom:2px">
                                    <MudTextField @bind-Value="_festival.Youtube" For="@(() => _festival.Youtube)"
                                                  HelperTextOnFocus="true" HelperText="@("Like: hisub ; without '@'")"
                                                  Label="@Localize["Youtube"]" Variant="Variant.Filled"
                                                  Margin="Margin.Dense"/>
                                </MudItem>
                            </MudGrid>
                        </MudItem>
                    </MudGrid>
                </MudItem>

                <CustomDivider></CustomDivider>
                <MudItem>
                    <MudGrid Class="px-0 px-md-20 px-lg-20">
                        <MudItem xs="12" md="2">
                            <MudText Typo="Typo.subtitle2">
                                @Localize["Submission Address"]
                            </MudText>
                        </MudItem>
                        <MudItem xs="12" md="10">
                            <MudSwitch Size="Size.Small" @bind-Value="@_festival.SeparateSubmissiionAddress"
                                       For="() => _festival.SeparateSubmissiionAddress"
                                       Label="@Localize["Separate Submission Address"]"
                                       Color="Color.Secondary"/>
                            @if (_festival.SeparateSubmissiionAddress)
                            {
                                <AddressComponent Address="_festival.SubmissionAddress"></AddressComponent>
                            }
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <CustomDivider></CustomDivider>
                <MudItem>
                    <MudGrid Class="px-0 px-md-20 px-lg-20">
                        <MudItem xs="12" md="2">
                            <MudText Typo="Typo.subtitle2">
                                @Localize["Event venue"] <span style="color:#d32f2f;font-weight:700" aria-hidden="true">*</span>
                            </MudText>
                        </MudItem>
                        <MudItem xs="12" md="10">
                            <MudSwitch T="bool" Size="Size.Small"
                                       @bind-Value="@_festival.OnlineEvent"
                                       For="() => _festival.OnlineEvent"
                                       Label="@Localize["Online Event"]" Color="Color.Secondary"/>
                            @if (!_festival.OnlineEvent)
                            {
                                <FestivalVenue IsAdmin="IsAdmin" ReadOnlyMood="_festival.ChangesNotAllowed"
                                               FestivalId="FestivalId"></FestivalVenue>
                            }
                        </MudItem>
                    </MudGrid>
                </MudItem>
                <MudDivider DividerType="DividerType.FullWidth" Style="margin:10px;"/>
            </EditForm>
            @* </MudContainer> *@
        </MudCardContent>
        <MudPaper Class="d-flex justify-end flex-grow-1 ">
            <MudPaper Class="mr-2 mb-2">
                        <MudButtonGroup Class="wizard-navigation-buttons" Variant="Variant.Outlined" OverrideStyles="false">
                    <ResponsiveButton Variant="Variant.Filled" OnClick="GoPrev"
                               EndIcon="@Icons.Material.Filled.ArrowLeft" Color="Color.Secondary">
                        @Localize["Prev"]
                    </ResponsiveButton>
                    @if (!IsAdmin)
                    {
                        <ResponsiveButton Disabled="_festival.ChangesNotAllowed" Processing="_processing"
                                       Variant="Variant.Filled" OnClick="SaveAsync"
                                       StartIcon="@Icons.Material.Filled.Save" Color="Color.Info">
                            @Localize["Save"]
                        </ResponsiveButton>
                    }
                    <ResponsiveButton Variant="Variant.Filled" OnClick="GoNext"
                               EndIcon="@Icons.Material.Filled.ArrowRight" Color="Color.Secondary">
                        @Localize["Next"]
                    </ResponsiveButton>
                </MudButtonGroup>
            </MudPaper>
        </MudPaper>
    }
</MudCard>

