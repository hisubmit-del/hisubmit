@inject IStringLocalizer<AddEditFestivalFileModal> Localize


@using HiSubmit.Client.SharedModels.Extensions

<EditForm Model="@File" OnValidSubmit="SaveAsync" FormName="festival-file-form">
    <FluentValidationValidator @ref="_fluentValidationValidator" />
    <MudDialog Class="form-dialog">
        <TitleContent>
            @{
                if (File.Id == 0)
                {
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-3 mb-n1" />
                        @Localize["Add File"]
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Update" Class="mr-3 mb-n1" />
                        @Localize["Update File"]
                    </MudText>
                }
            }
        </TitleContent>
        <DialogContent>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField For="@(() => File.Name)" @bind-Value="File.Name"
                                  Required="true" Label="@Localize["Name"]" Variant="Variant.Filled"
                                  Margin="Margin.Dense" />
                </MudItem>
              
                <MudItem xs="12" md="6">
                    <MudSelect T="FileFormat" Label="@Localize["format"]"
                    Disabled="@(File.Id != 0 )"   @bind-Value="File.FileFormat" 
                    For="@(()=>File.FileFormat)" Variant="Variant.Filled" Margin="Margin.Dense" >
                      @foreach (FileFormat fileFormat in Enum.GetValues(typeof(FileFormat)))
                      {
                          <MudSelectItem Value="fileFormat" >@fileFormat.ToDisplay()</MudSelectItem>
                      }
                    </MudSelect>
                </MudItem>
           
                <MudItem xs="12" md="6">
                    <div class="file-upload-field">
                        <MudText Typo="Typo.caption" Class="file-upload-field__label">
                            @Localize["File"] <span class="required-field-mark">*</span>
                        </MudText>
                        @if (_file != null)
                        {
                            <MudText Typo="Typo.body2" Class="file-upload-field__name">
                                <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" />
                                @_file.Name
                            </MudText>
                        }
                        @if (File.Id != 0 && !string.IsNullOrEmpty(File.FileURL))
                        {
                            <MudText Typo="Typo.caption" Class="file-upload-field__name">
                                @Localize["Existing file attached"]
                            </MudText>
                        }
                        <InputFile id="fileInput" hidden OnChange="UploadFiles" />
                        <div class="file-upload-field__action">
                            @if (File.Id == 0)
                            {
                                <MudButton HtmlTag="label"
                                           Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Medium"
                                           StartIcon="@Icons.Material.Filled.CloudUpload"
                                           for="fileInput">
                                    @Localize["Upload"]
                                </MudButton>
                            }
                            else if (!string.IsNullOrEmpty(File.FileURL))
                            {
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Secondary"
                                           StartIcon="@Icons.Material.Filled.CloudDownload"
                                           Size="Size.Small"
                                           Link="@(File.FileURL)" Target="_blank">
                                    @Localize["Download"]
                                </MudButton>

                            }
                        </div>
                    </div>
                </MudItem>
                  <MudItem xs="12" md="6">
                    <MudTextField For="@(() => File.Description)" @bind-Value="File.Description" 
                        Label="@Localize["Description"]" Lines="3" Variant="Variant.Filled"
                        Margin="Margin.Dense" />
                      </MudItem>
            </MudGrid>
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Filled" OnClick="Cancel">@Localize["Cancel"]</MudButton>
            @if (File.Id != 0)
            {
                <LoadingButton Processing="_processing" Variant="Variant.Filled"
                               ButtonType="ButtonType.Submit" 
                               Color="Color.Secondary">@Localize["Update"]</LoadingButton>
            }
            else
            {
                <LoadingButton Processing="_processing" Variant="Variant.Filled"
                               ButtonType="ButtonType.Submit"
                               Color="Color.Success">@Localize["Save"]</LoadingButton>
            }
        </DialogActions>
    </MudDialog>
</EditForm>
