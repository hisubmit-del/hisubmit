@inject IStringLocalizer<FestivalImages> Localize;
<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h3">@Localize["Gallery and Cover"]</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    @if (!_loaded)
    {
        <MudContainer MaxWidth="MaxWidth.Medium" Style="height:300px">
            <Spinner></Spinner>
        </MudContainer>
    }
    <MudCardContent>
        @* <MudContainer MaxWidth="MaxWidth.Large"> *@
        <MudGrid Class="px-0 px-md-20 px-lg-20">
            <MudItem xs="12" md="2">
                <MudText Typo="Typo.subtitle2">FestivalId Cover(Banner)</MudText>
            </MudItem>
            <MudItem xs="12" md="10">
                @if (_covers.Any())
                {
                    <MudGrid>
                        @* @foreach (var cover in _covers) *@
                        @* { *@
                        <MudItem xs="12" Class="ma-0 mb-2">
                            <ImageUploader  HideDeleteButton="true"
                                            SuggestedSize="1200*400"
                                            Height="300px" MaxHeight="300px" Width="100%"
                                            @bind-ImageAlt="@_covers[0].Title" 
                                            @bind-UploadRequest="@(_covers[0].UploadRequest)"
                                            @bind-Url="@(_covers[0].Url)"/>
                        </MudItem>
                        @* } *@
                        @* <MudIconButton Variant="Variant.Text" Size="Size.Large" Icon="@Icons.Material.Outlined.Add" OnClick="AddCover"></MudIconButton> *@
                    </MudGrid>
                }
                else
                {
                    <MudItem xs="12">
                        <MudButton Variant="Variant.Filled" Size="Size.Small" OnClick="AddCover">@Localize["Add cover"]</MudButton>
                    </MudItem>
                }
            </MudItem>
                                
            <MudItem xs="12">
                <MudDivider/>
            </MudItem>
            <MudItem xs="12" md="2">
                <MudText Typo="Typo.subtitle2">Gallery Images</MudText>
            </MudItem>
            <MudItem xs="12" md="10">
                @if (_images.Any())
                {
                    <MudGrid>
                        @foreach (var image in _images)
                        {
                            <MudItem>
                                <MudStack>
                                    <ImageUploader MaxHeight="200px" DeleteImage="() => DeleteImage(image)"
                                                   SuggestedSize="Square image"
                                                   @bind-ImageAlt="@image.Title"
                                                   @bind-UploadRequest="@(image.UploadRequest)"
                                                   @bind-Url="@(image.Url)"></ImageUploader>
                                </MudStack>
                            </MudItem>
                        }
                        <MudIconButton Variant="Variant.Text" Size="Size.Small" 
                                       Icon="@Icons.Material.Outlined.Add" OnClick="AddImage"></MudIconButton>
                    </MudGrid>
                }
                else
                {
                    <MudItem xs="12">
                        <MudButton Variant="Variant.Filled" Size="Size.Small" 
                                   OnClick="AddImage">@Localize["Add festival gallery image"]</MudButton>
                    </MudItem>
                }
            </MudItem>
             

        </MudGrid>
        @if (ShowNavigation)
        {
        <MudPaper Class="d-flex justify-end flex-grow-1 mt-2 mt-lg-0" Elevation="0">
            <MudPaper Class="mr-2 mb-2" Elevation="0">
                <MudButtonGroup Variant="Variant.Filled" OverrideStyles="false">
                    <ResponsiveButton Variant="Variant.Filled" OnClick="GoPrev"
                               EndIcon="@Icons.Material.Filled.ArrowLeft"
                               Color="Color.Secondary"> @Localize["Prev"]</ResponsiveButton>
                    @if (!IsAdmin)
                    {
                        if (_images.Any() || _covers.Any())
                        {
                            <ResponsiveButton Processing="_processing" Variant="Variant.Filled" Color="Color.Info" OnClick="SaveAsync">
                                @Localize["Save"]
                            </ResponsiveButton>
                        }
                    }
                    <ResponsiveButton Variant="Variant.Filled" OnClick="GoNext"
                               EndIcon="@Icons.Material.Filled.ArrowRight"
                               Color="Color.Secondary"> @Localize["Next"]</ResponsiveButton>
                </MudButtonGroup>
            </MudPaper>
        </MudPaper>
        }
    </MudCardContent>
</MudCard>
