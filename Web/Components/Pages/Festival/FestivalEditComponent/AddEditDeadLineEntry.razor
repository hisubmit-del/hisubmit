@inject IStringLocalizer<AddEditDeadLineEntry> Localize
<EditForm Model="DeadLine">
    <FluentValidationValidator @ref="_fluentValidationValidator"></FluentValidationValidator>
    <MudDialog>
        <TitleContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-3 mb-n1"/>
                @Localize["Add DeadLine"]
            </MudText>
        </TitleContent>
        <DialogContent>

            @if (!Loaded)
            {
                <MudContainer MaxWidth="MaxWidth.Medium" Style="height:120px">
                    <Spinner></Spinner>
                </MudContainer>
            }
            else
            {
                <MudItem xs="12">
                    <MudTextField Margin="Margin.Dense" Variant="Variant.Filled"
                                  Label="@Localize["Name"]" Required="true" For="() => DeadLine.Name" @bind-Value="DeadLine.Name" />
                </MudItem>
                <MudItem xs="12">
                    <MudDatePicker PickerVariant="PickerVariant.Dialog" HelperTextOnFocus="true"
                                   HelperText="There should be two weeks between both deadlines"
                                   Required="true"
                                   Margin="Margin.Dense" Rounded="true" Variant="Variant.Filled" DateFormat="MMMM,dd,yyyy"
                                   Label="@Localize["Date"]" For="() => DeadLine.Date" @bind-Date="DeadLine.Date"/>
                </MudItem>
                <MudItem xs="12" md="10" class="mt-4">
                    <MudSwitch T="bool" Size="Size.Medium" For="() => DeadLine.ApplyToAllCategory"
                               @bind-Value="@DeadLine.ApplyToAllCategory" Color="Color.Primary">
                        @Localize["This deadline applies to all categories"]
                        <MudText Typo="Typo.caption" Inline="true">
                            @Localize["(current categories and categories that will be added later)"]
                        </MudText>
                    </MudSwitch>
                </MudItem>
                @if (!DeadLine.ApplyToAllCategory)
                {
                    <MudItem>
                        <GroupCheckBox @ref="CategoryList" Items="@_CategoriesItems"></GroupCheckBox>
                    </MudItem>
                }
            }
        </DialogContent>
        <DialogActions>
            <MudButton DisableElevation Variant="Variant.Filled" OnClick="Cancel" 
                       ButtonType="ButtonType.Button">@Localize["Cancel"]</MudButton>
            <LoadingButton Processing="_processing" Variant="Variant.Filled"
                           OnClick="SaveAsync" ButtonType="ButtonType.Submit" Color="Color.Success">@Localize["Save"]</LoadingButton>
        </DialogActions>
    </MudDialog>
</EditForm>

