
@using HiSubmit.Client.SharedModels.Extensions
@inject IStringLocalizer<AddEditEventCategory> Localize



    <EditForm EditContext="_EditForm" OnValidSubmit="SaveAsync">
        <FluentValidationValidator @ref="_fluentValidationValidator" />
        @if (!Loaded)
        {
            <MudContainer MaxWidth="MaxWidth.Medium" Style="height:230px;">
                <Spinner></Spinner>
            </MudContainer>
        }
        else
        {
            <MudContainer Class="mt-3 pt-3 pb-3">
                <MudItem xs="12" md="6" Class="mt-2 mb-2">
                <MudTextField Margin="Margin.Dense" Required="true" Variant="Variant.Filled" Label="@Localize["Name"]"
                                  For="()=>Category.Name" @bind-Value="Category.Name" />
                </MudItem>
                <MudItem xs="12" Class="mt-2 mb-2">
                <MudTextField  @bind-Value="Category.Description" Margin="Margin.Normal" For="@(() => Category.Description)"
                                  Label="@Localize["Event Description"]" Variant="Variant.Filled" Lines="4" />
                </MudItem>
                @if (Category.CategoryonFees.Count > 0)
                {
                    <MudItem xs="12" Class="mt-2 mb-2">
                        <MudGrid>
                            <MudItem xs="12" md="2">
                                <MudText Typo="Typo.subtitle1">DeadLines Fee</MudText>
                            </MudItem>
                            <MudItem xs="12" md="10">
                                <MudGrid Class="pa-5 pa-md-2">
                                    @foreach (var fee in Category
                                                  .CategoryonFees.OrderBy(p => p.DeadLineDate))
                                    {
                                        <MudPaper Class="border-l-4 border-solid mud-border-primary pa-4 mt-2" Square="true">
                                            <AddEditCategoryDeadLineFee Fee="fee" />
                                        </MudPaper>
                                    }
                                </MudGrid>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                }
                <MudButton Icon="@Icons.Material.Filled.Add" OnClick="AddNewDeadline" FullWidth="true">Add DeadLine</MudButton>

                <MudItem xs="12" md="12" Class="m-2 mt-4">
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudSelect @bind-Value="Category.ProjectType" For="@(() => Category.ProjectType)" Margin="Margin.Dense"
                                       T="ProjectType?" Label="@Localize["Project ItemType"]" Variant="Variant.Filled" AnchorOrigin="Origin.BottomCenter">
                                <MudSelectItem Value="null as ProjectType?">@Localize["All Project ItemType"]</MudSelectItem>
                                @foreach (ProjectType projType in Enum.GetValues<ProjectType>())
                                {
                                    <MudSelectItem Value="projType as ProjectType?">@projType.ToDisplay()</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                </MudItem>
                
                @if (Category.ProjectType != null
               && Category.ProjectType !=ProjectType.Photography && Category.ProjectType==ProjectType.Art)
                {
                    <MudItem xs="12" Class="m-2 mt-4">
                        <MudGrid>
                            <MudItem xs="12" md="4">
                                <MudSelect @bind-Value="Category.RuntimeType"
                                           For="@(() => Category.RuntimeType)" Margin="Margin.Dense" T="RuntimeType?"
                                           Label="@Localize["RunTime"]" Variant="Variant.Filled" AnchorOrigin="Origin.BottomCenter">

                                    <MudSelectItem Value="RuntimeType.Over as RuntimeType?">@Localize["Over"]</MudSelectItem>
                                    <MudSelectItem Value="RuntimeType.Under as RuntimeType?">@Localize["Under"]</MudSelectItem>
                                    <MudSelectItem Value="RuntimeType.Beetween as RuntimeType?">@Localize["BeetWeen"]</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudTextField Margin="Margin.Dense" Variant="Variant.Filled"
                                              Label="@unit" For="()=>Category.FirstRunTimeValue"
                                              @bind-Value="Category.FirstRunTimeValue" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                @if (Category.RuntimeType == RuntimeType.Beetween)
                                {
                                    <MudTextField Margin="Margin.Dense" Variant="Variant.Filled"
                                                  Label="@unit" For="()=>Category.SecoundRunTimeValue"
                                                  @bind-Value="Category.SecoundRunTimeValue" />
                                }
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                }
                <MudItem xs="12" Class="m-2 mt-4">
                    <MudCheckBox T="bool" Size="Size.Small" @bind-Value="Category.StudentProject"
                                 Label="@Localize["Only Student Project"]" Color="Color.Secondary" />
                </MudItem>

                <MudItem xs="12" Class="m-2 mt-4">
                    <MudGrid>
                        <MudItem xs="12" md="3">
                            <MudSelect @bind-Value="Category.LocationType"
                                       Margin="Margin.Dense" For="@(() => Category.LocationType)"
                                       Clearable="true" T="LocationType?" Label="@Localize["Project Origin"]"
                                       Variant="Variant.Filled" AnchorOrigin="Origin.BottomCenter">

                                <MudSelectItem Value="LocationType.City as LocationType?">@Localize["City"]</MudSelectItem>
                                <MudSelectItem Value="LocationType.Country as LocationType?">@Localize["Country"]</MudSelectItem>
                                <MudSelectItem Value="LocationType.State as LocationType?">@Localize["StateProvince"]</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            @if (Category.LocationType is LocationType.State or LocationType.City)
                            {
                                <MudTextField Margin="Margin.Dense" Variant="Variant.Filled"
                                              Label="@Localize["Name"]" For="()=>Category.CityOrStateName"
                                              @bind-Value="Category.CityOrStateName" />
                            }
                            @if (Category.LocationType == LocationType.Country)
                            {
                                <MudAutocomplete T="int" Label="@Localize["Country"]"
                                                 Value="CountryId"
                                                 For="@(() => CountryId)"
                                                 ValueChanged="(t)=>SelectCountry(t)"
                                                 ResetValueOnEmptyText="true" SearchFunc="@SearchCountries"
                                                 Variant="Variant.Filled" Margin="Margin.Dense"
                                                 ToStringFunc="@(i => Countries.FirstOrDefault(b => b.Id == i)?.Name ?? string.Empty)"
                                                 OffsetY="true" />
                            }
                        </MudItem>
                        <MudItem xs="12" md="6">

                            @foreach (var item in Category.CountriesId)
                            {
                                var f = Countries.FirstOrDefault(p => p.Id == item);
                                <MudChip T="string" OnClose="@((t) => DeleteCountry(item))">@f.Name</MudChip>
                            }
                        </MudItem>
                    </MudGrid>
                </MudItem>
            </MudContainer>
        }
        <MudPaper Class="d-flex justify-end flex-grow-1 ">
            <MudPaper Class="mr-2 mb-2">
                <MudButtonGroup OverrideStyles="false">
                     @if (!IsAdmin)
                                    {
                                        <LoadingButton Processing="_processing" Variant="Variant.Filled"
                                                       ButtonType="ButtonType.Submit" Color="Color.Info">Save</LoadingButton>
                                    }
                                    <MudButton Variant="Variant.Filled" Color="Color.Inherit" OnClick="Cancel"> Cancel</MudButton>
                </MudButtonGroup>
            </MudPaper>
        </MudPaper>
    </EditForm>
