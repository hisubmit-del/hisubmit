@using HiSubmit.Client.SharedModels.Extensions
@inject IStringLocalizer<FestivalAdditionalSetting> Localize
<style>
    .text-danger{
        color:red
    }
</style>
<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h3">
                @Localize["Additional Settings"]
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @if (!_loaded)
        {
            <MudContainer MaxWidth="MaxWidth.Medium"
                          Style="height:300px">
                <Spinner></Spinner>
            </MudContainer>
        }
        else
        {
            <EditForm FormName="festival-additional-settings" EditContext="_editForm" OnSubmit="SaveAsync">
                <FluentValidationValidator @ref="_fluentValidationValidator"/>
                <ValidationSummary />
                @* <MudContainer MaxWidth="MaxWidth.Medium"> *@
                <MudGrid Class="py-0 py-md-5">
                    @if (!IsAdmin)
                    {
                        if (_model.FestivalStatus == FestivalStatus.UnderInvestigation)
                        {
                            <MudItem xs="12" Class="mb-2">
                                <MudAlert
                                    Severity="Severity.Warning">
                                    Your festival information is under review.
                                </MudAlert>
                            </MudItem>
                        }
                    }
                </MudGrid>
                <MudGrid Class="mt-3 px-0 px-md-20 px-lg-20">
                    <MudItem xs="12" md="2" Class="d-flex align-content-center flex-wrap"> 
                        <MudText Typo="Typo.subtitle2">
                            @Localize["search Terms"]:
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" md="8" Class="mb-2">
                        <MudTextField @bind-Value="_model.SearchTerms"
                                      For="@(() => _model.SearchTerms)"
                                      Variant="Variant.Filled"
                                      Margin="Margin.Dense"/>
                    </MudItem>
                    <MudItem xs="12"/>
                    <MudItem xs="12" md="2">
                        <MudText Typo="Typo.subtitle2">
                            @Localize["Category Search"]:
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" md="10">
                        <MudPaper Square="true" Elevation="0">
                            <MudGrid>
                                @foreach (var artCat in _artCategoryList)
                                {
                                    <MudItem xs="6" md="4">
                                        <MudCheckBox T="bool" Dense="true" Size="Size.Small"
                                                     Value="@artCat.IsSelected"
                                                     ValueChanged="(t) => CheckCatValidate(t, artCat)"
                                                     Color="Color.Default">
                                            @artCat.Name
                                        </MudCheckBox>
                                    </MudItem>
                                }
                            </MudGrid>
                            <ValidationMessage class="text-danger p-2"
                            For="() => _model.FestivalArtCategoriesId"/>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12"/>
                    @*<MudDivider Style="margin:20px" />*@
                    <MudItem xs="12" md="2" Style="margin-top:20px;">
                        <MudText Typo="Typo.subtitle2">
                            @Localize["festival Focus:"]
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" md="10" Style="margin-top:20px;">
                        <MudPaper Square="true" Elevation="0">
                            <MudGrid>
                                @foreach (var focus in _festivalFocusList)
                                {
                                    <MudItem xs="6" md="4">
                                        <MudCheckBox T="bool" Dense="true"
                                                     Size="Size.Small"
                                                     Value="@focus.IsSelected"
                                                     ValueChanged="(t) => CheckFocusValidate(t, focus)"
                                                     Color="Color.Default">
                                            @focus.Name
                                        </MudCheckBox>
                                    </MudItem>
                                }
                            </MudGrid>
                            <ValidationMessage class="text-danger p-2"
                            For="() => _model.FestivalFestivalFociId"/>
                        </MudPaper>
                    </MudItem>


                    <MudItem xs="12" md="2" Class="mt-3">
                        <MudText Typo="Typo.subtitle2">
                            @Localize["RunTime Search"]:
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" md="10"  Class="mt-3">
                        <MudGrid>
                            <MudItem xs="12" md="6" lg="4">
                                <MudSwitch T="bool" Size="Size.Medium"
                                           For="() => _model.AllLenghtAccepted"
                                           @bind-Value="_model.AllLenghtAccepted"
                                           Label="@Localize["All length Accepted"]"
                                           Color="Color.Secondary"/>
                            </MudItem>
                            @if (!_model.AllLenghtAccepted)
                            {
                                <MudItem xs="12" md="6" lg="3">
                                    <MudNumericField @bind-Value="_model.MinimomLenght"
                                                     T="int?"
                                                     For="@(() => _model.MinimomLenght)"
                                                     Label="@Localize["Minimum(Minutes)"]"
                                                     Variant="Variant.Filled"
                                                     Margin="Margin.Dense"/>
                                </MudItem>
                                <MudItem xs="12" md="6" lg="3">
                                    <MudNumericField @bind-Value="_model.MaximomLenght"
                                                     T="int?"
                                                     For="@(() => _model.MaximomLenght)"
                                                     Label="@Localize["Maximum(Minutes)"]"
                                                     Variant="Variant.Filled"
                                                     Margin="Margin.Dense"/>
                                </MudItem>
                            }
                        </MudGrid>
                    </MudItem>

                    <MudItem xs="12" md="2" Class="mt-3 d-flex align-content-center flex-wrap">
                        <MudText Typo="Typo.subtitle2">
                            @Localize["Listening URl"]:
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" md="10" Class="mt-3">
                        <MudGrid>
                            <MudItem xs="6" md=4>
                                <MudTextField @bind-Value="_model.URL" Label="@Localize["URL"]"
                                              For="@(() => _model.URL)" 
                                              Variant="Variant.Filled"
                                              Margin="Margin.Dense"
                                              Disabled="@(!(IsAdmin || string.IsNullOrWhiteSpace(_model.URL)))"
                                              TextChanged="@((string val) => HandleURLChange(val))" />
                            </MudItem>
                            <MudItem xs="6" md="4">
                                <br/>
                                @if (string.IsNullOrWhiteSpace(_model.URL))
                                {
                                    <MudText Typo="Typo.inherit">HiSubmit.com/</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.inherit">HiSubmit.com/@(_model.URL.TrimAll())</MudText>
                                }
                            </MudItem>
                        </MudGrid>
                    </MudItem>

                    <MudItem xs="12" md="2">
                        <MudText Typo="Typo.subtitle2">
                            @Localize["Listing Visibility"]:
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" md="10">
                        <MudItem xs="12" md="6" Style="margin-bottom:2px">
                            <MudSwitch T="bool" Class="ml-2" Size="Size.Medium" @bind-Value="_model.Public"
                                       For="() => _model.Public" Label="@Localize["Public"]"
                                       Color="Color.Secondary"/>
                        </MudItem>
                    </MudItem>

                    <MudItem xs="12" md="2" Class="mt-3">
                        <MudText Typo="Typo.subtitle2">
                            @Localize["Automatic workflows"]:
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" md="10" Class="mt-3">
                        <MudStack Spacing="1">
                            <MudSwitch T="bool"
                                       @bind-Value="_model.EnableAutomaticSelectionNews"
                                       For="() => _model.EnableAutomaticSelectionNews"
                                       Color="Color.Secondary"
                                       Label="@Localize["Publish official selection news on Notification Date"]"/>
                            <MudText Typo="Typo.caption" Class="ml-2">
                                @Localize["Creates one public news item with selected, finalist and award-winning works."]
                            </MudText>
                            <MudSwitch T="bool"
                                       @bind-Value="_model.EnableAutomaticPeriodCreation"
                                       For="() => _model.EnableAutomaticPeriodCreation"
                                       Color="Color.Secondary"
                                       Label="@Localize["Create the next festival period automatically"]"/>
                            <MudText Typo="Typo.caption" Class="ml-2">
                                @Localize["Clones this period after Event End Date and moves its dates one year forward."]
                            </MudText>
                        </MudStack>
                    </MudItem>

                    <MudItem xs="12" md="2" Class="d-flex align-content-center flex-wrap">
                        <MudText Typo="Typo.subtitle2">
                            @Localize["Tracking Sequence"]:
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" md="10">
                        <MudGrid>
                            <MudItem xs="5" md="4" lg="3">
                                <MudTextField @bind-Value="_model.Prefix"
                                              T="string"
                                              Label="@Localize["prefix"]" Immediate="true"
                                              For="@(() => _model.Prefix)" Variant="Variant.Filled"
                                              Margin="Margin.Dense"/>
                            </MudItem>
                            <MudItem xs="5" md="4" lg="3">
                                <MudTextField @bind-Value="_model.StartingNumber"
                                              T="int"
                                              Label="@Localize["starting number"]" Immediate="true"
                                              For="@(() => _model.StartingNumber)"
                                              Variant="Variant.Filled" Margin="Margin.Dense"/>
                            </MudItem>
                            <MudItem xs="2" md="2" lg="3">
                                <br/>
                                @($"{_model.Prefix}{_model.StartingNumber}")
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                </MudGrid>
                @* </MudContainer> *@

                <div Class="d-flex justify-end flex-grow-1 ">
                    <div Class="mr-2 mb-2">
                        <MudButtonGroup OverrideStyles="false">
                            @if (!IsAdmin)
                            {

                                <ResponsiveButton Variant="Variant.Filled"
                                                  OnClick="GoPrev" ButtonType="ButtonType.Submit"
                                               StartIcon="@Icons.Material.Filled.ArrowLeft" Color="Color.Secondary"
                                              >
                                    @Localize["Prev"]
                                </ResponsiveButton>
                                <ResponsiveButton Variant="Variant.Filled" Disabled="_model.ChangesNotAllowed"
                                               ButtonType="ButtonType.Submit"
                                               StartIcon="@Icons.Material.Filled.Save" Color="Color.Info"
                                               Processing="_processing">
                                    @Localize["Save"]
                                </ResponsiveButton>
                                if (_model.FestivalStatus == FestivalStatus.UnderInvestigation)
                                {
                                    <ResponsiveButton Processing="ReleasProcessing"
                                                   Size="Size.Small"
                                                   Variant="Variant.Filled" Color="Color.Primary"
                                                   OnClick="ReleaseFestival">
                                        @Localize["Release festival"]
                                    </ResponsiveButton>
                                }
                            }
                        </MudButtonGroup>
                    </div>
                </div>
            </EditForm>
        }
    </MudCardContent>
</MudCard>

