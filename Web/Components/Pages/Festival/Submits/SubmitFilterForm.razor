@using HiSubmit.Client.SharedModels.Extensions
@inject IStringLocalizer<SubmitFilterForm> Localize

    <MudContainer MaxWidth="MaxWidth.Large">
<EditForm Model="@Model">
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudTextField T="string" Margin="Margin.Dense" Label="@Localize["Project"]"
                          Variant="Variant.Text" @bind-Value="@Model.ProjectTitle">
            </MudTextField>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField T="string" Margin="Margin.Dense" Label="@Localize["Tracking Code"]"
                          Variant="Variant.Text" @bind-Value="@Model.TrackingCode">
            </MudTextField>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudDatePicker Margin="Margin.Dense" Rounded="true" Label="@Localize["Submit Date From"]"
                           Variant="Variant.Text" Editable="true" @bind-Date="@Model.SubmitDateFrom"/>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudDatePicker Margin="Margin.Dense" Rounded="true" Label="@Localize["Submit Date To"]"
                           Variant="Variant.Text" Editable="true" @bind-Date="@Model.SubmitDateTo"/>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudSelect T="JudgingStatus?" @bind-Value="Model.JudgingStatus" Label="@Localize["Judging result"]"
                       Variant="Variant.Text">
                <MudSelectItem Value="@(null as JudgingStatus?)">@Localize["All Enable"]</MudSelectItem>
                @foreach (JudgingStatus? status in Enum.GetValues(typeof(JudgingStatus)))
                {
                    <MudSelectItem Value="@(status as JudgingStatus?)">@status.ToDisplay()</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudSelect T="SubmitStatus?" @bind-Value="Model.SubmitStatus" Label="@Localize["Submission  Enable"]"
                       Variant="Variant.Text">
                <MudSelectItem  Value="@(null as SubmitStatus?)">@Localize["All Enable"]</MudSelectItem>
                @foreach (SubmitStatus? status in Enum.GetValues(typeof(SubmitStatus)))
                {
                    <MudSelectItem Value="@(status as SubmitStatus?)">@status.ToDisplay()</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12">
            <div class="d-flex justify-end">
                  <MudButton ButtonType="ButtonType.Button"
                                       OnClick="Serach"
                                       Variant="Variant.Filled" Color="Color.Info"
                                       EndIcon="@Icons.Material.Filled.Search">
                                Search
                            </MudButton>
                            @* <MudButton ButtonItemType="ButtonItemType.Reset" OnClick="CancelSearch" Variant="Variant.Filled">@Localize["Cancel"]</MudButton> *@
            </div>
        </MudItem>
    </MudGrid>
</EditForm>
</MudContainer>
