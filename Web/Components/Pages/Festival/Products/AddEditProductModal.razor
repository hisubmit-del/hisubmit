@using HiSubmit.Client.SharedModels.Extensions
@inject IStringLocalizer<AddEditProductModal> Localize

<EditForm Model="@AddEditProductModel" OnValidSubmit="SaveAsync">
    <FluentValidationValidator @ref="_fluentValidationValidator"/>
    <MudDialog>
        <TitleContent>
            @{
                if (AddEditProductModel.Id == 0)
                {
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-3 mb-n1"/>
                        @Localize["Add Product"]
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Update" Class="mr-3 mb-n1"/>
                        @Localize["Update Product"]
                    </MudText>
                }
            }
        </TitleContent>
        <DialogContent>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField For="@(() => AddEditProductModel.Name)" Variant="Variant.Filled"
                                  @bind-Value="AddEditProductModel.Name" Label="@Localize["Name"]"/>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField For="@(() => AddEditProductModel.Price)"
                                  Variant="Variant.Filled" @bind-Value="AddEditProductModel.Price" Label="@Localize["Price"]"/>
                </MudItem>

                <MudItem xs="12" md="12">
                    <MudTextField For="@(() => AddEditProductModel.Description)" Variant="Variant.Filled" Lines="3"
                                  @bind-Value="AddEditProductModel.Description"
                                  Label="@Localize["Description"]"/>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect @bind-Value="AddEditProductModel.ProductType"
                               For="@(() => AddEditProductModel.ProductType)" Margin="Margin.Dense"
                               T="ProductType" Label="Product type"
                               Variant="Variant.Filled" AnchorOrigin="Origin.BottomCenter">

                        @foreach (ProductType productType in Enum.GetValues<ProductType>())
                        {
                            <MudSelectItem Value="productType">@productType.ToDisplay()</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudItem>
                        <MudAvatar Image="@(AddEditProductModel.ImageDataURL)" Square="true"
                                   Style="height: auto; width: auto; max-height: 100%">
                        </MudAvatar>
                    </MudItem>
                    <MudItem>
                        <InputFile id="fileInput" hidden OnChange="UploadFiles"/>
                        <div>
                            <MudButton HtmlTag="label"
                                       Variant="Variant.Text"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.CloudUpload"
                                       for="fileInput">
                                @Localize["Upload"]
                            </MudButton>
                            @if (!string.IsNullOrEmpty(AddEditProductModel.ImageDataURL))
                            {
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Info"
                                           StartIcon="@Icons.Material.Filled.RemoveRedEye"
                                           Size="Size.Small"
                                           Link="@(AddEditProductModel.ImageDataURL)" Target="_blank">
                                    @Localize["View"]
                                </MudButton>
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Error"
                                           StartIcon="@Icons.Material.Filled.Delete"
                                           Size="Size.Small"
                                           OnClick="DeleteAsync">
                                    @Localize["Delete"]
                                </MudButton>
                            }
                        </div>
                    </MudItem>
                </MudItem>
            </MudGrid>
        </DialogContent>
        <DialogActions>
            <MudButton DisableElevation Variant="Variant.Filled" OnClick="Cancel">@Localize["Cancel"]</MudButton>
            @if (AddEditProductModel.Id != 0)
            {
                <LoadingButton Processing="_processing" DisableElevation Variant="Variant.Filled"
                               ButtonType="ButtonType.Submit" Disabled="@(!Validated)" Color="Color.Secondary">
                    @Localize["Update"]
                </LoadingButton>
            }
            else
            {
                <LoadingButton Processing="_processing" DisableElevation Variant="Variant.Filled"
                               ButtonType="ButtonType.Submit" Disabled="@(!Validated)" Color="Color.Success">
                    @Localize["Save"]
                </LoadingButton>
            }
        </DialogActions>
    </MudDialog>
</EditForm>
