@page "/faq"
@using Hisubmit.Client.SharedModels.Features.StaticPages.Commands
@inherits BasePublicPages
<SeoMetaTags PageId="0" PageType="@PageType.FAQ" />
@if (_loaded)
{
    <MudContainer MaxWidth="MaxWidth.Large">
        <div class="news-top ">
            <img src="/media/FAQ.png" alt="faq-page"/>
            <MudCard Class="pa-1 pa-md-3 news-desc">
                <MudCardContent>
                    <MudChip T="string" Variant="Variant.Text" Color="Color.Info">HiSubmit</MudChip>
                         
                    <MudText Typo="Typo.h5">
                        You can find your answer here,we tried to document everything  and easy to find
                    </MudText>
                </MudCardContent>
                <MudCardActions>
                    @*    <MudAvatar>
                                <MudImage Src="@(string.IsNullOrWhiteSpace(n.FestivalLogoURL)?ClientAppConstants.SmallLogoUrl :n.FestivalLogoURL)"></MudImage>
                            </MudAvatar>
                            <MudText Inline="true" Typo="Typo.body2" Class="ml-1" Color="Color.Default">@(string.IsNullOrWhiteSpace(n.FestivalName) ? "Admin" : n.FestivalName)</MudText>
                            <MudSpacer />
                            <MudText Inline="true" Typo="Typo.body2" Color="Color.Default">@n.CreatedOn.ToLongDateString()</MudText> *@
                </MudCardActions>
            </MudCard>
        </div>

            <MudGrid Justify="Justify.Center"
                     class="festival-key-search-box text-center justify-center px-lg-14 px-2 my-10">
                <MudItem xs="12" md="6" xl="5">
                    <MudTextField DebounceInterval="500"
                                  @bind-Value="@SearchString"
                                  @onkeypress="Search"
                                  Variant="Variant.Outlined"                                 
                                  Adornment="Adornment.End"       
                                  OnAdornmentClick="Search"
                                  AdornmentColor="Color.Surface"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
            </MudGrid>

            <MudGrid>
                <MudText Typo="Typo.h1"
                         Class="align-self-start  news-title  flex-1 my-3  my-md-8">
                  Get your answers and learned how hiSubmit works 
                </MudText>

            </MudGrid>

        @if (_faqResponse.Data.Any(p => p.FaqType == FaqType.General))
        {
            <MudText Typo="Typo.h3" Class="my-4 mt-md-18 mb-md-12">General frequently Asked questions</MudText>

            <MudGrid Class="faq-box">
                <MudItem xs="12" md="6" Class="right order-2 order-md-1">
                    @{
                        var selected = _faqResponse.Data
                            .FirstOrDefault(p => p.FaqType == FaqType.General && p.IsSelected);
                        @if (selected != null)
                        {
                            <MudText Typo="Typo.subtitle2">
                                @selected.Title
                            </MudText>
                            <p lass="mt-2">
                                @selected.Content
                            </p>
                        }
                    }
                </MudItem>
                <MudItem xs="12" md="6" Class="left order-1 order-md-2">
                    <MudPaper>
                        @foreach (var d in _faqResponse.Data.Where(p => p.FaqType == FaqType.General))
                        {
                            <div class="my-2">
                                <button class="w-100" @onclick="@(() => SetSelect(d))">
                                    <MudGrid Class="my-2 left-item d-flex flex-grow-1 gap-2 ">
                                        <MudAvatar Color="Color.Tertiary"></MudAvatar>
                                        <MudText  Class="flex-1" Align="Align.Start" Typo="Typo.subtitle2">
                                            @d.Title
                                        </MudText>
                                        <MudIcon Class="" Icon="@Icons.Material.Filled.ChevronRight"></MudIcon>
                                    </MudGrid>
                                </button>
                            </div>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>

        }
        @if (_faqResponse.Data.Any(p => p.FaqType == FaqType.Festival))
        {
            <MudText Typo="Typo.h3" Class="my-4 mt-md-18 mb-md-12">Festivals frequently Asked questions</MudText>

            <MudGrid Class="faq-box">
                <MudItem xs="12" md="6" Class="right order-2 order-md-1">
                    @{
                        var selected = _faqResponse.Data
                            .FirstOrDefault(p => p.FaqType == FaqType.Festival && p.IsSelected);
                        @if (selected != null)
                        {
                            <MudText Typo="Typo.subtitle2">
                                @selected.Title
                            </MudText>
                            <p lass="mt-2">
                                @selected.Content
                            </p>
                        }
                    }
                </MudItem>
                <MudItem xs="12" md="6" Class="left order-1 order-md-2">
                    <MudPaper>
                        @foreach (var d in _faqResponse.Data.Where(p => p.FaqType == FaqType.Festival))
                        {
                            <div  class="my-2">
                                <button class="w-100" @onclick="@(() => SetSelect(d))">
                                    <MudGrid Class="my-2 left-item d-flex flex-grow-1 gap-2 ">
                                        <MudAvatar Color="Color.Tertiary"></MudAvatar>
                                        <MudText  Class="flex-1" Align="Align.Start" Typo="Typo.subtitle2">
                                            @d.Title
                                        </MudText>
                                        <MudIcon Class="" Icon="@Icons.Material.Filled.ChevronRight"></MudIcon>
                                    </MudGrid>
                                </button>
                            </div>
                        }

                    </MudPaper>
                </MudItem>
            </MudGrid>

        }
        @if (_faqResponse.Data.Any(p => p.FaqType == FaqType.Artist))
        {
            <MudText Typo="Typo.h3" Class="my-4 mt-md-18 mb-md-12">Artists frequently Asked questions</MudText>
            <MudGrid Class="faq-box">
                <MudItem xs="12" md="6" Class="right order-2 order-md-1">
                    @{
                        var selected = _faqResponse.Data
                            .FirstOrDefault(p => p.FaqType == FaqType.Artist && p.IsSelected);
                        @if (selected != null)
                        {
                            <MudText Typo="Typo.subtitle2">
                                @selected.Title
                            </MudText>
                            <p lass="mt-2">
                                @selected.Content
                            </p>
                        }
                    }
                </MudItem>
                <MudItem xs="12" md="6" Class="left order-1 order-md-2">
                    <MudPaper>
                            @foreach (var d in _faqResponse.Data.Where(p => 
                                          p.FaqType == FaqType.Artist))
                            {
                                <div  class="my-2">
                                    <button class="w-100" @onclick="@(() => SetSelect(d))">
                                        <MudGrid Class="my-2 left-item d-flex flex-grow-1 gap-2 ">
                                                <MudAvatar Color="Color.Tertiary"></MudAvatar>
                                                <MudText  Class="flex-1" Align="Align.Start" Typo="Typo.subtitle2">
                                                    @d.Title
                                                </MudText>
                                                <MudIcon Class="" Icon="@Icons.Material.Filled.ChevronRight"></MudIcon>
                                        </MudGrid>
                                    </button>
                                </div>
                            }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }
    </MudContainer>
}