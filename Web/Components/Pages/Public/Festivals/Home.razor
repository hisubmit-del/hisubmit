@page "/"
@page "/festivals"
@page "/festivals/{PageNumber:int}"

@using global::Hisubmit.Client.SharedModels.Features.AdminFestival.Queries.GetAllFestival
@using HiSubmit.Client.SharedModels.Extensions
@using Web.Components.Shared.Components.ICons
@inject  IHttpContextAccessor HttpContextAccessor
@inherits BasePublicPages
@inject IStringLocalizer<Home> Localize


<style>
    .mud-table-container {
        overflow: auto;
    }
</style>

<SeoMetaTags PageId="0" PageType="@PageType.HomePage" OgImageUrl="https://hisubmit.com/media/logo/1.JPG" />

<div class="festival-header festival-hero home-hero">
    <div class="home-hero__content">
        <span class="festival-eyebrow">A calmer way to enter, judge and discover</span>
        @if (HttpContextAccessor.IsPrerendering())
        {
            <h1 class="mud-typography mud-typography-h1">
                HiSubmit online submission platform
            </h1>
        }
        else
        {
            <h1 class="mud-typography mud-typography-h1">
                HiSubmit online submission platform
            </h1>
        }
        <p class="home-hero__copy">
            Find the right festival for your work, follow every deadline and keep your creative journey in one organised place.
        </p>
        <div class="home-hero__actions">
            <a class="home-hero__primary" href="#festival-browser">Explore festivals</a>
            <a class="home-hero__secondary" href="/register">Join HiSubmit</a>
        </div>
    </div>
    <div class="home-hero__visual" aria-hidden="true">
        <span class="home-hero__orb home-hero__orb--large"></span>
        <span class="home-hero__orb home-hero__orb--small"></span>
        <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" />
    </div>
</div>

<MudContainer Class="festival-browser-page" id="festival-browser">
    <div class="mud-grid mud-grid-spacing-xs-6 justify-center festival-key-search-box text-center justify-center px-lg-14 px-2">
        <div class="mud-grid-item mud-grid-item-xs-12 mud-grid-item-md-6 mud-grid-item-xl-5">

            <MudTextField DebounceInterval="500"
                          Class="@(!HttpContextAccessor.IsPrerendering()?"animate__animated animate__backInDown":"")"
                          @bind-Value="@_advancedSearch.SearchString"
                          Variant="Variant.Outlined"
                          Placeholder="Search among the best content in the world"
                          Adornment="Adornment.End"
                          AdornmentColor="Color.Surface"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
        </div>
    </div>

    <div class="festival-section-intro">
        <div>
            <span class="festival-eyebrow">Discover your next opportunity</span>
            <h2 class="sponsored-festival-title">Featured festivals</h2>
        </div>
        <span class="festival-section-note">Curated competitions for ambitious artists</span>
    </div>

    <div class="mud-grid mud-grid-spacing-xs-3 justify-start festival-sponsored-box">
        @if (_loaded)
        {
            var max = 4;
            if (_pagedData.Count() < 4)
                max = _pagedData.Count();

            for (int i = 0; i < max; i++)
            {
                var festival = _pagedData.ToArray()[i];
                <a class="mud-grid-item mud-grid-item-xs-6 mud-grid-item-lg-3 festival-featured-tile img-box text-center"
                   href="@($"/festival/{festival.URL}")"
                   aria-label="View @festival.Name">
                    <div class="festival-featured-tile__media">
                        <span class="festival-featured-tile__fallback">@festival.Name</span>
                        <img alt="@festival.Name"
                             src="@festival.LogoURL"
                             loading="lazy"
                             onerror="this.style.display='none';" />
                    </div>

                    <span class="mud-button-root mud-button mud-button-outlined mud-button-outlined-tertiary mud-button-outlined-size-medium mud-ripple btn-view-festival">
                        <span class="mud-button-label">View festival</span>
                    </span>

                </a>
            }
        }
    </div>

    <MudForm FieldChanged="@(() => OnSearchElapsed(this, null))" Model="_advancedSearch">
        <div class="festival-filter-panel">
            <div class="festival-filter-heading">
                <div>
                    <span class="festival-eyebrow">Refine your search</span>
                    <h2>Find the right festival</h2>
                </div>
                <div class="festival-filter-toolbar">
                    <span class="festival-filter-count">
                        @if (_loaded && _festivalResponse is not null)
                        {
                            @_festivalResponse.TotalCount <span>opportunities</span>
                        }
                    </span>
                    @if (ActiveFilterCount > 0)
                    {
                        <MudChip T="string" Color="Color.Tertiary" Variant="Variant.Outlined" Size="Size.Small">
                            @ActiveFilterCount active filters
                        </MudChip>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Dark"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.RestartAlt"
                                   OnClick="ResetFilters">
                            Clear filters
                        </MudButton>
                    }
                </div>
            </div>
            <div class="mud-grid mud-grid-spacing-xs-6 justify-start festival-filter-form">
            <div class="mud-grid-item mud-grid-item-xs-12 mud-grid-item-md-6 mud-grid-item-lg-3 mud-grid-item-xxl-3">
                <p class="mud-typography mud-typography-subtitle1 ">
                    Sort By:
                </p>
                <MudSelect T="string"
                           Margin="Margin.Dense"
                           Variant="Variant.Outlined"
                           @bind-Value="@_advancedSearch.Orderby[0]"
                           Placeholder="relevance"
                           AnchorOrigin="Origin.BottomCenter">

                    <MudSelectItem Value="@("MinFee")">Fee</MudSelectItem>
                    <MudSelectItem Value="@("OpeningDate")">Opening Date</MudSelectItem>
                    <MudSelectItem Value="@("YearsRunning")">Years Running</MudSelectItem>
                </MudSelect>
            </div>
            <div class="mud-grid-item mud-grid-item-xs-12 mud-grid-item-md-6 mud-grid-item-lg-3">
                <p class="mud-typography mud-typography-subtitle1 ">
                    Competition ItemType:
                </p>
                @* <MudText Typo="Typo.subtitle1">Competition ItemType:</MudText> *@
                <MudSelect T="FestivalType?" Class="competition-selector"
                           Placeholder="competition type"
                           Margin="Margin.Dense"
                           @bind-Value="@_advancedSearch.FestivalType"
                           Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem T="FestivalType?" Value="null">Select type</MudSelectItem>
                    @foreach (var fs in Enum.GetValues<FestivalType>())
                    {
                        <MudSelectItem T="FestivalType?" Value="@fs">@fs.ToDisplay()</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div class="mud-grid-item mud-grid-item-xs-12 mud-grid-item-md-6 mud-grid-item-lg-3">
                <p class="mud-typography mud-typography-subtitle1 ">
                    Event Date before:
                </p>
                @* <MudText Typo="Typo.subtitle1"> Event Date before:</MudText> *@
                <MudDatePicker Editable="true" @bind-Date="@_advancedSearch.EventDateTo"
                               Class="mt-0"
                               Margin="Margin.Dense"
                               Clearable="true"
                               Variant="Variant.Outlined"
                               Mask="@(new DateMask("dd.MM.yyyy"))"
                               DateFormat="dd.MM.yyyy" Placeholder="de-AT Date" />
            </div>

            <div class="mud-grid-item mud-grid-item-xs-12 mud-grid-item-md-6 mud-grid-item-lg-3
    open-only-box d-flex align-content-end flex-wrap flex-grow-1 gap-1">

                <MudPaper Elevation="0"
                          Class="d-flex align-content-end flex-wrap flex-grow-1 gap-4"
                          Width="100% " Style="background-color: transparent">

                    <p class="mud-typography mud-typography-subtitle1 d-inline pt-2">
                        Open Only
                    </p>
                    @* <MudText Inline="true" Typo="Typo.subtitle1" Class="pt-2">Open Only</MudText> *@
                    <MudSwitch T="bool"
                               Size="Size.Small"
                               @bind-Value="@_advancedSearch.OpenOnly"
                               Color="Color.Tertiary" />
                </MudPaper>
            </div>

            <div class="mud-grid-item mud-grid-item-xs-12 mud-grid-item-md-6 mud-grid-item-lg-3">
                <p class="mud-typography mud-typography-subtitle1 ">
                    festival Focus:
                </p>
                @* <MudText Typo="Typo.subtitle1">festival Focus:</MudText> *@
                <MudSelect T="int?"
                           @bind-Value="@_advancedSearch.Focus"
                           Variant="Variant.Outlined"
                           Placeholder="All Focus"
                           Margin="Margin.Dense"
                           AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="@(null as int?)">All Focus</MudSelectItem>
                    @foreach (var focus in _focuses)
                    {
                        <MudSelectItem Value="@(focus.Id as int?)">@focus.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div class="mud-grid-item mud-grid-item-xs-12 mud-grid-item-md-6 mud-grid-item-lg-3">
                <p class="mud-typography mud-typography-subtitle1 ">
                    Category:
                </p>
                @* <MudText Typo="Typo.subtitle1">Category:</MudText> *@
                <MudSelect T="int?" Class="competition-selector"
                           Placeholder="All Category"
                           Margin="Margin.Dense"
                           @bind-Value="@_advancedSearch.Category"
                           Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                    <MudSelectItem Value="@(null as int?)">All Category</MudSelectItem>
                    @foreach (var cat in _artCategories)
                    {
                        <MudSelectItem Value="@(cat.Id as int?)">@cat.Name</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div class="mud-grid-item mud-grid-item-xs-12 mud-grid-item-md-6 mud-grid-item-lg-3">

                <p class="mud-typography mud-typography-subtitle1 ">
                    Deadline before:
                </p>


                <MudDatePicker Editable="true" @bind-Date="@_advancedSearch.EntryDeadlineTo"
                               Class="mt-0"
                               Margin="Margin.Dense"
                               Clearable="true"
                               Variant="Variant.Outlined"
                               Mask="@(new DateMask("dd.MM.yyyy"))"
                               DateFormat="dd.MM.yyyy" Placeholder="de-AT Date" />
            </div>

            <div class="mud-grid-item mud-grid-item-xs-12 mud-grid-item-md-6 mud-grid-item-lg-3
                        open-only-box d-flex align-content-end flex-wrap flex-grow-1 gap-1">
                <MudPaper Elevation="0"
                          Class="d-flex align-content-end flex-wrap flex-grow-1 gap-4"
                          Width="100% " Style="background-color: transparent">

                    <p class="mud-typography mud-typography-subtitle1 d-inline  pt-2">
                        Ticket Only
                    </p>
                    <MudSwitch T="bool"
                               Size="Size.Small"
                               @bind-Value="@_advancedSearch.TicketOnly"
                               Color="Color.Tertiary" />
                </MudPaper>
                @if (_loaded)
                {
                }
            </div>

            <div class="mud-grid-item mud-grid-item-xs-12  mud-grid-item-lg-6  px-12">
                <p class="mud-typography mud-typography-subtitle1  mb-9">
                    Fee
                </p>
                <CustomeSlider Id="FeeSlider"
                               MinVal="@_advancedSearch.FeeMinVal"
                               MaxVal="@_advancedSearch.FeeMaxVal"
                               MinValChanged="i => ChangeFeeMinVal(i)"
                               MaxValChanged="i => ChangeFeeMaxVal(i)"
                               Min="0" Max="200" Step="10">
                </CustomeSlider>
            </div>
            <div class="mud-grid-item mud-grid-item-xs-12  mud-grid-item-lg-6 px-12">
                <p class="mud-typography mud-typography-subtitle1  mb-9">
                    Years Running
                </p>
                <CustomeSlider Id="yearsRunningSlider"
                               MinVal="@_advancedSearch.YearsRunningMinVal"
                               MaxVal="@_advancedSearch.YearsRunningMaxVal"
                               MinValChanged="i => ChangeYearMinVal(i)"
                               MaxValChanged="i => ChangeYearMaxVal(i)"
                               Min="1" Max="20" Step="1">
                </CustomeSlider>
            </div>
            </div>
        </div>
    </MudForm>
    <div class="festival-results-heading">
        <div>
            <span class="festival-eyebrow">Open calls</span>
            <h2>Explore festivals</h2>
        </div>
        <span class="festival-results-hint">Use the filters above to narrow your creative search.</span>
    </div>
    <div class="mud-grid mud-grid-spacing-xs-6 justify-start mt-10 festival-cards festival-results-grid">
        @if (_loaded)
        {
            if (_pagedData != null && _pagedData.Any())
            {
                foreach (var item in _pagedData)
                {
                    <div class="mud-grid-item mud-grid-item-xs-12  mud-grid-item-lg-4">
                        <MudCard class="@(item.FeeStatus == FeeStatus.Special ? "festival-card bg-Gold" : "festival-card")"
                                 @onclick="@(() => GoToFestivalDetail(item.URL))"
                                 Style="cursor:pointer"
                                 role="link"
                                 tabindex="0">
                            <MudCardContent>
                                <div style="height: 220px" class="d-flex  flex-grow-1 gap-4 justify-center d-relative ">
                                    <img src="@item.LogoURL" alt="@item.Name" loading="lazy" class="align-self-center" style="max-width: 100%;max-height: 100%" />
                                    @if (item.SelectedQualifiersId != null && item.SelectedQualifiersId.Any())
                                    {
                                        var qualify =
                                        Qualifiers.FirstOrDefault(p => p.Id == item.SelectedQualifiersId.First());
                                        if (qualify != null)
                                        {
                                            <img src="@qualify.LogoName" alt="@qualify.Name" class="img-qualify" />
                                        }
                                    }
                                </div>
                                <div class="d-flex justify-space-between flex-grow-1 gap-1 mt-2">
                                    <h5 class="mud-typography mud-typography-h5 d-inline h-4em">
                                        @item.Name
                                        @if (item.FeeStatus == FeeStatus.Special)
                                        {
                                            <IGold Title="Special festival" Height="25px" Width="25px" />
                                        }
                                    </h5>
                                    @* <MudText Inline="true" Typo="Typo.h5" Class="h-4em"> @item.Name</MudText> *@
                                    @* <MudChip T="string" Variant="Variant.Text" Color="Color.Dark" Label="true">@item.YearsRunning years</MudChip> *@
                                </div>
                                <p class="mud-typography mud-typography-subtitle2 h-2em mt-5 ">
                                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Class="mr-1 .mb-m-6" />
                                    @if (item.Address != null)
                                    {
                                        @item.Address.ToString()
                                    }
                                </p>
                                @*  <MudText Typo="Typo.subtitle2" Class="mt-5 h-2em">
                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Class="mr-1 .mb-m-6" />
                    @if (item.Address != null)
                    {
                    @item.Address.ToString()
                    }
                    </MudText> *@
                                <p class="mud-typography mud-typography-subtitle2 h-2em mt-3 ">
                                    <MudIcon Icon="@Icons.Material.Filled.DateRange" Class="mr-1 .mb-m-6" />
                                    Next deadline: @item.NearDeadline.ToLongDate()
                                </p>

                                @*  <MudText Typo="Typo.subtitle2" Class="mt-3 h-2em">
                    <MudIcon Icon="@Icons.Material.Filled.DateRange" Class="mr-1 .mb-m-6" />
                    Next deadline: @item.NearDeadline.ToLongDate()
                    </MudText> *@
                                <div class="d-flex justify-space-between h-3em">
                                    <MudText Typo="Typo.subtitle2" Class="mt-3 ">
                                        <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Class="mr-1 .mb-m-6" />
                                        @if (item.MinFee != null)
                                        {
                                            @item.MinFee?.ToString("C2")
                                        }
                                    </MudText>
                                </div>
                            </MudCardContent>
                            <MudCardActions Class="d-flex justify-space-around flex-grow-1 gap-1 mt-2">
                                @switch (item.FestivalDateStatus)
                                {
                                    case FestivalDateStatus.Submit:
                                        <div @onclick:stopPropagation="true">
                                            <MudButton Variant="Variant.Filled"
                                                       OnClick="@(() => Submit(item.Id))"
                                                       Color="Color.Tertiary">
                                                Submit now
                                            </MudButton>
                                        </div>
                                        break;
                                    case FestivalDateStatus.Closed:
                                        <MudButton Variant="Variant.Outlined"
                                                   Disabled="true" Color="Color.Dark">
                                            Closed
                                        </MudButton>
                                        break;
                                    case FestivalDateStatus.OpenSoon:
                                        <MudButton Variant="Variant.Outlined"
                                                   Disabled="true" Color="Color.Dark">
                                            Open Soon
                                        </MudButton>
                                        break;
                                }
                                <div @onclick:stopPropagation="true">
                                    <MudButton Variant="Variant.Outlined"
                                               OnClick="@(() => GoToFestivalDetail(item.URL))"
                                               Color="Color.Dark">
                                        View festival
                                    </MudButton>
                                </div>
                            </MudCardActions>
                        </MudCard>
                    </div>
                }

                <Pagination ChangedCurrentPage="ChangePage"
                            TotalPage="_festivalResponse!.TotalPages" CurrentPage="@PageNumber" />
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="w-100 mt-4">
                    No festivals matched your current filters. Try broadening your search criteria.
                </MudAlert>
            }
        }
        else
        {
            for (var i = 0; i < 9; i++)
            {
                <MudItem xs="12" lg="3">
                    <MudSkeleton Class="my-5 rounded"
                                 SkeletonType="SkeletonType.Rectangle"
                                 Animation="Animation.Wave" Height="370px" Width="100%" />
                </MudItem>
            }
        }
    </div>

</MudContainer>
