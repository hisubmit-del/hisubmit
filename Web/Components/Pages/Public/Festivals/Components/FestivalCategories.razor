                                            <li class="@(d.Nearest ? "active" : "")">
                                                <p>@d.DeadLineDate.ToLongDate()</p>
                                                <div class="fees">
                                                    @if (d.StandardFee != null)
                                                    {
                                                        <span class="Student">
