                                                        </span>
                                                    }
                                                    @if (d.GoldFee != null)
                                                    {
                                                        <span class="gold-members">
                                                            Gold Members: $@d.GoldFee
                                                        </span>
                                                    }
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                    <MudButton Disabled="@(nearestDeadLineCat == null)" 
                                               Variant="Variant.Filled" 
                                               FullWidth="true"
                                               Color="Color.Success"
                                               Size="Size.Small"
                                               OnClick="@(() => SubmitToFestival(nearestDeadLineCat))" class="submit-btn">
                                        Submit Now
                                    </MudButton>

