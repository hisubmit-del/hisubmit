@inject IStringLocalizer<FestivalCategorySelected> Localize

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.subtitle2">
            <MudIcon Color="Color.Primary" Icon="@Icons.Material.Filled.CheckCircle" Class="mr-3 mb-n1"/>
            @Localize["Select category"]
        </MudText>
    </TitleContent>
    <DialogContent >
        <MudContainer Style="max-height: 70vh;overflow: scroll" Class="px-0" MaxWidth="MaxWidth.ExtraLarge">
            <EditForm Context="editFormContext" Model="Submit">
                <FluentValidationValidator @ref="_fluentValidationValidator"></FluentValidationValidator>
                @if (_loaded)
                {
                    @if (_selectCategory)
                    {
                        <MudAlert Severity="Severity.Info"
                                  Variant="Variant.Outlined"
                                  Dense="true"
                                  Class="submission-choice-guidance mb-4">
                            <MudText Typo="Typo.subtitle2">Choose the best submission option</MudText>
                            <MudText Typo="Typo.body2">
                                Compare the deadline date, fee and eligibility rules before selecting a category.
                                Earlier deadlines are often less expensive; choose a fee tier only when your project
                                meets that tier's conditions. The festival may review eligibility and incomplete or
                                inaccurate answers before accepting a submission.
                            </MudText>
                        </MudAlert>
                        <MudItem xs="12" md="4" Class="mb-4">
                            <MudSelect T="int?" Label="Chose your project" 
                                       SelectedValuesChanged="TakeProjectSpecification" Dense="true"
                                       @bind-Value="@Submit.ProjectId" Class="mt-4" Variant="Variant.Filled" AnchorOrigin="Origin.BottomCenter">
                                @foreach (var project in Projects)
                                {
                                    <MudSelectItem Value="@(project.Id as int?)">@project.Title</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        @if (DeadLineCategories.Any())
                        {
                            <MudTable @ref="_table" MultiSelection="true" @bind-SelectedItems="SelectedDeadLineCategories"
                                      Items="@DeadLineCategories" Loading="@(!_loaded)" Outlined="true" 
                                      Dense="true" Striped="true" Hover="true" Breakpoint="Breakpoint.Sm" 
                                      LoadingProgressColor="Color.Secondary">
                                <HeaderContent>
                                    <MudTh Class="pl-1" Style="text-align:center">@Localize["Name"]</MudTh>
                                    <MudTh Class="pl-1" Style="text-align:center">@Localize["DeadLine Title"]</MudTh>
                                    <MudTh Class="pl-1" Style="text-align:center">@Localize["DeadLine Date"]</MudTh>
                                    <MudTh Class="pl-1" Style="text-align:center">@Localize["Fee"]</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd Class="pl-1" Style="text-align:center" DataLabel="Name">
                                        @context.CategoryName
                                        <CategoryDescriptionToolTip EventCategory="@context.EventCategory"/>
                                    </MudTd>
                                    <MudTd Class="pl-1" Style="text-align:center" DataLabel="@Localize["Deadline Title"]">@context.DeadLineName</MudTd>
                                    <MudTd Class="pl-1" Style="text-align:center" DataLabel="@Localize["Deadline Date"]">@context.DeadLineDate.ToString("MMMM dd , yyyy")</MudTd>
                                    <MudTd Class="pl-1" Style="text-align:left">
                                        <MudRadioGroup T="FeeType"  @bind-Value="@_selectedFees[context.Id]" Class="w-100 pr-4">
                                            <MudStack>
                                                @if (context.StandardFee!=null)
                                                {
                                                    <MudItem Class="d-flex justify-space-between flex-grow-1 gap-4" T="int">
                                                        <MudRadio Disabled="true" Dense="true"
                                                                  Size="Size.Small" Color="Color.Primary"
                                                                  Value="FeeType.Standard"
                                                                  T="FeeType">
                                                            Standard:
                                                        </MudRadio>
                                                        <MudText Inline="true" Color="Color.Info" Typo="Typo.body2">
                                                            @*<MudIcon Size="Size.Small" ViewBox="0 0 24 24" Color="Color.Info" Icon="@Icons.Material.Filled.AttachMoney"></MudIcon>*@
                                                            @context.StandardFee?.ToString("C2")
                                                        </MudText>
                                                    </MudItem>
                                                }
                                                @if (@context.GoldFee !=null)
                                                {
                                                    <MudItem Class="d-flex justify-space-between flex-grow-1 gap-4" T="int">
                                                        <MudRadio Disabled="true" Dense="true"
                                                                  Value="FeeType.Gold"
                                                                  Size="Size.Small" Color="Color.Primary"
                                                                  T="FeeType">
                                                            Gold:
                                                        </MudRadio>
                                                        <MudText Inline="true" Color="Color.Info" Typo="Typo.body2">
                                                            @*<MudIcon Size="Size.Small" ViewBox="0 0 24 24" Color="Color.Info" Icon="@Icons.Material.Filled.AttachMoney"></MudIcon>*@

                                                            @context.GoldFee?.ToString("C2")

                                                        </MudText>
                                                    </MudItem>
                                                }
                                                @if (context.StudentFee !=null)
                                                {
                                                    <MudItem Class="d-flex justify-space-between flex-grow-1 gap-4" T="int">
                                                        <MudRadio Disabled="true" Dense="true" Size="Size.Small"
                                                                  Color="Color.Primary" Value="FeeType.Student"
                                                                  T="FeeType">
                                                            Student:
                                                        </MudRadio>
                                                        <MudText Inline="true" Color="Color.Info" Typo="Typo.body2">
                                                            @*<MudIcon Size="Size.Small" ViewBox="0 0 24 24" Color="Color.Info" Icon="@Icons.Material.Filled.AttachMoney"></MudIcon>*@

                                                            @context.StudentFee?.ToString("C2")

                                                        </MudText>
                                                    </MudItem>
                                                }
                                            </MudStack>
                                        </MudRadioGroup>
                                    </MudTd>


                                </RowTemplate>
                            </MudTable>
                            <MudItem Class="d-flex justify-content-between" xs="12">
                                <LoadingButton Processing="_processing" Class="mt-2 mb-2"
                                               Variant="Variant.Filled"
                                               EndIcon="@Icons.Material.Filled.ShoppingCart"
                                               OnClick="TrySubmitToFestival"
                                               Color="Color.Primary">
                                    Add To cart
                                </LoadingButton>
                                <div class="mx-lg-4 mx-sm-1 mt-2">
                                    <span col-span="3">Sum:</span>
                                    <MudText Color="Color.Info" Inline="true">
                                        @_submitSumPrice.ToString("C2")
                                    </MudText>
                                </div>
                            </MudItem>
                        }
                        else
                        {
                            <MudAlert Class="pa-2" Severity="Severity.Warning">
                                @Localize["Your selected project is not matched with festival rules please modify it or choose another project"]
                            </MudAlert>
                        }
                    }
                    else
                    {
                        <FormCreator
                            Questions="Questions"
                            Title="Submission Form"
                            Description="Please fill out the registration form "
                            AnsweredTheQuestions="@(SubmitToFestivalWithAnswers)"
                            SubmitButtonText="@Localize["Submit To festival"]"/>
                    }
                }
            </EditForm>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="()=>CloseModal()" Variant="Variant.Filled" >Cancel</MudButton>
    </DialogActions>
</MudDialog>
