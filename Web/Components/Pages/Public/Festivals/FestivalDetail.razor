@page "/festivalpage/{FestivalUrl}"

@using Web.Components.Pages.Public.Festivals.Components
@using Hisubmit.Client.SharedModels.Features.Advertises.Commands
@using Web.Components.Shared.Components.ICons
@inject IStringLocalizer<FestivalDetail> Localize
@inherits BasePublicPages
@* @layout PublicMainLayout  *@
@attribute [AllowAnonymous]
@page "/festival/{FestivalUrl}"



@if (FestivalId != 0)
{
    <SeoMetaTags PageId="@Festival.Id.ToString()" PageType="@PageType.FestivalPage"
                 OgImageUrl=@($"https://hisubmit.com{Festival.LogoURL}") />
}
@if (_loaded && Festival is not null)
{
	@* <div class="w-100"> *@
		
			 @* <MudContainer MaxWidth="MaxWidth.Large" Class="festival-page-container">  *@
			 <MudContainer MaxWidth="MaxWidth.Large" Class="festival-detail-page">
			@if (!Festival.Public)
			{
				<MudAlert Class="mt-5">
					This festival is not public
				</MudAlert>
			}
			else
			{
				<div class="festival-cover festival-detail-hero">
					@if (_covers.Any())
					{
						<img src="@GetImageUrl(_covers.FirstOrDefault()?.Url)"
						     onerror="this.onerror=null;this.src='/media/image.png';"
						     alt="cover-image-@Festival.Name" />
					}
					else
					{
						<img src="@GetImageUrl(null)" alt="Default festival cover for @Festival.Name" />
					}

					<div class="festival-cover-description">
						<MudHidden Breakpoint="Breakpoint.MdAndDown">
							<div class="d-flex justify-space-between flex-grow-1 py-xl-8">
								<div>
									<img src="@GetImageUrl(Festival.LogoURL)"
									     onerror="this.onerror=null;this.src='/media/image.png';"
									     alt="festival-logo-@Festival.Name" />
								</div>
								<div class="d-flex icon-box flex-column gap-2">
									<MudAvatar Color="Color.Surface" Variant="Variant.Filled">
										<MudIconButton Size="Size.Small" OnClick="@CopyLinkToClipboard"
													   Icon="@Icons.Material.Outlined.Share" />
									</MudAvatar>
									<MudAvatar Color="Color.Surface" Variant="Variant.Filled">
										@if (_liked)
										{
											<MudIconButton Size="Size.Small" OnClick="UpdateLike"
														   Color="Color.Primary" Icon="@Icons.Material.Filled.Favorite" />
										}
										else
										{
											<MudIconButton Size="Size.Small" OnClick="UpdateLike"
														   Icon="@Icons.Material.Outlined.Favorite" />
										}
									</MudAvatar>
									<MudText Color="Color.Surface" Class="text-center" Typo="Typo.body1">@_likedCount</MudText>
								</div>
							</div>
						</MudHidden>
						<MudHidden Breakpoint="Breakpoint.LgAndUp">
							<div class="d-flex justify-space-around flex-grow-1 py-xl-8">
								<div>
									<img src="@GetImageUrl(Festival.LogoURL)"
									     onerror="this.onerror=null;this.src='/media/image.png';"
									     alt="festival-logo-@Festival.Name" />
								</div>
								<div class="d-flex icon-box flex-grow-1 gap-x-4 justify-end mt-8">
									@if (_likedCount > 0)
									{
										<MudBadge Content="@(_likedCount)" Overlap="true">
											<MudAvatar Color="Color.Surface" Variant="Variant.Filled">
												<MudIconButton Size="Size.Small"
															   OnClick="UpdateLike"
															   Color="@(_liked?Color.Primary:Color.Default)"
															   Icon="@Icons.Material.Filled.Favorite" />
											</MudAvatar>
										</MudBadge>
									}
									else
									{
										<MudAvatar Color="Color.Surface" Variant="Variant.Filled">
											<MudIconButton OnClick="UpdateLike"
														   Color="@(_liked?Color.Primary:Color.Default)"
														   Size="Size.Small" Icon="@Icons.Material.Filled.Favorite" />
										</MudAvatar>
									}
									<MudAvatar Color="Color.Surface" Variant="Variant.Filled">
										<MudIconButton OnClick="@CopyLinkToClipboard"
													   Size="Size.Small"
													   Icon="@Icons.Material.Outlined.Share" />
									</MudAvatar>
								</div>
							</div>
						</MudHidden>
					</div>
				</div>

				<div class="row festival-detail-layout">
					
					<div class="col-12 col-lg-3" ></div>
					<div class="col-12 col-lg-6">
						<div class="festival-title festival-detail-heading mt-2 text-center d-relative">
							<MudText Typo="Typo.h1" Class="mb-2" Align="Align.Center">
								@Festival.Name
                                @if(Festival.FeeStatus == FeeStatus.Special)
                                {
                                    <IGold Title="Special festival" Height="25px" Width="25px" />
                                }
							</MudText>
							<MudText Class="mb-2 fg-grey"
									 Align="Align.Center" Typo="Typo.subtitle1">
								<MudText Inline=true Typo="Typo.subtitle1"
										 Color="Color.Tertiary">
									@Festival.YearsRunning
								</MudText>years /
								@Festival.GetFestivalType()
							</MudText>
            <div class="festival-rating-panel" aria-label="Festival rating">
                <div class="festival-rating-summary">
                    <MudRating ReadOnly="true"
                               SelectedValue="@Math.Clamp((int)Math.Round(_festivalAverageRating), 0, 5)"
                               Size="Size.Medium" />
                    <span class="festival-rating-average">
                        @_festivalAverageRating.ToString("0.0") <small>/ 5</small>
                    </span>
                    <span class="festival-rating-votes">
                        @_festivalRatingCount vote@( _festivalRatingCount == 1 ? "" : "s")
                    </span>
                </div>
                @if (!_hasRatedFestival)
                {
                    <div class="festival-rating-action">
                        <MudRating @bind-SelectedValue="_selectedFestivalRating"
                                   Size="Size.Small"
                                   Color="Color.Warning"
                                   aria-label="Choose a rating" />
                        <MudButton Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   Color="Color.Tertiary"
                                   Disabled="@(_selectedFestivalRating == 0)"
                                   OnClick="RateFestival">
                            Rate this festival
                        </MudButton>
                    </div>
                }
                else
                {
                    <span class="festival-rating-voted">Thanks for rating this festival.</span>
                }
            </div>
						</div>
					</div>
					<div class="col-12 col-lg-3 mx-auto">
						<div class="reward-box  ">
							<img src="@GetImageUrl(Festival.RewardLogoURL)"
							     onerror="this.onerror=null;this.src='/media/image.png';"
							     alt="@Festival.RewardsName" />
							<MudText Class="fg-grey"
									 Align="Align.Center"
									 Typo="Typo.subtitle1">
								@Festival.RewardsName
							</MudText>
						</div>
					</div>
					<div class="col-12" >
						<MudHidden Breakpoint="Breakpoint.LgAndUp">
							<MudButton Color="Color.Tertiary"
									   Class="my-2" FullWidth="true"
									   OnClick="Submit"
									   Variant="Variant.Filled">
								Submit Now
							</MudButton>
						</MudHidden>
					</div>
				
					<div class="col-12 col-lg-9" >
						 <div class="festival-detail-content">
							<MudTabs MinimumTabWidth="40px" PanelClass="mt-3" Elevation="0" Ripple="true"
								 Class="background-transparent festival-detail-text">
							<MudTabPanel Text="Festival details" Class="text-transform-none ">
								<ReadMore Text="@Festival.Description" MarkUpString="true" />
							</MudTabPanel>
							<MudTabPanel Text="Rules & Awards" Class="text-transform-none">
								<div class="rich-content-section">
									<MudText Typo="Typo.h6" Class="mb-2">Awards</MudText>
									<ReadMore Text="@Festival.Rewards" MarkUpString="true" />
								</div>
							</MudTabPanel>
							<MudTabPanel Text="Rules & fees" Class="text-transform-none">
								<div class="rich-content-section">
									<MudText Typo="Typo.h6" Class="mb-2">Rules and sections</MudText>
									<ReadMore Text="@Festival.Rules" MarkUpString="true" />
								</div>
							</MudTabPanel>
							@if (_tickets.Any())
                            {
                                <MudTabPanel Text="Tickets" Class="text-transform-none">
                                    <FestivalTickets Tickets="@_tickets" />
                                </MudTabPanel>
                            }
						</MudTabs>
						
						<div> 
							@if (_images != null && _images.Any())
						{
							<MudPaper Elevation="1" Class="pa-3 text-center mb-3 ">
								<MudText Typo="Typo.h5" Class="mb-5" Align="Align.Center">Gallery</MudText>

								<div class="gallery-tab-slider mb-5 pb-4 mt-5">
									<div class="tab-content" id="gallery-tab-slider-tabContent">
										<div class="tab-pane fade show active" id="pills-about" role="tabpanel"
											 aria-labelledby="pills-about-tab">
											<div class="gallery-slider " id="gallery-slider">
												@foreach (var image in _images)
												{
													<a class="mx-3">
														<img src="@GetImageUrl(image.Url)"
															 onerror="this.onerror=null;this.src='/media/image.png';"
															 onclick="@(() => GalleryImagesOverallyService.ShowImageOverlay(_images.Select(p =>new ImageDto()
                                                                      {
                                                                          Title = p.Title,
                                                                         Url = p.Url,
Id=p.Id
                                                                      }).ToArray(), new ImageDto()
                                                                      {
  Id=image.Id,
                                                                          Url = image.Url,
                                                                          Title = image.Title
                                                                      }))"
															 alt="@image.Title">
													</a>
												}
											</div>
										</div>
									</div>
								</div>
							</MudPaper>
						}

						</div>
						<div>

						@if (_festivalNews != null && _festivalNews.Any())
						{
							<MudPaper Elevation="1" Class="pa-md-3 mb-3">
								<MudText Typo="Typo.h5" Class="mb-5" Align="Align.Center">News</MudText>
								<MudGrid>
									@foreach (var n in _festivalNews)
									{
										<MudItem xs="12" md="6">
											<MudCard Class="pa-1 pa-md-3">
												<img src="@GetImageUrl(n.BannerUrl)" height="200px" class="max-width-100"
												     onerror="this.onerror=null;this.src='/media/image.png';"
												     alt="@n.Title" />
												<MudCardContent>													
													<MudText Typo="Typo.h5">
														<a href="@($"/new/{n.Id}/{Uri.EscapeDataString(n.Title ?? "news")}")">@n.Title</a>
													</MudText>
												</MudCardContent>
												<MudCardActions>
													<MudAvatar>
														<MudImage Src="@n.FestivalLogoURL"></MudImage>
													</MudAvatar>
													<MudText Inline="true" Typo="Typo.body2" Class="ml-1"
															 Color="Color.Default">@n.FestivalName</MudText>
													<MudSpacer />
													<MudText Inline="true" Typo="Typo.body2"
															 Color="Color.Default">@n.CreatedOn.ToLongDateString()</MudText>
												</MudCardActions>
											</MudCard>

										</MudItem>
									}
								</MudGrid>

							</MudPaper>
						}
						</div>
						<div>
						@if (Organizers != null && Organizers.Any())
						{
							<MudPaper Elevation="1" Class="pa-3 text-center mb-3">
								<MudText Typo="Typo.h5" Class="mb-5" Align="Align.Center">Organizers</MudText>
								<div class="gallery-tab-slider mb-5 pb-4 mt-5">
									<div class="tab-content" id="organizer-tab-slider-tabContent">
										<div class="tab-pane fade show active" id="pills-about" role="tabpanel"
											 aria-labelledby="pills-about-tab">
											<div class="gallery-slider" id="organizer-slider">
												@foreach (var organizer in Organizers)
												{
													<MudCard Elevation="0" Class="text-center">
														<MudAvatar Style="height:130px; width:130px;">
															<MudImage Src="@GetImageUrl(organizer.ImageName)"
															          Alt="@organizer.Name"
															          onerror="this.onerror=null;this.src='/media/image.png';" />
														</MudAvatar>
														<MudText Typo="Typo.subtitle1">@organizer.Name</MudText>
														<MudText Typo="Typo.subtitle2" Class="fg-grey">@organizer.Title</MudText>
													</MudCard>
												}
											</div>
										</div>
									</div>
								</div>
							</MudPaper>
						}
						</div>
						<div>
						@if (_files.Any())
						{
							<FestivalFiles Files="@_files" />
						}
						</div>
						<div>
						<FestivalReviews @key="_ratingRefreshToken" FestivalId="FestivalId"
						                 RefreshToken="_ratingRefreshToken" />
						</div>
						<div>
						<MudPaper Elevation="1" Class="pa-3 text-center">
							<MudText Typo="Typo.h5" Class="mb-5" Align="Align.Center">Write Your Comment!</MudText>
							@if (_canReview)
							{
								<MudGrid>
									<MudItem xs="12" lg="8">
										<MudTextField Lines="5" @bind-Value="_review.Text"
													  Variant="Variant.Outlined" Placeholder="Share your experience with this festival"></MudTextField>
									</MudItem>
									<MudItem xs="12" lg="4">
										<MudText Typo="Typo.subtitle2" Class="mb-2">Rate this festival</MudText>
										<MudRating Class="mb-2 d-block" @bind-SelectedValue="_review.Rate"></MudRating>
										<MudText Typo="Typo.subtitle2" @onclick="ViolationReport" Class="mb-2" Color="Color.Tertiary">
											Report this festival
										</MudText>
									</MudItem>
									<MudItem Class="text-center" xs="12" lg="12">
										<MudButton Color="Color.Tertiary" Class="px-10"
												   OnClick="AddComment"
												   Variant="Variant.Filled">Post comment</MudButton>
									</MudItem>
								</MudGrid>
							}
							else
							{
								<MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
									@_reviewEligibilityMessage
								</MudAlert>
								@if (UserIsAuthenticated)
								{
									<MudButton Color="Color.Tertiary" Variant="Variant.Text"
											   OnClick="ViolationReport">Report this festival</MudButton>
								}
							}
						</MudPaper>
						</div>
						</div>
					</div>

					<div class="col-12 col-lg-3" >
					<div>
							<FestivalTimeLine FestivalId="FestivalId" SubmitClicked="Submit" Festival="Festival" />
						<FestivalCategories FestivalId="FestivalId" />

						<MudPaper Class="mt-2 pb-3 pt-2 border-radius-20 ">
							<div Class="mt-2 text-center">
								<MudText Typo="Typo.h5" Align="Align.Center" Class="mb-2">Key stats</MudText>
							</div>
							<div class="side-box contact w-100">

								<ul class="contact-list mt-4">
									<li>Audience Attendance: @Festival.AudienceAttendence</li>
									<li>Submission : @Festival.EstimatedSubmissions</li>
									<li>Projected Selected: @Festival.ProjectsSelected</li>
									<li>Awards Presented: @Festival.AwardsPresented</li>
								</ul>
							</div>
						</MudPaper>
						<FestivalContact Festival="Festival" />
						<FestivalQualifiers Qualifiers="Qualifiers" />
						<FestivalVenue FestivalId="FestivalId" />
					</div>
					</div>
				
				</div>
			}
		 </MudContainer> 
	@* </div> *@

	@if (Festival.Public && _products != null && _products.Any())
	{

		<div class="w-100 festival-product festival-product-section">
			<MudText Typo="Typo.h6" Class="my-4" Color="Color.Surface">
				<MudIcon Color="Color.Surface" Icon="@Icons.Material.Filled.ShoppingCart"></MudIcon> Festival products
			</MudText>
			<MudContainer MaxWidth="MaxWidth.Large">

				<MudGrid Class="justify-content-center">
					@foreach (var product in _products)
					{
						<MudItem xs="12" md="4" lg="4" Class="h-100">
							<FestivalProductBox Product="product" />
						</MudItem>
					}
				</MudGrid>
			</MudContainer>
		</div>

	}
}
