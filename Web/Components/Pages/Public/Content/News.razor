@page "/news"
@inherits BasePublicPages

<SeoMetaTags PageId="0" PageType="@PageType.NewsList" OgImageUrl="https://hisubmit.com/media/logo/1.JPG" />
<section class="public-content-page news-hub-page">
    <MudContainer MaxWidth="MaxWidth.Large">
        <div class="public-page-hero news-hub-hero">
            <div>
                <MudChip T="string" Color="Color.Warning" Variant="Variant.Text">HiSubmit editorial</MudChip>
                <MudText Typo="Typo.h1">Stories behind the entries</MudText>
                <MudText Typo="Typo.body1" Class="public-page-hero__copy">
                    Festival announcements, artist insights and useful updates from the creative competition community.
                </MudText>
            </div>
            <div class="public-page-hero__icon">
                <MudIcon Icon="@Icons.Material.Outlined.AutoStories" Size="Size.Large" />
            </div>
        </div>

        <div class="public-toolbar">
            <PublicSectionHeader Title="Latest news"
                                 Description="Follow every festival from one calm, searchable feed." />
            <MudTextField Class="public-toolbar__search"
                          DebounceInterval="500"
                          @bind-Value="@SearchString"
                          Variant="Variant.Outlined"
                          Placeholder="Search news..."
                          Adornment="Adornment.End"
                          OnAdornmentClick="Search"
                          AdornmentColor="Color.Primary"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
        </div>

        @if (!_loaded)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-8" />
        }
        else if (_news.Any())
        {
            var pinned = _news.FirstOrDefault(p => p.IsPined);
            @if (pinned is not null)
            {
                <div class="news-featured-card">
                    <img src="@pinned.BannerUrl" alt="@pinned.Title" />
                    <div class="news-featured-card__content">
                        <MudChip T="string" Color="Color.Info" Variant="Variant.Text">
                            @(string.IsNullOrWhiteSpace(pinned.FestivalName) ? "HiSubmit" : pinned.FestivalName)
                        </MudChip>
                        <MudText Typo="Typo.h3">
                            <a href="@($"/new/{pinned.Id}/{Uri.EscapeDataString(pinned.Title ?? "news")}")">@pinned.Title</a>
                        </MudText>
                        <MudText Typo="Typo.body1">@pinned.ShortDescription</MudText>
                        <a class="public-text-link" href="@($"/new/{pinned.Id}/{Uri.EscapeDataString(pinned.Title ?? "news")}")">
                            Read the full story <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" />
                        </a>
                    </div>
                </div>
            }

            <MudGrid Class="news-grid public-card-grid">
                @foreach (var item in _news.Where(p => !p.IsPined))
                {
                    <MudItem xs="12" sm="6" lg="4">
                        <NewBox New="item" ShowFestivalName="true" />
                    </MudItem>
                }
            </MudGrid>
            <Pagination ChangedCurrentPage="ChangePage" TotalPage="_newResponse.TotalPages" CurrentPage="@PageNumber" />
        }
        else
        {
            <div class="public-empty-state">
                <MudIcon Icon="@Icons.Material.Outlined.Article" Size="Size.Large" />
                <MudText Typo="Typo.h6">No stories found</MudText>
                <MudText Typo="Typo.body2">Try a different keyword or check back soon.</MudText>
            </div>
        }
    </MudContainer>
</section>

