@page "/new/{NewId:int}/{Title}"
@page "/new/{NewId:int}"
@inherits BasePublicPages

<SeoMetaTags PageId="@NewId.ToString()" PageType="@PageType.News" OgImageUrl=@($"https://hisubmit.com{_new.BannerUrl}") />
<MudContainer MaxWidth="MaxWidth.Large" Class="mt-10">
    <MudGrid>
        <MudItem xs="12" md="9">
            <MudCard Class="mr-md-2">
                <MudCardContent Class="p-md-6">
                    <MudText Typo="Typo.h1">
                        @_new.Title
                    </MudText>
                    @* <MudChip T="string" Icon="@Icons.Material.Filled.FestivalId" Variant="Variant.Text">@_new.</MudChip> *@

                    <MudItem xs="12" Class="my-4 text-center">
                        <MudImage Class="mx-100" Src="@_new.BannerUrl"/>
                    </MudItem>

                    <MudGrid Class="bg-light-grey  font-italic mt-3  pa-4">
                        <MudText>
                            @_new.ShortDescription
                        </MudText>
                    </MudGrid>
                    <MudGrid Class="mt-7 pa-5">
                        @((MarkupString)_new.Description)
                    </MudGrid>
                    <div class="d-flex icon-box  gap-2">
                        <MudSpacer/>
                        <MudAvatar Class="my-4" Color="Color.Surface" Variant="Variant.Outlined">
                            <MudIconButton Size="Size.Small" OnClick="@CopyLinkToClipboard"
                                           Icon="@Icons.Material.Outlined.Share" />
                        </MudAvatar>
                                <MudBadge Content="@_likedCount" Color="Color.Primary" Overlap="true" Class="mx-6 my-4">
                        <MudAvatar Color="Color.Surface" Variant="Variant.Outlined">
                            @if (_liked)
                            {
                                    <MudIconButton Size="Size.Small" OnClick="UpdateLike"
                                                   Color="Color.Primary" Icon="@Icons.Material.Filled.Favorite" />
                                @* </MudBadge> *@
                            }
                            else
                            {
                                @* <MudBadge Content="@_likedCount" Overlap="true" Class="mx-6 my-4"> *@
                                    <MudIconButton Size="Size.Small" OnClick="UpdateLike"
                                                   Icon="@Icons.Material.Outlined.Favorite" />
                            }
                        </MudAvatar>
                                </MudBadge>
                    </div>
                </MudCardContent>
            </MudCard>

        </MudItem>
        <MudItem xs="12" md="3">
            <MudText Typo="Typo.h6" Class="side-title" Align="Align.Center">
                Other festival You May Like
            </MudText>
            <FavoriteFestival />
           @*  <MudGrid Class="festival-sponsored-box festival-side-box" Spacing="3">
                @foreach (var festival in _festivalResponse.Data)
                {
                    <MudItem xs="6" lg="6" Class="d-relative img-box">
                        <img alt="image"src="@festival.LogoURL"/>
                        <MudIconButton Class="btn-view-festival"
                            Href="@($"/festivalPage/{festival.URL}")"
                            Color="Color.Tertiary"
                            Variant="Variant.Outlined"
                                       Icon="@Icons.Material.Filled.RemoveRedEye"></MudIconButton>
                        @* <MudButton Class="btn-view-festival" *@
                        @*            Href="@($"/festivalPage/{festival.URL}")" *@
                        @*            Color="Color.Tertiary" *@
                        @*            Variant="Variant.Outlined"> *@
                        @*     View FestivalId *@
                        @* </MudButton> *@
                    @* </MudItem> *@
                @* } *@
            @* </MudGrid> *@
        </MudItem>

        <MudItem xs="12">
            <MudCard Elevation="1" Class="pa-md-3 mb-3">
                <MudText Typo="Typo.h5" Class="mb-5" Align="Align.Center">News</MudText>
                <MudGrid>
                    @foreach (var n in _newsResponse.Data)
                    {
                        <MudItem xs="12" md="4">
                            <NewBox New="@n" ShowFestivalName="true"></NewBox>
                        </MudItem>
                    }
                </MudGrid>
            </MudCard>
        </MudItem>
    </MudGrid>

</MudContainer>
