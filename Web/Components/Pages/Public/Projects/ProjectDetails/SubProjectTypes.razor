@using HiSubmit.Client.Infrastructure.Managers.SubProjectTypes

@using global::Hisubmit.Client.SharedModels.Features.SubProjectTypes.Queries.GetAll
<h4>Category</h4>
@foreach (var s in _subProjectNames)
{
    <p class="mb-1">@s</p>
}

@code{
    [Parameter]
    public  List<int> SubProjectTypeIds { get; set; }

    [Inject]
    private ISubProjectTypeManager SubProjectTypeManager { get; set; }

    private List<string> _subProjectNames = new();
    
    private async Task LoadCategories()
    {
        var response = await SubProjectTypeManager.GetAllAsync(new GetAllSubProjectTypeQuery
        {
            ProjectType = ProjectType.Film,
            SubIdString = string.Join("-", SubProjectTypeIds)
        });
        if (response.Succeeded)
        {
            _subProjectNames = response.Data.Select(p => p.Name).ToList();
        }
        else
        {
            foreach (var message in response.Messages)
            {
                _snackBar.Add(message, Severity.Error);
            }
        }
    }

}