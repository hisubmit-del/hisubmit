@inject IStringLocalizer<FilmSpecification> Localize

@using HiSubmit.Client.SharedModels.Extensions
<MudCardContent>
    <MudContainer MaxWidth="MaxWidth.Medium" Class="px-0">
        <MudGrid>
            @if (!_loaded)
            {
                <Spinner></Spinner>
            }
            else
            {
                <MudItem xs="12" sm="12" md="12">
                    <EditForm FormName="project-film-specification" OnValidSubmit="SaveAsync" EditContext="@_editContext">
                        <FluentValidationValidator @ref="_fluentValidationValidator"/>
                        <ValidationSummary />
                        <MudGrid>
                            <MudItem xs="12">
                                <MudGrid>
                                    @foreach (var type in _subProjectTypesItem)
                                    {
                                        <MudItem xs="6" md="4" lg="3">
                                            <MudCheckBox T="bool" Size="Size.Small" @bind-Value="@type.IsSelected"
                                                         Color="Color.Default">
                                                @type.Name
                                            </MudCheckBox>
                                        </MudItem>
                                    }
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12" md="12">
                                <MudGrid >
                                    <MudItem xs="12" md="2">
                                        <MudText Typo="Typo.subtitle1">
                                            @Localize["Genre"]:
                                        </MudText>
                                    </MudItem>
                                    <MudItem xs="12" md="10">
                                        <ChipsetTextField @bind-Value="@Model.Genre"
                                                          Label="Genres" HelperText="Separate genres with the - character"/>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>

                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="4" md="2">
                                        <MudText Typo="Typo.subtitle1">Run times:</MudText>
                                    </MudItem>
                                    <MudItem xs="8"  md="10">
                                        <MudGrid>
                                            <MudItem xs="12" md="4">
                                                <MudTextField @bind-Value="Model.RunTimeHours"
                                                              For="@(() => Model.RunTimeHours)"
                                                              Label="@Localize["RunTime Hours"]"
                                                              Variant="Variant.Filled" Margin="Margin.Dense"/>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudTextField @bind-Value="Model.RunTimeMinutes"
                                                              For="@(() => Model.RunTimeMinutes)"
                                                              Label="@Localize["RunTime Minutes"]"
                                                              Variant="Variant.Filled" Margin="Margin.Dense"/>
                                            </MudItem>
                                            <MudItem xs="12" md="4">
                                                <MudTextField @bind-Value="Model.RunTimeSecounds"
                                                              For="@(() => Model.RunTimeSecounds)"
                                                              Label="@Localize["RunTime Second"]"
                                                              Variant="Variant.Filled" Margin="Margin.Dense"/>
                                            </MudItem>
                                        </MudGrid>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudDatePicker @bind-Date="Model.CompletionDate"
                                               For="@(() => Model.CompletionDate)"
                                               Label="@Localize["Completion Date"]"
                                               DisableToolbar="true"
                                               PickerVariant="PickerVariant.Dialog"
                                               DateFormat="@DateTimeExtension.LongDateFormat"
                                               Variant="Variant.Filled" Margin="Margin.Dense"/>
                            </MudItem>
                            <MudItem xs="12">
                                <MudGrid>
                                    <MudItem xs="12" md="6">
                                        <MudTextField @bind-Value="Model.ProductionBudget"
                                                      For="@(() => Model.ProductionBudget)"
                                                      Label="@Localize["Production Budget"]"
                                                      Variant="Variant.Filled" Margin="Margin.Dense"/>
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudSelect T="int?" @bind-Value="Model.MonetaryUnitId"
                                                   For="@(() => Model.MonetaryUnitId)" Label="@Localize["Monetary unit"]">
                                            @foreach (var unit in _monetaryUnits)
                                            {
                                                <MudSelectItem Value="unit.Id as int?">@unit.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>
                            @* <MudItem xs="12" md="6"> *@
                            @*      <MudAutocomplete T="int" Label="@Localize["Country"]"  *@
                            @*                                                  Value="CountryId" *@
                            @*                                                  For="@(() => CountryId)" *@
                            @*                                                  ValueChanged="(t)=>SelectCountry(t)" *@
                            @*                                                  ResetValueOnEmptyText="true" SearchFunc="@SearchCountries"  *@
                            @*                                                  Variant="Variant.Filled" Margin="Margin.Dense"  *@
                            @*                                                  ToStringFunc="@(i => Countries.FirstOrDefault(b => b.Id == i)?.Name ?? string.Empty)" *@
                            @*                                                  OffsetY="true" /> *@
                            @*                              *@
                            @*                         </MudItem> *@

                            <MudItem xs="12" md="6" Class="mb-2">
                                  <MudAutocomplete T="int" Label="@Localize["Production Countries"]" 
                                                                             Value="CountryId"
                                                                             For="@(() => CountryId)"
                                                                             ValueChanged="(t)=>SelectCountry(t)"
                                                                             ResetValueOnEmptyText="true" SearchFunc="@SearchCountries" 
                                                                             Variant="Variant.Filled" Margin="Margin.Dense" 
                                                                             ToStringFunc="@(i => Countries.FirstOrDefault(b => b.Id == i)?.Name ?? string.Empty)"
                                                                             OffsetY="true" />
                           
                            </MudItem>
                            <MudItem xs="12" md="6">

                                @if (Model is { FilmingCountryIds: not null })
                                {
                                    foreach (var item in Model.FilmingCountryIds)
                                    {
                                        var f = Countries.FirstOrDefault(p => p.Id == item);
                                        <MudChip T="string" OnClose="@((t) => DeleteCountry(item))">@f.Name</MudChip>
                                    }
                                }
                            </MudItem>

                            <MudItem xs="12" md="6" Class="mb-2">
                                <MudAutocomplete T="int" Label="@Localize["Origin Country"]"
                                                 For="@(() => Model.OriginCountryId)"
                                                 @bind-Value="Model.OriginCountryId" ResetValueOnEmptyText="true"
                                                 SearchFunc="@SearchCountries" Variant="Variant.Filled"
                                                 OffsetY="true" Margin="Margin.Dense"
                                                 ToStringFunc="@(i => Countries.FirstOrDefault(b => b.Id == i)?.Name ?? string.Empty)"/>
                            </MudItem>
                            <MudItem xs="12" md="12" Class="mb-2">
                                <MudGrid >
                                    <MudItem xs="12" md="2">
                                        <MudText Typo="Typo.subtitle1">
                                            @Localize["Languages"]:
                                        </MudText>
                                    </MudItem>
                                    <MudItem xs="12" md="10">
                                        <ChipsetTextField @bind-Value="@Model.Language"
                                                          Label="Languages" HelperText="Separate Language with the - character"/>
                                    </MudItem>
                                </MudGrid>
                            </MudItem>

                            <MudItem xs="12" md="6" Class="mb-2">

                                <MudTextField @bind-Value="Model.ShottingFormat"
                                              For="@(() => Model.ShottingFormat)"
                                              Label="@Localize["Shotting Format"]"
                                              Variant="Variant.Filled" Margin="Margin.Dense"/>
                            </MudItem>

                            <MudItem xs="12" md="6" Class="mb-2">
                                <MudTextField @bind-Value="Model.AspectRatio"
                                              For="@(() => Model.AspectRatio)"
                                              Label="@Localize["Aspect Ratio"]" Variant="Variant.Filled" Margin="Margin.Dense"/>
                            </MudItem>
                            <MudItem xs="12" md="6" Class="mb-2">
                                <MudSelect T="FilmColor" @bind-Value="Model.FilmColor"
                                           For="@(() => Model.FilmColor)" Label="@Localize["FilmColor"]">
                                    @foreach (FilmColor filmColor in Enum.GetValues(typeof(FilmColor)))
                                    {
                                        <MudSelectItem Value="@filmColor">@filmColor.ToDisplay()</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            @* <MudItem xs="12" md="6"> *@
                            @*     <MudCheckBox T="bool" Size="Size.Small" For="@(()=>_model.StudentProject)" @bind-Value="@_model.StudentProject" Color="Color.Default">@localizer["Student project"]</MudCheckBox> *@
                            @* </MudItem> *@
                            <MudItem xs="12" md="6">
                                <MudCheckBox T="bool" Size="Size.Small" For="@(() => Model.FirstTimeFilmMaker)"
                                             @bind-Value="@Model.FirstTimeFilmMaker"
                                             Color="Color.Default">
                                    @Localize["FirstTimeFilmMaker"]
                                </MudCheckBox>
                            </MudItem>
                        </MudGrid>
                    </EditForm>
                </MudItem>
            }
        </MudGrid>
    </MudContainer>
</MudCardContent>
<MudPaper Class="d-flex justify-end flex-grow-1 " Elevation="0">
    <MudPaper Class="mr-2 mb-2" Elevation="0">
        <MudButtonGroup OverrideStyles="false" Variant="Variant.Filled" Color="Color.Info">
             <LoadingButton Processing="_processing" Variant="Variant.Filled"
                                   ButtonType="ButtonType.Submit" OnClick="SaveAsync"
                                   StartIcon="@Icons.Material.Filled.Save" Color="Color.Info">
                        @Localize["Save"]
                    </LoadingButton>
                    <MudButton Variant="Variant.Filled" OnClick="GoNext"
                               EndIcon="@Icons.Material.Filled.ArrowRight"
                               Color="Color.Secondary">
                        @Localize["Next"]
                    </MudButton>
        </MudButtonGroup>
    </MudPaper>
</MudPaper>
