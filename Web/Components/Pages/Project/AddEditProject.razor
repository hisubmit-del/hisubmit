@page "/user/project"
@page "/user/project/{ProjectId:int}"
@inject IStringLocalizer<AddEditProject> Localize
@inherits Web.Components.Pages.User.BaseUserPages

<MudContainer MaxWidth="MaxWidth.Large">
    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="2">
            <MudStack Spacing="0">
                <MudText Typo="Typo.h6">@Localize["Build your project"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @Localize["Complete each section, save your progress, then release the project when it is ready."]
                </MudText>
            </MudStack>
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">
                @($"{Math.Min(_activePanelIndex + 1, 5)} / 5")
            </MudChip>
        </MudStack>
        <MudProgressLinear Class="mt-3" Color="Color.Primary"
                           Value="@(((_activePanelIndex + 1) / 5d) * 100)"
                           Rounded="true" />
        <MudText Class="mt-2" Typo="Typo.caption" Color="Color.Secondary">
            @GetStepHint()
        </MudText>
    </MudPaper>
    <MudTabs ActivePanelIndex="_activePanelIndex"
             ActivePanelIndexChanged="ChangeTabChecked" @ref="MainTab"
             Elevation="25" Color="Color.Surface" Rounded="true" Centered="true" PanelClass="mt-6">
        @if (ProjectId != 0)
        {
            <MudHidden Breakpoint="Breakpoint.MdAndDown">
                <LoadingButton StartIcon="@Icons.Material.Filled.ArrowForward"
                               Processing="_releaseProcessing" Style="position: absolute; top:6px;right:15px;" Size="Size.Large"
                               Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="GotoProjectPage">
                    Go To Project Page
                </LoadingButton>
            </MudHidden>
            <MudHidden Breakpoint="Breakpoint.LgAndUp">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowForward"
                               Style="position: absolute; top:0;right:0;" Size="Size.Medium" Variant="Variant.Filled"
                               Color="Color.Primary" OnClick="GotoProjectPage" Title="Release Project"/>
            </MudHidden>
        }
        <CascadingValue Value="ProjectId">
            <MudTabPanel Style="text-transform:none" Text="@Localize["Project Information"]">
                <AddEditProjectInformation @ref="_addEditProjectInformation"
                                           UpdatedProjectId="UpdateProjectId" NextPanel="() => ChangeTab(1)"/>
    
    
            </MudTabPanel>
            <MudTabPanel Disabled="@(ProjectId == 0)" Style="text-transform:none" Text="@Localize["Credits"]">
                <AddEditProjectCredit @ref="_addEditProjectCredit" NextPanel="() => ChangeTab(2)"/>
            </MudTabPanel>
            <MudTabPanel Disabled="@(ProjectId == 0)" Style="text-transform:none" Text="@Localize["FilmSpecification"]">
                <AddEditProjectSpecification @ref="_addEditProjectSpecification" NextPanel="() => ChangeTab(3)"/>
            </MudTabPanel>
            <MudTabPanel Disabled="@(ProjectId == 0)" Style="text-transform:none" Text="@Localize["Award & Distribution"]">
                <ProjectAwardAndDistribution @ref="_projectAwardAndDistribution" NextPanel="() => ChangeTab(4)"/>
            </MudTabPanel>
            <MudTabPanel Disabled="@(ProjectId == 0)" Style="text-transform:none" Text="@Localize["Project Files"]">
                <AddEditProjectFile @ref="_addEditProjectFile"/>
            </MudTabPanel>
        </CascadingValue>
    </MudTabs>
</MudContainer>
