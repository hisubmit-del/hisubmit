@using HiSubmit.Client.SharedModels.Extensions
@using Hisubmit.Client.SharedModels.Features.Projects.Commands.AddEditProjectFileURL
@inject IStringLocalizer<ProjectFileConflictWays> Localize
    <MudDialog>
        <TitleContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-3 mb-n1" />
                @Localize["Conflict"]
            </MudText>
        </TitleContent>
        <DialogContent>
            <p>
                The file you selected for this position conflicts with other files.Please choose a method to resolve the conflict
            </p>
            
            <p><b>Please select the choice</b></p>
            <MudItem xs="12">
                <MudRadioGroup @bind-Value="_conflictWays">
                    @foreach (var c in Enum.GetValues<ConflictWays>())
                    {
                        <MudRadio Class="d-block" Value="c">@c.ToDescriptionString()</MudRadio>
                    }
                </MudRadioGroup>
            </MudItem>
               

        </DialogContent>
        <DialogActions>
            <MudButton DisableElevation Variant="Variant.Filled"
                       OnClick="Cancel" ButtonType="ButtonType.Button">@Localize["Cancel"]</MudButton>
            <MudButton 
                           Variant="Variant.Filled" OnClick="SaveAsync"
                           ButtonType="ButtonType.Submit" Color="Color.Success">@Localize["Save"]</MudButton>
        </DialogActions>
    </MudDialog>


                   