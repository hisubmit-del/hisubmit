@inject IStringLocalizer<AddEditProjectInformation> Localize

@using global::Hisubmit.Client.SharedModels.Features.Projects.Queries.GetAllProjectFiles
@using Web.Components.Pages.Project.Files
@using HiSubmit.Client.SharedModels.Extensions
<MudCard Elevation="25">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h3">@Localize["Project Files"]</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    @if (!_loaded)
    {
        <MudContainer MaxWidth="MaxWidth.Medium" Style="height:300px">
            <Spinner></Spinner>
        </MudContainer>
    }
    else
    {
        <MudCardContent >
            @* <div class="container"> *@
            <MudContainer MaxWidth="MaxWidth.Medium" Class="px-2">
				
	            <MudAlert Severity="Severity.Warning" Class="my-2">
		            It is recommended to visit the project page to upload your project files.
	            </MudAlert>
	            @if (_addFileForm)
	            {
		            <MudGrid Class="pa-2">
			            <MudItem xs="12" sm="12">
				            <MudGrid>
					            <MudItem xs="3" md="2">
						            <MudText Typo="Typo.subtitle2">File type</MudText>
					            </MudItem>
					            <MudItem xs="9" md="4">
						            <MudSelect T="bool" @bind-value="_uploadLocalFile"
						                       Variant="Variant.Filled"
						                       AnchorOrigin="Origin.BottomCenter">

							            <MudSelectItem Value="true">Local File</MudSelectItem>
							            <MudSelectItem Value="false">External File</MudSelectItem>
						            </MudSelect>
					            </MudItem>
				            </MudGrid>
			            </MudItem>
			            <MudItem xs="12" sm="12" md="12">
				            <MudPaper Elevation="4" Class="pa-2 pa-lg-4">
					            @if (_uploadLocalFile)
					            {
						            <LocalFile @ref="_localFile" Canceled="Cancel"
						                       UploadCompleted="AddedFile"
						                       ProjectId="ProjectId"/>
					            }
					            else
					            {
						            <ExternalFile @ref="_externalFile"
						                          UploadCompleted="AddedFile"
						                          Canceled="Cancel" FileUploaded="AddedFile"
						                          ProjectId="ProjectId"/>
					            }
				            </MudPaper>
			            </MudItem>
		            </MudGrid>
	            }
	            else
	            {
		            <MudButton Color="Color.Primary" Class="mb-3"
		                       Variant="Variant.Filled" OnClick="ShowUploadForm">
			            Add File
		            </MudButton>
	            }
	            <MudGrid>
		            <MudItem xs="12" lg="3"></MudItem>
		            <MudItem xs="12" lg="9">
			            <MudDropContainer T="GetAllProjectFileResponse"
			                              Items="ProjectFiles.OrderBy(p => p.Order)"
			                              ItemDropped="ItemUpdated"
			                              @ref="_FilesZone"
			                              ItemsSelector="@((item, dropzone) => true)"
			                              Class="d-flex flex-wrap flex-grow-1">
				            <ChildContent>
					            <MudDropZone AllowReorder="true" T="GetAllProjectFileResponse"
					                         Identifier="Drop Zone 1"
					                         Class="rounded mud-background-gray pa-2 pa-xl-6 ma-xl-8 flex-grow-1">

						            <MudHidden Breakpoint="Breakpoint.MdAndDown">
							            <MudGrid>
								            <MudItem xs="12" lg="4">
									            @Localize["Name"]
								            </MudItem>
								            <MudItem xs="12" lg="2">
									            @Localize["File Format"]
								            </MudItem>
								            <MudItem xs="12" lg="2">
									            @Localize["Local File"]
								            </MudItem>
								            <MudItem xs="12" lg="2">
									            @Localize["Position"]
								            </MudItem>
								            <MudItem xs="12" lg="2">
									            @Localize["Actions"]
								            </MudItem>
							            </MudGrid>
						            </MudHidden>
					            </MudDropZone>
				            </ChildContent>
				            <ItemRenderer>
					            <MudPaper Elevation="25" Class="ps-xl-4 my-xl-4 my-2 pa-2">
						            <MudGrid>
							            <MudItem xs="12" lg="4" Class="d-flex justify-content-between">
								            <MudHidden Breakpoint="Breakpoint.LgAndUp">
									            <MudText Typo="Typo.body1">
										            @Localize["Name"]
									            </MudText>
								            </MudHidden>
								            <MudText>
									            @context.Name
								            </MudText>
							            </MudItem>
							            <MudItem xs="12" lg="2" Class="d-flex justify-content-between">
								            <MudHidden Breakpoint="Breakpoint.LgAndUp">
									            <MudText Typo="Typo.body1">
										            @Localize["File Format"]
									            </MudText>
								            </MudHidden>
								            <MudText>
									            @context.FileFormat
								            </MudText>
							            </MudItem>
							            <MudItem xs="12" lg="2" Class="d-flex justify-content-between">
								            <MudHidden Breakpoint="Breakpoint.LgAndUp">
									            <MudText Typo="Typo.body1">
										            @Localize["Is Local File"]
									            </MudText>
								            </MudHidden>
								            @if (context.IsLocalFile)
								            {
									            <MudIcon Color="Color.Success" Icon="@Icons.Material.Filled.CheckCircle"></MudIcon>
								            }
								            else
								            {
									            <MudIcon Color="Color.Default" Icon="@Icons.Material.Filled.Block"></MudIcon>
								            }
							            </MudItem>
							            <MudItem xs="12" lg="2" Class="d-flex justify-content-between">
								            <MudHidden Breakpoint="Breakpoint.LgAndUp">
									            <MudText Typo="Typo.body1">
										            @Localize["Position"]
									            </MudText>
								            </MudHidden>
								            @context.Position.ToDisplay()
							            </MudItem>
							            <MudItem xs="12" lg="2" Class="d-flex justify-content-between">
								            <MudHidden Breakpoint="Breakpoint.LgAndUp">
									            <MudText Typo="Typo.body1">
										            @Localize["Actions"]
									            </MudText>
								            </MudHidden>
								            <MudButtonGroup>
									            <MudIconButton Size="Size.Small" Color="Color.Default"
									                           Icon="@Icons.Material.Filled.Delete"
									                           OnClick="() => DeleteFileUrl(context.Id)"/>
								            </MudButtonGroup>
							            </MudItem>
						            </MudGrid>
					            </MudPaper>
				            </ItemRenderer>
			            </MudDropContainer>
		            </MudItem>
	            </MudGrid>
            </MudContainer
            >
            @* </div> *@
        </MudCardContent>
    }
</MudCard>
