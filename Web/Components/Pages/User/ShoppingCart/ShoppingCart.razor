@page "/user/ShoppingCart"
@using HiSubmit.Client.SharedModels.Extensions
@using Web.Components.Shared.Components.Payments
@inject IStringLocalizer<ShoppingCart> Localize
@inherits BaseUserPages
<MudContainer MaxWidth="MaxWidth.Large" Class="cart-page-shell">
    <HeroTitle Title="@Localize["Cart"]" Description="@Localize["All your purchases"]" />
    <MudDivider />
    @if (_cartLoading)
    {
        <MudPaper Class="pa-6 my-4 text-center" Elevation="1">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            <MudText Class="mt-3" Typo="Typo.body2">@Localize["Loading your cart and receipts..."]</MudText>
        </MudPaper>
    }
    else if (_cartLoadFailed && !_shopCartItems.Any())
    {
        <MudAlert Class="my-4" Severity="Severity.Error" Variant="Variant.Outlined">
            @Localize["We could not load your cart. Refresh the page and try again before starting a new payment."]
        </MudAlert>
    }
    <MudTabs Elevation="0" Color="Color.Surface" Rounded="true"
              Class="workspace-tabs cart-tabs" PanelClass="mt-6">
        <MudTabPanel Text="@Localize["Cart Items"]">
            <MudGrid Class="mt-2 flex-row-reverse">
                <MudItem xs="12" md="4">
                    <MudPaper Outlined="true"
                              Class="flex-grow-1 px-4 pt-2 pb-4 relative cart-summary-card">
                        <MudOverlay Visible="IsVisibleOveralls" ZIndex="500"
                                    DarkBackground="true" Absolute="true">
                            <div>
                                <MudProgressCircular Color="Color.Secondary"
                                                     Size="Size.Large" Indeterminate="true" />
                            </div>
                        </MudOverlay>
                        <MudStack Row="true" Justify="Justify.SpaceBetween"
                                  AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.h6">Unpaid Cart Summary</MudText>
                            <MudIconButton Icon="@Icons.Material.Filled.AttachMoney"
                                           Color="Color.Default" Edge="Edge.End" />
                        </MudStack>
                        <MudStack Spacing="5">
                            @if (!_shopCartItems.Any(p => !p.Paid))
                            {
                                <MudText Class="py-16" Typo=Typo.h6 Align="Align.Center">
                                    @Localize["Your cart is empty."]
                                </MudText>
                            }
                            else
                            {
                                foreach (var item in _shopCartItems
                                .Where(p => !p.Paid)
                                .GroupBy(p => p.FestivalId))
                                {
                                    var festivalName = item.First().FestivalName;
                                    <MudDivider />
                                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                                        <MudText Typo=Typo.body2>
                                            @(festivalName)
                                        </MudText>
                                        <MudText Typo=Typo.subtitle2>
                                            @item.Sum(p => p.GetRealPrice()).ToString("C2")

                                        </MudText>
                                    </MudStack>
                                    @foreach (var i in item)
                                    {
                                        <MudStack Row="true" Class="ml-4"
                                                  Justify="Justify.SpaceBetween">
                                            @if (i.CartItemType == CartItemType.Submit)
                                            {
                                                <MudText Typo="Typo.caption">@i.SubmitCategoriesName </MudText>
                                            }

                                            @if (i.CartItemType == CartItemType.ServiceFee)
                                            {
                                                <MudText Typo="Typo.caption" Inline="false">Service fee </MudText>
                                            }
                                            @if (i.CartItemType == CartItemType.Product)
                                            {
                                                <MudText Typo="Typo.caption" Inline="false">@i.ProductName</MudText>
                                            }
                                            @if (i.CartItemType == CartItemType.Ticket)
                                            {
                                                <MudText Typo="Typo.caption" Inline="false">@i.SoldTicketName</MudText>
                                            }
                                            @if (i.CartItemType == CartItemType.Badge)
                                            {
                                                <MudText Typo="Typo.caption" Inline="false">@i.SoldTicketName</MudText>
                                            }

                                            @if (i.PriceAfterDiscount == null)
                                            {
                                                <MudText Typo="Typo.caption">
                                                    @i.Price.ToString("C2")
                                                </MudText>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.caption">
                                                    <del> @i.Price.ToString("C2")</del>
                                                    @i.PriceAfterDiscount.Value.ToString("C2")
                                                </MudText>
                                            }
                                        </MudStack>
                                    }
                                }

                                <MudDivider />

                                @foreach (var c in _discountCodes)
                                {
                                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Dark"
                                             OnClose="() => RemoveDiscountCode(c)"
                                             CloseIcon="@Icons.Material.Filled.Delete">@c</MudChip>
                                }
                                <MudTextField Variant="Variant.Outlined"
                                              @bind-Value="_discountCode"
                                              Margin="Margin.Dense"
                                              AdornmentColor="Color.Primary"
                                              Adornment="Adornment.End"
                                              OnAdornmentClick="() => AddDiscountCodes()"
                                              Label="Discount Code"
                                              Placeholder="Enter Your Discount Codes"
                                              AdornmentIcon="@Icons.Material.Filled.Add"></MudTextField>
                            }

                        </MudStack>
                        <MudStack Class="mt-4">
                            <MudStack Row="true" Justify="Justify.SpaceBetween">
                                <MudText Typo=Typo.subtitle1>
                                    <b>@Localize["Checkout total"]:</b>
                                </MudText>
                                <MudText Typo=Typo.subtitle1>
                                    <b>@_shopCartItems?.Where(p => !p.Paid).Sum(p => p.GetRealPrice()).ToString("C2")</b>
                                </MudText>
                            </MudStack>
                            @if (_shopCartItems.Any(p => !p.Paid)
                                                        && _shopCartItems.Where(p => !p.Paid).Sum(p => p.GetRealPrice()) > 0)
                            {
                                    <PaypalButtons @bind-Overaly="IsVisibleOveralls"
                                                   DiscountCodes="_discountCodes"
                                                   PaidSuccessfully="PaidSuccessfully"
                                                   CostumeId="@(_shopCartItems?.Where(p => !p.Paid).FirstOrDefault()?.CartId.ToString())"
                                                   Amount="@_shopCartItems.Where(p => !p.Paid).Sum(p => p.GetRealPrice())">
                                    </PaypalButtons>
                            }
                            else
                            {

                                <MudButton OnClick="PaidZero" Variant="Variant.Filled" Color="Color.Primary"
                                           FullWidth="true"
                                           Disabled="@(!(_shopCartItems?.Where(p=>!p.Paid)).Any())" DisableElevation
                                           Size=@Size.Large>
                                    @Localize["Complete checkout"]
                                </MudButton>
                            }
                        </MudStack>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="8" Class="max-vh-90 overflow-auto cart-items-panel">
                    <div class="animate__animated animate__fadeInDown" style="animation-delay:100ms;animation-duration:1000ms;">
                        <MudStack Spacing="8">
                            @foreach (var cartGrouped in _shopCartItems.GroupBy(p => p.CartId))
                            {
                                foreach (var festivalGrouped in cartGrouped.GroupBy(p => p.FestivalId))
                                {
                                    var festivalFirstItem = festivalGrouped.First();
                                    <div class="cart-festival-group">
                                        <div class="cart-festival-header">
                                            @if (festivalGrouped.Any(p => p.CartItemType is CartItemType.Submit
                                                                          or CartItemType.Badge or CartItemType.Ticket))
                                            {
                                                <MudImage Src="@festivalFirstItem.ImageUrl" Width="88"
                                                          Height="88" Class="rounded" />
                                            }
                                            else
                                            {
                                                <MudImage Src="@ClientAppConstants.SmallLogoUrl"
                                                          Width="88" Height="88" Class="rounded" />
                                            }
                                            <div class="cart-festival-context">
                                                <MudText Typo="Typo.overline">Festival</MudText>
                                                <MudText Typo="Typo.h6" Class="cart-festival-name">
                                                    @(string.IsNullOrWhiteSpace(festivalFirstItem.FestivalName) ? "HiSubmit" : festivalFirstItem.FestivalName)
                                                </MudText>
                                                @if (GetFestivalCategories(festivalGrouped) is { Length: > 0 } categories)
                                                {
                                                    <MudText Typo="Typo.body2" Class="cart-festival-categories">
                                                        <b>Categories:</b> @categories
                                                    </MudText>
                                                }
                                                <MudText Typo="Typo.caption">
                                                    @festivalGrouped.Count() item(s) · @festivalGrouped.Sum(p => p.GetRealPrice()).ToString("C2")
                                                </MudText>
                                            </div>
                                        </div>

                                        <div class="cart-items-table-wrap">
                                            <MudSimpleTable Dense="true" Bordered="true" Class="cart-items-table">
                                                @foreach (var i in festivalGrouped)
                                                {
                                                    <MudTr>
                                                        <MudTd Class="cart-item-main-cell">
                                                            <MudText Typo="Typo.body2" Class="cart-item-title">@GetCartItemTitle(i)</MudText>
                                                            @if (i.CartItemType == CartItemType.Submit &&
                                                                 !string.IsNullOrWhiteSpace(i.SubmitCategoriesName))
                                                            {
                                                                <MudText Typo="Typo.caption" Class="cart-item-meta">
                                                                    <b>Category:</b> @i.SubmitCategoriesName
                                                                </MudText>
                                                            }
                                                            @if (i.CartItemType == CartItemType.Submit &&
                                                                 !string.IsNullOrWhiteSpace(i.SubmitTrackCode))
                                                            {
                                                                <MudText Typo="Typo.caption" Class="cart-item-meta">
                                                                    <b>Tracking:</b> @i.SubmitTrackCode
                                                                </MudText>
                                                            }
                                                        </MudTd>
                                                        <MudTd Class="cart-item-type-cell">
                                                            <MudChip T="string" Label="true" Size="Size.Small" Variant="Variant.Text"
                                                                     Color="Color.Info">
                                                                @i.CartItemType
                                                            </MudChip>
                                                        </MudTd>
                                                        <MudTd Class="cart-item-price-cell">
                                                            @if (i.PriceAfterDiscount == null)
                                                            {
                                                                <MudText Typo="Typo.caption">@i.Price.ToString("C2")</MudText>
                                                            }
                                                            else
                                                            {
                                                                <MudText Typo="Typo.caption">
                                                                    <del>@i.Price.ToString("C2")</del>
                                                                    <span class="cart-discounted-price">@i.PriceAfterDiscount.Value.ToString("C2")</span>
                                                                </MudText>
                                                            }
                                                        </MudTd>
                                                        <MudTd Class="cart-item-action-cell">
                                                            @if (i.CanDelete)
                                                            {
                                                                <MudIconButton Color="Color.Error"
                                                                               Icon="@Icons.Material.Filled.Delete"
                                                                               OnClick="() => DeleteItem(i)"
                                                                               Size="Size.Small" />
                                                            }
                                                        </MudTd>
                                                    </MudTr>
                                                }
                                            </MudSimpleTable>
                                        </div>

                                        <div class="cart-festival-status">
                                            <MudChip T="string" Size="Size.Small" Label="true"
                                                     Color="@(festivalFirstItem.Paid ? Color.Success : Color.Warning)"
                                                     Variant="Variant.Filled">
                                                @(festivalFirstItem.Paid ? "Paid" : "UnPaid")
                                            </MudChip>
                                            @if (festivalFirstItem.Paid)
                                            {
                                                <MudText Typo="Typo.caption">
                                                    Paid date: @festivalFirstItem.PaidDate.ToLongDateString()
                                                </MudText>
                                            }
                                        </div>
                                    </div>
                                    <MudDivider />
                                }
                            }
                        </MudStack>
                    </div>
                </MudItem>
            </MudGrid>
        </MudTabPanel>
        <MudTabPanel Text="@Localize["Receipts"]">
            <Carts />
        </MudTabPanel>
    </MudTabs>
</MudContainer>


