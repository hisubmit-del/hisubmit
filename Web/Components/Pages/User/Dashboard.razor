@page "/user/dashboard"

@using HiSubmit.Client.SharedModels.Extensions
@using Web.Components.Pages.Admin
@* @inherits BaseUserPages *@
@inherits BaseAdminPages

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="dashboard-page-shell user-dashboard-shell">
    <div class="dashboard-page-intro">
        <div>
            <MudText Typo="Typo.overline">Artist workspace</MudText>
            <MudText Typo="Typo.h3">Keep every submission moving</MudText>
            <MudText Typo="Typo.body2">Manage your works, follow submission progress and act on the next deadline from one clear workspace.</MudText>
        </div>
        <MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Size="Size.Large" />
    </div>
    @if (_userLoaded)
    {
        <MudGrid Class="user-card-data dashboard-profile-card">
            <MudItem xs="12" sm="4" md="2" Class="text-center text-md-end">
                <MudAvatar Rounded="true" Class="relative" Style="width:120px;height:120px" Square="true">
                    <MudImage Src="@ImageDataUrl"></MudImage>

                    <MudIconButton Href="/account" Variant="Variant.Outlined"
                    Color="Color.Primary"
                    Class="bg-white"
                    Size="Size.Small"
                    Icon="@Icons.Material.Filled.Edit"
                    Style="position:absolute;right:0;bottom:0px;transform: translate(0, 0)"></MudIconButton>
                </MudAvatar>
            </MudItem>
            <MudItem xs="12" sm="8" md="3" Class="text-user mt-auto">
                <MudText Typo="Typo.subtitle1" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Tertiary"
                             Size="Size.Small"></MudIcon> @_profileModel.FirstName @_profileModel.LastName
                </MudText>
                <MudText Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Email"
                             Color="Color.Tertiary" Size="Size.Small" /> @_profileModel.Email
                </MudText>
            </MudItem>
            <MudItem xs="12" md="4" Class="d-flex align-content-center mt-auto justify-content-center flex-wrap flex-grow-1 gap-4">
                @*  @if (Project.Address != null)
            {<div style="position: absolute; bottom: 0; left: 0; width: 100px; height: 100px; background-color: red; transform: translate(0, 0);"></div>
                <MudText>
                    <MudIcon Icon="@Icons.Material.Filled.LocationOn"
                             Color="Color.Tertiary" Size="Size.Small" /> @Project.Address.ToShortString()
                </MudText>
            } *@
            </MudItem>


            <MudItem xs="12" md="3" Class="text-user mt-auto">
                <MudText Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Phone"
                             Color="Color.Tertiary" Size="Size.Small" /> @_profileModel.PhoneNumber
                </MudText>
            </MudItem>
        </MudGrid>
    }
    @if (_isArtist)
    {
        @if (_accountType.FeeStatus == FeeStatus.Special)
        {
            <MudGrid Class="mt-5">
                <MudItem xs="12">
                    <MudPaper Class="dashboard-section-card pa-5 gold-advisor-card" Elevation="0">
                        <div class="d-flex flex-wrap justify-space-between align-center gap-3">
                            <div>
                                <MudText Typo="Typo.overline">Gold artist advisor</MudText>
                                <MudText Typo="Typo.h6">Find festivals with an open deadline</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    Suggestions use your project type and current public deadlines. They are
                                    recommendations only; you decide where to submit.
                                </MudText>
                            </div>
                            <MudChip T="string" Color="Color.Warning" Icon="@Icons.Material.Filled.Star">
                                Gold active until @_accountType.CloseDate?.ToShortDateString()
                            </MudChip>
                        </div>
                        <MudGrid Class="mt-3">
                            <MudItem xs="12" md="6">
                                <MudSelect T="int" @bind-Value="_selectedRecommendationProjectId"
                                           Label="Project to review" Variant="Variant.Outlined"
                                           Dense="true">
                                    @foreach (var project in _projects)
                                    {
                                        <MudSelectItem Value="@project.Id">@project.Title</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="3" Class="d-flex align-center">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           Disabled="@(_selectedRecommendationProjectId <= 0 || _recommendationsLoading)"
                                           OnClick="LoadGoldRecommendations"
                                           StartIcon="@Icons.Material.Filled.AutoAwesome">
                                    @( _recommendationsLoading ? "Checking..." : "Get suggestions")
                                </MudButton>
                            </MudItem>
                        </MudGrid>
                        @if (_goldRecommendations.Any())
                        {
                            <MudSimpleTable Dense="true" Hover="true" Class="mt-4">
                                <thead>
                                <tr>
                                    <th>Festival</th>
                                    <th>Next deadline</th>
                                    <th>Why it matches</th>
                                    <th></th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var recommendation in _goldRecommendations)
                                {
                                    <tr>
                                        <td>@recommendation.FestivalName</td>
                                        <td>@recommendation.NextDeadline.ToShortDateString()</td>
                                        <td>@recommendation.MatchReason</td>
                                        <td>
                                            <MudButton Href="@($"/festivalpage/{recommendation.FestivalUrl}")"
                                                       Variant="Variant.Text" Color="Color.Primary">
                                                View
                                            </MudButton>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </MudSimpleTable>
                        }
                        else if (!_recommendationsLoading && _selectedRecommendationProjectId > 0)
                        {
                            <MudAlert Severity="Severity.Info" Class="mt-4">
                                No matching public festival with an open deadline was found.
                            </MudAlert>
                        }
                    </MudPaper>
                </MudItem>
            </MudGrid>
        }
        <MudGrid Class="mt-5">
            <MudItem xs="12">
                <MudPaper Class="dashboard-section-card pa-5" Elevation="0">
                    <div class="d-flex flex-wrap justify-space-between align-center gap-3">
                        <div>
                            <MudText Typo="Typo.overline">Artist financial overview</MudText>
                            <MudText Typo="Typo.h6">Your HiSubmit spending and savings</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Paid purchases and the value retained through discounts.
                            </MudText>
                        </div>
                        <MudButton Href="/user/carts" Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.ReceiptLong">
                            View receipts
                        </MudButton>
                    </div>
                    <MudGrid Class="mt-3">
                        <MudItem xs="12" sm="4">
                            <DividerNameValue Class="pa-3"
                                              Icon="@Icons.Material.Filled.Payments"
                                              Name="Paid through HiSubmit"
                                              Value="@_artistPaidTotal.ToString("C2")" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <DividerNameValue Class="pa-3"
                                              Icon="@Icons.Material.Filled.Savings"
                                              Name="Discount savings"
                                              Value="@_artistDiscountTotal.ToString("C2")" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <DividerNameValue Class="pa-3"
                                              Icon="@Icons.Material.Filled.ReceiptLong"
                                              Name="Paid checkouts"
                                              Value="@_artistPaidCartCount.ToString()" />
                        </MudItem>
                    </MudGrid>
                    @if (_artistPaidTotal > 0)
                    {
                        <MudChart Class="mt-4" ChartType="ChartType.Donut"
                                  InputData="@_artistSpendChart"
                                  InputLabels="@(new[] { "Submissions", "Products", "Tickets & badges", "Service fees" })"
                                  ChartOptions="new ChartOptions() { ShowLegend = true, ShowLabels = true }"
                                  Width="320px" Height="240px" />
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
  @if (!isAdmin)
    {
        <MudGrid>
            <MudItem xs="12" md="9" Class="ml-0 my-5 pl-0">
                @if (_submitLoaded)
                {
                    <MudCard Elevation="0" Class="dashboard-section-card">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <TitleWithIcon Typo="Typo.h6" Icon="@Icons.Material.Filled.PersonalVideo">Last Submissions</TitleWithIcon>
                            </CardHeaderContent>
                        </MudCardHeader>

                        <MudCardContent>
                            <MudSimpleTable Elevation="0" Dense="true" Class="table-center">
                                <thead>
                                    <tr>
                                        <th>Logo</th>
                                        <th>Submission Date</th>
                                        <th>project</th>
                                        <th>Enable</th>
                                        <th>Judging</th>
                                    </tr>
                                </thead>
                                <tbody>

                                    @foreach (var submit in _submit)
                                    {
                                        <tr>
                                            <td>
                                                <MudImage height="80" width="80" Src="@submit.FestivalLogoUrl" />
                                            </td>
                                            <td>@submit.SubmitDate.ToShortDateString()</td>
                                            <td>@submit.ProjectTitle</td>
                                            <td><SubmitStatusChip SelectedSubmitStatus="@submit.SubmitStatus" /></td>
                                            <td><JudgingStatusChip SelectedJudgingStatus="@submit.JudgingStatus" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </MudCardContent>
                    </MudCard>
                }

            </MudItem>
            <MudItem xs="12" md="3" Class="mr-0 ">
                @if (_notificationLoaded)
                {
                    <ul>
                        @foreach (var n in _notifications)
                        {
                            <li class="my-1"> @n.Title</li>
                        }
                    </ul>
                }
            </MudItem>
        </MudGrid>

        <MudGrid Class="mt-5">
            <MudCard Class="w-100 dashboard-section-card" Elevation="0">
                <MudCardHeader>
                    <CardHeaderContent>
                        <TitleWithIcon Typo="Typo.h6" Icon="@Icons.Material.Filled.HowToReg">Projects</TitleWithIcon>

                    </CardHeaderContent>
                </MudCardHeader>

                <MudCardContent>
                    @if (_projectLoaded)
                    {
                        <MudGrid>
                            @foreach (var project in _projects)
                            {
                                <MudItem xs="12" md="4" lg="3">
                                    <MudCard class="festival-card project-dashboard-card" Elevation="0"
                                             @onclick="() => EditProject(project.Id)">
                                        <MudCardContent>
                                            <div style="height: 220px" class="d-flex  flex-grow-1 gap-4 justify-center d-relative ">
                                                <img src="@project.FileURl" alt="@project.Title"
                                                     class="align-self-center" style="max-width: 100%;max-height: 100%" />

                                            </div>
                                            <div class="d-flex justify-space-between flex-grow-1 gap-1 mt-2 ">
                                                <MudText Inline="true" Class="h-2em" Typo="Typo.subtitle1"> @project.Title</MudText>

                                                <MudChip T="string" Color="Color.Info"
                                                         Size="Size.Small"
                                                         Label="true">@project.ProjectType.ToDisplay()</MudChip>

                                                @* } *@
                                                @* else *@
                                                @* { *@
                                                @*     <MudChip T="string" Color="Color.Default" Size="Size.Small" Label="true">Not Set</MudChip> *@
                                                @* }
                                        </div>
                                        <div class="d-flex justify-space-between flex-grow-1 gap-1 mt-2">

                                            @* <MudText Typo="Typo.subtitle2" Class="mt-3"> *@
                                                @*     @* <MudIcon Icon="@Icons.Material.Filled.DateRange" Class="mr-1 .mb-m-6"/> *@ 
                                                @*     @ProjectReferee.FestivalIdName *@
                                                @* </MudText> *@ 
                                                @* <MudText Typo="Typo.subtitle2" Class="mt-3"> *@
                                                @*     <MudChip T="string" Color="Color.Secondary" *@
                                                @*              Size="Size.Small" *@
                                                @*              Icon="@Icons.Material.Filled.StarRate" Variant="Variant.Text"> *@
                                                @*         @ProjectReferee.JudgingFiledAverage *@
                                                @*     </MudChip> *@
                                                @* </MudText> *@
                                            </div>

                                        </MudCardContent>

                                    </MudCard>
                                </MudItem>
                            }

                            <MudItem xs="12" md="4" lg="3">
                                <MudCard class="festival-card h-100" Elevation="0">
                                    <MudCardContent>
                                        <div Class="d-flex align-content-center flex-wrap flex-grow-1 gap-4 h-100">
                                            <MudButton Class="w-100 text-center" Href="/user/project">

                                                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Medium"></MudIcon>
                                                <br />
                                                <MudText Typo="Typo.subtitle1">Add New Project</MudText>

                                            </MudButton>
                                        </div>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    }
                </MudCardContent>
            </MudCard>
        </MudGrid>
    }
</MudContainer>

