@page "/user/dashboard"

@using HiSubmit.Client.SharedModels.Extensions
@using Web.Components.Pages.Admin
@* @inherits BaseUserPages *@
@inherits BaseAdminPages

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="dashboard-page-shell user-dashboard-shell">
    @if (_userLoaded)
    {
        <MudGrid class="mt-3 text-start project-specification">
            <div class="container mx-auto" style="height:120px">
            </div>
        </MudGrid>
        <MudGrid Class="user-card-data dashboard-profile-card">
            <MudItem xs="6" md="2" Class="text-end ">
                <MudAvatar Rounded="true" Class="relative" Style="width:120px;height:120px" Square="true">
                    <MudImage Src="@ImageDataUrl"></MudImage>

                    <MudIconButton Href="/account" Variant="Variant.Outlined"
                    Color="Color.Primary"
                    Class="bg-white"
                    Size="Size.Small"
                    Icon="@Icons.Material.Filled.Edit"
                    Style="position:absolute;right:0;bottom:0px;transform: translate(0, 0)"></MudIconButton>
                </MudAvatar>
            </MudItem>
            <MudItem xs="6" md="3" Class="text-user mt-auto">
                <MudText Typo="Typo.subtitle1" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Tertiary"
                             Size="Size.Small"></MudIcon> @_profileModel.FirstName @_profileModel.LastName
                </MudText>
                <MudText Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Email"
                             Color="Color.Tertiary" Size="Size.Small" /> @_profileModel.Email
                </MudText>
            </MudItem>
            <MudItem xs="12" md="4" Class="d-flex align-content-center mt-auto justify-content-center flex-wrap flex-grow-1 gap-4">
                <MudText Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Phone"
                             Color="Color.Tertiary" Size="Size.Small" /> @_profileModel.PhoneNumber
                </MudText>
                @*  @if (Project.Address != null)
            {<div style="position: absolute; bottom: 0; left: 0; width: 100px; height: 100px; background-color: red; transform: translate(0, 0);"></div>
                <MudText>
                    <MudIcon Icon="@Icons.Material.Filled.LocationOn"
                             Color="Color.Tertiary" Size="Size.Small" /> @Project.Address.ToShortString()
                </MudText>
            } *@
            </MudItem>


            <MudItem xs="6" md="3" Class="text-user mt-auto">
                <MudText Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Phone"
                             Color="Color.Tertiary" Size="Size.Small" /> @_profileModel.PhoneNumber
                </MudText>
            </MudItem>
        </MudGrid>
    }
  @if (!isAdmin)
    {
        <MudGrid>
            <MudItem xs="12" md="9" Class="ml-0 my-5 pl-0">
                @if (_submitLoaded)
                {
                    <MudCard Elevation="0" Class="dashboard-section-card">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <TitleWithIcon Typo="Typo.h6" Icon="@Icons.Material.Filled.PersonalVideo">Last Submissions</TitleWithIcon>
                            </CardHeaderContent>
                        </MudCardHeader>

                        <MudCardContent>
                            <MudSimpleTable Elevation="0" Dense="true" Class="table-center">
                                <thead>
                                    <tr>
                                        <th>Logo</th>
                                        <th>Submission Date</th>
                                        <th>project</th>
                                        <th>Enable</th>
                                        <th>Judging</th>
                                    </tr>
                                </thead>
                                <tbody>

                                    @foreach (var submit in _submit)
                                    {
                                        <tr>
                                            <td>
                                                <MudImage height="80" width="80" Src="@submit.FestivalLogoUrl" />
                                            </td>
                                            <td>@submit.SubmitDate.ToShortDateString()</td>
                                            <td>@submit.ProjectTitle</td>
                                            <td><SubmitStatusChip SelectedSubmitStatus="@submit.SubmitStatus" /></td>
                                            <td><JudgingStatusChip SelectedJudgingStatus="@submit.JudgingStatus" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </MudCardContent>
                    </MudCard>
                }

            </MudItem>
            <MudItem xs="12" md="3" Class="mr-0 ">
                @if (_notificationLoaded)
                {
                    <ul>
                        @foreach (var n in _notifications)
                        {
                            <li class="my-1"> @n.Title</li>
                        }
                    </ul>
                }
            </MudItem>
        </MudGrid>

        <MudGrid Class="mt-5">
            <MudCard Class="w-100 dashboard-section-card" Elevation="0">
                <MudCardHeader>
                    <CardHeaderContent>
                        <TitleWithIcon Typo="Typo.h6" Icon="@Icons.Material.Filled.HowToReg">Projects</TitleWithIcon>

                    </CardHeaderContent>
                </MudCardHeader>

                <MudCardContent>
                    @if (_projectLoaded)
                    {
                        <MudGrid>
                            @foreach (var project in _projects)
                            {
                                <MudItem xs="12" md="4" lg="3">
                                    <MudCard class="festival-card project-dashboard-card" Elevation="0"
                                             @onclick="() => EditProject(project.Id)">
                                        <MudCardContent>
                                            <div style="height: 220px" class="d-flex  flex-grow-1 gap-4 justify-center d-relative ">
                                                <img src="@project.FileURl" alt="@project.Title"
                                                     class="align-self-center" style="max-width: 100%;max-height: 100%" />

                                            </div>
                                            <div class="d-flex justify-space-between flex-grow-1 gap-1 mt-2 ">
                                                <MudText Inline="true" Class="h-2em" Typo="Typo.subtitle1"> @project.Title</MudText>

                                                <MudChip T="string" Color="Color.Info"
                                                         Size="Size.Small"
                                                         Label="true">@project.ProjectType.ToDisplay()</MudChip>

                                                @* } *@
                                                @* else *@
                                                @* { *@
                                                @*     <MudChip T="string" Color="Color.Default" Size="Size.Small" Label="true">Not Set</MudChip> *@
                                                @* }
                                        </div>
                                        <div class="d-flex justify-space-between flex-grow-1 gap-1 mt-2">

                                            @* <MudText Typo="Typo.subtitle2" Class="mt-3"> *@
                                                @*     @* <MudIcon Icon="@Icons.Material.Filled.DateRange" Class="mr-1 .mb-m-6"/> *@ 
                                                @*     @ProjectReferee.FestivalIdName *@
                                                @* </MudText> *@ 
                                                @* <MudText Typo="Typo.subtitle2" Class="mt-3"> *@
                                                @*     <MudChip T="string" Color="Color.Secondary" *@
                                                @*              Size="Size.Small" *@
                                                @*              Icon="@Icons.Material.Filled.StarRate" Variant="Variant.Text"> *@
                                                @*         @ProjectReferee.JudgingFiledAverage *@
                                                @*     </MudChip> *@
                                                @* </MudText> *@
                                            </div>

                                        </MudCardContent>

                                    </MudCard>
                                </MudItem>
                            }

                            <MudItem xs="12" md="4" lg="3">
                                <MudCard class="festival-card h-100" Elevation="0">
                                    <MudCardContent>
                                        <div Class="d-flex align-content-center flex-wrap flex-grow-1 gap-4 h-100">
                                            <MudButton Class="w-100 text-center" Href="/user/project">

                                                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Medium"></MudIcon>
                                                <br />
                                                <MudText Typo="Typo.subtitle1">Add New Project</MudText>

                                            </MudButton>
                                        </div>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    }
                </MudCardContent>
            </MudCard>
        </MudGrid>
    }
</MudContainer>

