@using HiSubmit.Client.SharedModels.Constants.Application
@using Microsoft.AspNetCore.SignalR.Client
@using HiSubmit.Client.Infrastructure.Managers.Submits
@using global::Hisubmit.Client.SharedModels.Features.Submits.Commands
@namespace ClientComponents.Shared.Dialogs
@inject IStringLocalizer<WithDrawDialog> localizer
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Logout" Class="mr-3 mb-n1" />
            @localizer["WithDraw Confirmation"]
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText>@ContentText</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@localizer["Cancel"]</MudButton>
        <MudButton Color="@Color" Variant="Variant.Filled" OnClick="Submit">@ButtonText</MudButton>
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    [Parameter] public HubConnection HubConnection { get; set; }

    [Parameter] public string ContentText { get; set; }

    [Parameter] public string ButtonText { get; set; }

    [Parameter] public Color Color { get; set; }

    [Parameter]public  int SubmitId{ get; set; }
    
    [Inject]public  ISubmitManager SubmitManager { get; set; }

    async Task Submit()
    {
    // await HubConnection.SendAsync(ApplicationConstants.SignalR.OnDisconnect, CurrentUserId);
      var response= await SubmitManager.WithDraw(new WithDrawProjectCommand()
        {
            Id =SubmitId
        });

        if (response.Succeeded)
        {
            _snackBar.Add(response.Messages[0], Severity.Success);
            MudDialog.Close();
        }
        else
        {
            foreach (var message in response.Messages)
            {
                _snackBar.Add(message, Severity.Error);
            }
        }
    }
    void Cancel() => MudDialog.Cancel();
}