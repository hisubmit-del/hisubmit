@page "/User/Judges/Dashboard"
@page "/Judges/Dashboard/{UserId}"
@inherits BaseUserPages

<div class="dashboard-page-shell referee-dashboard-shell">
    <div class="dashboard-page-intro">
        <div>
            <MudText Typo="Typo.overline">Judging workspace</MudText>
            <MudText Typo="Typo.h3">Review with clarity and consistency</MudText>
            <MudText Typo="Typo.body2">See the work assigned to you, complete scores in the correct festival context and keep your judging queue moving.</MudText>
        </div>
        <MudIcon Icon="@Icons.Material.Outlined.Score" Size="Size.Large" />
    </div>

@if (_refereeData.RatedProject + _refereeData.NotRatedProject == 0)
{
    <MudGrid>
        <MudAlert ContentAlignment=HorizontalAlignment.Center Variant="Variant.Text" Severity="Severity.Warning"
         Class="pa-3 ma-7 w-100">
            Your judging queue is empty. New festival-scoped assignments will appear here when a manager assigns work to you.
        </MudAlert>
    </MudGrid>
}

else
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
        Your queue is limited to active assignments. Each project remains tied to its festival and assignment period.
    </MudAlert>

    <MudGrid>
        <MudItem >
            <MudPaper Elevation="25"
                      Class="d-flex flex-row pt-3 pb-2  mud-theme-white text-dark">
                <MudIcon Icon="@Icons.Material.Filled.AppRegistration"
                         Color="Color.Tertiary"
                         Class="mx-4"
                         Size="Size.Large"/>
                <div class="pr-10">
                    <MudText Typo="Typo.subtitle1"
                             Color="Color.Dark"
                             Class=" mb-n1">
                        Rated Project
                    </MudText>
                    <MudText Typo="Typo.h6" Color="Color.Tertiary">
                        @_refereeData.RatedProject.ToString()
                    </MudText>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem >
            <MudPaper Elevation="25"
                      Class="d-flex flex-row pt-3 pb-2  mud-theme-white text-dark">
                <MudIcon Icon="@Icons.Material.Filled.AppRegistration"
                         Color="Color.Tertiary"
                         Class="mx-4"
                         Size="Size.Large"/>
                <div class="pr-10">
                    <MudText Typo="Typo.subtitle1"
                             Color="Color.Dark"
                             Class=" mb-n1">
                        Not Rated Project
                    </MudText>
                    <MudText Typo="Typo.h6" Color="Color.Tertiary">
                        @_refereeData.NotRatedProject.ToString()
                    </MudText>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem>
            <MudPaper Elevation="25"
                      Class="d-flex flex-row pt-3 pb-2  mud-theme-white text-dark">
                <MudIcon Icon="@Icons.Material.Filled.AppRegistration"
                         Color="Color.Tertiary"
                         Class="mx-4"
                         Size="Size.Large"/>
                <div class="pr-10">
                    <MudText Typo="Typo.subtitle1"
                             Color="Color.Dark"
                             Class=" mb-n1">
                        All Project
                    </MudText>
                    <MudText Typo="Typo.h6" Color="Color.Tertiary">
                        @(_refereeData.RatedProject + _refereeData.NotRatedProject)
                    </MudText>
                </div>
            </MudPaper>
        </MudItem>
        <MudItem >
            <MudPaper Elevation="25"
                      Class="d-flex flex-row pt-3 pb-2  mud-theme-white text-dark">
                <MudIcon Icon="@Icons.Material.Filled.AppRegistration"
                         Color="Color.Tertiary"
                         Class="mx-4"
                         Size="Size.Large"/>
                <div class="pr-10">
                    <MudText Typo="Typo.subtitle1"
                             Color="Color.Dark"
                             Class=" mb-n1">
                        Average
                    </MudText>
                    <MudText Typo="Typo.h6" Color="Color.Tertiary">
                        @_refereeData.AverageRate.ToString("N1")
                    </MudText>
                </div>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid Class="mt-5">
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4">
                <MudChart ChartType="ChartType.Donut" Width="100%"
                          Height="300px"
                          ChartOptions="new ChartOptions(){
                          ChartPalette=[Colors.Red.Lighten1,Colors.Blue.Lighten1,Colors.Yellow.Lighten1]
    }"
                          InputData="@( [_refereeData.RatedProject, _refereeData.NotRatedProject])"
                          InputLabels="@( ["Rated Project", "Not Rated Project"])">
                </MudChart>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="8">
            <MudCard  Elevation="1" Class="h-100">
                <MudCardHeader>
                    <MudCardHeader>
                        <HeroTitle Align="Align.Center" Title="Not Rate Project"></HeroTitle>
                    </MudCardHeader>
                </MudCardHeader>
                <MudCardContent Class="pa-4">
                    <MudSimpleTable Dense="true" Elevation="0" Class="overflow-auto" Hover="true">
                        <thead>
                        <tr>
                            <th>Title</th>
                            <th>festival</th>
                            <th>Rate</th>
                            <th>Judging result</th>
                            <th>Actions</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in _pagedDate
                                      .Where(p => string.IsNullOrWhiteSpace(p.JudgingButtonName)))
                        {
                            <tr>
                                <td>@item.ProjectName</td>
                                <td>@item.FestivalName</td>
                                <td>@item.JudgingFiledAverage</td>
                                <td>@item.JudgingButtonName</td>
                                <td>
                                    <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                                   Title="Go to Project page"
                                                   Href="@($"/project/{item.ProjectURL}")"/>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </MudSimpleTable>


                    <MudLink Href="/Judges" Class="mt-2" Color="Color.Tertiary">
                        Show more
                        <MudIcon Color="Color.Tertiary" Size="Size.Small"
                                 Icon="@Icons.Material.Filled.ArrowForward"></MudIcon>
                    </MudLink>
                </MudCardContent>

            </MudCard>
        </MudItem>

        <MudItem xs="12">
            <h3 class="sponsored-festival-title">Last Judges</h3>
            <MudGrid>
                @foreach (var item in _pagedDate.Where
                              (p => !string.IsNullOrWhiteSpace(p.JudgingButtonName)))
                {
                    <MudItem xs="12" md="3">
                        <ProjectBox ProjectReferee="item"/>
                    </MudItem>
                }
            </MudGrid>
        </MudItem>
    </MudGrid>
}
</div>
