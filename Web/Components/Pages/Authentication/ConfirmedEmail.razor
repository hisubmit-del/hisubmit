@page "/confirm-email"
@layout MainLayout
@attribute [AllowAnonymous]
@inject IStringLocalizer<Login> Localize
@inherits Web.Components.Pages.Public.BasePublicPages
<MudGrid Class="mt-lg-8" Justify="Justify.Center">
    <MudItem xs="12" md="6" lg="5" Class="pl-0">
        <MudPaper Class="pa-5">
            <EditForm Model="@_model" OnValidSubmit="SubmitAsync">
                <FluentValidationValidator @ref="_fluentValidationValidator" /> 
                <MudGrid Class=" pa-lg-8 pa-2">
                    <DataAnnotationsValidator />
                    <MudItem xs="12">
                        <div class="d-flex justify-center">
                            <MudText Color="Color.Primary" Typo="Typo.h4">@Localize["Verify Account"]</MudText>
                        </div>
                    </MudItem>
                    <MudItem xs="12" Class="text-center">
                        <MudImage Style="width: 60%" Src="@ClientAppConstants.LogoUrl"></MudImage>
                    </MudItem>

                    <MudItem xs="12">
                        <div class="d-flex justify-center">
                            <MudText>
                                We have sent you an email containing the activation code for your account. 
                                Please check your inbox (and spam/junk folder if necessary) to find it
                            </MudText>
                        </div>
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField T="string" Label="@Localize["Code"]"
                                      Required="true" Variant="Variant.Outlined"
                                      @bind-Value="_model.Code" For="@(() => _model.Code)" />
                    </MudItem>
                    
                    <MudItem xs="12">
                        <MudStack Direction="Row" Spacing="2" AlignItems="AlignItems.Center">
                            <MudButton Variant="Variant.Filled" Disabled="!_enableButton"
                                       Color="Color.Primary" OnClick="ResendEmail">
                                Resend Email 
                            </MudButton>

                            <MudText Typo="Typo.body2" Class="ml-2">
                                Didn't receive the email?
                                @if (!_enableButton)
                                {
                                    <span>@CountdownMessage</span>
                                }
                            </MudText>
                        </MudStack>

                    </MudItem>
                  
                 
                    <MudItem xs="12" Class="d-flex justify-center">
                        <LoadingButton Processing="_processing" ButtonType="ButtonType.Submit"
                                       Variant="Variant.Filled" Disabled="@(!_validated)"
                                       Color="Color.Dark" Size="Size.Large"
                                       Style="width: 100%;">@Localize["Verify Account"]</LoadingButton>
                    </MudItem>
                    <MudItem xs="12" Class="text-center">
                        <MudLink Typo="Typo.body1" Href="/account/register">@Localize["Back to Register"]</MudLink>
                    </MudItem>
                </MudGrid>
            </EditForm>
        </MudPaper>
    </MudItem>
</MudGrid>