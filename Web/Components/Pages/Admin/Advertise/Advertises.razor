@page "/admin/advertises"
@using HiSubmit.Client.SharedModels.Extensions
@using global::Hisubmit.Client.SharedModels.Features.Advertises.Queries
@inject IStringLocalizer<Advertises> Localize;
@inherits BaseAdminPages


<MudContainer MaxWidth="MaxWidth.Large">
    <HeroTitle Title="@Localize["Advertisement Request"]" Description="Advertisement Requests & Proposals" />

    <MudTable LoadingProgressColor="Color.Secondary" class="default-light-table"
              Elevation="25" Items="_pagedDate" TotalItems="_totalItems"
              ServerData="@(new Func<TableState, CancellationToken, Task<TableData<GetAllAdvertiseResponse>>>(ServerReload))"
              Hover="true" Dense="true" Bordered="false" Striped="true" @ref="_table">
        <ToolBarContent>
            <ResponsiveButton Class="my-2" Variant="Variant.Filled"
                              OnClick="@(() => OnSearch(""))"
                              StartIcon="@Icons.Material.Filled.Refresh" IconColor="Color.Surface" Color="Color.Secondary">
                              Reload
            </ResponsiveButton>

            <MudSpacer/>

            <MudTextField T="string" ValueChanged="@(OnSearch)"
                          Placeholder="@Localize["Search On Advertise Title and user name and email"]" Adornment="Adornment.End"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium"></MudTextField>

        </ToolBarContent>
        <HeaderContent>
            <MudTh>@Localize["Email"]</MudTh>
            <MudTh>@Localize["User"]</MudTh>
            <MudTh>Request type</MudTh>
            <MudTh>@Localize["Date"]</MudTh>
            <MudTh Style="text-align:center">@Localize["Actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Email">
                <MudHighlighter Text="@context.Email" HighlightedText="@_searchString" />
            </MudTd>
            <MudTd DataLabel="User">
                <MudHighlighter Text="@context.UserName" HighlightedText="@_searchString" />
            </MudTd>
            <MudTd DataLabel="Type">
                <MudText Typo="Typo.caption">@context.AdvertiseType.ToString()</MudText>
            </MudTd>
            <MudTd DataLabel="Date">
                <MudText>@context.CreatedOn.ToLongDate()</MudText>
            </MudTd>
            <MudTd DataLabel="Actions">
                <MudButton StartIcon="@Icons.Material.Filled.Details"
                           OnClick="() => Detail(context.Id)">Detail</MudButton>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <TablePager />
        </PagerContent>
    </MudTable>
</MudContainer>
