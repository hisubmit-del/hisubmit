@page "/admin/faq"
@using HiSubmit.Client.SharedModels.Extensions
@using Hisubmit.Client.SharedModels.Features.StaticPages.Queries
@inject IStringLocalizer<FAQList> Localize;
@inherits BaseAdminPages

<style>
    .mud-table-container {
        overflow: auto;
    }
</style>

<MudContainer MaxWidth="MaxWidth.Large">
    <HeroTitle Title="@Localize["F&Q"]" Description="@Localize["Manage F&Q Pages"]" />

    <MudTable Loading="!_loaded" LoadingProgressColor="Color.Secondary"
              class="default-light-table" Elevation="25" Items="_pagedDate"
              TotalItems="_totalItems"
              ServerData="@(new Func<TableState, CancellationToken, Task<TableData<GetAllStaticPageResponse>>>(ServerReload))"
              Hover="true" Bordered="false" Striped="true" @ref="_table">
        <ToolBarContent>
            <div class="justify-center mud-text-align-center">
                <ResponsiveButton DisableElevation Variant="Variant.Filled" OnClick="@(() => OnSearch(""))"
                                  StartIcon="@Icons.Material.Filled.Refresh" IconColor="Color.Surface"
                                  Class="my-1"
                                  Color="Color.Secondary">@Localize["Reload"]</ResponsiveButton>
                <AuthorizeView Context="authorizeContext"
                               Policy="@Permissions.Contents.UpdateFAQ">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               Class="sticky-bottom-mobile"
                               OnClick="() => InvokeModal(0)" StartIcon="@Icons.Material.Filled.Add">Add Item</MudButton>
                </AuthorizeView>
            </div>
            <MudSpacer />
            <MudTextField T="string" ValueChanged="@(OnSearch)" Placeholder="@Localize["Search"]"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"></MudTextField>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>@Localize["Title"]</MudTh>

            <MudTh>@Localize["Category"]</MudTh>
            <MudTh Style="text-align:center">@Localize["Actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Title">
                <MudHighlighter Text="@context.Title" HighlightedText="@_searchString" />
            </MudTd>

            <MudTd DataLabel="Category">
                @context.FaqType.ToDisplay()
            </MudTd>

            <MudTd DataLabel="Actions">
                <MudHidden Breakpoint="Breakpoint.MdAndDown">
                    <AuthorizeView Context="authorizeContext" Policy="@Permissions.Contents.UpdateFAQ">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Title="Edit" OnClick="() => InvokeModal(context.Id)" Color="Color.Default" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Title="Delete" OnClick="() => Delete(context.Id, context.Title)" Color="Color.Default" />
                    </AuthorizeView>
                    <CopyToClipboard TextToCopy="@context.Link" Size="Size.Small"></CopyToClipboard>
                </MudHidden>
                <MudHidden Breakpoint="Breakpoint.LgAndUp">
                    <MudMenu Label="@Localize["Actions"]" Variant="Variant.Filled" DisableElevation="true"
                             EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Secondary" Direction="Direction.Left" OffsetX="true">
                        <AuthorizeView Context="authorizeContext" Policy="@Permissions.Contents.UpdateFAQ">
                            <MudMenuItem  OnClick="(() => InvokeModal(context.Id))">@Localize["Edit"]</MudMenuItem>
                            <MudMenuItem  OnClick="(() => Delete(context.Id, context.Title))">@Localize["Delete"]</MudMenuItem>
                        </AuthorizeView>
                    </MudMenu>
                </MudHidden>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <TablePager />
        </PagerContent>
    </MudTable>
</MudContainer>
