@page "/admin/menu-items"
@attribute [Authorize(Permissions.Contents.View)]
@inject IStringLocalizer<FooterItem> Localize
@using global::Hisubmit.Client.SharedModels.Features.FooterItems
@using HiSubmit.Client.SharedModels.Extensions
@inherits BaseAdminPages
<style>
    .mud-table-container {
        overflow: auto;
    }
</style>

<MudContainer MaxWidth="MaxWidth.Large">
    <HeroTitle Title="@Localize["Menu Items"]" Description="@Localize["Link & Items in footer and header"]" />

        <MudTable Class="default-light-table" Hover="true" Elevation="25"
                  Loading="!_loaded"
                  Items="_footerItems" Dense="@_dense" Bordered="@_bordered"
                  Striped="@_striped" Filter="new Func<FooterItemDto, bool>(Search)" @bind-brand="_footerItem">
            <ToolBarContent>
                <MudButtonGroup OverrideStyles="false">

                    <AuthorizeView Policy="@Permissions.Contents.UpdateMenuItem">
                        <MudButton  Variant="Variant.Filled" Color="Color.Primary"
                                      Class="sticky-bottom-mobile"
                                          OnClick="(() => InvokeModal(new FooterItemDto()))" StartIcon="@Icons.Material.Filled.Add"
                                          IconColor="Color.Surface">
                            @Localize["Create"]
                        </MudButton>
                    </AuthorizeView>

                    <ResponsiveButton  Variant="Variant.Filled" OnClick="GetArtCategoryAsync"
                                      StartIcon="@Icons.Material.Filled.Refresh" IconColor="Color.Surface" Color="Color.Secondary">
                        @Localize["Reload"]
                    </ResponsiveButton>

                </MudButtonGroup>
                <MudSpacer />
                <MudTextField @bind-Value="_searchString" Immediate="true"
                              Placeholder="@Localize["Search in items"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mb-3">
                </MudTextField>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>
                    @Localize["Title"]
                </MudTh>
                <MudTh>
                    @Localize["Link"]
                </MudTh>
                <MudTh>
                    @Localize["Position"]
                </MudTh>

                <MudTh Style="text-align:right">@Localize["Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Title">
                    <MudHighlighter Text="@context.Title" HighlightedText="@_searchString" />
                </MudTd>
                <MudTd DataLabel="Link">
                    <MudHighlighter Text="@context.Link" HighlightedText="@_searchString" />
                </MudTd>
                <MudTd DataLabel="Position">
                    <MudHighlighter Text="@context.Position.ToDisplay()" HighlightedText="@_searchString" />
                </MudTd>
                <MudTd DataLabel="Actions" Style="text-align: right">
                    <AuthorizeView Context="authorizeView" Policy="@Permissions.Contents.UpdateStaticPage">
                        <MudHidden Breakpoint="Breakpoint.MdAndDown">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Title="Edit"
                                           OnClick="() => InvokeModal(context)" Color="Color.Default">
                            </MudIconButton>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Title="Delete"
                                           OnClick="() => Delete(context.Id, context.Title)" Color="Color.Default">
                            </MudIconButton>
                        </MudHidden>
                        <MudHidden Breakpoint="Breakpoint.LgAndUp">
                            <MudMenu Label="@Localize["Actions"]" Variant="Variant.Filled" DisableElevation="true"
                                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Secondary" Direction="Direction.Left" OffsetX="true">
                                <MudMenuItem OnTouch="() => InvokeModal(context)" OnClick="(() => InvokeModal(context))">@Localize["Edit"]</MudMenuItem>
                                <MudMenuItem OnTouch="() => Delete(context.Id, context.Title)" OnClick="(() => Delete(context.Id, context.Title))">@Localize["Delete"]</MudMenuItem>
                            </MudMenu>
                        </MudHidden>
                    </AuthorizeView>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <TablePager />
            </PagerContent>
        </MudTable>
</MudContainer>