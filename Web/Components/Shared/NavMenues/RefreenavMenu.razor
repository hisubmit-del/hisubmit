@using HiSubmit.Client.SharedModels.Constants.Role
@using Hisubmit.Client.SharedModels.Contracts.Permission
@inject IStringLocalizer<RefreenavMenu> _localizer
@if (IsRefereeRole)
{
    <MudListSubheader Class="mt-2 mb-n2">@_localizer["Judge"]</MudListSubheader>

    <MudNavLink Href="/User/Judges/Dashboard" IconColor="Color.Tertiary" Icon="@Icons.Material.Filled.Dashboard">
        @_localizer["Dashboard"]
    </MudNavLink>
    <MudNavLink Href="/Judges" IconColor="Color.Tertiary" Icon="@Icons.Material.Filled.PersonalVideo">
        @_localizer["Judges"]
    </MudNavLink>
}

@code{

    private bool IsRefereeRole { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var currentUser = await AuthenticationManager.CurrentUser();

        // Festival-scoped referee roles are represented as FestivalRole
        // claims by the server cookie factory and as "festivalId-Referee"
        // claims by the legacy JWT flow. The menu is only a convenience;
        // the API still enforces assignment ownership and status.
        IsRefereeRole = currentUser.Claims
            .Where(claim => claim.Type == ApplicationClaimTypes.FestivalRole)
            .Select(claim => claim.Value?.Split('-', StringSplitOptions.RemoveEmptyEntries).LastOrDefault())
            .Any(role => string.Equals(role, RoleConstants.Referee, StringComparison.OrdinalIgnoreCase));
    }

}
