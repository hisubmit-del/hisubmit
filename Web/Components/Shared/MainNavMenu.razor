@using HiSubmit.Client.Infrastructure.Managers.Contents
@using Hisubmit.Client.SharedModels.Features.FooterItems
@using Hisubmit.Client.SharedModels.Features.FooterItems.Queries.GetAll
@inject IStringLocalizer<MainNavMenu> Localize

<MudNavMenu Dense="false" Class="linear-background"
            Rounded="true" Margin="Margin.Normal" Color="Color.Tertiary">

    <MudNavLink Href="/">
        @Localize["Browse festival"]
    </MudNavLink>
    <MudNavLink Href="/news">
        News
    </MudNavLink>
    <MudNavLink Href="/store">
        Store
    </MudNavLink>
    <MudNavLink Href="/tickets">
        Tickets
    </MudNavLink>

    @foreach (var item in MenuItems.Where
                  (p => p.Position == MenuItemPosition.Header))
    {
        <MudNavLink Href="@item.Link">
            @item.Title
        </MudNavLink>
    }
    
    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="/user/shoppingCart" Icon="@Icons.Material.Outlined.ShoppingCart">
                Cart
            </MudNavLink>
            <MudNavLink Href="/account" Icon="@Icons.Material.Outlined.AccountCircle">
                Profile
            </MudNavLink>
            <MudNavLink Href="/advertise" Icon="@Icons.Material.Outlined.Campaign">
                Advertise
            </MudNavLink>
        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="/account/login" Icon="@Icons.Material.Outlined.Login">
                @Localize["Login"]
            </MudNavLink>
            <MudNavLink Href="/register" Icon="@Icons.Material.Outlined.AppRegistration">
                @Localize["Signup"]
            </MudNavLink>
        </NotAuthorized>
    </AuthorizeView>
</MudNavMenu>

@code
{
    [Parameter] public List<FooterItemDto> MenuItems { get; set; } = new();
    [Inject]
    private IContentManager ContentManager { get; set; }


    protected override async Task OnInitializedAsync()
    {
        await LoadMenuItems();
        await  base.OnInitializedAsync();
    }

    private async Task LoadMenuItems()
    {
        // if (ApplicationState.TryTakeFromJson
        //         <List<FooterItemDto>>("menuitemNavMenu", out var stored))
        // {
        //     MenuItems = stored;
        // }
        // else
        // {
            var response = await ContentManager.GetFooterItems(new GetAllFooterItemQuery());
            if (response.Succeeded)
                MenuItems = response.Data.Where(p => p.Position == MenuItemPosition.Header)
                    .ToList();
        // }
    }
}
