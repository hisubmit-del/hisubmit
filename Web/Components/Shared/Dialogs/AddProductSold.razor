
@inject IStringLocalizer<AddProductSold> Localize;

<EditForm Model="@Product" FormName="product-add-to-cart" OnValidSubmit="SaveAsync">
    <FluentValidationValidator @ref="_fluentValidationValidator"/>
    <MudDialog>
        <TitleContent>
            @{
                <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Update" Class="mr-3 mb-n1"/>
                        @Localize["Add Product To Cart"]
                    </MudText>
            }
        </TitleContent>
        <DialogContent>
            <MudGrid>
                @if (Product.ProductType == ProductType.Downloadable)
                {
                    <MudItem xs="12" md="6">
                        <MudTextField For="@(() => Product.Email)" Variant="Variant.Filled"
                                      @bind-Value="Product.Email" Label="@Localize["Email"]"/>
                    </MudItem>
                }
                
                @if (Product.ProductType == ProductType.Sent)
                {
                    <MudItem xs="12" md="12">
                        <AddressComponent Address="Product.Address"/>
                    </MudItem>   
                }
            </MudGrid>
        </DialogContent>
        <DialogActions>
            <MudButton DisableElevation Variant="Variant.Filled" OnClick="Cancel">@Localize["Cancel"]</MudButton>
          
                <LoadingButton Processing="_processing" DisableElevation Variant="Variant.Filled"
                               ButtonType="ButtonType.Submit"  Color="Color.Success">
                    @Localize["Add To Cart"]
                </LoadingButton>
        </DialogActions>
    </MudDialog>
</EditForm>
