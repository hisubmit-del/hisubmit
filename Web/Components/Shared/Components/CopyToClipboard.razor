<MudIconButton Icon="@Icons.Material.Filled.Copyright" Size="Size" OnClick="CopyToClipBoard"></MudIconButton>
@inherits MudIconButton
@code{

    
    [Inject]
    private  IJSRuntime Js { get; set; }
    
    [Parameter]
    public  string TextToCopy { get; set; }

    private async Task CopyToClipBoard()
    {
        await Js.InvokeVoidAsync("navigator.clipboard.writeText", TextToCopy);
        _snackBar.Add("Saved to clipboard",Severity.Info);
    }
}