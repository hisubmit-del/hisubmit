@using HiSubmit.Client.SharedModels.Extensions
@inject IStringLocalizer<AddEditCategoryDeadLineFee> Localizer
<MudGrid Spacing="2">
  <MudItem xs="12">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="1">
      <MudStack Spacing="0">
        <MudText Typo="Typo.subtitle1">@Fee.DeadLineName</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">@Fee.DeadLineDate.ToLongDate()</MudText>
      </MudStack>
      @if (Fee.StandardFee is null)
      {
        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
          Fee required
        </MudChip>
      }
      else
      {
        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
          Ready
        </MudChip>
      }
    </MudStack>
  </MudItem>

    <MudItem xs="12" md="6" lg="4">
        <MudNumericField @bind-Value="Fee.StandardFee" 
                         Margin="Margin.Dense" 
                         T="double?"
                         Min="0"
                         Required="true"
                         For="()=>Fee.StandardFee"
                         Label="@Localizer["Standard Fee (required)"]"
                         Variant="Variant.Outlined" />
    </MudItem>
    <MudItem xs="12" md="6" lg="4">
        <MudNumericField @bind-Value="Fee.StudentFee"
                         Margin="Margin.Dense" 
                         Min="0"
                         T="double?"
                         For="()=>Fee.StudentFee" 
                         Label="@Localizer["Student Fee"]"
                         Variant="Variant.Outlined" />
    </MudItem>
    <MudItem xs="12" md="6" lg="4">
        <MudNumericField @bind-Value="Fee.GoldFee" 
                         Margin="Margin.Dense"
                         Min="0"
                         T="double?"
                         For="()=>Fee.GoldFee"
                         Label="@Localizer["Gold Fee"]"
                         Variant="Variant.Outlined" />
    </MudItem>
</MudGrid>
