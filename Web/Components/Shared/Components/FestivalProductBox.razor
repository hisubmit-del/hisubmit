@using global::Hisubmit.Client.SharedModels.Features.Products.Queries.GetAllPaged
@using global::Hisubmit.Client.SharedModels.Features.SoldProducts.Commands
@using global::Hisubmit.Client.SharedModels.Features.Locatuions.Commands.AddEdit

<MudCard Class="pa-1 pa-md-3 text-center marketplace-product-card">
    <div class="marketplace-product-card__image">
        <MudImage Src="@Product.ImageDataURL" Class="my-4" Height="200"/>
    </div>
    <MudCardContent>
        @if (!string.IsNullOrWhiteSpace(Product.FestivalName))
        {
            <MudChip T="string" Color="Color.Info" Variant="Variant.Text" Size="Size.Small">@Product.FestivalName</MudChip>
        }
        <MudText Typo="Typo.h6" Class="Product-title">
            <a href="@($"/product/{Product.Id}/{Product.Name}")">
                @Product.Name
            </a>
        </MudText>
        <MudText Typo="Typo.body2" Class="product-card-description">
            @Product.Description
        </MudText>
        <MudText Color="Color.Success" Class="mt-2" Align="Align.Center" Typo="Typo.body1">
            @Product.Price.ToString("C2")
        </MudText>
    </MudCardContent>

    <MudCardActions>
        <MudButton Variant="Variant.Text"
                   OnClick="AddToCart"
                   StartIcon="@Icons.Material.Filled.ShoppingCart"
                   Color="Color.Success">
            Add To Cart
        </MudButton>
        <MudSpacer/>
        <MudButton Href="@($"/product/{Product.Id}/{Product.Name}")" 
                   Variant="Variant.Text"> View Detail </MudButton>
    </MudCardActions>
</MudCard>

@code{

    [Parameter] public GetAllPagedProductsResponse Product { get; set; }

    private async Task AddToCart()
    {
        var productSold = new AddProductSoldCommand
        {
            ProductId = Product.Id,
            ProductType = Product.ProductType,
            Address = new AddEditAddressCommand(),
            Status = ProductSoldStatus.AwaitingPayment
        };
        var parameters = new DialogParameters
        {
            { nameof(AddProductSold.Product), productSold }
        };
        var options = new DialogOptions
        {
            FullWidth = true,
            MaxWidth = MaxWidth.Small,
            
        };
        _dialogService.Show<AddProductSold>("Add Product To Cart", parameters, options);
    }

}
