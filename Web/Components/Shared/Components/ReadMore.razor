<section class="read-more-shell @(_showMore ? "is-expanded" : "is-collapsed")">
    <div class="read-more-content @(_showMore ? "is-expanded" : "is-collapsed")"
         aria-expanded="@_showMore">
        @if (MarkUpString)
        {
            @((MarkupString)(_text ?? string.Empty))
        }
        else
        {
            @_text
        }
    </div>

    @if (IsExpandable)
    {
        <MudButton DisableElevation="true"
                   Variant="Variant.Text"
                   Class="read-more-toggle"
                   OnClick="ToggleShow"
                   EndIcon="@(_showMore ? Icons.Material.Filled.KeyboardDoubleArrowUp : Icons.Material.Filled.KeyboardDoubleArrowDown)"
                   Color="Color.Primary">
            @(_showMore ? "Show less" : "Show more")
        </MudButton>
    }
</section>
