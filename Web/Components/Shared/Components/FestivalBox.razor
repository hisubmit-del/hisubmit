@using global::Hisubmit.Client.SharedModels.Features.AdminFestival.Queries.GetAllFestival

@inject IStringLocalizer<FestivalBox> _Localizer;
<style>
    .member-img{
        margin-bottom: 5px;
        position: relative;
        padding: 5px;
    }
    .member-img img{
        width: 100%;
        height: 140px;
        border-radius: 4px;
    }
    .team-hover{
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color:rgb(78, 126, 149,0.7);
        opacity: 0;
        border-radius: 4px;
        transition: all 500ms;
    }
    .member:hover .team-hover{
        opacity: 1;
    }
    .light-button{
    color: white !important;
    border-color: white !important;
    }
    .team-social-icon{
        position: absolute;
        z-index: 5;top: 0;
        left: 0;
        height: 100%;
        width: 100%;
        padding-top: 5px;
        display:flex;
        align-items: center;
        justify-content: center;
    }
</style>

<div class="member">
    <div class="member-img">
        <img src="@Festival.LogoURL" alt="">
        <div class="team-hover">
            <div class="team-social-icon">
                <MudButton Class="light-button"  OnClick="GoToDetail" Variant="Variant.Outlined"  Color="Color.Secondary">View festival</MudButton>
            </div>
        </div>
    </div>
</div>

@code{

    [Parameter]
    public GetAllFestivalResponse Festival { get; set; }

    private void GoToDetail()
    {
        _navigationManager.NavigateTo($"/festivalpage/{Festival.URL}");
    }
}
