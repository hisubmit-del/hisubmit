@using Web.Components.Shared.Components.ICons
@namespace Web.Components.Shared.Components

@if (UserInHeader)
{
    if (_loaded)
    {
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                 Dense="true" Class="mt-1 ml-1">
            <ActivatorContent>
                @if (string.IsNullOrEmpty(SelectedImageUrl))
                {
                    <MudAvatar Color="Color.Dark">
                        @(string.IsNullOrWhiteSpace(SelectedFullName) ? '?' : SelectedFullName[0])
                    </MudAvatar>
                }
                else
                {
                    <MudAvatar>
                        <MudImage Src="@SelectedImageUrl" Class="h-none" Alt="@SelectedFullName" />
                    </MudAvatar>
                }
            </ActivatorContent>
            <ChildContent>
                <MudCard Elevation="0" Square="true" Class="user-card" Style="min-width: 200px;max-width:270px">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <div class="text-center">
                                @if (_loaded)
                                {
                                    if (string.IsNullOrEmpty(SelectedImageUrl))
                                    {
                                        <MudAvatar Size="Size.Large" Color="Color.Dark">
                                            @(string.IsNullOrWhiteSpace(SelectedFullName) ? '?' : SelectedFullName[0])
                                        </MudAvatar>
                                    }
                                    else
                                    {
                                        <MudAvatar Size="Size.Large">
                                            <MudImage Src="@SelectedImageUrl" Class="h-none" Alt="@SelectedFullName" />
                                        </MudAvatar>
                                    }
                                }
                                <MudText Class=" my-2" Typo="Typo.h5">
                                    @SelectedFullName
                                    @if (_isGoldAccount)
                                    {
                                        <IGold Title="@_goldDescription" Height="25px" Width="25px" />
                                    }
                                </MudText>
                                <MudText Typo="Typo.caption">@SelectedEmail</MudText>
                            </div>
                        </CardHeaderContent>

                    </MudCardHeader>
                </MudCard>
                @if (ShowAnotherAccount)
                {
                    @if (_isAdmin)
                    {
                        <SelectAccountBox FullName="Administrator"
                                          IsAdminAccount="true"
                                          ImageDataUrl="@ImageDataUrl" />
                        <MudDivider />
                    }

                    <SelectAccountBox FullName="@($"{FirstName} {SecondName}")"
                                      IsPersonalAccount="true"
                                      ImageDataUrl="@ImageDataUrl" />
                    
                    <MudDivider />
                    if (FestivalId != 0)
                    {
                        <SelectAccountBox FullName="@Festival.Name"
                                          FestivalId="@FestivalId" ImageDataUrl="@Festival.LogoURL" />
                        <MudDivider />
                    }

                    foreach (var item in
                             FestivalNames.Where(p=>p.Id!=FestivalId))
                    {
                       
                        <SelectAccountBox FullName="@item.Name"
                                          AdminLogin="@item.AdminLogin"
                                          FestivalId="@item.Id" ImageDataUrl="@item.LogoURL" />
                       
                        <MudDivider />
                    }

                    <MudListItem T="string" Text="Logout" Icon="@Icons.Material.Filled.Logout" OnClick="Logout" />
                }
            </ChildContent>
        </MudMenu>
    }
}
else
{
    <div>
        <MudCard Elevation="0" Square="true" Class="user-card">
            <MudCardHeader>
                <CardHeaderContent>
                    <div class="text-center">
                        @if (_loaded)
                        {
                            if (string.IsNullOrEmpty(SelectedImageUrl))
                            {
                                <MudAvatar Color="Color.Dark">
                                    @(string.IsNullOrWhiteSpace(SelectedFullName) ? '?' : SelectedFullName[0])
                                </MudAvatar>
                            }
                            else
                            {
                                <MudAvatar Style="height:50px; width:50px;">
                                    <MudImage Src="@SelectedImageUrl" Alt="@SelectedFullName" />
                                </MudAvatar>
                            }
                        }
                        <MudText Class=" my-2" Typo="Typo.h5">
                            @SelectedFullName
                            @if (_isGoldAccount)
                            {
                                <IGold Title="@_goldDescription" Height="25px" Width="25px" />
                            }
                        </MudText>
                        <MudText Typo="Typo.caption">@SelectedEmail</MudText>
                    </div>
                    <div class="text-center user-card-icons">
                        <MudIconButton Size="Size.Small" Href="@notifUrl" Title="Notifications"
                                       Icon="@Icons.Material.Filled.Notifications" />
                        <MudIconButton Size="Size.Small" Href="@messageUrl" Title="Messages"
                                       Icon="@Icons.Material.Filled.Message" />
                        @if (_selectedFestivalId == null)
                        {
                            <MudIconButton Size="Size.Small" Href="/account"
                                           Title="My Account" Icon="@Icons.Material.Filled.AccountBox" />
                        }
                    </div>
                </CardHeaderContent>
            </MudCardHeader>
        </MudCard>
        @if (ShowAnotherAccount)
        {
            @if (_isAdmin)
            {
                <SelectAccountBox FullName="Administrator"
                                  IsAdminAccount="true"
                                  ImageDataUrl="@ImageDataUrl" />
                <MudDivider />
            }

            <SelectAccountBox FullName="@($"{FirstName} {SecondName}")"
                              IsPersonalAccount="true"
                              ImageDataUrl="@ImageDataUrl" />
            <MudDivider />

            if (FestivalId != 0)
            {
                <SelectAccountBox FullName="@Festival.Name" FestivalId="@FestivalId" ImageDataUrl="@Festival.LogoURL" />
                <MudDivider />
            }

                foreach (var item in  
                FestivalNames.Where(p=>p.Id!=FestivalId))
                {
                    <SelectAccountBox FullName="@item.Name" AdminLogin="@item.AdminLogin"
                                      FestivalId="@item.Id" ImageDataUrl="@item.LogoURL" />
                    <MudDivider />
                }

            <MudListItem T="string" Text="Logout" Icon="@Icons.Material.Filled.Logout" OnClick="Logout" />
        }
    </div>
}
