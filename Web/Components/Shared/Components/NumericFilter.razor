@using Hisubmit.Hisubmit.Client.SharedModels.Features.Payments
@using HiSubmit.Client.SharedModels.Extensions
@typeparam T where T:struct
<style>
    .operator-box {
        border: 1px solid #bbbbbb;
        border-radius: 3px;
        padding:  5px 0;
        color: #aaaaaa;
        text-align: center;
        font-size: 12px;
    }

    .number-box {
        border: 1px solid #bbbbbb;
        padding: 4px;
        border-radius: 3px;
        color: #aaaaaa;
        width: 80px;
    }

    d-none {
        display: none;
    }
</style>

<div class="d-flex gap-1">
    <MudText Class="py-2">@Title :</MudText>
    <InputSelect class="operator-box" @bind-Value="Model.NumberFilterType">
        @foreach (var item in Enum.GetValues<NumberFilterType>())
        {
            <option value="@item">@item.ToDisplay()</option>
        }
        
    </InputSelect>

    <InputNumber TValue="T?" class="number-box" @bind-Value="Model.Number1" />
    
    @if (Model.NumberFilterType == NumberFilterType.Range)
    {
        <InputNumber TValue="T?" class="number-box " @bind-Value="Model.Number2" />
    }
   @*  else
    {
        <span style="width: 90px"></span>
    } *@
</div>

@code {
    [Parameter] public NumberFilter<T> Model { get; set; } = new();
    //[Parameter] public  EventCallback<NumberFilter<T>> ModelChanged { get; set; } = new();

    [Parameter]
    public string Title { get; set; }

}