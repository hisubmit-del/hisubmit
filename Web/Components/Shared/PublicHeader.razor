@using global::Hisubmit.Client.SharedModels.Features.FooterItems
@inject IStringLocalizer<PublicHeader> Localize

@if (_isMobileMenuOpen)
{
    <div class="side-menu-bac show"
         aria-hidden="false"
         @onclick="CloseMobileMenu"></div>
    <div class="side-menu show"
         aria-hidden="false">
        <a href="/" class="public-brand public-brand--drawer" aria-label="HiSubmit home">
            <img src="/assets/img/logo.png" alt="HiSubmit">
            <span>Creative entry, made simple.</span>
        </a>
        <MudIconButton Class="side-menu-close"
                       Icon="@Icons.Material.Outlined.Close"
                       Color="Color.Inherit"
                       UserAttributes="@(new() { { "aria-label", "Close navigation menu" } })"
                       OnClick="CloseMobileMenu" />
        <nav class="menu public-mobile-nav" aria-label="Mobile navigation">
            <ul>
            <li>
                <a class="public-nav-link" href="/" @onclick="CloseMobileMenu">Browse festivals</a>
            </li>
            <li>
                <a class="public-nav-link public-nav-link--featured" href="/news" @onclick="CloseMobileMenu">
                    <MudIcon Icon="@Icons.Material.Outlined.Newspaper" Size="Size.Small" />
                    <span>News</span>
                </a>
            </li>
            <li>
                <a class="public-nav-link" href="/store" @onclick="CloseMobileMenu">
                    <MudIcon Icon="@Icons.Material.Outlined.Storefront" Size="Size.Small" />
                    <span>Store</span>
                </a>
            </li>
            <li>
                <a class="public-nav-link" href="/tickets" @onclick="CloseMobileMenu">
                    <MudIcon Icon="@Icons.Material.Outlined.LocalActivity" Size="Size.Small" />
                    <span>Tickets</span>
                </a>
            </li>
            @foreach (var item in Items)
            {
                <li>
                    <a class="public-nav-link" href="@item.Link" @onclick="CloseMobileMenu">@item.Title</a>
                </li>
            }
            <AuthorizeView>
                <Authorized>
                    <li>
                        <a class="public-nav-link" href="/user/shoppingCart" @onclick="CloseMobileMenu">
                            <MudIcon Icon="@Icons.Material.Outlined.ShoppingCart" Size="Size.Small" />
                            <span>Cart</span>
                        </a>
                    </li>
                    <li>
                        <a class="public-nav-link" href="/account" @onclick="CloseMobileMenu">
                            <MudIcon Icon="@Icons.Material.Outlined.AccountCircle" Size="Size.Small" />
                            <span>Profile</span>
                        </a>
                    </li>
                    <li>
                        <a class="public-nav-link public-nav-link--featured" href="/advertise" @onclick="CloseMobileMenu">
                            <MudIcon Icon="@Icons.Material.Outlined.Campaign" Size="Size.Small" />
                            <span>Advertise</span>
                        </a>
                    </li>
                </Authorized>
                <NotAuthorized>
                    <li>
                        <a class="public-nav-link public-nav-link--login"
                           href="/Account/Login"
                           data-enhance-nav="false"
                           @onclick="CloseMobileMenu">
                            <MudIcon Icon="@Icons.Material.Outlined.Login" Size="Size.Small" />
                            <span>Login</span>
                        </a>
                    </li>
                    <li>
                        <a class="public-nav-cta" href="/register" @onclick="CloseMobileMenu">
                            <MudIcon Icon="@Icons.Material.Outlined.AppRegistration" Size="Size.Small" />
                            <span>Signup</span>
                        </a>
                    </li>
                </NotAuthorized>
            </AuthorizeView>
            </ul>
        </nav>
    </div>
}

<div class="public-announcement">
    <div class="public-announcement__inner">
        <span><MudIcon Icon="@Icons.Material.Outlined.AutoAwesome" Size="Size.Small" /> Creative opportunities, clearly organised.</span>
        <AuthorizeView>
            <Authorized>
                <a href="/advertise">Promote your festival <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" /></a>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

<header id="site-header" class="site-header mud-elevation-1 site-header-background">
    <div class="main-header">
        <div class="container public-header-container">
            <div class="row main-header-row mx-0 public-header-row">
                <a href="/" class="public-brand public-brand--desktop pl-0" aria-label="HiSubmit home">
                    <img class="d-none d-sm-block" src="/assets/img/logo.png" alt="HiSubmit">
                    <span>Creative entry, made simple.</span>
                </a>
                <MudIconButton Class="side-menu-toggle public-mobile-menu-button"
                               Icon="@Icons.Material.Outlined.Menu" 
                               Color="Color.Inherit"
                               UserAttributes="@(new() { { "aria-label", "Open navigation menu" }, { "aria-expanded", _isMobileMenuOpen.ToString().ToLowerInvariant() } })"
                               OnClick="ToggleMobileMenu"></MudIconButton>
                <MudSpacer/>
                <nav class="menu public-nav public-desktop-nav" aria-label="Primary navigation">
                    <ul>
                        <li>
                            <a class="public-nav-link" href="/">Browse festivals</a>
                        </li>
                        <li>
                            <a class="public-nav-link public-nav-link--featured" href="/news">
                                <MudIcon Icon="@Icons.Material.Outlined.Newspaper" Size="Size.Small" />
                                <span>News</span>
                            </a>
                        </li>
                        <li>
                            <a class="public-nav-link" href="/store">
                                <MudIcon Icon="@Icons.Material.Outlined.Storefront" Size="Size.Small" />
                                <span>Store</span>
                            </a>
                        </li>
                        <li>
                            <a class="public-nav-link" href="/tickets">
                                <MudIcon Icon="@Icons.Material.Outlined.LocalActivity" Size="Size.Small" />
                                <span>Tickets</span>
                            </a>
                        </li>
                        @foreach (var item in Items)
                        {
                            <li>
                                <a class="public-nav-link" href="@item.Link">@item.Title</a>
                            </li>
                        }
                        <AuthorizeView>
                            <Authorized>
                                <li class="public-nav-auth">
                                    <a class="public-nav-link" href="/user/shoppingCart">
                                        <MudIcon Icon="@Icons.Material.Outlined.ShoppingCart" Size="Size.Small" />
                                        <span>Cart</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="public-nav-link" href="/advertise">
                                        <MudIcon Icon="@Icons.Material.Outlined.Campaign" Size="Size.Small" />
                                        <span>Advertise</span>
                                    </a>
                                </li>
                            </Authorized>
                            <NotAuthorized>
                                <li class="public-nav-auth">
                                    <a class="public-nav-link public-nav-link--login"
                                       href="/Account/Login"
                                       data-enhance-nav="false">
                                        <MudIcon Icon="@Icons.Material.Outlined.Login" Size="Size.Small" />
                                        <span>Login</span>
                                    </a>
                                </li>
                                <li>
                                    <a class="public-nav-cta" href="/register">
                                        <MudIcon Icon="@Icons.Material.Outlined.AppRegistration" Size="Size.Small" />
                                        <span>Signup</span>
                                    </a>
                                </li>
                            </NotAuthorized>
                        </AuthorizeView>
                    </ul>
                </nav>
                <MudSpacer/>
                <AuthorizeView>
                    <Authorized>
                        <NotificationDropDown/>
                        <UserCartItems/>
                        <UserCard ShowAnotherAccount="true" UserInHeader="true"/>
                    </Authorized>
                    <NotAuthorized>
                        <div class="public-header-auth d-none d-md-flex">
                            <a class="public-nav-link public-nav-link--login"
                               href="/Account/Login"
                               data-enhance-nav="false">
                                <MudIcon Icon="@Icons.Material.Outlined.Login" Size="Size.Small" />
                                <span>Login</span>
                            </a>
                            <a class="public-nav-cta" href="/register">
                                <MudIcon Icon="@Icons.Material.Outlined.AppRegistration" Size="Size.Small" />
                                <span>Signup</span>
                            </a>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>

                <a href="/" class="public-brand public-brand--mobile pl-0" aria-label="HiSubmit home">
                    <img src="/media/logo/logosmal.png" style="width: 57px;height: 57px;" alt="logo">
                </a>
            </div>
        </div>
    </div>
</header>

@code {

    [Parameter]
    public string ImageDataUrl { get; set; }

    [Parameter]
    public char FirstLetterOfName { get; set; }

    [Parameter]
    public EventCallback LogoutClicked { get; set; }

    [Parameter]
    public List<FooterItemDto> Items { get; set; } = new();

    private bool _isMobileMenuOpen;

    private async Task Logout()
    {
        await LogoutClicked.InvokeAsync();
    }

    private void ToggleMobileMenu()
    {
        _isMobileMenuOpen = !_isMobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        _isMobileMenuOpen = false;
    }

}
