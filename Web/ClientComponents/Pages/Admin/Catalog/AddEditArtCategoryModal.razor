@inject IStringLocalizer<AddEditArtCategoryModal> Localize

<EditForm Model="@ArtCategoryModel" OnValidSubmit="SaveAsync">
    <FluentValidationValidator @ref="_fluentValidationValidator" />
    <MudDialog>
        <TitleContent>
            @{
                if (ArtCategoryModel.Id == 0)
                {
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-3 mb-n1" />
                        @Localize["Add ArtCategory"]
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Update" Class="mr-3 mb-n1" />
                        @Localize["Update ArtCategory"]
                    </MudText>
                }
            }
        </TitleContent>
        <DialogContent>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" For="@(() => ArtCategoryModel.Name)" @bind-Value="ArtCategoryModel.Name" Label="@Localize["Name"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField For="@(() => ArtCategoryModel.Description)" @bind-Value="ArtCategoryModel.Description" Label="@Localize["Description"]" />
                </MudItem>
            </MudGrid>
        </DialogContent>
        <DialogActions>
            <MudButton DisableElevation Variant="Variant.Filled" OnClick="Cancel">@Localize["Cancel"]</MudButton>
            @if (ArtCategoryModel.Id != 0)
            {
                <LoadingButton Processing="_processing" DisableElevation Variant="Variant.Filled" ButtonType="ButtonType.Submit" Disabled="@(!Validated)" Color="Color.Secondary">@Localize["Update"]</LoadingButton>
            }
            else
            {
                <LoadingButton Processing="_processing" DisableElevation Variant="Variant.Filled" ButtonType="ButtonType.Submit" Disabled="@(!Validated)" Color="Color.Success">@Localize["Save"]</LoadingButton>
            }
        </DialogActions>
    </MudDialog>
</EditForm>

