@page "/festival/edit"
@page "/admin/festival/{FestivalIdParam:int}"

@using ClientComponents.Pages.Festival.FestivalEditComponent
@using HiSubmit.Client.SharedModels.Extensions
@inject IStringLocalizer<Festival> Localize
@inherits BaseFestival
@if (!_loaded)
{
    <Spinner></Spinner>
}
else
{
    <MudTabs @ref="MainTab" MinimumTabWidth="50" ActivePanelIndex="_activePanelIndex" ActivePanelIndexChanged="ChangeTabChecked"
                Elevation="25"  Color="Color.Surface" Rounded="true" Centered="true" PanelClass="mt-6">
    <MudContainer MaxWidth="MaxWidth.Large">
                <MudPaper Class="relative">
                    @if (FestivalDetail.IsActive)
                    {
                        <MudItem Style="position: absolute;top:15px;right: 25px">
        
                            @if (FestivalDetail.FeeStatus == FeeStatus.Usual)
                            {
                                <MudHidden Breakpoint="Breakpoint.LgAndUp">
                                    <MudIconButton Color="Color.Info" Size="Size.Small" Title="Request To be special"
                                    Icon="@Icons.Material.Filled.FolderSpecial" OnClick="SpecialRequest">
                                        @* <MudChip T="string" Color="Color.Info" Variant="Variant.Text"> *@
                                        @*     Filter to be special *@
                                        @* </MudChip> *@
                                    </MudIconButton>
                                </MudHidden>
                                <MudHidden Breakpoint="Breakpoint.MdAndDown">  
                                    <MudButton Color="Color.Info" Size="Size.Small" OnClick="SpecialRequest">
                                        <MudChip T="string" Label="true" Color="Color.Info" Variant="Variant.Text">
                                            Filter to be special
                                        </MudChip>
                                    </MudButton>
                                </MudHidden>
                            }
                        </MudItem>
                    }
                    else
                    {
                        @if (FestivalDetail.FestivalStatus == FestivalStatus.UnderInvestigation)
                        {
                            <MudChip T="FestivalStatus" Color="Color.Info" Style="position: absolute; top:15px;right:6%;"
                                   Size="Size.Small">@FestivalDetail.FestivalStatus.ToDisplay()</MudChip>
                            // <MudText Align="Align.Center" Class="mb-2" Typo="Typo.subtitle1">
                            //     Not Published
                            // </MudText>
                        }
                        else
                        {
                            <MudHidden Breakpoint="Breakpoint.MdAndDown">
                                <LoadingButton Processing="_releaseProcess" Style="position: absolute; top:15px;right:6%;" Size="Size.Small"
                                               Variant="Variant.Filled" Color="Color.Primary" OnClick="ReleaseFestival">Release FestivalId</LoadingButton>
                            </MudHidden>

                            <MudHidden Breakpoint="Breakpoint.LgAndUp">
                                <MudIconButton Icon="@Icons.Material.Filled.NewReleases" Style="position: absolute; top:15px;right:6%;"
                                               Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="ReleaseFestival"/>
                            </MudHidden>
                        }
                    }
        
                    <MudTabPanel Style="text-transform:none" Text="@Localize["Event Details"]">
                        <FestivalDetail @ref="_festivalDetail" FestivalId="FestivalId" 
                                        NextPanel="() => ChangeTab(1)"></FestivalDetail>
                    </MudTabPanel>
                    <MudTabPanel Style="text-transform:none" Text="@Localize["Contact And Venue"]">
                        <ContactAndVenue @ref="_contactAndVenue" FestivalId="FestivalId" 
                                         NextPanel="() => ChangeTab(2)"
                                         PrevPanel="()=>ChangeTab(0)"></ContactAndVenue>
                    </MudTabPanel>
                    <MudTabPanel Style="text-transform:none" Text="@Localize["DeadLines"]">
                        <FestivalDeadline @ref="_festivalDeadline" 
                                          NextPanel="() => ChangeTab(3)"
                                          PrevPanel="()=>ChangeTab(1)"
                                          FestivalId="FestivalId"/>
                    </MudTabPanel>
                    <MudTabPanel Style="text-transform:none" Text="@Localize["Categories"]">
                        <FestivalEventCategory @ref="_festivalEventCategory"
                                               NextPanel="() => ChangeTab(4)" 
                                               PrevPanel="()=>ChangeTab(2)"
                                               FestivalId="FestivalId"/>
                    </MudTabPanel>
                    <MudTabPanel Style="text-transform:none" Text="@Localize["Files"]">
                        <FestivalFile @ref="_festivalFile" 
                                      NextPanel="() => ChangeTab(5)"
                                      PrevPanel="() => ChangeTab(3)"
                                      FestivalId="FestivalId"></FestivalFile>
                    </MudTabPanel>
                    <MudTabPanel Style="text-transform:none" Text="@Localize["Gallery & Cover"]">
                        <FestivalImages @ref="_festivalImages"
                                        NextPanel="() => ChangeTab(6)"
                                        PrevPanel="() => ChangeTab(4)"
                                        FestivalId="FestivalId"></FestivalImages>
                    </MudTabPanel>
                    <MudTabPanel Style="text-transform:none" Text="@Localize["Additional Setting"]">
                        <FestivalAdditionalSetting @ref="_festivalAdditionalSetting"
                                                   OnReleasedFestivalClick="ReleaseFestival"
                                                   PrevPanel="()=>ChangeTab(5)"
                                                   ReleasProcessing="_releaseProcess"
                            FestivalId="FestivalId"></FestivalAdditionalSetting>
                    </MudTabPanel>
                </MudPaper>
    </MudContainer>
            </MudTabs>
        
}
