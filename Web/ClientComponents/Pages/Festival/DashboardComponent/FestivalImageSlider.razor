<MudCard Class="pa-3">
    <MudCard Outlined="true">
        <MudCarousel Class="mud-width-full"  Style="height: 350px"  ShowArrows="true" ShowBullets="true"  TData="object">
            @foreach (var image in _images)
            {
                <MudCarouselItem Style="align-items: center"  Transition="Transition.Slide" Class="pb-1 px-1 pb-3" Color="@Color.Default">
                    <MudImage   Src="@image.Url"  Class="ma-auto" ObjectFit="ObjectFit.Cover" Style="height: 100%;width: 100%;border-radius: 5px" Alt="@image.Title" Elevation="25"  ></MudImage>
                </MudCarouselItem>
            }
        </MudCarousel>
    </MudCard>
</MudCard>