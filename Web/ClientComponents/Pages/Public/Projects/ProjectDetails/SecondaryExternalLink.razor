@using global::Hisubmit.Client.SharedModels.Features.Projects.Queries.GetAllProjectFiles
@if (DetailLoaded)
{
    @if (Files.Any())
    {
        <div class="side-box mt-3">
            <h6>Other Links</h6>
            @foreach (var file in Files)
            {
                <p class="mb-0">@file.Name</p>
                <a href="@file.FileURL" class="link mt-0" target="_blank">
                    Go To link
                </a>
            }
        </div>
    }
}
@code{

    [Parameter]
    public List<GetAllProjectFileResponse> Files { get; set; }
    
    [Parameter]
    public bool DetailLoaded { get; set; }

}