
@inject IStringLocalizer<AddPhotoModal> Localize

    <MudDialog>
        <TitleContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-3 mb-n1"/>
                @Localize["Add Music"]
            </MudText>
        </TitleContent>
        <DialogContent>
          <MudGrid>
              <MudItem sm="12" Class="mb-3">
                  <EditForm Model="Model">
                      <MudGrid>
                          <FluentValidationValidator @ref="_localFileValidator"></FluentValidationValidator>
                          <MudItem sm="12" md="6" Class="mb-3">
                              <MudTextField @bind-Value="Model.Name" For="@(() => Model.Name)" Label="@Localize["Name"]" Variant="Variant.Filled" Margin="Margin.Dense"/>
                          </MudItem>
                          <MudItem sm="12" md="6" Class="mb-3">
                              <MudSwitch T="bool" Color="Color.Secondary" @bind-Value="Model.IsMainFile" For="@(() => Model.IsMainFile)" Label="@Localize["Is Main File"]"/>
                          </MudItem>
                          <MudItem sm="12" md="6" Class="mb-2">
                              <MudSelect T="FileFormat" @bind-Value="Model.FileFormat" Label="Format" Variant="Variant.Filled" AnchorOrigin="Origin.BottomCenter">
                                  @foreach (FileFormat value in Enum.GetValues(typeof(FileFormat)))
                                  {
                                      <MudSelectItem Value="value"/>
                                  }
                              </MudSelect>
                          </MudItem>
                          <MudItem sm="12" md="6" Class="mb-3">
                              <MudTextField @bind-Value="Model.FileDescription" For="@(() => Model.FileDescription)" Label="@Localize["Description"]" Lines="3" Variant="Variant.Filled" Margin="Margin.Dense"/>
                          </MudItem>
                      </MudGrid>
                  </EditForm>
              </MudItem>
              <MudItem sm="12" Class="mb-3">
                  <InputFile id="fileInput" OnChange="AddToBrowserFile" hidden multiple/>
                  <MudButton HtmlTag="label"
                             Variant="Variant.Filled"
                             Color="Color.Primary"
                             StartIcon="@Icons.Material.Filled.CloudUpload"
                             for="fileInput"
                             Disabled="@(string.IsNullOrWhiteSpace(Model.Name))">
                      Upload Files
                  </MudButton>
                  <MudText Inline="true" Typo="Typo.caption">@_selectedFileName</MudText>
              </MudItem>
              @if (_uploading)
              {
                  <MudProgressLinear Color="Color.Primary" Value="@_percent" Class="my-7"/>
              }
              @* <div>@_echo</div> *@
              <MudItem sm="12" Class="mb-3">
                  <MudButton OnClick="Cancel" Variant="Variant.Filled" Class="ma-2">Cancel</MudButton>
                  <LoadingButton Processing="_processing" ProcessingTitle="@_processingTitle" Variant="Variant.Filled" ButtonType="ButtonType.Button" OnClick="Upload" StartIcon="@Icons.Material.Filled.Save" Color="Color.Primary">
                      @Localize["Upload"]
                  </LoadingButton>
              </MudItem>
          </MudGrid>
        </DialogContent>
        <DialogActions>
            <MudButton DisableElevation Variant="Variant.Filled" OnClick="Cancel">@Localize["Cancel"]</MudButton>
            <LoadingButton Processing="_processing" DisableElevation Variant="Variant.Filled" ButtonType="ButtonType.Submit" Color="Color.Success">@Localize["Save"]</LoadingButton>
        </DialogActions>
    </MudDialog>