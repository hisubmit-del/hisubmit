<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.CrisisAlert" Color="Color.Warning" Class="mr-3 mb-n1" />
            First, log in to the user account
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText>
            To access this possibility, first
            <MudLink Href="/login" Typo="Typo.button" Color="Color.Secondary">login</MudLink>
            to your account
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Ok</MudButton>
    </DialogActions>
</MudDialog>

@code{
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    void Cancel()
    {
        MudDialog.Close();
    }
}