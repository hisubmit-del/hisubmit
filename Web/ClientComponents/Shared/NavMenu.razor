@inject IStringLocalizer<NavMenu> Localize
@using System.Security.Claims
@using global::Hisubmit.Client.SharedModels.Enums
@using global::Hisubmit.Client.SharedModels.Features.FooterItems
@using global::Hisubmit.Client.SharedModels.Features.FooterItems.Queries.GetAll
@using HiSubmit.Client.Infrastructure.Managers.Contents
@using HiSubmit.Client.Infrastructure.Managers.Footer
@using ClientComponents.Shared.NavMenues

@using HiSubmit.Client.SharedModels.Constants.Role
@using Hisubmit.Client.SharedModels.Constants.Storage

<AuthorizeView>
    <Authorized>
        <MudHidden Breakpoint="Breakpoint.LgAndUp">
            @if (AccountPages)
            {
                <MudButton EndIcon="@Icons.Material.Filled.ArrowForward" FullWidth="true" Class="py-4" IconColor="Color.Tertiary" Color="Color.Tertiary"
                           Variant="Variant.Text" OnClick="ToggleMenuItem">
                    @Localize["Main Menu"]
                </MudButton>
            }
            else
            {
                <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" FullWidth="true" Class="py-4" IconColor="Color.Tertiary" Color="Color.Tertiary"
                           Variant="Variant.Text" OnClick="ToggleMenuItem">
                    @Localize["Account Menu"]
                </MudButton>
            }

        </MudHidden>
        <MudHidden Breakpoint="Breakpoint.LgAndUp">
            <UserCard FromNavMenu="true" @ref="_userCardComponent" ShowAnotherAccount="true"/>
        </MudHidden>
        <MudHidden Breakpoint="Breakpoint.MdAndDown">
            <UserCard FromNavMenu="true" @ref="_userCardComponent" ShowAnotherAccount="false"/>
        </MudHidden>
    </Authorized>
</AuthorizeView>
<MudNavMenu Dense="false" Class="linear-background"
            Rounded="true" Margin="Margin.Normal" Color="Color.Tertiary">
    <MudHidden Breakpoint="Breakpoint.MdAndDown">
        @if (IsAdminRole)
        {
            if (_adminSelectedFestival)
            {
                <FestivalNavMenu/>
            }
            else
            {
                <AdminNavMenu/>
            }
        }
        else
        {
            if (SelectedFestivalId == null)
            {
                <ArtistNavMenu/>
                <RefreenavMenu/>
            }
            else
            {
                if (FestivalId == SelectedFestivalId)
                {
                    <FestivalNavMenu/>
                }
                else
                {
                    <OtherFestivalNavMenu SelectedFestivalId="SelectedFestivalId.Value"/>
                }
            }
        }
    </MudHidden>
    <MudHidden Breakpoint="Breakpoint.LgAndUp">
        <AuthorizeView>
            <Authorized>
                @if (AccountPages)
                {
                    if (ShowCreateFestivalButton)
                    {
                        <MudButton OnClick="AddFestival"
                                   Class="my-1"
                                   Variant="Variant.Filled"
                                   FullWidth="true"
                                   Color="Color.Primary">
                            Create Your festival
                        </MudButton>
                    }

                    <AdminNavMenu></AdminNavMenu>
                    if (!IsAdminRole)
                    {
                        if (SelectedFestivalId == null)
                        {
                            <ArtistNavMenu/>
                            <RefreenavMenu/>
                        }
                        else
                        {
                            if (FestivalId == SelectedFestivalId)
                            {
                                <FestivalNavMenu/>
                            }
                            else
                            {
                                <OtherFestivalNavMenu SelectedFestivalId="SelectedFestivalId.Value"/>
                            }
                        }
                    }
                }
                else
                {
                    <MudNavLink Href="/">
                        @Localize["Browse festival"]
                    </MudNavLink>

                    foreach (var item in MenuItems.Where
                                 (p => p.Position == MenuItemPosition.Header))
                    {
                        <MudNavLink Href="@item.Link">
                            @item.Title
                        </MudNavLink>
                    }
                }
            </Authorized>
            <NotAuthorized>
                <MudNavLink Href="/">
                    @Localize["Browse festival"]
                </MudNavLink>

                @foreach (var item in MenuItems.Where
                              (p => p.Position == MenuItemPosition.Header))
                {
                    <MudNavLink Href="@item.Link">
                        @item.Title
                    </MudNavLink>
                }
                <MudNavLink Href="/login" Icon="@Icons.Material.Outlined.Login">
                    @Localize["Login"]
                </MudNavLink>
                <MudNavLink Href="/register" Icon="@Icons.Material.Outlined.AppRegistration">
                    @Localize["Signup"]
                </MudNavLink>
            </NotAuthorized>
        </AuthorizeView>
    </MudHidden>
</MudNavMenu>