@using global::Hisubmit.Client.SharedModels.Features.News.Queries
@using global::Hisubmit.Client.SharedModels.Features.FestivalPaymentItems.Queries.GetAll
@using ClientComponents.Shared.SelectedItems
@using HiSubmit.Client.SharedModels.Extensions
@inject IStringLocalizer<FestivalPaymentItemsList> Localize
<style>
    .mud-table-container {
        overflow: auto;
    }
</style>

<MudTable Loading="!_loaded" FixedHeader="true" 
          LoadingProgressColor="Color.Secondary" class="default-light-table" 
          Elevation="25" Items="PagedDate" Height="300px" TotalItems="_totalItems"
          ServerData="@(new Func<TableState,CancellationToken, Task<TableData<GetAllFestivalPaymentItemResponse>>>(ServerReload))" 
          Hover="true" Dense="true" Bordered="false" Striped="true" @ref="_table">
    <ToolBarContent>
        <div class="justify-center mud-text-align-center">
            <MudHidden Breakpoint="Breakpoint.LgAndUp">
                <MudIconButton DisableElevation Variant="Variant.Filled" OnClick="@(() => OnSearch(""))"
                               Icon="@Icons.Material.Filled.Refresh" Color="Color.Secondary"/>
                @if (IsAdmin)
                {
                    <AuthorizeView Context="authorizeContext" Policy="@Permissions.AdminFestival.UpdatePaymentItem">
                        <Authorized>
                            <MudIconButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Add"
                                           Icon="@Icons.Material.Filled.Add"/>
                        </Authorized>
                    </AuthorizeView>
                }
            </MudHidden>
            <MudHidden Breakpoint="Breakpoint.MdAndDown">
                <MudText Typo="Typo.h5" Inline="true" Color="Color.Primary" 
                         Class="pt-2">Site payments </MudText>
                @if (IsAdmin)
                {
                    <AuthorizeView Context="authorizeContext" Policy="@Permissions.AdminFestival.UpdatePaymentItem">
                        <Authorized>
                            <MudIconButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Add"
                                           Icon="@Icons.Material.Filled.Add"/>
                        </Authorized>
                    </AuthorizeView>
                }
            </MudHidden>
        </div>
        <MudSpacer/>
        <MudTextField T="string" ValueChanged="@(OnSearch)" Placeholder="@Localize["Search"]"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      IconSize="Size.Medium" Class="mt-0">
        </MudTextField>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>@Localize["Amount"]</MudTh>
        <MudTh>@Localize["ItemType"]</MudTh>
        <MudTh>@Localize["Tracking Number"]</MudTh>
        <MudTh>@Localize["Paid Date"]</MudTh>
    </HeaderContent>
    <RowTemplate>
        
        @if (PagedDate.Any())
        {
            <MudTd DataLabel="Name">
                <MudHighlighter Text="@context.Amount.ToString("C2")" HighlightedText="@_searchString"/>
            </MudTd>
            <MudTd DataLabel="ItemType">
                <FestivalPaymentTypeChip SelectedType="@context.Type"/>
            </MudTd>
            <MudTd DataLabel="TrackingNumber">
                <MudHighlighter Text="@context.TrackNumber" HighlightedText="@_searchString"/>
            </MudTd>
            <MudTd DataLabel="TrackingNumber">
                <MudText Typo="Typo.caption">@context.PaidDate.ToLongDate()</MudText>
            </MudTd>
        }
        else
        {
            <MudAlert Variant="Variant.Filled" Severity="Severity.Info" Class="pa-3 ma-3">
                HiSubmit has not yet paid for your festival
            </MudAlert>
        }
        
    </RowTemplate>
    <PagerContent>
        <TablePager/>
    </PagerContent>
</MudTable>
