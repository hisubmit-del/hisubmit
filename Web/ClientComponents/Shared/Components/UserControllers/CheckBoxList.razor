@typeparam T 
@typeparam TItem

@foreach (var item in _checkBoxItems)
{
    <MudCheckBox T="bool" Dense="true"
                 Size="Size.Small"
                 T="bool"
                 ValueChanged="(t)=>SetToSelectedItems(t,item)"
                 Color="Color.Default">
        @item.Name
    </MudCheckBox>
}