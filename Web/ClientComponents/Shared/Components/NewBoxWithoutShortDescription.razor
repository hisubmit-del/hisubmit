@using global::Hisubmit.Client.SharedModels.Features.News.Queries
@using HiSubmit.Client.SharedModels.Extensions
<div class="article-box article-box2 text-center" data-slick-index="2" aria-hidden="false"  tabindex="0">
    <div class="thumbnail">
        <img src="@New.BannerUrl" height="150px" alt="@New.Title">
        @if (ShowFestivalName && !string.IsNullOrWhiteSpace(New.FestivalName))
        {
            <span class="cat">
                @New.FestivalName
            </span>
        }
    </div>
    <div class="content">
        <div class="meta text-secondary my-2">
            <span class="date">
                @New.CreatedOn.ToLongDate()
            </span>
            <span class="h-line"></span>
            @*  <span class="view"> *@
            @*     134 views *@
            @* </span> *@
            <span class="h-line"></span>
            @if (New.CommentCount == 0)
            {
                <span class="comments-count">
                    @New.CommentCount comments
                </span>
            }
            else
            {
                <span class="comments-count">
                    No comments
                </span>
            }
        </div>
        <h5 >
            <a href="@($"/new/{New.Id}")"> @New.Title</a>
        </h5>
        @* <a Href="@($"/new/{New.Id}")" class="read-more" tabindex="0"> *@
        @*     Read more *@
        @*     <svg id="right-arrow" xmlns="http://www.w3.org/2000/svg" width="14" height="9" viewBox="0 0 14 9"> *@
        @*         <path id="Path" d="M13.8,3.986,10.177.211a.671.671,0,0,0-.98,0,.751.751,0,0,0,0,1.026l2.43,2.534H.693a.727.727,0,0,0,0,1.452H11.63L9.2,7.76a.751.751,0,0,0,0,1.026.671.671,0,0,0,.98,0L13.8,5.014A.751.751,0,0,0,13.8,3.986Z" transform="translate(0 0)" fill="#516995"></path> *@
        @*     </svg> *@
        @* </a> *@
    </div>
</div>

@code {

    [Parameter]
    public GetAllNewResponse New { get; set; }

    [Parameter]
    public bool ShowFestivalName { get; set; }

    int _count;

    protected override Task OnInitializedAsync()
    {
        _count = New.ShortDescription.Length;
        if (_count > 200) _count = 200;
        return base.OnInitializedAsync();
    }
}