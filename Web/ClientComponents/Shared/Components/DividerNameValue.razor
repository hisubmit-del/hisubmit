 @inherits MudDivider 
 <style>
    .line-with-text {
      position: relative;
      margin: 20px 5px; /* فاصله بین خط و متن */
    }
    
   .line-with-text hr {
      border: none;
      border-top: 1px dotted white;
      margin: 0;
      padding: 0;
      height: 0!important;     
    }
    
    .text-container {
      display: flex;
      justify-content: space-between;
      position: absolute;
      top: -10px; /* فاصله بین خط و متن را تعیین می کند */
      left: 50%; /* قرار دادن متن در مرکز */
      transform: translateX(-50%);
      background-color: transparent; /* پس زمینه متن */
      padding: 0 0;
       width: 100%;
       /* حاشیه داخلی دو سمت */
    }
    
    .name, .value {      
      background-color:@BackGround;
    }
    
</style>
<div class="line-with-text">
  <hr >
  <div class="text-container">
    <MudText Typo="Typo.subtitle2" class="name pr-2">
       <MudIcon Size="Size.Small" Icon="@Icon"/>
      @Name
    </MudText>
    <MudText Typo="Typo.body1" class="value pl-2">@Value</MudText>
  </div>
</div>
@code{
    [Parameter]
    public  string Name { get; set; }
    [Parameter]
    public  string Value { get; set; }
  [Parameter]
  public  string Icon { get; set; }

  [Parameter]
  public string BackGround { get; set; } = "#fff";

}