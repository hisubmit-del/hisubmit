<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Email Template</title>
    <style type="text/css">
        /* Reset styles */
        body, html {
            margin: 0;
            padding: 0;
            font-family: Arial, Helvetica, sans-serif;
            line-height: 1.4;
            color: #333333;
        }

        /* Main container */
        .email-container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
        }

        /* Header styles */
        .header {
            padding: 20px;
            text-align: center;
            background-color: #f9f9f9;
        }

        .logo {
            max-width: 200px;
            height: auto;
        }

        /* Content styles */
        .content {
            padding: 20px;
        }

        .title {
            font-size: 22px;
            font-weight: bold;
            margin-bottom: 15px;
            color: #222222;
        }

        .text {
            font-size: 16px;
            margin-bottom: 20px;
            line-height: 1.7;
            color:#333333
        }
        .text p{
                color: #333333
            }

        /* Footer styles */
        .footer {
            padding: 20px;
            text-align: center;
            background-color: #f9f9f9;
            font-size: 12px;
            color: #66787f;
        }

        .footer-links {
            margin: 15px 0;
        }

            .footer-links a {
                color: #555555;
                text-decoration: none;
                margin: 0 10px;
            }

        .footer-text {
            line-height: 1.5;
        }
    </style>
</head>
<body>
    <div class="email-container">
     
        <div class="header">
           
            <img src="https://hisubmit.com/media/logo/logo.png" alt="HiSubmit" class="logo">
        </div>

      
        @RenderBody()

       
        <div class="footer">
            <div class="footer-links">
               
                <a href="https://hisubmit.com"> Home</a>
                <a href="https://hisubmit.com"> About Us</a>
                <a href="https://hisubmit.com/FAq"> F&Q </a>
            </div>

            <div class="footer-text">
                HiSubmit makes it easy to discover, submit, and get tickets
                to festivals and contests all over the world
            </div>
        </div>
    </div>
</body>
</html>