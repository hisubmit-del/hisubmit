@using HiSubmit.Client.SharedModels.Extensions
@model Hisubmit.Client.SharedModels.Features.Payments.Queries.GetAllCartsResponse 
<style>
    .cart-table{
    width: 100%;    
    }
    .cart-table,.cart-table tr ,.cart-table td,.cart-table th{
    border: 1px solid #eeeeee;
    }
</style>
<table class="cart-table"
       style="border-radius:4px; border-color:#eeeeee;font-family: Arial, Helvetica, sans-serif;">
    <tbody style="padding: 4px;">
    <tr style="text-align: center; background-color: #eeeeee;">
        <th>Paypal Email</th>
        <th>Payment Id</th>
        <th>Paid date</th>
        <th>Total Price</th>
    </tr>
    <tr style="text-align: center; background-color: #eeeeee;">
        <td>@Model.Email</td>
        <td>@Model.PaymentId</td>
        <td>@Model.CartDate.ToShortDateString()</td>
        <td>@Model.Price.ToString("N2")</td>
    </tr>
    <tr style="text-align: center;">
        <td colspan="4">Cart Items</td>
    </tr>
    <tr style="text-align: center;">
        <th colspan="2">Title</th>
        <th>Item Type</th>
        <th >Cost</th>
    </tr>
   @foreach (var item in Model.CartItems)
   {
       <tr style="text-align: center;">
           <td colspan="2">@item.Title</td>
           <td>@item.CartItemType.ToDisplay()</td>
           <td >@item.Price.ToString("N2")</td>
       </tr>
   }
   
    </tbody>
</table>