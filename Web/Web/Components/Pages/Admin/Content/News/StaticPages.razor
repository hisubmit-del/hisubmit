@page "/admin/static-pages"
@attribute [Authorize(Permissions.Contents.View)]

@using global::Hisubmit.Client.SharedModels.Features.StaticPages.Queries
@inject IStringLocalizer<StaticPages> Localize;
<style>
    .mud-table-container {
        overflow: auto;
    }
</style>
@inherits  BaseAdminPages
<MudContainer MaxWidth="MaxWidth.Large">
<HeroTitle Title="@Localize["static page"]"
           Description="@Localize["static pages such as contact us , lows"]"/>

<MudTable Loading="!_loaded" LoadingProgressColor="Color.Secondary" class="default-light-table" Elevation="25" Items="_pagedDate" TotalItems="_totalItems"
          ServerData="@(new Func<TableState,CancellationToken, Task<TableData<GetAllStaticPageResponse>>>(ServerReload))"
          Hover="true" Bordered="false" Striped="true" @ref="_table">
    <ToolBarContent>
        <MudButtonGroup OverrideStyles="false">
            <MudHidden Breakpoint="Breakpoint.MdAndDown">
                <ResponsiveButton  Variant="Variant.Filled" 

                                   OnClick="@(() => OnSearch(""))" StartIcon="@Icons.Material.Filled.Refresh"
                                   IconColor="Color.Surface" Color="Color.Secondary">@Localize["Reload"]</ResponsiveButton>

                <AuthorizeView Context="authorizeContext" 
                               Policy="@Permissions.Contents.UpdateStaticPage">
                    <ResponsiveButton Variant="Variant.Filled" Color="Color.Primary"
                                      Class="sticky-bottom-mobile"
                                      OnClick="Add" StartIcon="@Icons.Material.Filled.Add">Add Page</ResponsiveButton>
                </AuthorizeView>
            </MudHidden>
        </MudButtonGroup>
        <MudSpacer/>
        <MudTextField T="string" ValueChanged="@(OnSearch)" Placeholder="@Localize["Search"]"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" 
                      IconSize="Size.Medium" Class="mb-3"></MudTextField>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>@Localize["Title"]</MudTh>
        <MudTh>@Localize["Link"]</MudTh>
        <MudTh>@Localize["Show in site"]</MudTh>
        <MudTh Style="text-align:center">@Localize["Actions"]</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Title">
            <MudHighlighter Text="@context.Title" HighlightedText="@_searchString"/>
        </MudTd>
        <MudTd DataLabel="Link">
            <MudHighlighter Text="@context.Link" HighlightedText="@_searchString"/>
        </MudTd>
        <MudTd DataLabel="Status">
            @if (context.IsEnable)
            {
                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success"/>
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error"/>
            }
        </MudTd>
        <MudTd DataLabel="Actions">
            <MudHidden Breakpoint="Breakpoint.MdAndDown">
                <AuthorizeView Context="authorizeContext" Policy="@Permissions.Contents.UpdateStaticPage">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Title="Edit" OnClick="() => Edit(context.Id)" Color="Color.Default"/>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Title="Delete" OnClick="() => Delete(context.Id, context.Title)" Color="Color.Default"/>
                </AuthorizeView>
                <CopyToClipboard TextToCopy="@context.Link" Size="Size.Small"></CopyToClipboard>
            </MudHidden>
            <MudHidden Breakpoint="Breakpoint.LgAndUp">
                <MudMenu Label="@Localize["Actions"]" Variant="Variant.Filled" DisableElevation="true"
                         EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Secondary" Direction="Direction.Left" OffsetX="true">
                    <AuthorizeView Context="authorizeContext" Policy="@Permissions.Contents.UpdateStaticPage">
                        <MudMenuItem OnTouch="() => Edit(context.Id)" OnClick="(() => Edit(context.Id))">@Localize["Edit"]</MudMenuItem>
                        <MudMenuItem OnTouch="() => Delete(context.Id, context.Title)" OnClick="(() => Delete(context.Id, context.Title))">@Localize["Delete"]</MudMenuItem>
                    </AuthorizeView>
                    <MudMenuItem>
                        <CopyToClipboard TextToCopy="@context.Link" Size="Size.Small"/>
                    </MudMenuItem>
                </MudMenu>
            </MudHidden>
        </MudTd>
    </RowTemplate>
    <PagerContent>
        <TablePager/>
    </PagerContent>
</MudTable>
</MudContainer>