@page "/admin/dashboard"
@using Web.Components.Shared.SelectedItems

@inject IStringLocalizer<AdminDashboard> Localize
@inherits BaseAdminPages
<MudGrid Class="mt-3">
    <MudItem xs="6" sm="4" md="4" lg="2">
        <MudPaper Elevation="25"
                  Class="d-flex flex-row pt-3 pb-2  mud-theme-white text-tertiary">
            @* Class="d-flex flex-row pt-3 pb-2 mud-theme-white text-dark"> *@
            <MudIcon Icon="@Icons.Material.Filled.AccountCircle"
                     Color="Color.Tertiary"
                     Class="mx-4"
                     Size="Size.Large" />
            <div>
                <MudText Typo="Typo.subtitle1"
                         Color="Color.Dark"
                         Class=" mb-n1">
                    @Localize["All Account"]
                </MudText>
                <MudText Typo="Typo.h6">
                    @_statusCount.AllAccountCount
                </MudText>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="4" md="4" lg="2">
        <MudPaper Elevation="25"
                  Class="d-flex flex-row pt-3 pb-2  mud-theme-white text-tertiary">
            @* Class="d-flex flex-row pt-3 pb-2 mud-theme-white text-dark"> *@
            <MudIcon Icon="@Icons.Material.Filled.Festival"
                     Color="Color.Tertiary"
                     Class="mx-4"
                     Size="Size.Large" />
            <div>
                <MudText Typo="Typo.subtitle1"
                         Color="Color.Dark"
                         Class=" mb-n1">
                    @Localize["Festivals"]
                </MudText>
                <MudText Typo="Typo.h6">
                    @_statusCount.FestivalCount
                </MudText>
            </div>
        </MudPaper>
    </MudItem>
   @*  <MudItem xs="6" sm="4" md="4" lg="2">
        <MudPaper Elevation="25"
                  Class="d-flex flex-row pt-3 pb-2  mud-theme-white text-tertiary">
            
            <MudIcon Icon="@Icons.Material.Filled.AccountCircle"
                     Color="Color.Tertiary"
                     Class="mx-4"
                     Size="Size.Large" />
            <div>
                <MudText Typo="Typo.subtitle1"
                         Color="Color.Dark"
                         Class=" mb-n1">
                    @Localize["Active Festivals"]
                </MudText>
                <MudText Typo="Typo.h6">
                    @_statusCount.ActiveFestivalCount
                </MudText>
            </div>
        </MudPaper>
    </MudItem> *@
    <MudItem xs="6" sm="4" md="4" lg="2">
        <MudPaper Elevation="25"
                  Class="d-flex flex-row pt-3 pb-2  mud-theme-white text-tertiary">
            @* Class="d-flex flex-row pt-3 pb-2 mud-theme-white text-dark"> *@
            <MudIcon Icon="@Icons.Material.Filled.CameraAlt"
                     Color="Color.Tertiary"
                     Class="mx-4"
                     Size="Size.Large" />
            <div>
                <MudText Typo="Typo.subtitle1"
                         Color="Color.Dark"
                         Class=" mb-n1">
                    @Localize["Project"]
                </MudText>
                <MudText Typo="Typo.h6">
                    @_statusCount.ProjectsCount
                </MudText>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="4" md="4" lg="2">
        <MudPaper Elevation="25"
                  Class="d-flex flex-row pt-3 pb-2  mud-theme-white text-tertiary">
            @* Class="d-flex flex-row pt-3 pb-2 mud-theme-white text-dark"> *@
            <MudIcon Icon="@Icons.Material.Filled.Send"
                     Color="Color.Tertiary"
                     Class="mx-4"
                     Size="Size.Large" />
            <div>
                <MudText Typo="Typo.subtitle1"
                         Color="Color.Dark"
                         Class=" mb-n1">
                    @Localize["Submissions"]
                </MudText>
                <MudText Typo="Typo.h6">
                    @_statusCount.SubmitCount
                </MudText>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="4" md="4" lg="2">
        <MudPaper Elevation="25"
                  Class="d-flex flex-row pt-3 pb-2  mud-theme-white text-tertiary">
            @* Class="d-flex flex-row pt-3 pb-2 mud-theme-white text-dark"> *@
            <MudIcon Icon="@Icons.Material.Filled.Money"
                     Color="Color.Tertiary"
                     Class="mx-4"
                     Size="Size.Large" />
            <div>
                <MudText Typo="Typo.subtitle1"
                         Color="Color.Dark"
                         Class=" mb-n1">
                    @Localize["Transactions"]
                </MudText>
                <MudText Typo="Typo.h6">
                    @_sitePurchase.AllInComes.ToString("C2")
                </MudText>
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" sm="4" md="4" lg="2">
        <MudPaper Elevation="25"
                  Class="d-flex flex-row pt-3 pb-2  mud-theme-white text-tertiary">
            @* Class="d-flex flex-row pt-3 pb-2 mud-theme-white text-dark"> *@
            <MudIcon Icon="@Icons.Material.Filled.AttachMoney"
                     Color="Color.Tertiary"
                     Class="mx-4"
                     Size="Size.Large" />
            <div>
                <MudText Typo="Typo.subtitle1"
                         Color="Color.Dark"
                         Class=" mb-n1">
                    @Localize["Total Incomes"]
                </MudText>
                <MudText Typo="Typo.h6">
                    @_sitePurchase.AllSiteInComes.ToString("C2")
                </MudText>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudGrid>
    @if (_underInvestigationFestivals.Any())
    {
        <MudItem xs="12" lg="6">

            <MudCard Class="pa-4 my-4">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Festivals Pending Approval</MudText>
                <MudSimpleTable Elevation="0">
                    <thead>
                    <th>Festival</th>
                    <th>Status</th>
                    <th>Actions</th>
                    </thead>
                    <tbody>
                        @foreach (var festival in _underInvestigationFestivals)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex">
                                        <MudAvatar>
                                            <MudImage Src="@festival.LogoURL"></MudImage>
                                        </MudAvatar>
                                        <MudText Class="pt-2 ml-2">@festival.Name</MudText>
                                    </div>
                                </td>
                                <td>
                                    <FestivalStatusItems SelectedFestivalStatus="festival.FestivalStatus" />
                                </td>
                                <td>
                                    <MudIconButton Href="/admin/festivals"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   Icon="@Icons.Material.Filled.OpenInNew"></MudIconButton>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudCard>
        </MudItem>
    }

</MudGrid>

<MudGrid Class="mt-8">
    <MudItem xs="12" lg="5">
        <MudPaper Class="pa-7 ">
            <HeroTitle  Title="Website transactions" />
            <div class="d-flex flex-column flex-md-row gap-1 mt-lg-3">
                <div class="flex-1">
                    <MudStack>

                        <DividerNameValue Class="pa-3"
                                          Icon="@Icons.Material.Filled.AppRegistration"
                                          IconColor="@ChartColors.ChartPlate1[0]"
                                          Name="@Localize["Submission"]"
                                          Value="@_sitePurchase.Submission.ToString("C2")"/>
                        <DividerNameValue Class="pa-3"
                                          Icon="@Icons.Material.Filled.DesignServices"
                                          Name="@Localize["Service Fee"]"
                                          IconColor="@ChartColors.ChartPlate1[1]"
                                          Value="@_sitePurchase.ServiceFee.ToString("C2")"/>
                        <DividerNameValue Class="pa-3"
                                          Icon="@Icons.Material.Filled.ProductionQuantityLimits"
                                          Name="@Localize["Product"]"
                                          IconColor="@ChartColors.ChartPlate1[2]"
                                          Value="@_sitePurchase.AllProduct.ToString("C2")"/>
                        <DividerNameValue Class="pa-3"
                                          Icon="@Icons.Material.Filled.AirplaneTicket"
                                          Name="@Localize["Ticket/Badge"]"
                                          IconColor="@ChartColors.ChartPlate1[3]"
                                          Value="@_sitePurchase.AllTicket.ToString("C2")"/>
                    </MudStack>
                </div>

                @if (_loadPurchase)
                {
                    <div class="mx-auto pl-3 flex-1">
                       @if (_sitePurchase.AllInComes > 0)
                       {
                           <MudChart ChartType="ChartType.Pie" InputData="@_pieChartData1"
                                     Class="m-auto"
                                     ChartOptions="new ChartOptions() { ShowLabels = true, ShowLegend = false, ChartPalette = ChartColors.ChartPlate1 }"
                                     InputLabels="@_pieChartLabel1" Width="220px" Height="220px" />
                       }
                    </div>
                }
            </div>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" lg="5">
        <MudPaper Class="pa-7 ">
            <HeroTitle Title="Website Incomes"/>
            <div class="d-flex flex-column-reverse flex-md-row gap-1 mt-lg-3">
                @if (_loadPurchase)
                {
                    <div class="mx-auto flex-1 pl-3">
                        @if (_sitePurchase.AllInComes > 0)
                        {
                            <MudChart ChartType="ChartType.Pie" InputData="@_pieChartData2"
                                      Class="m-auto"
                                      ChartOptions="new ChartOptions() { ShowLabels = true, ShowLegend = false, ChartPalette = ChartColors.ChartPlate1 }"
                                      InputLabels="@_pieChartLabel2" Width="220px" Height="220px"/>
                        }
                    </div>
                }
                <div class="flex-1">
                    <MudStack>
                        <DividerNameValue Class="pa-3"
                                          Icon="@Icons.Material.Filled.AppRegistration"
                                          IconColor="@ChartColors.ChartPlate1[0]"
                                          Name="@Localize["Service Fee"]"
                                          Value="@_sitePurchase.ServiceFee.ToString("C2")"/>

                        <DividerNameValue Class="pa-3"
                                          Icon="@Icons.Material.Filled.ProductionQuantityLimits"
                                          Name="@Localize["Website’s product fee"]"
                                          IconColor="@ChartColors.ChartPlate1[1]"
                                          Value="@_sitePurchase.SiteProduct.ToString("C2")"/>

                        <DividerNameValue Class="pa-3"
                                          Icon="@Icons.Material.Filled.AirplaneTicket"
                                          Name="@Localize[" Website’s Ticket/Badge fee"]"
                                          IconColor="@ChartColors.ChartPlate1[2]"
                                          Value="@_sitePurchase.SiteTicket.ToString("C2")"/>

                        <DividerNameValue Class="pa-3"
                                          Icon="@Icons.Material.Filled.AirplaneTicket"
                                          Name="@Localize["Gold Account Sales"]"
                                          IconColor="@ChartColors.ChartPlate1[3]"
                                          Value="@_sitePurchase.GoldAccount.ToString("C2")"/>
                    </MudStack>
                </div>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>
