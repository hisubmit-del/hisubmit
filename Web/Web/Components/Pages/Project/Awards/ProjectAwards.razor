@inject IStringLocalizer<ProjectAwards> Localize

@using HiSubmit.Client.SharedModels.Extensions
@using HiSubmit.Client.SharedModels.Extensions

@if (!_loaded)
{
    <Spinner></Spinner>
}
else
{
    @if (Request.Awards.Any())
    {
        <MudPaper Elevation="4" Outlined="true" Class="pa-lg-4 pa-2 ">
            <MudText Typo="Typo.subtitle1">@Localize["Award"]</MudText>
            <EditForm EditContext="_editContext">
                <FluentValidationValidator @ref="_fluentValidationValidator"/>

                @foreach (var award in Request.Awards)
                {
                    <MudGrid Class="pl-3 pr-3 pt-3 pb-3 position-relative">

                        <MudItem xs="12" md="6" Class="position-relative" >
                            <MudItem>
                                <MudTextField @bind-Value="@award.Title" 
                                              Label="@Localize["Title"]" For="@(() => award.Title)"
                                              Variant="Variant.Filled" Margin="Margin.Dense"/>
                            </MudItem>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="@award.Location" 
                                          Label="@Localize["Location"]" For="@(() => award.Location)" 
                                          Variant="Variant.Filled" Margin="Margin.Dense"/>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudDatePicker Label="Date" For="@(() => award.Date)"
                                           Editable="true" @bind-Date="@award.Date" 
                                           PickerVariant="PickerVariant.Dialog"
                                           DisableToolbar="true"
                                           DateFormat="@DateTimeExtension.LongDateFormat"/>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="@award.AwardsWon"
                                          Label="@Localize["Awards Won"]"
                                          For="@(() => award.AwardsWon)" Variant="Variant.Filled"
                                          Margin="Margin.Dense"/>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <ImageUploader @bind-Url="@award.ImageUrl" @bind-UploadRequest="@award.UploadRequest"/>
                        </MudItem>
                        <MudItem>
                            <MudButton OnClick="() => DeleteAward(award)"
                                       EndIcon="@Icons.Material.Filled.Delete" 
                                       Color="Color.Error">@Localize["Delete Award"]</MudButton>
                        </MudItem>
                    </MudGrid>
                    <CustomDivider/>
                }
            </EditForm>
        </MudPaper>
    }
    <MudButton EndIcon="@Icons.Material.Filled.Add" Class="mb-2 mt-6"
               Variant="Variant.Filled" OnClick="AddAward" 
               Color="Color.Default">@Localize["Add award"]</MudButton>
}