@inject IStringLocalizer<AddEditProjectSpecification> localizer

@using Web.Components.Pages.Project.Specification

<MudCard Elevation="25">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h3">@localizer["FilmSpecification"]</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    @if (!_loaded)
    {
        <MudContainer MaxWidth="MaxWidth.Medium" >
            <Spinner/>
        </MudContainer>
    }
    else
    {
        <MudCardContent>
            <MudContainer MaxWidth="MaxWidth.Medium">
        
        @switch (ProjectType)
        {
            case ProjectType.Film:
                <FilmSpecification @ref="_filmSpecification" ClickedNextPanel="GoNextPanel"></FilmSpecification>
                break;
            case ProjectType.Music:
                <MusicSpecification @ref="_musicSpecification" ClickedNextPanel="GoNextPanel"></MusicSpecification>
                break;
            case ProjectType.Script_ScreenWriting:
                <ScriptSpecification @ref="_scriptSpecification" ClickedNextPanel="GoNextPanel"></ScriptSpecification>
                break;
            case ProjectType.Photography:
                <PhotographySpecification @ref="_photographySpecification" ClickedNextPanel="GoNextPanel"></PhotographySpecification>
                break;
            case ProjectType.VR_XR:
                <VrXrSpecification @ref="_vrXrSpecification" ClickedNextPanel="GoNextPanel"></VrXrSpecification>
                break;
            case ProjectType.Art:
                break;
            default:
                throw new ArgumentOutOfRangeException();
        }
            </MudContainer>
        </MudCardContent>
    }
</MudCard>
