@page "/file-group-demo"
@using System.IO

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">نمایش فایل‌های هم‌نام</MudText>
    
    <FileGroupViewer Files="@_files" 
                     Title="فایل‌های هم‌نام در پروژه"
                     NoFilesMessage="لطفاً یک پوشه را انتخاب کنید"/>
    
    <MudButton Variant="Variant.Filled" 
               Color="Color.Primary" 
               OnClick="LoadSampleFiles" 
               Class="mt-4">
        بارگذاری فایل‌های نمونه
    </MudButton>
</MudContainer>

@code {
    private List<FileInfo> _files = new();

    private void LoadSampleFiles()
    {
        // این یک نمونه است. در حالت واقعی، شما باید فایل‌های واقعی را از سیستم فایل یا API دریافت کنید
        _files = new List<FileInfo>
        {
            new FileInfo("Component1.razor"),
            new FileInfo("Component1.razor.cs"),
            new FileInfo("Component1.razor.css"),
            new FileInfo("Component2.razor"),
            new FileInfo("Component2.razor.cs"),
            new FileInfo("Component2.razor.css")
        };
    }
} 