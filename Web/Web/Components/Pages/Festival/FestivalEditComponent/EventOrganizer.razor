@inject IStringLocalizer<EventOrganizer> Localize
<MudGrid>
    <MudItem xs="12" md="2">
        <MudStack Row="true" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.subtitle2"> @Localize["Event Organizer"]</MudText>
            <MudHidden Breakpoint="Breakpoint.MdAndUp">
                <MudButton Variant="Variant.Filled" Class="mud-elevation-8"
                           Color="Color.Default" Disabled="ReadOnlyMood"
                           OnClick="()=>InvokeModal()" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add">
                    @Localize["Add Organizer"]
                </MudButton>
            </MudHidden>
        </MudStack>
    </MudItem>
    <MudItem xs="12" md="9">
        <MudTable Class="default-table" Items="@_organizers" Dense="true" 
                  Hover="true" Breakpoint="Breakpoint.Sm" LoadingProgressColor="Color.Info">
            <HeaderContent>
                <MudTh>@Localize["Name"]</MudTh>
                <MudTh>@Localize["Title"]</MudTh>
                <MudTh>
                    @if (!IsAdmin)
                    {
                        <MudButton Variant="Variant.Filled" Class="mud-elevation-8"
                                   Color="Color.Default" Disabled="ReadOnlyMood"
                                   OnClick="()=>InvokeModal()" Size="Size.Medium"
                                   StartIcon="@Icons.Material.Filled.Add">
                            @Localize["Add Organizer"]
                        </MudButton>
                    }
                </MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Title">@context.Title</MudTd>
                <MudTd DataLabel="Actions">
                    @if (!IsAdmin)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Disabled="ReadOnlyMood" OnClick="() => DeleteAsync(context.Id, context.Name)"
                                       Size="Size.Small" aria-label="delete" />

                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Disabled="ReadOnlyMood" OnClick="() => InvokeModal(context)"
                                       Size="Size.Small" aria-label="edit" />
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudItem>
</MudGrid>