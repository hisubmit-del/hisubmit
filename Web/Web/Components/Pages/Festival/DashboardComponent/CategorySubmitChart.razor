@using global::Hisubmit.Client.SharedModels.Features.Submits.Queries.GetAllSubmitsQueries
<style>
    .bar-chart .mud-charts-bar-series path {
    stroke-width: 35px !important;
    }
</style>
<MudCard Class="pa-3 chart-box">
    @if (!_loaded)
    {
        <CustomeProgress/>
    }
    else
    {
        <MudChart Class="bar-chart" Style="overflow: scroll" 
                  ChartOptions="@(new ChartOptions()
                                {LineStrokeWidth = 10,YAxisLines = true,
                                    ChartPalette=ChartColors.ChartPlate2,
                                    MaxNumYAxisTicks = MaxTick,YAxisTicks = Tick})" 
                  ChartType="ChartType.Bar" ChartSeries="@Series" 
                  XAxisLabels="@xLabels" Width="100%" Height="240px"></MudChart>
    }
</MudCard>
