@using global::Hisubmit.Client.SharedModels.Features.Projects.Queries.GetAllProjectFiles
<div class="row pa-2 ma-1 position-relative" style="@($"background:{Colors.BlueGray.Lighten5};")">
    <div class="col-md-3 col-12">
       <MudIcon Icon="@Icons.Material.Filled.Phonelink" Color="Color.Primary" Style="height: 70px;width: 70px"></MudIcon>
    </div>
    <div class="col-md-9 col-12">
        <div class="col-md-8">
            <h4 class="AppName fs-20"> @File.Name </h4>
            <div class="DetailsPageHeader__company">
                <span href="#" class="fs-14">@File.FileDescription</span>
            </div>
            <div class="DetailsPageHeader__subtitles">
                <div class="AppSubtitles">
                    <div class="fs-12 AppSubtitles__item AppSubtitles__item--clickable">
                        Password:@File.Password
                    </div>
                </div>
            </div>
        </div>
        <div style="position: absolute;right: 5px;bottom: 5px;">
            <a href="@File.FileURL" data-size="lg" data-color="primary"
               data-arrow-focusable="" autofocus="autofocus" class="AppInstallBtn newbtn">
                <MudText Inline="true" Color="Color.Primary">Go To Link</MudText>
                <MudIcon Icon="@Icons.Material.Filled.ArrowRight" Color="Color.Primary" Size="Size.Small"/>
            </a>
        </div>
    </div>
</div>

@code
{
    [Parameter]
    public GetAllProjectFileResponse File { get; set; }
}