<div>
    <h2 class="mb-5">Approved By</h2>
    <div class="organizers">
        @foreach (var q in SelectedQualifures)
        {
            var qualify
                = _qualifires.FirstOrDefault(p => p.Id == q);
            if (qualify == null) continue;
            
            <div class="approved-box">
                <div class="image">
                    <img src="@qualify.LogoName" alt="@qualify.Name">
                </div>
                <div class="content text-center">
                    <h3>@qualify.Name</h3>
                </div>
            </div>
        }
    </div>
</div>
