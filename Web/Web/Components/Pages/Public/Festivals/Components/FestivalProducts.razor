@using global::Hisubmit.Client.SharedModels.Features.Products.Queries.GetAllPaged
<MudGrid>
    @foreach (var product in Products)
    {
        <MudItem xs="12" lg="4" md="6" xl="3">
            <FestivalProductBox Product="product"/>
        </MudItem>
    }
</MudGrid>


@code{

    [Parameter]
    public List<GetAllPagedProductsResponse> Products { get; set; } = new();

}