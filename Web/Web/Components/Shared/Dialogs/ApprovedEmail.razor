<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-3 mb-n1" />
            Pending approval
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText>Your request will be processed on the website after admin approval,
            and you will be notified of the admin's decision via email</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Ok</MudButton>
    </DialogActions>
</MudDialog>

@code
{
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    private void Close()
    {
        MudDialog.Close();
    }
}
