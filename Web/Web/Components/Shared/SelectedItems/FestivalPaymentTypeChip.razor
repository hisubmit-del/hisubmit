
@using HiSubmit.Client.SharedModels.Extensions
@using Hisubmit.Client.SharedModels.Enums.Festivals
@switch (SelectedType)
{
    case FestivalPaymentType.Paypal:
        <MudChip T="string"  Size="Size.Small" Variant="Variant.Text" Color="Color.Info" >@SelectedType.ToDisplay()</MudChip>
        break;
    case FestivalPaymentType.DebitCard:
        <MudChip T="string"   Size="Size.Small" Variant="Variant.Text" Color="Color.Success" >@SelectedType.ToDisplay()</MudChip>
        break;
    default:
        throw new ArgumentOutOfRangeException();
}


@code{

    [Parameter]
    public FestivalPaymentType SelectedType { get; set; }

}