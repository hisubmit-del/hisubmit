@inject IStringLocalizer<AddEditSeoTagForm> Localize

<MudGrid Class="mt-3">
    <CustomDivider />
    <TitleWithIcon Class="my-2" IconSize="Size.Large"
                   Icon="@Icons.Material.Filled.Search" Typo="Typo.h5">
        @Localize["Seo Settings"]
    </TitleWithIcon>
    <MudItem xs="12" Class="pa-0 ma-0">
    </MudItem>
    <MudItem xs="12" md="6">
        <MudTextField Counter="0" Immediate="true" For="@(() => Model.Title)" Variant="Variant.Filled"
                      @bind-Value="Model.Title" Label="@Localize["Title"]"
                      HelperText="It is better not to exceed 70 characters" />
    </MudItem>

    <MudItem xs="12">
        <ChipsetTextField @bind-Value="@Model.MetaKeywords"
                          Label="Genres" HelperText="Separate keywords with the - character"/>
    </MudItem>
    <MudItem xs="12" md="12">
        <MudTextField For="@(() => Model.Description)"
                      Counter="0"
                      Immediate="true"
                      Variant="Variant.Filled" @bind-Value="Model.Description"
                      HelperText="It is better not to exceed 160 characters"
                      Label="@Localize["Description"]" Lines="3" />
    </MudItem>

    <MudItem xs="12" md="6">
        <MudTextField Counter="0" Immediate="true" For="@(() => Model.CanonicalUrl)" Variant="Variant.Filled"
                      @bind-Value="Model.CanonicalUrl" Label="@Localize["CanonicalUrl"]"
                      HelperText="The preferred version of a webpage to avoid duplicate content issues in search engines" />
    </MudItem>
 


    <MudItem xs="12" md="12">
        <MudCheckBox T="bool" @bind-Value="@Model.Index"
                     Label="Allow search engine to show this page in search results" />
    </MudItem>
    <MudItem xs="12" md="12">
        <MudCheckBox T="bool" @bind-Value="@Model.Index"
                     Label="Should search engines follow links in this page" />
    </MudItem>
</MudGrid>
