<PageTitle>
    @_seoTags.Title
</PageTitle>
<HeadContent>
    <meta name="description" content="@_seoTags.Description"/>
    <meta name="robots" content="@($"{_index},{_follow}")">

    <meta charset="utf-8"/>
    <meta name=viewport content="width=device-width, initial-scale=1">
    
    <link rel="canonical" href="@_seoTags.CanonicalUrl" />
    
    <meta name="keywords" content="@_seoTags.MetaKeywords" />

    <meta property="og:title" content="@_seoTags.Title" />
    <meta property="og:description" content="@_seoTags.Description" />
   @if (string.IsNullOrWhiteSpace(OgImageUrl))
    {
        <meta property="og:image" content="@OgImageUrl" />
    }
    <meta property="og:url" content="@_seoTags.CanonicalUrl" />
    <meta property="og:type" content="website" />

</HeadContent>

