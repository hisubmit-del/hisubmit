
@inject IStringLocalizer<NewCountrySelector> Localize 
     
<MudAutocomplete T="int"
                 Label="@Localize["Country"]"
                 ValueChanged="@(ChangeCountry)"
                 Error="HasError" ErrorText="@_errorText"
                 Value="CountryId" ResetValueOnEmptyText="true" 
                 SearchFunc="@SearchCountries" Variant="SelectorVariant" Margin="Margin.Dense" 
                 ToStringFunc="@(i => Countries.FirstOrDefault(b => b.Id == i)?.Name ?? string.Empty)" OffsetY="true" />

