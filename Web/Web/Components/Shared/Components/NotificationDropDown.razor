@if (_items.Any())
{
    <MudMenu AnchorOrigin="Origin.BottomLeft"
             TransformOrigin="Origin.TopRight"
             Class="mr-2"
             Direction="Direction.Right">
        <ActivatorContent>
            <MudBadge Color="Color.Primary"
                      Content="@_items.Count"
                      Overlap="true"
                      Origin="Origin.TopRight">
                     <MudIcon
                                        Size="Size.Large"
                                        Icon="@Icons.Material.Rounded.Notifications"
                                        Color="Color.Dark"/>
            </MudBadge>
        </ActivatorContent>
        <ChildContent >
            <MudSimpleTable Dense="true" Elevation="0" Bordered="false" Class="default-simple-table px-2">
                <tbody>
                @foreach (var group in _items.GroupBy(p => p.NotificationType))
                {
                    var item = group.First();
                    <tr>
                        <div class="my-4">
                            @if (group.Count() > 1)
                            {
                                <MudBadge Color="Color.Info" Content="@group.Count()" Overlap="true" Origin="Origin.TopRight">
                                    <MudIcon Icon="@Icons.Material.Filled.Notifications" Size="Size.Small" />
                                </MudBadge>
                            }else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Notifications" Size="Size.Small" />
                            }
                            <MudText Inline="true" Typo="Typo.body2" class="ma-2">
                                @item.Title
                                <MudLink Typo=Typo.caption  Href="@item.Link">Show More</MudLink>
                            </MudText>
                        </div>
                    </tr>
                }
                </tbody>
            </MudSimpleTable>
        </ChildContent>
    </MudMenu>
}


