@inject IStringLocalizer<FormCreator> Localize


<MudCard Elevation="0">
    <MudCardHeader>
        <MudText Color="Color.Primary" Typo="Typo.h5">@Description</MudText>
        @* <br/> *@
        @*                 <MudText Class="mt-2" Typo="Typo.body1">@Description</MudText> *@
    </MudCardHeader>
    <MudCardContent>
        <MudContainer>
            @if (_loaded)
            {
                @foreach (var question in Questions.OrderBy(p=>p.Questiontype))
                {
                    switch (question.Questiontype)
                    {
                        case Questiontype.CheckBox:

                            <MudGrid class="mb-3">
                                <MudItem xs="12" md="4" Class="d-flex mb-2">
                                    <MudText Typo="Typo.subtitle2" Class="my-auto" >
                                        @question.Title
                                    </MudText>
                                </MudItem>
                                <MudItem xs="12" md="8" Class="d-flex">

                                    @{
                                        var questionOptions = _checkedBoxOptions[question.Id];
                                        foreach (var option in questionOptions)
                                        {
                                            <MudItem xs="6" md="3" Class="d-flex">
                                                <MudCheckBox  Size="Size.Small" T="bool" @bind-Value="option.IsSelected">
                                                    @option.Name
                                                </MudCheckBox>
                                            </MudItem>
                                        }
                                    }

                                </MudItem>
                            </MudGrid>

                            break;

                        case Questiontype.DropDownMenu:
                            <MudGrid class="mb-3">
                                <MudItem xs="12" md="4" Class="d-flex">
                                    <MudText Typo="Typo.subtitle2" Class="my-auto">
                                        @question.Title
                                    </MudText>
                                </MudItem>
                                <MudItem >
                                    <MudSelect Variant="Variant.Outlined"
                                               @bind-Value="@(_selectedOptions[question.Id])"
                                              >
                                        @foreach (var option in question.Options)
                                        {
                                            <MudSelectItem Value="@option.Id">
                                                @option.Title
                                            </MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                            </MudGrid>
                            break;

                        case Questiontype.True_False:

                            <MudGrid class="mb-3">
                                <MudItem xs="12" md="4" Class="d-flex">
                                    <MudText Typo="Typo.subtitle2" Class="my-auto" >
                                        @question.Title
                                    </MudText>
                                </MudItem>
                                <MudItem >
                                    <MudSelect Variant="Variant.Outlined"
                                               @bind-Value="@(_trueOrFalseOptions[question.Id])">
                                        <MudSelectItem Value="true">@Localize["True"]</MudSelectItem>
                                        <MudSelectItem Value="false">@Localize["False"]</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                            </MudGrid>
                            break;

                        case Questiontype.Text:
                            <MudGrid class="mb-3">
                                <MudItem xs="12" md="4" Class="d-flex">
                                    <MudText Typo="Typo.subtitle2" Class="my-auto" >
                                        @question.Title
                                    </MudText>
                                </MudItem>
                                <MudItem >
                                    <MudTextField Variant="Variant.Outlined" Class="w-350"
                                                  @bind-Value="_textAndTextAreas[question.Id]"></MudTextField>
                                </MudItem>
                            </MudGrid>
                            break;

                        case Questiontype.TextArea:
                            <MudGrid class="mb-3">
                                <MudItem xs="12" md="4" Class="d-flex">
                                    <MudText Typo="Typo.subtitle2" Class="mt-3">
                                        @question.Title
                                    </MudText>
                                </MudItem>
                                <MudItem >
                                    <MudTextField Lines="3" Variant="Variant.Outlined" Class="w-350"
                                                  @bind-Value="_textAndTextAreas[question.Id]"></MudTextField>
                                </MudItem>
                            </MudGrid>
                            break;
                    }
                }

                <div>
                    <MudSpacer/>
                    <MudButton Class="mt-2 mb-4"
                               ButtonType="ButtonType.Button"
                               Color="Color.Primary"
                               Variant="Variant.Filled"
                               OnClick="SubmitForm">
                        @SubmitButtonText
                    </MudButton>
                </div>
            }
        </MudContainer>
    </MudCardContent>
</MudCard>