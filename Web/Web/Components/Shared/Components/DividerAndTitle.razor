@*         @Title *@
@*     </MudText> *@
@* </MudPaper> *@
<style>
.divider-title{
position: relative;
margin: 20px 4px;
}
    .divider-title:before{
        width: 100%;
        height: 4px;
        background-color: #edf1f4;
        position: absolute;
        content: '';
        border-radius: 100%;
        -moz-border-radius: 100%;
        -webkit-border-radius: 100%;
        right: 0;
        top: 14px;
        z-index: 1;
    }
    
    .divider-title .inside{
    width: auto;
        padding: 0 10px;
        background-color: @BackGround;
        z-index: 2;
        display: table;
        margin: 0 auto;
        text-align: center;
        position: relative;
    }
</style>

<div class="divider-title">
    <div class="inside">
    <MudText  Typo="Typo.subtitle1">@Title</MudText>
    </div>
</div>
@code{
    [Parameter]
    public  string Title { get; set; }

    [Parameter]
    public string BackGround { get; set; } = "#fff";

}