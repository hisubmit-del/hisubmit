@using HiSubmit.Application.Extensions
@using Hisubmit.Client.SharedModels.Enums
@using HiSubmit.Client.SharedModels.Extensions
@using Hisubmit.Client.SharedModels.Features.Payments.Queries
@model Hisubmit.Client.SharedModels.Features.Payments.Queries.GetAllCartsResponse
@{
    var discountCodes = Model.CartItems
        .Where(p => !string.IsNullOrWhiteSpace(p.DiscountCode))
        .Select(p => p.DiscountCode)
        .Distinct()
        .ToList();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Cart</title>
</head>
<body style="font-family: Arial, Helvetica, sans-serif;">
<style>
    .cart-table{
    margin: 5px 5px 20px 5px;   
    width: 100%;    
    }
    .cart-table,.cart-table tr ,.cart-table td,.cart-table th{
    border: 1px solid #eeeeee;
    
    }
    .cart-table th,.cart-table td{
    padding: 5px;
    /*height: 100%;*/
    }
     .question-box p{
     font-size: 14px;
     }
</style>

