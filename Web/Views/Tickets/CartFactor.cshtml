    @* </div> *@
    @* *@
    @if (Model.CartItems.Any(p => p.CartItemType == CartItemType.ServiceFee || p.CartItemType == CartItemType.Submit))
    {
      <h3 style="margin: 20px">Submit Detail</h3> 
    <table class="cart-table" style="width: 100%;">
    <tr style="text-align: center; background-color: #dedede;height: 40px">
        <th>ProductProductFestivalId</th>
        <th>Project</th>
        <th>Category</th>
        <th>Tracking Code</th>
        <th>Type </th>
        <th>Price</th>
    </tr>
    @foreach (var item in Model.CartItems
                  .Where(p => p.CartItemType == CartItemType.ServiceFee || p.CartItemType == CartItemType.Submit).GroupBy(p => p.FestivalId))
    {
        var projectSpan = item
            .Count(p => p.ProjectName == item.First().ProjectName);
        var categorySpan = item
            .Count(p => p.ProjectName == item.First().ProjectName
                        && p.SubmitCategoriesName == item.First().SubmitCategoriesName);
        var tCodeSpan = item
            .Count(p => p.ProjectName == item.First().ProjectName
                        && p.SubmitCategoriesName == item.First().SubmitCategoriesName
                        && p.SubmitTrackCode == item.First().SubmitTrackCode);

        <tr style="text-align: center;height: 50px;background-color: #eeeeee">
            <td rowspan="@(item.Count() + 1)">
                <div>
                    <img src="@($"data:image/png;base64,{Convert.ToBase64String(item.First().ImageUrl.ConvertImageToByteArray())}")"
                         height="40px" width="40px" alt="@item.First().FestivalName"/>
                    <h6> @item.First().FestivalName</h6>
                </div>
            </td>
            <td rowspan="@projectSpan">
                @item.First().ProjectName
            </td >
            <td rowspan="@categorySpan">
                @item.First().SubmitCategoriesName
            </td >
            <td rowspan="@tCodeSpan"> @item.First().SubmitTrackCode </td>
            <td > @item.First().CartItemType.ToDisplay() </td >
            <td > @item.First().GetRealPrice().ToString("N2") </td >
        </tr>
        foreach (var i in item.Where(p => p != item.First()))
        {
            var indexItem = item
                .Where(p => p != item.First()).ToList().IndexOf(i);
            //var projectSpan = item.GroupBy(p => p.SubmitTrackCode).Count() + 1;
            GetCartItemResponse previousItem;
            if (indexItem == 0)
            {
                previousItem = item.First();
            }
            else
            {
                previousItem = item.Where(p => p != item.First()).ToList()[indexItem - 1];
            }

            <tr style="text-align: center;height: 50px;background-color: #eeeeee">
                @if (previousItem.ProjectName != i.ProjectName)
                {
                    var projectSpan2 = item.Count(p =>
                        p.ProjectName == i.ProjectName);

                    <td rowspan="@projectSpan2">@i.ProjectName</td>
                }
                @if (previousItem.ProjectName != i.ProjectName || previousItem.SubmitCategoriesName != i.SubmitCategoriesName)
                {
                    var projectSpan2 = item.Count(p =>
                        p.ProjectName == i.ProjectName && p.SubmitCategoriesName == i.SubmitCategoriesName);

                    <td rowspan="@projectSpan2">@i.SubmitCategoriesName</td>
                }
                @if (previousItem.ProjectName != i.ProjectName
                     || previousItem.SubmitCategoriesName != i.SubmitCategoriesName || i.SubmitTrackCode != previousItem.SubmitTrackCode)
                {
                    var projectSpan2 = item.Count(p =>
                        p.ProjectName == i.ProjectName && p.SubmitCategoriesName == i.SubmitCategoriesName
                                                       && p.SubmitTrackCode == i.SubmitTrackCode);

                    <td rowspan="@projectSpan2">@item.First().SubmitTrackCode</td>
                }

                <td>@i.CartItemType.ToDisplay()</td>
                <td>@i.GetRealPrice().ToString("N2")</td>
            </tr>
        }
    }
</table>

    }

@if (Model.CartItems.Any(p => p.CartItemType == CartItemType.Product))
{
    <hr style="color: #eeeeee;margin: 5px"/>
        <h3 style="margin: 20px">Purchased Product Details </h3>
    <table class="cart-table">
        <tr style="text-align: center; background-color: #dedede;">
            <th>ProductProductFestivalId</th>
            <th>Product</th>
            <th>Price</th>
        </tr>
        @foreach (var item in Model.CartItems
                      .Where(p => p.CartItemType == CartItemType.Product).GroupBy(p => p.FestivalId))
        {
            <tr style="text-align: center;background-color: #eeeeee">
                <td rowspan="@(item.Count() + 1)">
                    @item.First().FestivalName
                </td>
                <td>@item.First().ProductName</td>
                <td>@item.First().GetRealPrice().ToString("N2")</td>
            </tr>
            foreach (var i in item.Where(p => p != item.First()))
            {
                <tr style="text-align: center;background-color: #eeeeee">
                    <td>@i.ProductName</td>
                    <td>@i.GetRealPrice().ToString("C2")</td>
                </tr>
            }
        }
    </table>
}


@if (Model.CartItems.Any(p => p.CartItemType == CartItemType.Badge
                              || p.CartItemType == CartItemType.Ticket))
{
    <hr style="color: #eeeeee;margin: 5px"/>
        <h3 style="margin: 20px">Purchased Ticket Details </h3>
    <table class="cart-table">
        <tr style="text-align: center; background-color: #dedede;">
            <th>ProductProductFestivalId</th>
            <th>Ticket</th>
            <th>Price</th>
        </tr>
        @foreach (var item in Model.CartItems
                      .Where(p => p.CartItemType == CartItemType.Badge || p.CartItemType==CartItemType.Ticket).GroupBy(p => p.FestivalId))
        {
            <tr style="text-align: center;background-color: #eeeeee">
                <td rowspan="@(item.Count() + 1)">
                    @item.First().FestivalName
                </td>
                <td>@item.First().SoldTicketName</td>
                <td>@item.First().GetRealPrice().ToString("N2")</td>
            </tr>
            foreach (var i in item.Where(p => p != item.First()))
            {
                <tr style="text-align: center;background-color: #eeeeee">
                    <td>@i.SoldTicketName</td>
                    <td>@i.GetRealPrice().ToString("C2")</td>
                </tr>
            }
        }
    </table>
}
<hr style="color: #eeeeee;margin: 5px"/>
<h3 style="margin: 20px">Payment Information </h3>
<table class="cart-table"
       style="border-radius:4px; width: 100%">
    <tbody style="padding: 4px;">
    <tr style="text-align: center;height: 50px;   background-color: #dedede;">
        <th>Paypal Email</th>
        <th>Payment Id</th>
        <th>Paid date</th>
        <th>Total Price</th>
    </tr>
    <tr style="text-align: center;height: 50px; background-color: #eeeeee;">
        <td>@Model.Email</td>
        <td>@Model.PaymentId</td>
        <td>@Model.CartDate.ToShortDateString()</td>
        <td>@Model.Price.ToString("N2")</td>
    </tr>
    @if (discountCodes.Count > 0)
    {
        <tr style="text-align: center;height: 40px; background-color: #f8f8f8;">
            <th colspan="2">Discount code(s)</th>
            <td colspan="2">@string.Join(", ", discountCodes)</td>
        </tr>
    }
