@model HiSubmit.Application.Models.Emails.EmailNotificationAddUserToFestivalViewModel

@{
    Layout = "_EmailLayout.cshtml";
}


<div class="content">
    <!-- عنوان اصلی -->
    <div class="title">
        You have been added to a festival‌
    </div>

    <!-- متن اصلی -->
    <div class="text">
        <div
            style="color:#393d47;direction:ltr;font-family:Helvetica Neue, Helvetica, Arial, sans-serif;font-size:14px;font-weight:400;letter-spacing:0px;line-height:120%;text-align:justify;mso-line-height-alt:19.2px;">
            <p style="margin: 0;">
                <b>" @Model.FestivalName "</b>  has added you to the festival
            </p>
            <p>
                Log in to your account to view more information
            </p>                
        </div>
    </div>
</div>



