@using Hisubmit.Client.SharedModels.Constants.Application
@using Microsoft.AspNetCore.SignalR.Client
@namespace HiSubmit.Web.Components.Shared.Dialogs
@inject IStringLocalizer<Logout> localizer
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.CloudDone" Color="Color.Success" Class="mr-3 mb-n1"/>
            @localizer[" Successfully Release festival"]
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudPaper Class="ma-2 pa-2">
             <MudText Typo="Typo.body2">@ContentText</MudText>
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="Cancel">@localizer["Ok"]</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; }
    

    [Parameter]
    public string ContentText { get; set; }

    private void Cancel()
    {
        MudDialog.Close();
    }
}