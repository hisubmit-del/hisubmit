@inject IStringLocalizer<NavMenu> Localize
@using System.Security.Claims
@using Hisubmit.Client.SharedModels.Constants.Role


@if (IsAdminRole)
{
    @* <MudListSubheader Class="mt-2 mb-n2">@Localize["Personal"]</MudListSubheader> *@
    @* <MudNavLink Href="/account" IconColor="Color.Tertiary" Icon="@Icons.Material.Outlined.SupervisorAccount"> *@
    @*     @Localize["Account"] *@
    @* </MudNavLink> *@

    <MudListSubheader Class="mt-2 mb-n2">@Localize["Administrator"]</MudListSubheader>

    <MudNavGroup Icon="@Icons.Material.Filled.AccountBox"  IconColor="Color.Tertiary" Title="User and Roles" Expanded="false">
        <MudNavLink Href="/identity/users" IconColor="Color.Tertiary" Icon="@Icons.Material.Outlined.Person">
            @Localize["Users"]
        </MudNavLink>
        <MudNavLink Href="/identity/roles" IconColor="Color.Tertiary" Icon="@Icons.Material.Outlined.Person">
            @Localize["Roles"]
        </MudNavLink>
    </MudNavGroup>
    <MudNavGroup Icon="@Icons.Material.Filled.Festival" IconColor="Color.Tertiary" Title="Festivals" Expanded="false">
        <MudNavLink Href="/admin/festivals" IconColor="Color.Tertiary" Icon="@Icons.Custom.Brands.Awesome">
            @Localize["Festivals List"]
        </MudNavLink>
        <MudNavLink Href="/festival/artCategory" IconColor="Color.Tertiary" Icon="@Icons.Material.Outlined.CallToAction">
            @Localize["ArtCategory"]
        </MudNavLink>
        <MudNavLink Href="/festivalFocus" IconColor="Color.Tertiary" Icon="@Icons.Material.Outlined.CenterFocusStrong">
            @Localize["Festival Focus"]
        </MudNavLink>
        <MudNavLink Href="/admin/violationReport" IconColor="Color.Tertiary" Icon="@Icons.Material.Outlined.Newspaper">
            @Localize["Violation Report"]
        </MudNavLink>
    </MudNavGroup>
    <MudNavGroup Icon="@Icons.Material.Filled.Campaign" IconColor="Color.Tertiary" Title="@Localize["Advertise"]" Expanded="false">
        <MudNavLink Href="/admin/advertises">@Localize["Requests"]</MudNavLink>
        <MudNavLink Href="/admin/banners">@Localize["Banners"]</MudNavLink>
    </MudNavGroup>
    <MudNavGroup Icon="@Icons.Material.Filled.ContentPaste" IconColor="Color.Tertiary" Expanded="false" Title="Content">
        <MudNavLink Href="/admin/contents" IconColor="Color.Tertiary" Icon="@Icons.Material.Outlined.ContentPaste">
            @Localize["StaticPage/MenuItem"]
        </MudNavLink>
        <MudNavLink Href="/admin/faq" IconColor="Color.Tertiary" Icon="@Icons.Material.Outlined.QuestionAnswer">
            @Localize["F&Q"]
        </MudNavLink>
        <MudNavLink Href="/admin/news" IconColor="Color.Tertiary" Icon="@Icons.Material.Outlined.Newspaper">
            @Localize["News"]
        </MudNavLink>
        <MudNavLink Href="/admin/content/seo" IconColor="Color.Tertiary" Icon="@Icons.Material.Filled.Search">
            @Localize["Seo"]
        </MudNavLink>
    </MudNavGroup>
    <MudNavGroup Icon="@Icons.Material.Filled.Money" IconColor="Color.Tertiary"
                 Expanded="false" Title="Financial">
        <MudNavLink Href="/admin/income/payments" IconColor="Color.Tertiary"
                    Icon="@Icons.Material.Outlined.Payments">Income</MudNavLink>
        @* <MudNavLink Href="/admin/income/carts" IconColor="Color.Tertiary" *@
        @*             Icon="@Icons.Material.Outlined.ShoppingCart">Carts</MudNavLink> *@
        <MudNavLink Href="/commissions" IconColor="Color.Tertiary" 
                    Icon="@Icons.Material.Outlined.CenterFocusStrong">
            @Localize["Commission"]
        </MudNavLink>
    </MudNavGroup>
    <MudNavLink Href="/admin/chat" IconColor="Color.Tertiary" Icon="@Icons.Material.Filled.Chat">
        @Localize["Chat"]
    </MudNavLink>
}

@code{
    private bool IsAdminRole { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        IsAdminRole = (await AuthenticationManager.CurrentUser())
            .IsInRole(RoleConstants.AdministratorRole);
    }

}