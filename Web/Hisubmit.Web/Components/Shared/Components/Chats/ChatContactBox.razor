@using global::Hisubmit.Client.SharedModels.Features.Chats.Queries
 <MudListItem T="string" Class="pa-2" OnClick="LoadUserChat">
    <div class="d-flex flex-row mt-n1 mb-n1">
        <div class="mr-4">
        @if (Contact.NotSeenCount is null or 0)
        {
            <div  Class="mx-6 my-1">
                @if (string.IsNullOrEmpty(Contact.ImageUrl))
                {
                    <MudAvatar Color="Color.Secondary" Style="height:50px; width:50px;">@Contact.FullName.ToUpper().FirstOrDefault()</MudAvatar>
                }
                else
                {
                    <MudAvatar Image="@Contact.ImageUrl" Style="height:50px; width:50px;"> </MudAvatar>
                }
            </div>
        }
        else
        {
            <MudBadge Color="Color.Default" Content="@Contact.NotSeenCount" Overlap="true" Class="mx-6 my-1">
                @if (string.IsNullOrEmpty(Contact.ImageUrl))
                {
                    <MudAvatar Color="Color.Secondary" Style="height:50px; width:50px;">@Contact.FullName.ToUpper().FirstOrDefault()</MudAvatar>
                }
                else
                {
                    <MudAvatar Image="@Contact.ImageUrl" Style="height:50px; width:50px;"> </MudAvatar>
                }
            </MudBadge>
        }
        </div>
        <div>
            <MudText Typo="Typo.body2" Class="mt-3 mb-n2">@Contact.FullName</MudText>
             @* <MudText Typo="Typo.caption" Style="font-size: xx-small!important;">@Contact.NotSeenCount</MudText>  *@
        </div>
    </div>
</MudListItem>

@code{

    [Parameter]
    public GetAllContactResponse Contact { get; set; }

    [Parameter]
    public EventCallback<GetAllContactResponse> OnClickContact { get; set; }

    private async Task LoadUserChat()
    {
        await OnClickContact.InvokeAsync(Contact);
    }
}