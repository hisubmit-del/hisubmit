@using global::Hisubmit.Client.SharedModels.Features.News.Queries
@using Hisubmit.Client.SharedModels.Extensions

<style>
    .max-height-100 {
        max-height: 100%;
    }
</style>
<MudCard Class="pa-1 pa-md-3">
    <img src="@New.BannerUrl" height="200px" class="max-width-100 max-height-100" alt="@New.Title" />
    @* <MudCardMedia Image="@($"/{New.BannerUrl}")" alt="@New.Title" Height="200"/> *@
    <MudCardContent>
        @if (ShowFestivalName && !string.IsNullOrWhiteSpace(New.FestivalName))
        {
            <MudChip T="string" Variant="Variant.Text" Color="Color.Info">
                @New.FestivalName
            </MudChip>
        }
        else
        {
            <MudChip T="string" Variant="Variant.Text" Color="Color.Info">Admin</MudChip>
        }
        <MudText Typo="Typo.h5" Class="h-3em">
            <a href="@($"/new/{New.Id}")">@New.Title</a>
        </MudText>
    </MudCardContent>
    <MudCardActions>
        <MudAvatar>
            <MudImage Src="@(string.IsNullOrWhiteSpace(New.FestivalLogoURL)?ClientAppConstants.SmallLogoUrl :New.FestivalLogoURL)"></MudImage>
        </MudAvatar>
        <MudText Inline="true" Typo="Typo.body2" Class="ml-1" Color="Color.Default" >@(string.IsNullOrWhiteSpace(New.FestivalName) ? "Admin":New.FestivalName)</MudText>
        <MudSpacer />
        <MudText Inline="true" Typo="Typo.body2" Color="Color.Default">@New.CreatedOn.ToLongDateString()</MudText>
    </MudCardActions>
</MudCard>


