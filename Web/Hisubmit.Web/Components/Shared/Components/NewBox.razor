@code {

    [Parameter]
    public GetAllNewResponse New { get; set; }

    [Parameter]
    public bool ShowFestivalName { get; set; }

    int _count;

    protected override Task OnInitializedAsync()
    {
        _count = New.ShortDescription.Length;
        if (_count > 200) _count = 200;
        return base.OnInitializedAsync();
    }
