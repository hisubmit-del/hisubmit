@using global::Hisubmit.Client.SharedModels.Features.Advertises.Queries
@using Hisubmit.Client.SharedModels.Extensions
@inject IStringLocalizer<Banners> Localize;
@inherits BaseAdminPages
@attribute [Authorize(Policy = Permissions.Advertise.BannerView)] 
@page "/admin/banners"


<MudContainer MaxWidth="MaxWidth.Large">
    <HeroTitle Title="@Localize["Advertisement Banners"]" Description="@Localize["Site advertising banner settings"]"/>
    
    <MudTable Loading="!_loaded" LoadingProgressColor="Color.Secondary" class="default-light-table"
              Elevation="25" Items="_pagedDate" TotalItems="_totalItems"
              ServerData="@(new Func<TableState,CancellationToken, Task<TableData<GetAllAdvertiseBannerResponse>>>(ServerReload))"
              Hover="true" Dense="false" Bordered="false" Striped="true" @ref="_table">
        <ToolBarContent>
            <div class="justify-center mud-text-align-center">
                <MudHidden Breakpoint="Breakpoint.MdAndDown">
                    <MudButton DisableElevation Variant="Variant.Filled" 
                               OnClick="@(() => OnSearch(""))" StartIcon="@Icons.Material.Filled.Refresh" 
                               IconColor="Color.Surface" Color="Color.Secondary">@Localize["Reload"]</MudButton>
                    <AuthorizeView Context="authorizeContext" Policy="@Permissions.Advertise.BannerUpdate">
                        <Authorized >
                            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                       OnClick="() => InvokeModal()"
                                       StartIcon="@Icons.Material.Filled.Add">Add Banner</MudButton>
                        </Authorized>
                    </AuthorizeView>
                </MudHidden>
                <MudHidden Breakpoint="Breakpoint.LgAndUp">
                    <MudIconButton DisableElevation Variant="Variant.Filled" 
                                   OnClick="@(() => OnSearch(""))" Icon="@Icons.Material.Filled.Refresh" Color="Color.Secondary"/>
                    <AuthorizeView Context="authorizeContext" 
                                   Policy="@Permissions.Advertise.BannerUpdate">
                        <Authorized >
                            <MudIconButton Variant="Variant.Filled" Color="Color.Primary" 
                                           OnClick="() => InvokeModal()" Icon="@Icons.Material.Filled.Add"/>
                        </Authorized>
                    </AuthorizeView>
                </MudHidden>
            </div>
            <MudSpacer/>
            <MudTextField T="string" ValueChanged="@(OnSearch)" 
                          Placeholder="@Localize["Search"]" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>@Localize["Image"]</MudTh>
            <MudTh>@Localize["Start Time"]</MudTh>
            <MudTh>@Localize["End Time"]</MudTh>
            <MudTh Style="text-align:center">@Localize["Actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Image">
                <img src="@context.Url" style="height:60px" Width="100" Height="60" 
                     alt="@context.Title" Elevation="25" Class="rounded-lg"/>
            </MudTd>
            <MudTd DataLabel="Start Time">
                <MudHighlighter Text="@context.OpenDateTime.ToLongDate()" HighlightedText="@_searchString"/>
            </MudTd>
            <MudTd DataLabel="End Time">
                <MudHighlighter Text="@context.CloseDateTime.ToLongDate()" HighlightedText="@_searchString"/>
            </MudTd>
            <MudTd DataLabel="Actions">
                <MudHidden Breakpoint="Breakpoint.MdAndDown">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   Title="Edit" OnClick="() => InvokeModal(context)" Color="Color.Default"></MudIconButton>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small" Title="Delete"
                                   OnClick="() => Delete(context.Id, context.Title)" Color="Color.Default"></MudIconButton>
                </MudHidden>
                <AuthorizeView Context="authorizeContext" Policy="@Permissions.Advertise.BannerUpdate">
                    <Authorized >
                        <MudHidden Breakpoint="Breakpoint.LgAndUp">
                            <MudMenu Label="@Localize["Actions"]" Variant="Variant.Filled" DisableElevation="true"
                                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                     IconColor="Color.Secondary" Direction="Direction.Left" OffsetX="true">
                                <MudMenuItem OnTouch="() => InvokeModal(context)"
                                             OnClick="(() => InvokeModal(context))">@Localize["Edit"]</MudMenuItem>
                                <MudMenuItem OnTouch="() => Delete(context.Id, context.Title)"
                                             OnClick="(() => Delete(context.Id, context.Title))">@Localize["Delete"]</MudMenuItem>
                            </MudMenu>
                        </MudHidden>
                    </Authorized>
                </AuthorizeView>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <TablePager/>
        </PagerContent>
    </MudTable>
</MudContainer>