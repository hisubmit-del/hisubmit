@inject IStringLocalizer<AddEditFestivalFocusModal> _localizer

<EditForm Model="@FestivalFocus" OnValidSubmit="SaveAsync">
    <FluentValidationValidator @ref="_fluentValidationValidator" />
    <MudDialog>
        <TitleContent>
            @{
                if (FestivalFocus.Id == 0)
                {
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-3 mb-n1" />
                        @_localizer["Add Focus"]
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Update" Class="mr-3 mb-n1" />
                        @_localizer["Update Focus"]
                    </MudText>
                }
            }
        </TitleContent>
        <DialogContent>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" For="@(() => FestivalFocus.Name)" @bind-Value="FestivalFocus.Name" Label="@_localizer["Name"]" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField For="@(() => FestivalFocus.Description)" @bind-Value="FestivalFocus.Description" Label="@_localizer["Description"]" />
                </MudItem>
            @*    <MudItem xs="12" md="6">
                    <MudTextField For="@(() => ArtCategoryModel.Tax)" @bind-Value="ArtCategoryModel.Tax" Label="@_localizer["Tax"]" />
                </MudItem>*@
            </MudGrid>
        </DialogContent>
        <DialogActions>
            <MudButton DisableElevation Variant="Variant.Filled" OnClick="Cancel">@_localizer["Cancel"]</MudButton>
            @if (FestivalFocus.Id != 0)
            {
                <LoadingButton Processing="_processing" DisableElevation Variant="Variant.Filled" ButtonType="ButtonType.Submit" Disabled="@(!Validated)" Color="Color.Secondary">@_localizer["Update"]</LoadingButton>
            }
            else
            {
                <LoadingButton Processing="_processing" DisableElevation Variant="Variant.Filled" ButtonType="ButtonType.Submit" Disabled="@(!Validated)" Color="Color.Success">@_localizer["Save"]</LoadingButton>
            }
        </DialogActions>
    </MudDialog>
</EditForm>