@page "/news"
@inherits BasePublicPages
<SeoMetaTags PageId="0" PageType="@PageType.NewsList" />
<section class="article-section">
    @if (_loaded && _news.Any())
    {
        <MudContainer MaxWidth="MaxWidth.Large">
            @{
                var n = _news.FirstOrDefault(p=>p.IsPined);
                <div class="news-top">
                    <img src="@n.BannerUrl" />

                    <MudCard Class="pa-1 pa-md-3 news-desc">
                        @* <MudCardMedia Image="@($"/{New.BannerUrl}")" alt="@New.Title" Height="200"/> *@
                        <MudCardContent>
                            @if (!string.IsNullOrWhiteSpace(n.FestivalName))
                            {
                                <MudChip T="string" Variant="Variant.Text" Color="Color.Info">
                                    @n.FestivalName 
                                </MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Variant="Variant.Text" Color="Color.Info">Admin</MudChip>
                            }
                            <MudText Typo="Typo.h5">
                                <a href="@($"/new/{n.Id}")">@n.Title</a>
                            </MudText>
                        </MudCardContent>
                        <MudCardActions>
                            <MudAvatar>
                                <MudImage Src="@(string.IsNullOrWhiteSpace(n.FestivalLogoURL)?ClientAppConstants.SmallLogoUrl :n.FestivalLogoURL)"></MudImage>
                            </MudAvatar>
                            <MudText Inline="true" Typo="Typo.body2" Class="ml-1" Color="Color.Default">@(string.IsNullOrWhiteSpace(n.FestivalName) ? "Admin" : n.FestivalName)</MudText>
                            <MudSpacer />
                            <MudText Inline="true" Typo="Typo.body2" Color="Color.Default">@n.CreatedOn.ToLongDateString()</MudText>
                        </MudCardActions>
                    </MudCard>

                </div>
            }

            <MudGrid Justify="Justify.Center"
                     class="festival-key-search-box text-center justify-center px-lg-14 px-2 my-10">
                <MudItem xs="12" md="6" xl="5">
                    <MudTextField DebounceInterval="500"
                                  @bind-Value="@SearchString"
                                  Variant="Variant.Outlined"                                 
                                  Adornment="Adornment.End"       
                                  OnAdornmentClick="Search"
                                  AdornmentColor="Color.Surface"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
            </MudGrid>


            <MudGrid>
                <MudText Typo="Typo.h1"
                         Class="align-self-start  news-title  flex-1 my-8">
                   Read Art Competitions latest news and updates here 
                </MudText>

            </MudGrid>
            <div>
                <MudText Typo="Typo.subtitle2" Class="my-4" Inline="false">Last Post</MudText>
            </div>
            <MudGrid>
                @foreach (var n in _news.Where(p=>!p.IsPined))
                {
                    <MudItem xs="12" md="6" lg="4" class="mb-4">
                        <NewBox New="n" ShowFestivalName="true" />
                    </MudItem>
                }
            </MudGrid>
            <Pagination ChangedCurrentPage="ChangePage" TotalPage="_newResponse.TotalPages" CurrentPage="@PageNumber" />
        </MudContainer>
    }
</section>

