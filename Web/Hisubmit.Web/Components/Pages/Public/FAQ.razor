@page "/faq"
@using Hisubmit.Client.SharedModels.Features.StaticPages.Commands
@inherits BasePublicPages

@if (_loaded)
{
    <MudContainer MaxWidth="MaxWidth.Large">

        @if (_faqResponse.Data.Any(p => p.FaqType == FaqType.General))
        {
            <MudText Typo="Typo.h3" Class="mt-18 mb-12">General frequently Asked questions</MudText>

            <MudGrid Class="faq-box">
                <MudItem xs="12" md="6" Class="right">
                    @{
                        var selected = _faqResponse.Data
                        .FirstOrDefault(p => p.FaqType == FaqType.Artist && p.IsSelected);
                        @if (selected != null)
                        {
                            <MudText Typo="Typo.subtitle2">
                                @selected.Title
                            </MudText>
                            <p lass="mt-2">
                                @selected.Content
                            </p>
                        }
                    }
                </MudItem>
                <MudItem xs="12" md="6" Class="left">
                    <MudPaper>
                        @foreach (var d in _faqResponse.Data.Where(p => p.FaqType == FaqType.General))
                        {
                            <MudGrid Class="my-2 left-item">
                                <MudItem xs="1">
                                    <MudAvatar Color="Color.Tertiary"></MudAvatar>
                                </MudItem>
                                <MudItem xs="10">
                                    <MudText Typo="Typo.subtitle2">
                                        @d.Title
                                    </MudText>
                                </MudItem>
                                <MudItem xs="1">
                                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight"></MudIcon>
                                </MudItem>
                            </MudGrid>
                        }

                    </MudPaper>
                </MudItem>
            </MudGrid>

        }
        @if (_faqResponse.Data.Any(p => p.FaqType == FaqType.Festival))
        {
            <MudText Typo="Typo.h3" Class="mt-18 mb-12">FestivalIds frequently Asked questions</MudText>

            <MudGrid Class="faq-box">
                <MudItem xs="12" md="6" Class="right">
                    @{
                        var selected = _faqResponse.Data
                        .FirstOrDefault(p => p.FaqType == FaqType.Festival && p.IsSelected);
                            @if (selected != null)
                            {
                        <MudText Typo="Typo.subtitle2">
                                @selected.Title
                        </MudText>
                        <p lass="mt-2">
                            @selected.Content
                        </p>
                            }
                    }
                </MudItem>
                <MudItem xs="12" md="6" Class="left">
                    <MudPaper>
                        @foreach (var d in _faqResponse.Data.Where(p => p.FaqType == FaqType.Festival))
                        {
                            <MudGrid Class="my-2 left-item">
                                <MudItem xs="1">
                                    <MudAvatar Color="Color.Tertiary"></MudAvatar>
                                </MudItem>
                                <MudItem xs="10">
                                    <MudText Typo="Typo.subtitle2">
                                        @d.Title
                                    </MudText>
                                </MudItem>
                                <MudItem xs="1">
                                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight"></MudIcon>
                                </MudItem>
                            </MudGrid>
                        }

                    </MudPaper>
                </MudItem>
            </MudGrid>

        }

        @if (_faqResponse.Data.Any(p => p.FaqType == FaqType.Artist))
        {

            <MudText Typo="Typo.h3" Class="mt-18 mb-12">Artists frequently Asked questions</MudText>

            <MudGrid Class="faq-box">
                <MudItem xs="12" md="6" Class="right">
                    @{
                        var selected = _faqResponse.Data
                        .FirstOrDefault(p => p.FaqType == FaqType.Artist && p.IsSelected);
                        @if (selected != null)
                        {
                            <MudText Typo="Typo.subtitle2">
                                @selected.Title
                            </MudText>
                            <p lass="mt-2">
                                @selected.Content
                            </p>
                        }
                    }
                </MudItem>
                <MudItem xs="12" md="6" Class="left">
                    <MudPaper>
                        <MudNavMenu>
                            @foreach (var d in _faqResponse.Data.Where(p => p.FaqType == FaqType.Artist))
                            {
                                <MudNavLink OnClick="() => SetSelect(d)">
                                    <MudGrid Class="my-2 left-item">
                                        <MudItem xs="1">
                                            <MudAvatar Color="Color.Tertiary"></MudAvatar>
                                        </MudItem>
                                        <MudItem xs="10">
                                            <MudText @oncliclk="()=>SetSelect(d)" Typo="Typo.subtitle2">
                                                @d.Title
                                            </MudText>
                                        </MudItem>
                                        <MudItem xs="1">
                                            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"></MudIconButton>
                                        </MudItem>
                                    </MudGrid>
                                </MudNavLink>
                            }
                        </MudNavMenu>

                    </MudPaper>
                </MudItem>
            </MudGrid>
        }

    </MudContainer>

}