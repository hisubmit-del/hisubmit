@using Hisubmit.Client.SharedModels.Extensions

<h4 class="sponsored-festival-title my-2"> Screenings/Awards</h4>    

<div class="gallery-tab-slider mb-5 pb-4 mt-5">
    <div class="tab-content" id="gallery-tab-slider-tabContent">
          <div class="tab-pane fade show active" id="pills-about" role="tabpanel"
               aria-labelledby="pills-about-tab">
              <div class="gallery-slider " id="award-project-slider">
                  @foreach (var award in ScreenAwards)
                  {
                      <MudCard Style="@($"background:{Colors.BlueGray.Lighten5}")">
                          <MudItem xs="6" lg="4" Class="text-end my-auto">
                              <MudAvatar Size="Size.Large">
                                  <MudImage Src="@award.ImageUrl" Alt="@award.Title"></MudImage>
                              </MudAvatar>
                          </MudItem>
                          <MudItem xs="6" lg="8" Class="pl-0 d-flex flex-column flex-grow-1 ">
                              <MudText Typo="Typo.h6">@award.Title</MudText>
                              <MudText Typo="Typo.subtitle2">@award.AwardSelection</MudText>
                              <MudText Typo="Typo.subtitle2">@award.ScreeningDate.Year</MudText>
                          </MudItem>
                      </MudCard>
                  }
                  @foreach (var award in Awards)
                  {
                      <MudCard  Style="@($"background:{Colors.BlueGray.Lighten5}")">
                          <MudItem xs="6" lg="4" Class="text-end my-auto">
                              <MudAvatar Size="Size.Large">
                                  <MudImage Src="@award.ImageUrl" Alt="@award.Title"></MudImage>
                              </MudAvatar>
                          </MudItem>
                          <MudItem xs="6" lg="8" Class="pl-0 d-flex flex-column flex-grow-1">
                              <MudText Typo="Typo.h6">@award.Title</MudText>
                              <MudText Typo="Typo.subtitle2">@award.AwardsWon</MudText>
                              <MudText Typo="Typo.subtitle2">@award.Location</MudText>
                          </MudItem>
                      </MudCard>
                  }

              </div>
</div>
    </div>
</div>
