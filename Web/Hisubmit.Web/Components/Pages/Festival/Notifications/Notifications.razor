@page "/festival/notifications"

@inject IStringLocalizer<Notifications> Localize;
@using Hisubmit.Client.SharedModels.Features.Notifications.Queries
@using Hisubmit.Client.SharedModels.Extensions
@inherits BaseFestival
<MudContainer MaxWidth="MaxWidth.Medium">

    <HeroTitle Title="@Localize["Notifications"]" Description="@Localize["Your festival Notifications "]" />

    <MudTable Loading="!_loaded" LoadingProgressColor="Color.Secondary" class="default-light-table" Elevation="25" Items="_pagedDate" TotalItems="_totalItems"
              ServerData="@(new Func<TableState,CancellationToken, Task<TableData<GetAllNotificationResponse>>>(ServerReload))" Hover="true" Dense="true" Bordered="false" Striped="true" @ref="_table">
        <ToolBarContent>
            <MudSpacer />
            <MudTextField T="string" ValueChanged="@(OnSearch)" Placeholder="@Localize["Search"]" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <HeaderContent>
            @* <MudTh>@Localize["Date"]</MudTh> *@
            <MudTh>@Localize["Date"]</MudTh>
            <MudTh>@Localize["Text"]</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Title">
                @context.CreatedOn.ToLongDateTime()
            </MudTd>
            <MudTd DataLabel="Title">
                <MudHighlighter Text="@context.Title" HighlightedText="@_searchString" />
            </MudTd>
            <MudTd DataLabel="Show in site">
                <MudIconButton Icon="@Icons.Material.Filled.RemoveRedEye" Variant="Variant.Filled" Href="@context.Link"></MudIconButton>
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <TablePager />
        </PagerContent>
    </MudTable>
</MudContainer>

