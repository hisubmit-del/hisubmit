
@using Hisubmit.Client.SharedModels.Extensions
@inject IStringLocalizer<ProductSoldDetailDialog> Localize

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Assessment" Class="mr-3 mb-n1"/>
            @Localize["Product Sold Detail"]
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (!_loaded)
        {
            <MudGrid Class="pa-2">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="300px" />
            </MudGrid>
        }
        else
        {
        <MudGrid>
            <MudItem xs="12" lg="6">
                <DividerAndTitle Title="User Information" Class="ma-3"/>
                
                <MudStack Row="true" Class="mb-4" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.h5">@Localize["User Name"]:</MudText>
                    <MudText Typo="Typo.body1">@_productSold.UserName</MudText>
                </MudStack>
                <MudStack Row="true" Class="mb-4" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.h5">@Localize["Email"]:</MudText>
                    <MudText Typo="Typo.body1">@_productSold.UserEmail</MudText>
                </MudStack>
                <MudStack Row="true" Class="mb-4" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.h5">@Localize["Phone Number"]:</MudText>
                    <MudText Typo="Typo.body1">@_productSold.UserPhoneNumber</MudText>
                </MudStack>

                <DividerAndTitle Title="Purchase" Class="ma-5"/>

                <MudStack Row="true" Class="mb-4" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.h5">@Localize["Cost"]:</MudText>
                    <MudText Typo="Typo.body1">@_productSold.CartItem.Price.ToString("C2")</MudText>
                </MudStack>
                <MudStack Row="true" Class="mb-4" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.h5">@Localize["Purchase Date"]:</MudText>
                    <MudText Typo="Typo.body1">@_productSold.CartItem.PaidDate.ToLongDateTime()</MudText>
                </MudStack>

            </MudItem>
            <MudItem xs="12" lg="6">
                <DividerAndTitle Title="Product" Class="ma-3"/>
                <MudStack Row="true" Class="mb-4" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.h5">@Localize["Product"]:</MudText>
                    <MudText Typo="Typo.body1">@_productSold.Product.Name</MudText>
                </MudStack>
                <MudStack Row="true" Class="mb-4" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.h5">@Localize["Product ItemType"]:</MudText>
                    <MudText Typo="Typo.body1">@_productSold.Product.ProductType.ToDisplay()</MudText>
                </MudStack>
                @if (_productSold.Product.ProductType == ProductType.Sent && _productSold.Address != null)
                {
                    <DividerAndTitle Title="Address" Class="ma-3"/>
                    <MudStack Row="true" Class="mb-4" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.h5">@Localize["Country"]:</MudText>
                        <MudText Typo="Typo.body1">@_productSold.Address.CountryName</MudText>
                    </MudStack>
                    <MudStack Row="true" Class="mb-4" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.h5">@Localize["City"]:</MudText>
                        <MudText Typo="Typo.body1">@_productSold.Address.City</MudText>
                    </MudStack>
                    <MudStack Row="true" Class="mb-4" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.h5">@Localize["State"]:</MudText>
                        <MudText Typo="Typo.body1">@_productSold.Address.State</MudText>
                    </MudStack>
                    <MudStack Row="true" Class="mb-4" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.h5">@Localize["Address"]:</MudText>
                        <MudText Typo="Typo.body1">@_productSold.Address.Text</MudText>
                    </MudStack>
                }
                else
                {
                    <DividerAndTitle Title="Email" Class="ma-3"/>

                    <MudStack Row="true" Class="mb-4" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.h5">@Localize["Email to send file"]:</MudText>
                        <MudText Typo="Typo.body1">@_productSold.Email</MudText>
                    </MudStack>
                }
            </MudItem>
        </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton DisableElevation Variant="Variant.Filled" OnClick="Close">@Localize["Ok"]</MudButton>
    </DialogActions>
</MudDialog>