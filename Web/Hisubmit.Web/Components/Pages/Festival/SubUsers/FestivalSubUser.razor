@page "/festival/subuser/users"

@inject IStringLocalizer<FestivalSubUser> Localize
@using global::Hisubmit.Client.SharedModels.Responses.Identity
@inherits BaseFestival
<style>
    .mud-table-container {
        overflow: auto;
    }
</style>

<MudContainer MaxWidth="MaxWidth.Large">
    <HeroTitle Title="@Localize["Users"]" />
    @if (!_loaded)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <MudTable Hover="true" Elevation="25" Items="_userList" Dense="@_dense" Bordered="@_bordered" 
                  Striped="@_striped" Filter="new Func<UserResponse, bool>(Search)" @bind-user="_user">
            <ToolBarContent>
                <div class="justify-center mud-text-align-center min-w-xs-50">
                    <MudHidden Breakpoint="Breakpoint.MdAndDown">
                        <FestivalAuthorizeView Policy="@Permissions.SubUser.CreateNewUser">
                            <MudButton DisableElevation Variant="Variant.Filled" Color="Color.Primary" 
                                       OnClick="InvokeModal" StartIcon="@Icons.Material.Filled.AppRegistration"
                                       IconColor="Color.Surface">@Localize["Register New User"]</MudButton>
                        </FestivalAuthorizeView>
                        <FestivalAuthorizeView Policy="@Permissions.SubUser.AddExistUser">
                            <MudButton DisableElevation Variant="Variant.Filled" Color="Color.Info" 
                                       OnClick="AddToFestival" StartIcon="@Icons.Material.Filled.Add" 
                                       Style="margin-left: 5px;" IconColor="Color.Surface">@Localize["Add Existing User To festival "]</MudButton>
                        </FestivalAuthorizeView>
                        <MudButton DisableElevation Variant="Variant.Filled" OnClick="GetUsersAsync" 
                                   StartIcon="@Icons.Material.Filled.Refresh" IconColor="Color.Surface" 
                                   Color="Color.Secondary">@Localize["Reload"]</MudButton>

                    </MudHidden>
                    <MudHidden Breakpoint="Breakpoint.LgAndUp">
                        <FestivalAuthorizeView Policy="@Permissions.SubUser.CreateNewUser">
                            <MudIconButton DisableElevation Variant="Variant.Filled" Color="Color.Primary" 
                                           OnClick="InvokeModal" Icon="@Icons.Material.Filled.AppRegistration" />
                        </FestivalAuthorizeView>
                        <FestivalAuthorizeView Policy="@Permissions.SubUser.AddExistUser">
                            <MudIconButton DisableElevation Variant="Variant.Filled" Color="Color.Info"
                                           OnClick="AddToFestival" Icon="@Icons.Material.Filled.Add" Style="margin-left: 5px;" />
                        </FestivalAuthorizeView>
                        <MudIconButton DisableElevation Variant="Variant.Filled" OnClick="GetUsersAsync" 
                                       Icon="@Icons.Material.Filled.Refresh" Color="Color.Secondary" />
                    </MudHidden>

                </div>
                <MudSpacer />

                <MudTextField @bind-Value="_searchString" Immediate="true" FullWidth=false 
                              Placeholder="@Localize["Search For Users"]" Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium" Class="mt-0 mb-3"></MudTextField>

            </ToolBarContent>
            <HeaderContent>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<UserResponse, object>(x => x.FirstName)">@Localize["First Name"]</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<UserResponse, object>(x => x.LastName)">@Localize["Last Name"]</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<UserResponse, object>(x => x.Email)">@Localize["Email"]</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<UserResponse, object>(x => x.PhoneNumber)">@Localize["PhoneNumber"]</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<UserResponse, object>(x => x.EmailConfirmed)">@Localize["Email Confirmation"]</MudTableSortLabel>
                </MudTh>
                <MudTh>
                    <MudTableSortLabel SortBy="new Func<UserResponse, object>(x => x.IsActive)">@Localize["Active"]</MudTableSortLabel>
                </MudTh>
                <MudTh Style="text-align:right">@Localize["Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="FirstName">
                    <MudHighlighter Text="@context.FirstName" HighlightedText="@_searchString" />
                </MudTd>
                <MudTd DataLabel="LastName">
                    <MudHighlighter Text="@context.LastName" HighlightedText="@_searchString" />
                </MudTd>

                <MudTd DataLabel="Email">
                    <MudHighlighter Text="@context.Email" HighlightedText="@_searchString" />
                </MudTd>
                <MudTd DataLabel="PhoneNumber">
                    <MudHighlighter Text="@context.PhoneNumber" HighlightedText="@_searchString" />
                </MudTd>
                <MudTd DataLabel="EmailConfirmed">
                    <MudCheckBox T="bool" @bind-Value="@context.EmailConfirmed" ReadOnly Color="Color.Secondary"></MudCheckBox>
                </MudTd>
                <MudTd DataLabel="Active">
                    <MudCheckBox T="bool" @bind-Value="@context.IsActive" ReadOnly Color="Color.Secondary"></MudCheckBox>
                </MudTd>
                <MudTd DataLabel="Actions" Style="text-align:right">
                    <MudMenu Label="@Localize["Actions"]" Variant="Variant.Filled" DisableElevation="true" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" IconColor="Color.Secondary" Direction="Direction.Left" OffsetX="true">
                        <MudMenuItem OnClick="(() => ViewProfile(context.Id))">@Localize["View Profile"]</MudMenuItem>
                        <FestivalAuthorizeView Policy="@Permissions.SubUser.ManageRoles">
                            <MudMenuItem   OnClick="(() => ManageRoles(context.Id, context.Email))">@Localize["Manage Roles"]</MudMenuItem>
                        </FestivalAuthorizeView>
                        <FestivalAuthorizeView Policy="@Permissions.SubUser.AddToProject">
                            <MudMenuItem OnClick="() => AddToProjects(context.Id)">@Localize["Add To projects"]</MudMenuItem>
                        </FestivalAuthorizeView>
                        <FestivalAuthorizeView Policy="@Permissions.SubUser.RemoveFestival">
                            <MudMenuItem  OnClick="() => RemoveFromFestival(context.Id)">@Localize["Remove From festival"]</MudMenuItem>
                        </FestivalAuthorizeView>
                    </MudMenu>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <TablePager />
            </PagerContent>

        </MudTable>
    }
</MudContainer>