@inject IStringLocalizer<AddEditEventVenueModal> _localizer

@using Hisubmit.Client.SharedModels.Extensions
<EditForm Model="@Venue">
    <FluentValidationValidator @ref="_fluentValidationValidator"/>
    <MudDialog>
        <TitleContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-3 mb-n1"/>
                @_localizer["Add Venue"]
            </MudText>
        </TitleContent>
        <DialogContent>
            @if (!_loaded)
            {
                <MudContainer MaxWidth="MaxWidth.Medium" Style="height:120px">
                    <Spinner></Spinner>
                </MudContainer>
            }
            else
            {
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" For="@(() => Venue.Name)"
                                      Required="true"
                                      Variant="Variant.Filled"  Margin="Margin.Dense" 
                                      @bind-Value="Venue.Name" Label="@_localizer["Name"]"/>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="VenueType" Margin="Margin.Dense" Label="ItemType"
                                   Variant="Variant.Filled" @bind-Value="Venue.VenueType"
                                   AnchorOrigin="Origin.BottomCenter">

                            @foreach (VenueType value in Enum.GetValues(typeof(VenueType)))
                            {
                                <MudSelectItem Value="value">@value.ToDisplay()</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12">
                        <AddressComponent Address="Venue.Address"></AddressComponent>
                    </MudItem>
                </MudGrid>
            }
        </DialogContent>
        <DialogActions>
            <MudButton DisableElevation Variant="Variant.Filled" OnClick="Cancel">@_localizer["Cancel"]</MudButton>
            <LoadingButton Processing="_processing"   Variant="Variant.Filled" OnClick="SaveAsync"
                           ButtonType="ButtonType.Submit" Color="Color.Success">@_localizer["Save"]</LoadingButton>
        </DialogActions>
    </MudDialog>
</EditForm>