@page "/festival/products"
@inject IStringLocalizer<Products> Localize
@using global::Hisubmit.Client.SharedModels.Features.Products.Queries.GetAllPaged;
@inherits BaseFestival

<MudContainer MaxWidth="MaxWidth.Medium">
    <HeroTitle Title="@Localize["Products"]" Description="@Localize["Manage your festival Products."]" />
    @if (!_loaded)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <MudTable Elevation="25"
                  ServerData="@(new Func<TableState,CancellationToken, Task<TableData<GetAllPagedProductsResponse>>>(ServerReload))"
                  Hover="true" @ref="_table">
            <ToolBarContent>
                <div class="justify-center mud-text-align-center min-w-xs-50">
                    <MudHidden Breakpoint="Breakpoint.LgAndUp">
                        <FestivalAuthorizeView Policy="@Permissions.FestivalProducts.Edit">
                            <MudIconButton DisableElevation Variant="Variant.Filled" Color="Color.Primary"
                                           @onclick="@(() => InvokeModal(0))" Icon="@Icons.Material.Filled.Add" />
                        </FestivalAuthorizeView>


                        <MudIconButton DisableElevation Variant="Variant.Filled"
                                       OnClick="@(() => OnSearch(""))" Icon="@Icons.Material.Filled.Refresh"
                                       Color="Color.Secondary" />
                    </MudHidden>
                    <MudHidden Breakpoint="Breakpoint.MdAndDown">
                        <FestivalAuthorizeView Policy="@Permissions.FestivalProducts.Edit">
                            <MudButton DisableElevation Variant="Variant.Filled" Color="Color.Primary"
                                       Href="/festival/products/add"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       IconColor="Color.Surface">
                                @Localize["Create"]
                            </MudButton>
                        </FestivalAuthorizeView>
                        <MudButton DisableElevation Variant="Variant.Filled"
                                   OnClick="@(() => OnSearch(""))" StartIcon="@Icons.Material.Filled.Refresh"
                                   IconColor="Color.Surface" Color="Color.Secondary">
                            @Localize["Reload"]
                        </MudButton>
                    </MudHidden>
                </div>
                <MudSpacer />

                <MudTextField T="string" ValueChanged="@(OnSearch)"
                              Placeholder="@Localize["Search"]"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Medium" Class="mt-0" />

            </ToolBarContent>
            <HeaderContent>
                <MudTh>
                    <MudTableSortLabel T="GetAllPagedProductsResponse" SortLabel="Name">
                        @Localize["Name"]
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    @Localize["Enable"]
                </MudTh>
                <MudTh>
                    <MudTableSortLabel T="GetAllPagedProductsResponse" SortLabel="Price">
                        @Localize["Price"]
                    </MudTableSortLabel>
                </MudTh>
                <MudTh>
                    @Localize["ItemType"]
                </MudTh>
                <MudTh Style="text-align:right">@Localize["Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">
                    <MudHighlighter Text="@context.Name" HighlightedText="@_searchString" />
                </MudTd>
                <MudTd DataLabel="Enable">
                    @if (context.IsEnable)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Block" Size="Size.Small" Color="Color.Error" />
                    }
                </MudTd>
                <MudTd DataLabel="Price">
                    <MudHighlighter Text="@context.Price.ToString("C2")" HighlightedText="@_searchString" />
                </MudTd>
                <MudTd>
                    <ProductTypeChip ProductType="@context.ProductType" />
                </MudTd>
                <MudTd DataLabel="Actions" Style="text-align: right">
                    <FestivalAuthorizeView Policy="@Permissions.FestivalProducts.Edit">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       Href="@($"/festival/products/add/{context.Id}")"/>
                            
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" 
                                       OnClick="@(() => Delete(context.Id))"/>
                       
                    </FestivalAuthorizeView>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <TablePager />
            </PagerContent>
        </MudTable>
    }
</MudContainer>
