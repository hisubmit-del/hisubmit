@inject IStringLocalizer<FinalResultModal> Localize

@using Hisubmit.Client.SharedModels.Extensions
<EditForm Model="@FinalJudging" OnValidSubmit="SubmitResult">
    @*<FluentValidationValidator @ref="_fluentValidationValidator" />*@
    <MudDialog>
        <TitleContent>
            @{
                <MudText Typo="Typo.h6">
                    <MudIcon Icon="@Icons.Material.Filled.Verified" Class="mr-3 mb-n1"/>
                    @Localize["Final Result"]
                </MudText>
            }
        </TitleContent>
        <DialogContent>
            <MudGrid>

                <MudItem Class="mb-2 " xs="12" md="6">
                    <MudSelect T="JudgingStatus" @bind-Value="FinalJudging.JudgingStatus" Label="Judging Enable" Variant="Variant.Filled" AnchorOrigin="Origin.BottomCenter">
                        @foreach (JudgingStatus value in Enum.GetValues(typeof(JudgingStatus)))
                        {
                            <MudSelectItem Value="value">@value.ToDisplay()</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem Class="mb-2 " xs="12" md="6">
                    <MudSelect T="SubmitStatus" @bind-Value="FinalJudging.SubmitStatus" Label="Submission State" Variant="Variant.Filled" AnchorOrigin="Origin.BottomCenter">
                        @foreach (SubmitStatus value in Enum.GetValues(typeof(SubmitStatus)))
                        {
                            if (value!=SubmitStatus.Paid && value !=SubmitStatus.DontPaid && value!=SubmitStatus.Default )
                            {
                                <MudSelectItem Value="value">@value.ToDisplay()</MudSelectItem>
                            }

                            if (value == SubmitStatus.Paid)
                            {
                                <MudSelectItem Disabled="true" Value="value">@value.ToDisplay()</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="12">
                    <MudTextField Lines="3" Variant="Variant.Filled" For="@(() => FinalJudging.Comment)" @bind-Value="FinalJudging.Comment" Label="@Localize["Comment"]"/>
                </MudItem>
            </MudGrid>
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Filled" OnClick="Cancel">@Localize["Cancel"]</MudButton>
            @{
                <LoadingButton Processing="_processing" Variant="Variant.Filled" ButtonType="ButtonType.Submit" Color="Color.Success">@Localize["Notify"]</LoadingButton>
            }
        </DialogActions>
    </MudDialog>
</EditForm>